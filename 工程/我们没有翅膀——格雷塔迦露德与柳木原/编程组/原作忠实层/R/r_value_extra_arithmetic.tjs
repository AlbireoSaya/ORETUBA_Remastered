function RValueExtraArithmetic(op, a, b) {
    if (typeof op !== "Integer" || typeof a !== "Integer" || typeof b !== "Integer") {
        throw new global.Exception("RValueExtraArithmetic: op, a, b must be Integer");
    }
    var x = a & 0xffffffff;
    var y = b & 0xffffffff;
    if (op == 14) {
        return (x - y) & 0xffffffff;
    }
    if (op == 15) {
        return global.RValueExtraMul(x, y);
    }
    throw new global.Exception("RValueExtraArithmetic: unsupported op " + op);
}