function RRunRecord(record, base, params, rd, wr, evalExpr, varMap) {
    var c = RRecordValue(record.condition, base, rd, evalExpr, varMap) & 0xffffffff;
    if (record.opcode == 0) {
        c = (c == 0) ? 1 : 0;
    }
    if (c == 0) {
        return %["accepted" => false, "condition_value" => 0, "parameter_count" => 0, "parameter_end" => params];
    }
    var items = record.items;
    for (var i = 0; i < items.count; i++) {
        RWriteRecordItem(items[i], base, (params + 8 * i) & 0xffffffff, rd, wr, evalExpr, varMap);
    }
    return %["accepted" => true, "condition_value" => c, "parameter_count" => items.count, "parameter_end" => (params + 8 * items.count) & 0xffffffff];
}
