function RRecordFixtureValue(rows, v, isItem) {
    rows.add(["value", v.tag, v.kind]);

    if (isItem) {
        rows.add(["flags", v.flags]);
    }

    if (typeof v.selector != "undefined") {
        rows.add(["selector", v.selector]);
    }

    if (v.kind == "always") {
    } else if (v.kind == "empty" || v.kind == "literal") {
        rows.add(["literal", v.value]);
    } else if (v.kind == "array") {
        rows.add(["array", v.bank_index, v.element_index]);
    } else if (v.kind == "inline") {
        rows.add(["inline", v.data_offset, v.data_size]);
    } else if (v.kind == "expression") {
        RRecordFixtureExpression(rows, v.expression);
    } else {
        throw new Exception("UNKNOWN_FIXTURE_KIND");
    }
}
