function RVMFByte(s, q) {
    RVMFRange(s, q, 1, false);
    var v = s.words["" + (q & 0xfffffffc)];
    if (typeof v != "Integer")
        throw new Exception("RVMFByte: word is not Integer");
    return (v >> ((q & 3) * 8)) & 255;
}

function RVMFRB(q) {
    return RVMFByte(this, q);
}

function RVMFRD(q) {
    RVMFRange(this, q, 4, false);
    var b0 = RVMFByte(this, q);
    var b1 = RVMFByte(this, q + 1);
    var b2 = RVMFByte(this, q + 2);
    var b3 = RVMFByte(this, q + 3);
    return (b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)) & 0xffffffff;
}