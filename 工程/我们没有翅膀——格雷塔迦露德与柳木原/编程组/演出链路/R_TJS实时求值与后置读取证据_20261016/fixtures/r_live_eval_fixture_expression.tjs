// r_live_eval_fixture_expression.tjs
// RVEExpression(p) —— live 表达式求值 fixture。
// 只委托 global.RLiveExpressionEvaluate，不自实现 VM / 指针链。

function RVEExpression(p)
{
	var rd = global.RVERead32 incontextof this;
	var rh = global.RVERead16 incontextof this;
	var rb = global.RVERead8 incontextof this;
	var wr = global.RVEWrite32 incontextof this;
	var wb = global.RVEWrite8 incontextof this;
	var resolve = global.RVEResolve incontextof this;
	var native = global.RVEForbiddenNative;
	var run = global.RVEVM incontextof this;

	var r = global.RLiveExpressionEvaluate(rd, wr, rh, rb, wb, p, this.cursor, this.ctx, resolve, native, run, 1000);

	this.bindings.add([r.bound ? 1 : 0]);

	return [r.value, r.next_cursor];
}
