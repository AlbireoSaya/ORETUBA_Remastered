// r_live_bind_fixture_reads.tjs
function RLFWatched(s, q)
{
    if(q >= s.source && q < s.source + 4096) return true;
    if(q >= 0x1000000 && q < 0x1100000) return true;
    if(q >= 0x5355e4 && q < 0x5355f4) return true;
    if(q >= s.cursor && q < s.cursor + 4) return true;
    if(q >= 0 && q < 4096) return true;
    return false;
}

function RLFRead32(q)
{
    if(!RLFWatched(this, q)) throw new Exception("UNEXPECTED_LIVE_BIND_READ");
    var v = RMemoryRead32(this.memory, q);
    this.events.add(["r", q, 4, v]);
    return v;
}

function RLFRead16(q)
{
    if(!RLFWatched(this, q)) throw new Exception("UNEXPECTED_LIVE_BIND_READ");
    var v = RMemoryRead16(this.memory, q);
    this.events.add(["r", q, 2, v]);
    return v;
}

function RLFRead8(q)
{
    if(!RLFWatched(this, q)) throw new Exception("UNEXPECTED_LIVE_BIND_READ");
    var v = RMemoryRead8(this.memory, q);
    this.events.add(["r", q, 1, v]);
    return v;
}
