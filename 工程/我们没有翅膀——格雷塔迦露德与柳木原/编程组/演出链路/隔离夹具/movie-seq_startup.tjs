Scripts.execStorage("config.tjs");
Debug.startLogToFile();
Debug.message("C0_BEGIN " + C0Nonce);
try {
    Scripts.execStorage("ui_movie.tjs");
    Scripts.execStorage("ui_movie_seqtest.tjs");
    var C0Result = uiMovieSeqTestRun();
    Debug.message("C0_VERDICT " + C0Nonce + ((C0Result && UMSTFails == 0) ? " PASS " : " FAIL ")
        + (UMSTChecks - UMSTFails) + "/" + UMSTChecks);
} catch(C0Error) {
    Debug.message("C0_EXCEPTION " + C0Nonce + " " + C0Error.message);
    Debug.message("C0_VERDICT " + C0Nonce + " FAIL 0/0");
}
System.exit();
