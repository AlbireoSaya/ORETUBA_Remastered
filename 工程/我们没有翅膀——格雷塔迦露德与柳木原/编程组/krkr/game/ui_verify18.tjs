// ============================================================
// ui_verify18.tjs —— 流程图自绘「分页 + 标题 + 视图」机检（ISSUE-20261004-03，诊断用）
//
// 判定对象（全部是**可失败**的断言，不是空跑）：
//   ① **分页几何**：9 页；每页节点/连线/标题/场景 id 四表同长；包围盒 == 由 Nodes 现算的极值；
//   ② ★ **同坐标成组 = 0**（本轮的分页改造就是为了消掉 UI 组 `full` 预设的 48 处同坐标叠字）
//      + ★ **同层两节点矩形不相交**（水平间距 ≥ 节点宽）；
//   ③ 页表合计 = **构建集** 676 场（语料 712 − D15/D30 去重件 36）；**跨页锚点出边合计 = 12**
//      （与 `流程图分页方案.md` §五 定稿一致）；ISSUE-20261004-12 起节点集跟随 spine 构建集。
//   ④ 连线表里**存在多点折线**（异列贝塞尔展平 / 枢纽总线）—— 证明曲线路径真的进了几何；
//   ⑤ **标题真的画出来了**（`UIFullLastResult.labels > 0`）＋ 折行缓存冷/热对照；
//   ⑥ 自绘启用时 UI 静态节点族被隐藏（判据取 UI 组自己的可见性谓词在最终状态上的返回值）；
//   ⑦ 滚轮缩放（含上下界夹取负向）、拖动平移（>阈值不当点选）、**点选节点进入场景**；
//   ⑧ **页签切页**：点第 N 个页签 → `flow_page_enter` → `uiFlowFullSelectPage(N)` → 表真的换了；
//   ⑨ 负向：视口外/节点间空隙处不得命中节点。
//
// 开关：`game\flowshot.txt`（由 `ui_boot.tjs` 装载并武装）+ `game\flowfull.txt`（开自绘）。
// 判词：`★FLOWVIEW★ PASS n/n` / FAIL；结束 `★FLOWVIEW-DONE★`。
// 截图：`UIStoryWin.exportPng()` → `shot_2xx_flow18_<tag>.png`（`Debug.logLocation`）。
//
// ⚠️ TJS2：计分状态一律放**模块级变量**（嵌套函数读写外层局部变量会抛「未找到 Member」）。
// ⚠️ 全程不抛异常 —— krkrz 对**被 catch 的异常**仍打整段 dump，会污染 `An exception occured` 判定线。
// ============================================================

var UV18Timer = null;
var UV18Phase = 0;
var UV18Ok = 0;
var UV18All = 0;
var UV18Fails = [];
var UV18ShotN = 200;

// 每页节点数指纹（由 `emit_flow_pages.py` 的体检输出直接抄来；版式一变立刻 FAIL ⇒ 要人重核）
var UV18PageCounts = [164, 105, 114, 94, 55, 36, 28, 53, 27];   // ISSUE-20261004-12 去重后（F −4、J −32）

function uv18log(m) { Debug.message("[VERIFY18] " + m); }

function uv18chk(name, cond, got)
{
	UV18All++;
	if(cond === true) { UV18Ok++; uv18log("  OK   " + name); }
	else { UV18Fails.push(name + "（实际=" + got + "）"); uv18log("  FAIL " + name + " ｜ 实际=" + got); }
}

function uv18scr() { var s = "?"; try { s = "" + uiScreenCurrent(); } catch(e) { } return s; }

function uv18draw()
{
	if(UIStoryWin === null || UIStoryWin === void) return;
	try { UIStoryWin.redraw(); } catch(e) { uv18log("redraw 异常：" + e.message); }
}

// ★ 截图走 UI 组的 `exportPng`（读 `stageLayer`），**不用 `primLayer`**：
//   实测 `primLayer.copyToBitmapFromMainImage()` **不合成子层**（四张图字节数完全一样 = 只有底板填充）。
//   ⚠️ 乒乓双缓冲 ⇒ 拍摄一律排在「上一相位已画好」的相位开头，否则会拍到上一屏。
function uv18shot(tag)
{
	UV18ShotN++;
	if(UIStoryWin === null || UIStoryWin === void) { uv18log("截图跳过（无窗口）：" + tag); return; }
	try { UIStoryWin.exportPng("flow18_" + tag, UV18ShotN); } catch(e) { uv18log("截图异常：" + tag + " : " + e.message); }
}

function uv18stats(tag)
{
	var n = -1, l = -1, t = -1, s = -1, pg = -1, nm = "?";
	try { n = UIFlowGeomNodes.count; } catch(e1) { }
	try { l = UIFlowGeomLinks.count; } catch(e2) { }
	try { t = UIFlowGeomTitles.count; } catch(e3) { }
	try { s = UIFlowGeomIds.count; } catch(e4) { }
	try { pg = UIFullPageCur; } catch(e5) { }
	try { nm = "" + UIFlowPageNames[pg]; } catch(e6) { }
	uv18log("· " + tag + "：第 " + pg + " 页「" + nm + "」几何 节点 " + n + " / 连线 " + l
		+ " / 标题 " + t + " / 场景id " + s
		+ " ｜ 视图 view=(" + Math.floor(UIFullViewX) + "," + Math.floor(UIFullViewY) + ") zoom=" + UIFullZoom
		+ " ｜ 本帧 " + UIFullHookNote);
}

function uv18Last(tag)
{
	if(UIFullLastResult === null || UIFullLastResult === void)
	{ uv18log("· " + tag + "：本帧无绘制结果（钩子未跑？）"); return null; }
	uv18log("· " + tag + "：本帧 节点 " + UIFullLastResult.nodes + " / 连线 " + UIFullLastResult.links
		+ " / 箭头 " + UIFullLastResult.arrows + " / **标题 " + UIFullLastResult.labels + "**"
		+ " ｜ 页签+锚点 " + UIFullChromeDrawn
		+ " ｜ 分段 " + UIFullPerfNote);
	return UIFullLastResult;
}

// ★ 函数名必须与 `ui_boot.tjs` 里调用的名字**逐字一致**（本项目已踩：叫 uv18Start 而 boot 调
//   uiVerify18Start ⇒ 抛「未找到 Member」，脚手架整段没跑、还多一条 exception dump）。
function uiVerify18Start()
{
	if(UV18Timer !== null) return false;
	UV18Phase = 0; UV18Ok = 0; UV18All = 0; UV18Fails = [];
	// ★ ISSUE-20261004-12：**本机检与影片解耦**（与 verify15 同款，A/B 取证见该记录）。
	//   槽② 片头 OP 会在 `game_start` 接管流程，使「开局进 dialog」及其后的已读断言整组失败；
	//   影片路径另有自己的验证（movietest + run_storytest --entry/--skip-movie）。
	UIMovieEnabled = false;
	uv18log("已关闭影片模块（UIMovieEnabled=false）——本机检不验影片");
	try { if(UIMovieActive === true) uiMovieClose(); } catch(eMC) { }
	try
	{
		UV18Timer = new Timer(uv18Tick, '');
		// ★ ISSUE-20261005-02：600 → 800ms。原注「> 420ms 转场」只留 180ms 余量，而转场管理器
		//   自身还有 120ms 放行余量（`420+120`）⇒ 实际余量仅 60ms；巡演第 10→11 步存在
		//   「dialog→flowchart→切页签」三连转场，机器稍有负载即撞车（实测：加入章节过场卡后
		//   偶发 `ui_transition.tjs` 转场撞车 dump ⇒ 判定线 FAIL，A/B 对照坐实）。
		//   800ms 与既有成文口径一致（自测收尾相位「相位之间等约 1 秒，转场 420ms」）。
		UV18Timer.interval = 800;
		UV18Timer.enabled = true;
	}
	catch(e) { Debug.message("[VERIFY18][ERR] Timer 建立失败：" + e.message); return false; }
	uv18log("开始（800ms/拍）；开关 game\\flowshot.txt");
	return true;
}

function uv18Tick()
{
	if(UV18Timer === null) return;
	UV18Phase++;
	var p = UV18Phase;

	// ① 分页几何体检
	if(p == 1)
	{
		try { uiFlowFullLoadGeometry(); } catch(eL1) { }     // ★ 几何是**懒装载**，本相位先显式装一次
		uv18stats("装载后");
		uv18chk("已装载**分页**几何（非旧扁平件）", UIFullPageLoaded == true, UIFullPageLoaded);
		uv18chk("页数 = 9", UIFlowPageTable.count == 9, UIFlowPageTable.count);
		uv18chk("页名[0] = 渡来明日香", ("" + UIFlowPageNames[0]) == "渡来明日香", "" + UIFlowPageNames[0]);
		uv18chk("当前页 = 0（A 渡来明日香）", UIFullPageCur == 0, UIFullPageCur);
		uv18chk("当前页 节点 164", UIFlowGeomNodes.count == 164, UIFlowGeomNodes.count);
		uv18chk("当前页 连线 218", UIFlowGeomLinks.count == 218, UIFlowGeomLinks.count);
		uv18chk("当前页 标题 164", UIFlowGeomTitles.count == 164, UIFlowGeomTitles.count);
		uv18chk("当前页 场景 id 164", UIFlowGeomIds.count == 164, UIFlowGeomIds.count);
		uv18chk("当前页 锚出 3 / 锚入 1",
			UIFullPagOutAnchors.count == 3 && UIFullPagInAnchors.count == 1,
			"" + UIFullPagOutAnchors.count + " / " + UIFullPagInAnchors.count);

		// ── 全 9 页体检（同坐标 / 同层相交 / 合计 / 锚点 / 多点连线）──────────
		var totalNodes = 0, totalAnchors = 0, coincident = 0, maxStack = 0;
		var overlapPairs = 0, minDx = 999999, multiPt = 0, badPageCount = "";
		var pi = 0;
		for(pi = 0; pi < UIFlowPageTable.count; pi++)
		{
			var T = UIFlowPageTable[pi];
			totalNodes += T.nodes.count;
			totalAnchors += T.anchors_out.count;
			if(T.nodes.count != UV18PageCounts[pi])
				badPageCount += ("" + pi + ":" + T.nodes.count + "≠" + UV18PageCounts[pi] + " ");
			// 同坐标成组
			var seenM = %[];
			var ci = 0;
			for(ci = 0; ci < T.nodes.count; ci++)
			{
				var cn = T.nodes[ci];
				var key = "" + (0 + cn[0]) + "," + (0 + cn[1]) + "," + (0 + cn[2]) + "," + (0 + cn[3]);
				var cnt = (seenM[key] === void) ? 0 : (0 + seenM[key]);
				seenM[key] = cnt + 1;
				if(cnt + 1 == 2) coincident++;
				if(cnt + 1 > maxStack) maxStack = cnt + 1;
			}
			// 同 y 分组的水平间距（同层不得相交；节点宽 296）
			var byY = %[];
			for(ci = 0; ci < T.nodes.count; ci++)
			{
				var n2 = T.nodes[ci];
				var ky = "" + (0 + n2[1]);
				if(byY[ky] === void) byY[ky] = [];
				byY[ky].add(0 + n2[0]);
			}
			var ks = [];
			ks.assign(byY);
			var qi = 0;
			for(qi = 1; qi < ks.count; qi += 2)
			{
				var xs = ks[qi];
				var ia = 0, ib = 0;
				for(ia = 0; ia < xs.count; ia++)
					for(ib = ia + 1; ib < xs.count; ib++)
					{
						var d = xs[ia] - xs[ib];
						if(d < 0) d = 0 - d;
						if(d < minDx) minDx = d;
						if(d < 296) overlapPairs++;
					}
			}
			// 多点连线（贝塞尔展平 / 总线）
			for(ci = 0; ci < T.links.count; ci++)
				if(T.links[ci].count > 4) multiPt++;
		}
		uv18log("· 全 9 页合计：节点 " + totalNodes + " ｜ 锚出 " + totalAnchors + " ｜ 同坐标成组 " + coincident
			+ "（单格最多 " + maxStack + "）｜ 同层相交对 " + overlapPairs
			+ " ｜ 同层最小水平间距 " + minDx + " ｜ 多点连线 " + multiPt);
		uv18chk("★同坐标成组 = 0（分页的核心目标）", coincident == 0, coincident + " 组 / 最多 " + maxStack);
		// ★ 前置条件（一审 Minor-2）：上面两条在「0 节点」时会**退化通过**（coincident 恒 0、
		//   minDx 恒 999999）。加一条非空前置断言，让它们**独立可失败**，不再依赖同相位的别的断言兜底。
		uv18chk("★前置：全页节点合计 > 0（防止上面两条在空几何上退化通过）", totalNodes > 0, totalNodes);
		uv18chk("★同层两节点矩形不相交（最小水平间距 ≥ 296）", overlapPairs == 0 && minDx >= 296,
			"相交 " + overlapPairs + " 对 / 最小间距 " + minDx);
		uv18chk("★全页节点合计 = 676（＝spine 构建集；语料 712 − 去重件 36）", totalNodes == 676, totalNodes);
		uv18chk("★跨页锚点出边合计 = 12（方案 §五 定稿）", totalAnchors == 12, totalAnchors);
		uv18chk("★每页节点数 = 定稿指纹 164/105/114/94/55/36/28/53/27（ISSUE-20261004-12 去重后）",
			badPageCount == "", badPageCount);
		uv18chk("★连线表含多点折线（异列贝塞尔展平 / 枢纽总线）", multiPt > 0, multiPt);
		// ★ 版式**规则**计数（算法真的按「并排分叉 + 汇合对齐」在跑，而不是只把坐标摊平）：
		//   并排分叉 = 触发横向铺开的父节点数；汇合对齐 = 多父节点回到最近公共祖先列的个数。
		var fN = -1, mA = -1, mNL = -1, hb = -1, sf = -1;
		try
		{
			fN  = 0 + UIFlowPageRule.fan_nodes;
			mA  = 0 + UIFlowPageRule.merge_aligned;
			mNL = 0 + UIFlowPageRule.merge_no_lca;
			hb  = 0 + UIFlowPageRule.hubs;
			sf  = 0 + UIFlowPageRule.shifted;
		}
		catch(eR1) { }
		uv18log("· 版式规则：并排分叉 " + fN + " ｜ 汇合对齐 " + mA + " ｜ 无 LCA " + mNL
			+ " ｜ 枢纽 " + hb + " ｜ 去冲突推挤 " + sf);
		uv18chk("★并排分叉节点数 = 51（定稿；版式一变即 FAIL 须重核）", fN == 51, fN);
		uv18chk("★汇合对齐 73 个且**全部**命中最近公共祖先（无 LCA = 0）",
			mA == 73 && mNL == 0, "对齐 " + mA + " / 无 LCA " + mNL);
		uv18chk("★菜单枢纽 = 1（np_start_oretuba，走左侧总线）", hb == 1, hb);

		// ★ 包围盒必须**真的来自生成物**：模块里预置了默认值，只断言"非空"会被默认值满足。
		var bx0 = 0, by0 = 0, bx1 = 0, by1 = 0, first = true;
		for(var bi = 0; bi < UIFlowGeomNodes.count; bi++)
		{
			var bn = UIFlowGeomNodes[bi];
			var x0 = 0 + bn[0], y0 = 0 + bn[1], x1 = x0 + (0 + bn[2]), y1 = y0 + (0 + bn[3]);
			if(first) { bx0 = x0; by0 = y0; bx1 = x1; by1 = y1; first = false; }
			else { if(x0 < bx0) bx0 = x0; if(y0 < by0) by0 = y0; if(x1 > bx1) bx1 = x1; if(y1 > by1) by1 = y1; }
		}
		uv18chk("包围盒 == 由 Nodes 现算的极值",
			UIFlowGeomBBox.count == 4 && UIFlowGeomBBox[0] == bx0 && UIFlowGeomBBox[1] == by0
			&& UIFlowGeomBBox[2] == bx1 && UIFlowGeomBBox[3] == by1,
			"表 " + UIFlowGeomBBox + " vs 现算 [" + bx0 + "," + by0 + "," + bx1 + "," + by1 + "]");
		return;
	}
	// ② 开局 → dialog
	if(p == 2) { try { uiActionDispatch("game_start", -1); } catch(e) { } uv18draw();
		uv18chk("开局进 dialog", uv18scr() == "dialog", uv18scr()); return; }
	// ③ 进流程图
	if(p == 3)
	{
		try { uiActionDispatch("open_flowchart", -1); } catch(e) { }
		uv18draw();
		uv18chk("进入 flowchart 屏", uv18scr() == "flowchart", uv18scr());
		uv18chk("默认缩放 = 1.0", UIFullZoom == 1.0, UIFullZoom);
		uv18stats("flowchart 默认视图");
		return;
	}
	// ④ 拍默认视图（上一相位已画好）；标题/缓存/隐藏/页签 全部断言
	if(p == 4)
	{
		uv18shot("1_pageA_top");
		uv18draw();
		var r = uv18Last("默认视图");
		uv18chk("节点已画出 (>3)", r !== null && r.nodes > 3, (r === null) ? "null" : r.nodes);
		uv18chk("连线已画出 (>0)", r !== null && r.links > 0, (r === null) ? "null" : r.links);
		uv18chk("★标题已画出 (>=3)", r !== null && r.labels >= 3, (r === null) ? "null" : r.labels);
		// 默认视图（zoom 1.0）一屏只看得见 5–6 个节点（一页就是一条 1.97 万 px 的长竖列，
		// 与原作同款）⇒ 页签条一定在（9 条），锚点标记要等下面的「全览」相位才进视口。
		uv18chk("★页签条已画出 (>=9)", UIFullChromeDrawn >= 9, UIFullChromeDrawn);

		// ★ 折行缓存自证（不能靠连调两次 `uv18draw()`：`redraw()` 有脏检查，第二次是空转）
		var okCache = false, cCold = -1, cWarm = -1, cNote = "";
		try
		{
			if(UIFlowFullLayer === null || UIFlowFullLayer === void) uiFlowFullInit(UIStoryWin);
			var vp = UIFlowGeomViewport;
			UIFullLabelCache = []; UIFullLabelCacheZoom = -1.0;      // 强制冷启动
			var rc = uiFlowFullDraw(vp[0], vp[1], vp[2], vp[3], true, true, true, true);
			var rw = uiFlowFullDraw(vp[0], vp[1], vp[2], vp[3], true, true, true, true);
			if(rc !== null && rw !== null)
			{
				cCold = rc.msLabels; cWarm = rw.msLabels;
				okCache = (rw.msLabels < rc.msLabels);
				cNote = "（标题 冷 " + cCold + " ms → 热 " + cWarm + " ms；标题条数 " + rc.labels + "）";
			}
			else cNote = "（离屏层不可用 ⇒ 本项无法自证）";
		}
		catch(eCC) { cNote = "（异常：" + eCC.message + "）"; }
		uv18log("· 折行缓存冷/热对照" + cNote);        // ★ 无论成败都落数字（一审：只在失败时打印＝无法独立复算）
		uv18chk("★折行缓存生效（同 zoom 第2帧标题耗时 < 第1帧）", okCache == true, cNote);

		// ★ 用户 2026-10-03 裁决（Q1①）：自绘启用时**隐藏 UI 静态节点族**。
		//   判据取 **UI 组自己的可见性谓词在最终状态上的返回值**，不取"flag 被设成了什么"。
		var scF = null, nodeEl = null, labelEl = null, jumpEl = null;
		try
		{
			scF = UILayoutData.screens["flowchart"];
			for(var ei = 0; ei < scF.elements.count; ei++)
			{
				var e2 = scF.elements[ei];
				if(e2 === void || e2.id === void) continue;
				var id2 = "" + e2.id;
				if(nodeEl === null  && id2 == "fc.node.0001")      nodeEl = e2;
				if(labelEl === null && id2 == "fc.label.0001_tx")  labelEl = e2;
				if(jumpEl === null  && id2 == "fc.jump_hit")       jumpEl = e2;
			}
		}
		catch(eFE) { uv18log("找元素异常：" + eFE.message); }
		var flagNow = "";
		try { flagNow = "" + uiScreenFlagGet("fc_layer"); } catch(eFG) { }
		var visNode = true, visLabel = true, visJump = false;
		try { if(nodeEl  !== null) visNode  = (uiScreenElementVisible(nodeEl)  == true); } catch(eVN) { }
		try { if(labelEl !== null) visLabel = (uiScreenElementVisible(labelEl) == true); } catch(eVL) { }
		try { if(jumpEl  !== null) visJump  = (uiScreenElementVisible(jumpEl)  == true); } catch(eVJ) { }
		uv18chk("★自绘启用时 fc_layer 被置为哨兵值", flagNow == "selfdraw", flagNow);
		uv18chk("★UI 幕级节点**真的不显示**（fc.node.0001）", visNode == false, visNode);
		// ⚠️ 名称订正（一审重要-2）：`fc.label.*_tx` 的 sample 是**番外入口块的文字**，不是泳道标签。
		uv18chk("★UI 番外入口块文字**真的不显示**（fc.label.0001_tx）", visLabel == false, visLabel);
		uv18chk("反向：右栏「进入本章」**仍显示**（没有误藏整屏）", visJump == true, visJump);
