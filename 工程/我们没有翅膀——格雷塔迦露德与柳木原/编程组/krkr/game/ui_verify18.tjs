		try { rq2 = uiScreenClick(UIStoryWin.stageLayer, qx2, qy2); } catch(eQ5) { }
		var aq2 = (rq2 === null || rq2 === void || rq2.action === void) ? "" : ("" + rq2.action);
		uv18chk("再点节点仍走确认卡", aq2 == "flow_ask_open", "action=[" + aq2 + "]");
		if(aq2 == "flow_ask_open")
		{
			try { uiActionDispatch(aq2, 1); } catch(eQ6) { }
		}
		// 「进入」按钮矩形要等确认卡画过一帧后才有效 ⇒ 若还没算好，本相位只开卡
		if(UIFullAskYes.count == 4)
		{
			var yx = Math.floor(UIFullAskYes[0] + UIFullAskYes[2] / 2);
			var yy = Math.floor(UIFullAskYes[1] + UIFullAskYes[3] / 2);
			var ry = null;
			try { ry = uiScreenClick(UIStoryWin.stageLayer, yx, yy); } catch(eQ7) { }
			var ay = (ry === null || ry === void || ry.action === void) ? "" : ("" + ry.action);
			uv18chk("★点「进入」→ flow_scene_enter + index=1", ay == "flow_scene_enter"
				&& ((ry === null || ry === void || ry.index === void) ? -1 : (0 + ry.index)) == 1,
				"action=[" + ay + "]");
			if(ay == "flow_scene_enter")
			{
				try { uiActionDispatch(ay, 1); } catch(eQ8) { }
				uv18chk("★确认后进入 dialog 屏", uv18scr() == "dialog", uv18scr());
				uv18chk("★确认后载入的场景正确", ("" + UIStoryCur) == ("" + UIFlowGeomIds[1]), "" + UIStoryCur);
				uv18chk("★跳转后确认卡自动关闭", UIFullAskIdx == -1, UIFullAskIdx);
			}
		}
		else uv18log("· 「进入」按钮矩形尚未算出（该相位只开卡，未点按钮）");
		uv18draw();
		return;
	}
	// ㉓ 拍「确认后已进入该场景」；恢复 askJump 默认关
	if(p == 23)
	{
		uv18shot("15_afterjump");
		UIFullAskJump = false;
		uv18chk("askJump 已恢复默认关", UIFullAskJump == false, UIFullAskJump);
		return;
	}
	// ㉔ 收尾
	if(p == 24)
	{
		var tot = UV18Ok + UV18Fails.count;
		Debug.message("[VERIFY18] ★FLOWVIEW★ " + ((UV18Fails.count == 0) ? "PASS " : "FAIL ")
			+ UV18Ok + "/" + tot
			+ ((UV18Fails.count == 0) ? "" : ("  ｜ " + UV18Fails.join(" ｜ "))));
		Debug.message("★FLOWVIEW-DONE★");
		if(UV18Timer !== null) { try { UV18Timer.enabled = false; } catch(eE) { } }
		return;
	}
}
