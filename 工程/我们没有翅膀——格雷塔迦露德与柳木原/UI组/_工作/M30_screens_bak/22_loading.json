      "h": 1080,
      "color": "@palette.backdrop",
      "opacity": 255,
      "note": "全屏遮罩（required「全屏遮罩」；不透明纯黑，完全遮盖下层画面）"
    },
    {
      "id": "loading.box_fill",
      "kind": "rect",
      "z": 10,
      "visible_default": true,
