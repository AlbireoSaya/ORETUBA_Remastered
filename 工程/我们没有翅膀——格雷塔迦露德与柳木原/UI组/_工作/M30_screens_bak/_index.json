{
  "_comment": "屏清单（主代理维护）。owner = 写权限归属模块；file = 相对 layout/screens/ 的文件名。",
  "screens": [
    {
      "id": "title",
      "file": "01_title.json",
      "title_cn": "标题画面",
      "owner": "M13",
      "required": [
        "满幅背景图（x_bg_system，不留黑边）",
        "标题 logo",
        "主菜单 7 项（图上烘焙中英文，439×122 的 image + hit 各 7，按内容右边缘居右对齐）",
        "署名行"
      ]
    },
    {
      "id": "dialog",
