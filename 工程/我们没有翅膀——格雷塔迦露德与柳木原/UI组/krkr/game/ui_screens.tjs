// ============================================================
// ui_screens.tjs —— 屏渲染调度 / 界面栈导航 / 动作表 / 自动巡演（M2 · UI 组）
//
// 设计原则（用户与 M2 验收硬要求）：
//   * **一切由 layout 数据驱动**：本文件不出现任何屏级坐标；某屏存在就按
//     UILayoutData.screens[id] 的元素表渲染，不存在就画「模块未接入」占位。
//     ⇒ M5 之后新增 layout/screens/2x_*.json 时，只要重跑 gen_layout.py，
//        本渲染器**无需改动**即可覆盖新屏。
//   * 屏级"装饰"（占位画面）的几何也全部由 UILayoutData 的 canvas 与 fonts 推出。
//   * 缺件/缺屏不崩：登记 + 占位 + 日志，绝不抛异常打断演示。
//
// 与 M4 的接口（本模块不实现，只留调用点）：
//   open_flowchart / open_fragment → 若 layout 里已有该屏则正常渲染；
//   否则显示「模块未接入」占位（等 M4 交付 3x_*.json 与 ui_flow.tjs / ui_fragment.tjs 后自动接管）。
// ============================================================

// ------------------------------------------------------------
// 界面栈与状态
// ------------------------------------------------------------
var UIScrStack        = [];
var UIScrPage         = %[];    // 键 = 元素 id，值 = 页码
var UIScrFocus        = %[];    // 键 = 元素 id，值 = 高亮项下标
// ★ M1（2026-09-24 · ISSUE-20260924-08_鉴赏模式）：**栏位内差分翻页**的运行期序号。
//   键 = `"<list 元素 id>|<全局行号>"`，值 = 当前差分序号（0 基）。由 `ctx.variantIndex`
//   交给 `ui_widget.tjs` 的 `uiWidgetVariantIdx`（clamp 在那边做）。换屏（gallery_tab_*）时清空。
var UIScrVarIdx       = %[];
// ★ M1：鉴赏动作的**可观测状态**（巡演 `★M08VAR★` / `★M08PAGE★` / `★M08TAB★` 直接读它们）。
var UIScrGalLastAct   = "";   // 最近一次派发的鉴赏动作**原文**（含行号）
var UIScrGalLastRow   = -1;   // 最近一次派发解析出的行号（-1 = 无/非法）
var UIScrGalActCount  = 0;    // 累计派发次数（区分「真派发过」与「值恰好相同」）
var UIScrGalLastTab   = "";   // 最近一次切屏的目标屏 id
var UIScrActiveList   = "";     // 最近交互的列表 id（翻页键的目标）
var UIScrBlinkPhase   = 0.0;    // 通用闪烁相位（0/1）
var UIScrSeenThisRun  = [];
var UIScrSeenIndex    = %[];
var UIScrEventLog     = [];
var UIScrLastEvent    = "";
var UIScrPlaceholder  = "";     // 当前屏是占位时的原因（"" = 正常）
var UIScrQuitRequest  = false;  // 请求退出（由窗口执行 close）
var UIScrDrawCount    = 0;
// ★ M13：窗口对象的登记点。startup.tjs 在 UiWindow 构造完成后写入（= 引擎里那个 Window 实例），
//   供巡演的「合成鼠标事件」步骤调用 onMouseDown —— 自动巡演本身不产生真实鼠标事件，
//   右键图标浮层（sysicons）无法被巡演覆盖，故用同一入口合成一次右键。
//   方向说明：startup.tjs 读 ui_screens.tjs 的变量是**已实测成立**的方向（如 UIScrTourIdList），
//   故这里声明、startup 赋值，不依赖反向。
var UIScrMouseSink    = null;
var UIScrMouseLastMsg = "";
var UIScrSynthMouse   = false;  // ★ M13：合成鼠标事件进行中（startup.tjs 的 onMouseDown 据此跳过静默期/巡演判定）
var UIScrOverlayLogged = %[];   // ★ M13：浮层「先画下层」日志去重表（键 = "下层>浮层"）
// ★ M20：悬停态。UIScrHoverHit = 当前鼠标悬停命中的 hit 元素 id（"" = 无）。
//   由 startup.tjs 的 onMouseMove(x,y) 每帧调用 uiScreenHoverUpdate() 维护；
//   uiScreenCtx() 把它透传给渲染 ctx，ui_widget.tjs 的 uiWidgetDrawHit 据此画 hover 图。
var UIScrHoverHit   = "";
var UIScrHoverMsg   = "";       // 最近一次悬停变化的可读描述（诊断用）
// ★ M35：按下态（点击态）。UIScrPressHit = 当前左键**按住**时命中的 hit 元素 id（"" = 无）。
//   置位：startup.tjs 的 onMouseDown 左键分支 → uiScreenPressUpdate()；
//   清空：① onClick（左键抬起，源码 TVPWindow.cpp:95 WM_LBUTTONUP→OnClick）
//         ② 指针移出该元素（在 uiScreenHoverUpdate 里连同悬停一起判，见下方规则表）
//         ③ 换屏（随 uiScreenHoverClear 一起清）
//   UIScrPressProbe = **验收用强制按下探针**（非空时优先于 UIScrPressHit，供巡演导出按下态截图）。
//   来源：**项目根 `press_probe.tjs`**（一行 `UIScrPressProbe = "<元素id>";`），
//         由 startup.tjs 的 uiInitPressProbe() 用 Scripts.execStorage 执行 —— 详见该函数注释
//         （为什么不用命令行参数：本轮实测本引擎版本脚本读不到命令行参数）。
var UIScrPressHit   = "";
var UIScrPressMsg   = "";       // 最近一次按下变化的可读描述（诊断用）
var UIScrPressProbe = "";
// ★ M46：指针位置（供列表逐项三态）+ 当前悬停项序号（供「同项内换项也要重画」判定）
var UIScrPointerX   = -1;
var UIScrPointerY   = -1;
var UIScrHoverIndex = -1;
// ★ M46：按下态**锁存的项序号**（-1 = 非逐项）。按下时锚定、抬起/移出该项时清空 ——
//   绝不能每帧按指针重算，否则「按下态跟着鼠标飘」（详见 uiScreenPressUpdate 注释）。
var UIScrPressIndex = -1;

// ★ M47（2026-09-24 · ISSUE-20260924-01 · 《M47_设置屏重设方案》§三.1/§三.2）：**滑块拖动**。
//   UIScrDragSlider = 正在被拖动的 `slider` 元素 id（"" = 未拖动）。
//     起点：uiScreenPressUpdate 命中**带 `slider` 字段的 hit**（见 uiScreenSliderHitEl）；
//     终点：① uiScreenPressClear（左键抬起）② uiScreenHoverClear（换屏 / 清悬停）。
//   UIScrHoverSlider = 指针当前悬停的 `slider` 元素 id（"" = 无）—— 手柄 hover 图用。
//   两者随 ctx 透传给渲染器（`ctx.dragSlider` / `ctx.hoverSlider`，见 uiScreenCtx）。
//   ⚠️ 拖动语义**有意不同于** M35 规则③（指针移出按下目标即取消）：见 uiScreenHoverUpdate。
var UIScrDragSlider  = "";
var UIScrHoverSlider = "";
var UIScrDragMsg     = "";       // 最近一次拖动变化的可读描述（诊断 / 日志）

// ★ M46（2026-09-23，用户指令「让选择支能有三态效果」）：**指针位置**。
//   用途：`list` 的悬停/按下目标只记**元素 id**，而「列表逐项三态图」要按**项序号**选图 ⇒
//   必须在 ctx 里用 (指针坐标 + 该元素 + 它的当前页) 换算出项序号（见 `uiScreenListItemIndexAt`）。
//   维护点：`uiScreenHoverUpdate` / `uiScreenPressUpdate`（两者入参即指针坐标）。
var UIScrPointerX    = -1;
var UIScrPointerY    = -1;

// ------------------------------------------------------------
// 屏级状态 flag（★ M1 · ISSUE-20260922-28）
//   目的：让元素按「当前屏的运行时 flag 值」显示/隐藏（系统菜单快捷条的收起/展开、
//   说明气泡、钉住指示等）。**本模块只做机制**：贴边呼出 / 延时收起 / 钉住 / 动作派发
//   由 M2/M3 实现（它们读 layout 的屏级 `reveal` 与元素级数据）。
//
//   ★★ 判定语义（**唯一定义**，与 `复刻/replica.js` 的 `elementVisible()` 必须逐字一致）：
//     元素可见/可点击 ⟺ el.visible_default !== false
//                       且（el.vis_flag 不存在 → 通过；存在 → 当前 flag 值满足：
//                            vis_when == "*" 时要求**非空字符串**，否则要求**严格相等**）
//
//   ★ 本文件不写死任何坐标/阈值：进出边界等数值一律来自 layout 数据（`reveal`），
//     否则 工具/verify_ui.py 的检查 [4]（game/*.tjs 硬编码布局值扫描）会判失败。
//   ★ 换屏（reset/push/pop）后按**新栈顶屏**的 `flags_default` 重置（见 uiScreenFlagsInitFor）。
//     本表是「当前绘制屏」的 flags：浮层屏切换后即是浮层屏的 flags。
//   ★ **附加层（屏级 `attach`）的 flag 表处理**（2026-09-22 订正，与 `layout/_schema.md`
//     §四 `attach` 条一致，两端同一口径）：附加层**不切换、也不还原** flag 表，而是
//     **并进同一张表** —— 承载屏入栈时即按**附加层自己的 `flags_default`** 为「承载屏
//     未定义」的键铺初值（承载屏自己的 defaults 优先），此后附加层的运行期值
//     （展开 / 气泡 / 钉住）持续被读写；每帧叠画只做「为尚未存在的键补默认」的幂等兜底，
//     **不重置已有运行值**（否则展开态会在下一次叠画时被清空）。
//     实现：uiScreenFlagsInitFor（承载屏入栈时铺一次）+ uiScreenFlagsEnsureFor（叠画兜底）。
// ------------------------------------------------------------
var UIScrFlags = %[];

// ★ M2（ISSUE-20260922-28）：**强制 flag 表**（默认空）。
//   项目根存在 `quick_flags.tjs` 时，由 startup.tjs 的 uiInitQuickFlags() 用 Scripts.execStorage
//   执行该文件填充（内容形如 `UIScrFlagForce["quickbar"] = "expanded";`），供**巡演 / 无头验收**
//   强制竖排快捷条处于展开态（自动巡演不产生鼠标移动，贴边呼出无法被巡演覆盖）。
//   语义：**只覆盖「该屏 flag 名集合」中的名字**（Dictionary 无枚举接口，见上），在
//   uiScreenFlagsInitFor 填完 flags_default 之后套用 ⇒ 换屏后不会被默认值冲掉（契约⑦）。
//   另：竖条的**自动收起**在强制期间被抑制（见 uiScreenRevealTick），否则强制展开会被倒计时打掉。
var UIScrFlagForce = %[];

// 竖排快捷条的两个**契约常量**（★ 修复 2：flag 名一律**读数据**，不再写死）：
//   · 钉住 flag 名 = 屏级 `reveal.pin_flag`（`layout/_schema.md` §四 ⑥；值 "1" = 钉住）
//     —— 取值见 uiScreenRevealPinFlagName()；"1" 是契约里写死的**值**，不是 flag 名。
//   · 整条开关（把手）动作名 = 动作表里的 `open_sysmenu`（schema §六 的动作名契约，**不是**
//     `reveal` 字段）：仅用于「附加层内 `action` 留空的热区」兜底。
//     ★ M37（ISSUE-20260923-01）：整条把手 `quick.hit_toggle` 已随「整条带」退场 ⇒
//     本兜底路径**当前无数据可达**；`open_sysmenu` 动作本身**保留**（= 「展开竖条（不钉住）」的
//     编程入口，同 uiQuickbarOpen()）。展开的唯一鼠标入口是「指针移到 x ≥ reveal.in_x」。
var UIScrQuickPinOn     = "1";
var UIScrQuickToggleAct = "open_sysmenu";

// 置值；返回 true = **值发生了变化**（调用方据此决定是否重画）。值一律按字符串存
//   （契约里 flag 初值就是字符串；空串 = 「无值」，与 flags_default 的空串同义）。
function uiScreenFlagSet(name, value)
{
	if(name === void || name === null) return false;
	var k = "" + name;
	if(k == "") return false;
	var nv = (value === void || value === null) ? "" : ("" + value);
	var old = UIScrFlags[k];
	old = (old === void || old === null) ? "" : ("" + old);
	if(old == nv) return false;
	UIScrFlags[k] = nv;
	return true;
}

// 取当前值；未设置（或值为空）返回 ""（与 flags_default 的空串同义）
function uiScreenFlagGet(name)
{
	if(name === void || name === null) return "";
	var v = UIScrFlags["" + name];
	if(v === void || v === null) return "";
	return "" + v;
}

// 某屏**自身**的 flag 名集合 = 元素级 vis_flag ∪ reveal.flag ∪ reveal.tip_flag ∪ reveal.pin_flag
//   ★ 为什么是「被数据引用到的 flag 名」而不是直接枚举 flags_default：TJS2 的 Dictionary
//     **没有枚举接口**（不能 for...in，也没有 count/keys，见 引擎工作原理.md §5.1/§5.4）
//     ⇒ 无法遍历它的键。未被任何元素或 reveal 引用的 flag 不参与任何可见性判定，
//     其初值无观感影响；两端（本函数与 replica.js 的 initFlagsFor）采用**同一算法**，
//     故不存在行为差异（M2 起，初始化的「填默认值 / 套强制值」也都按同一名字集合走）。
//   ★ 2026-09-22 修复 C：`reveal` 的**全部 6 键**都要参与（含 `pin_flag`）—— 见
//     `layout/_schema.md` §四「flag 名的枚举口径」。
function uiScreenFlagNamesForOwn(screenId)
{
	var names = [];
	if(screenId === void || screenId === null) return names;
	var sc = UILayoutData.screens["" + screenId];
	if(sc === void || sc === null) return names;
	var els = sc.elements;
	if(els !== void && els !== null)
	{
		for(var i = 0; i < els.count; i++)
		{
			var el = els[i];
			if(el !== void && el !== null) names.push(el.vis_flag);
		}
	}
	var rv = sc.reveal;
	if(rv !== void && rv !== null)
	{
		names.push(rv.flag);
		names.push(rv.tip_flag);
		names.push(rv.pin_flag);
	}
	return names;
}

// 某屏某 flag 的 flags_default 初值（该键缺失 → ""，与「无值」同义）
function uiScreenFlagDefaultFor(screenId, name)
{
	var sc = UILayoutData.screens["" + screenId];
	if(sc === void || sc === null) return "";
	var def = sc.flags_default;
	if(def === void || def === null) return "";
	var dv = def["" + name];
	return (dv === void || dv === null) ? "" : ("" + dv);
}

// ★ M2 契约⑦：强制覆盖（表见 UIScrFlagForce 注释）。按传入的名字集合逐名套用 ——
//   Dictionary 不能枚举，故不遍历强制表本身，只问「这个名字被强制了吗」。
function uiScreenFlagsApplyForce(names)
{
	for(var i = 0; i < names.count; i++)
	{
		var fn = names[i];
		if(fn === void || fn === null || ("" + fn) == "") continue;
		var fv = UIScrFlagForce["" + fn];
		if(fv === void || fv === null) continue;
		UIScrFlags["" + fn] = "" + fv;
	}
}

// 强制表是否含某 flag（供竖条自动收起的抑制判断）
function uiScreenFlagForced(name)
{
	if(name === void || name === null) return false;
	var v = UIScrFlagForce["" + name];
	return (v !== void && v !== null);
}

// 按某屏的 layout 数据重置 flag 表（换屏时调用；无 flags_default 即清空表）
//   逐名取 flags_default 的值（无该键则 ""），**最后套用 UIScrFlagForce** ⇒ 换屏不会把
//   强制值冲掉（契约⑦）。
//   ★ M2：若本屏有**附加层**（屏级 attach，如 dialog 挂 quickbar），附加层的 flag 用
//     **附加层自己的 flags_default** 铺（竖条的默认态以它自己的数据为准），名字并入
//     强制覆盖的集合 —— 这样承载屏一入栈，竖条就处于数据声明的默认态（本数据 =
//     collapsed），且 UIScrFlagForce 立刻生效，无需等到第一次叠画/命中。
function uiScreenFlagsInitFor(screenId)
{
	UIScrFlags = %[];
	if(screenId === void || screenId === null) return;
	var names = uiScreenFlagNamesForOwn(screenId);
	for(var j = 0; j < names.count; j++)
	{
		var fn = names[j];
		if(fn === void || fn === null || ("" + fn) == "") continue;
		UIScrFlags["" + fn] = uiScreenFlagDefaultFor(screenId, fn);
	}
	var a = uiScreenAttachId(screenId);
	if(a != "")
	{
		var an = uiScreenFlagNamesForOwn(a);
		for(var k = 0; k < an.count; k++)
		{
			var afn = an[k];
			if(afn === void || afn === null || ("" + afn) == "") continue;
			UIScrFlags["" + afn] = uiScreenFlagDefaultFor(a, afn);
			names.push(afn);
		}
	}
	uiScreenFlagsApplyForce(names);
}

// 附加层（屏级 `attach`）用：只为**尚未设置**的 flag 名补默认值（**不重置已有值** ⇒
//   竖条的运行期状态——展开 / 气泡 / 钉住——不会被每帧的叠画重置），再套用强制值。
//   正常路径上 uiScreenFlagsInitFor 已经铺好（含强制值），这里是**兜底**（例如换屏与
//   首次叠画之间、或 flag 表被别处清空时）。
function uiScreenFlagsEnsureFor(screenId)
{
	var names = uiScreenFlagNamesForOwn(screenId);
	for(var i = 0; i < names.count; i++)
	{
		var fn = names[i];
		if(fn === void || fn === null || ("" + fn) == "") continue;
		if(UIScrFlags["" + fn] === void)
			UIScrFlags["" + fn] = uiScreenFlagDefaultFor(screenId, fn);
	}
	uiScreenFlagsApplyForce(names);
}

// 元素可见性谓词（判定语义见本区块顶部注释）——**所有可见性消费者统一走这里**：
//   ui_widget.tjs 的 uiWidgetElementVisible（绘制）、uiScreenHoverAt（悬停命中）、
//   uiScreenClick（点击命中）、uiScreenKey（键盘选中列表）四处。
function uiScreenElementVisible(el)
{
	if(el === void || el === null) return false;
	if(el.visible_default === false) return false;
	var fn = el.vis_flag;
	if(fn === void || fn === null || ("" + fn) == "") return true;
	var want = el.vis_when;
	want = (want === void || want === null) ? "" : ("" + want);
	var cur = uiScreenFlagGet(fn);
	if(want == "*") return (cur != "");
	return (cur == want);
}

// ------------------------------------------------------------
// 基本查询
// ------------------------------------------------------------
function uiScreenExists(id)
{
	if(id === void) return false;
	var sc = UILayoutData.screens["" + id];
	return (sc !== void);
}

function uiScreenCurrent()
{
	if(UIScrStack.count == 0) return "";
	return UIScrStack[UIScrStack.count - 1];
}

function uiScreenMarkSeen(id)
{
	var k = "" + id;
	if(UIScrSeenIndex[k] === true) return;
	UIScrSeenIndex[k] = true;
	UIScrSeenThisRun.push(k);
	uiStateMarkSeen(k);
}

function uiScreenNote(msg)
{
	UIScrLastEvent = "" + msg;
	UIScrEventLog.push(UIScrLastEvent);
}

// ------------------------------------------------------------
// 栈操作
// ------------------------------------------------------------
function uiScreenReset(id)
{
	UIScrStack = ["" + id];
	uiScreenMarkSeen(id);
	uiScreenNote("reset -> " + id);
	uiScreenHoverClear();          // ★ M20：换屏即清悬停，避免旧屏 id 残留
	uiScreenFlagsInitFor(uiScreenCurrent());   // ★ M1：屏级 flag 按新屏的 flags_default 重置
	uiScreenSliderInitFor(uiScreenCurrent());  // ★ M47：该屏滑块按元素初值初始化（**已有运行值的不动**）
	uiScreenConfigFlagsInitFor(uiScreenCurrent());  // ★ M47 追补：值键按「当前页」派生（挡跨页泄漏）
	uiScreenGalleryShellSyncFor(uiScreenCurrent()); // ★ M1：外壳页签高亮按承载屏 id 派生
	uiScreenGalleryEntryResetFor(uiScreenCurrent()); // ★ M8 一审⑥：挂壳屏重进 ⇒ 页码/差分/页码flag 归零
}

// ★ M1（2026-09-24 · ISSUE-20260924-08）：**同级换屏**（tab = 切屏口径）。
//   把**栈顶**替换成另一屏（栈深不变）—— 与 `uiScreenReset` 的区别：
//     · reset：栈 = [id]（丢掉整条历史，返回键会到栈底）；
//     · replace：栈顶换人 ⇒ 上一页**完全不在栈里**（满足验收「切屏后上一屏不在栈里」），
//       而**入口屏（标题/对话框）仍在栈中** ⇒ 外壳的「返回」= close 能正常回到入口。
function uiScreenReplace(id)
{
	var nid = "" + id;
	if(UIScrStack.count == 0) { uiScreenReset(nid); return; }
	UIScrStack[UIScrStack.count - 1] = nid;
	uiScreenMarkSeen(nid);
	uiScreenNote("replace -> " + nid + "  (depth=" + UIScrStack.count + ")");
	uiScreenHoverClear();
	uiScreenFlagsInitFor(uiScreenCurrent());
	uiScreenSliderInitFor(uiScreenCurrent());
	uiScreenConfigFlagsInitFor(uiScreenCurrent());
	uiScreenGalleryShellSyncFor(uiScreenCurrent());
}

function uiScreenPush(id)
{
	UIScrStack.push("" + id);
	uiScreenMarkSeen(id);
	uiScreenNote("push -> " + id + "  (depth=" + UIScrStack.count + ")");
	uiScreenHoverClear();
	uiScreenFlagsInitFor(uiScreenCurrent());   // ★ M1
	uiScreenSliderInitFor(uiScreenCurrent());  // ★ M47
	uiScreenConfigFlagsInitFor(uiScreenCurrent());  // ★ M47 追补
	uiScreenGalleryShellSyncFor(uiScreenCurrent()); // ★ M1
	uiScreenGalleryEntryResetFor(uiScreenCurrent()); // ★ M8 一审⑥：push 路径的重进归零（主代理追认项）
}

function uiScreenPop()
{
	if(UIScrStack.count <= 1) { uiScreenNote("pop 被拒：已是栈底 " + uiScreenCurrent()); return false; }
	UIScrStack.pop();
	uiScreenNote("pop -> " + uiScreenCurrent() + "  (depth=" + UIScrStack.count + ")");
	uiScreenHoverClear();
	uiScreenFlagsInitFor(uiScreenCurrent());   // ★ M1
	uiScreenSliderInitFor(uiScreenCurrent());  // ★ M47
	uiScreenConfigFlagsInitFor(uiScreenCurrent());  // ★ M47 追补
	uiScreenGalleryShellSyncFor(uiScreenCurrent()); // ★ M1
	uiScreenGalleryEntryResetFor(uiScreenCurrent()); // ★ M8 一审⑥：pop 返回再进同属「重进」（与 push 同口径）
	return true;
}

function uiScreenStackText()
{
	return UIScrStack.join(" > ");
}

// ------------------------------------------------------------
// 附加层（★ M2 · 契约①：屏级 `attach`）
//   `attach` 是**附加层**：当前屏画完后，再**按普通屏的方式**叠画该屏的元素（复用
//   uiWidgetDrawScreen）。**不改屏栈语义**：uiScreenCurrent() 仍是承载屏，剧情推进 /
//   动作派发不受影响；也不参与 overlay 的一层回溯、不进历史。
//   命中优先级：**附加层先于承载屏**（先扫附加层，命中即返回）。
//   flags：附加层与承载屏共用 UIScrFlags，叠画/命中前用 uiScreenFlagsEnsureFor() 为附加层
//   的 flag 名补默认值（**不重置运行期值**）——见该函数注释。
// ------------------------------------------------------------
var UIScrAttachLogged = %[];    // 附加层日志去重（键 = "ok|miss|err>附加层 id"）

function uiScreenAttachId(screenId)
{
	if(screenId === void || screenId === null) return "";
	var sc = UILayoutData.screens["" + screenId];
	if(sc === void || sc === null) return "";
	var a = sc.attach;
	if(a === void || a === null) return "";
	return "" + a;
}

function uiScreenAttachIdCurrent()
{
	var id = uiScreenCurrent();
	if(id == "") return "";
	return uiScreenAttachId(id);
}

// 竖条元素所在的屏对象（当前屏有附加层且该附加层带 reveal → 附加层；否则当前屏自己）
function uiScreenRevealTargetScreen()
{
	var aid = uiScreenAttachIdCurrent();
	if(aid != "")
	{
		var asc = UILayoutData.screens[aid];
		if(asc !== void && asc !== null && asc.reveal !== void) return asc;
	}
	var id = uiScreenCurrent();
	if(id == "" || !uiScreenExists(id)) return null;
	return UILayoutData.screens[id];
}

// 当前屏（优先其附加层）的 `reveal` 屏对象；无 → null
function uiScreenRevealScreen()
{
	var sc = uiScreenRevealTargetScreen();
	if(sc === null) return null;
	if(sc.reveal === void) return null;
	return sc;
}

// 当前屏（优先其附加层）的 `reveal` **参数对象**；无 → null
//   ★ 注意：阈值/flag 名一律取自 `屏对象.reveal.*`（不是屏对象本身——`in_x` 等键在
//     屏级 `reveal` 字典里，见 layout/_schema.md §四）。
function uiScreenRevealData()
{
	var sc = uiScreenRevealScreen();
	if(sc === null) return null;
	var rv = sc.reveal;
	if(rv === void || rv === null) return null;
	return rv;
}

// 当前竖条的**钉住 flag 名**（`reveal.pin_flag`；★ 修复 2：不再写死 `qbar_pin`）。
//   无竖条 / 未声明 `pin_flag` → ""（= 不做钉住判定，quick_pin 也被忽略）。
function uiScreenRevealPinFlagName()
{
	var rv = uiScreenRevealData();
	if(rv === null) return "";
	var pf = rv.pin_flag;
	if(pf === void || pf === null) return "";
	return "" + pf;
}

// 叠画**承载屏的附加层**；返回叠画的元素数（无附加层 / 无数据 → 0）
//   screenId 省略 = 当前屏（契约①：承载屏画完再叠）；
//   ★ B2：给定 screenId 时用于「浮层回溯下层」路径 —— 下层承载屏也要叠它的附加层，
//     否则浮层弹出时下层的竖条把手消失（与 HTML 端 replica.js 的浮层下层重画路径分叉）。
function uiScreenDrawAttach(stage, screenId)
{
	var holder = (screenId === void || screenId === null) ? uiScreenCurrent() : ("" + screenId);
	var aid = uiScreenAttachId(holder);
	if(aid == "") return 0;
	var lkey = holder + ">" + aid;
	var asc = UILayoutData.screens[aid];
	if(asc === void || asc === null || asc.elements === void)
	{
		if(UIScrAttachLogged["miss>" + lkey] !== true)
		{
			UIScrAttachLogged["miss>" + lkey] = true;
			Debug.message("[UI][ATTACH][MISS] 附加层 " + aid + " 无布局数据，本帧跳过");
		}
		return 0;
	}
	uiScreenFlagsEnsureFor(aid);
	var drawn = 0;
	try
	{
		uiWidgetDrawScreenBg(stage, asc);
		drawn = uiWidgetDrawScreen(stage, asc, uiScreenCtx(asc));
	}
	catch(e)
	{
		// 单帧异常不得扩散：附加层画不出来也不影响承载屏（同 overlay 的处理口径）
		if(UIScrAttachLogged["err>" + lkey] !== true)
		{
			UIScrAttachLogged["err>" + lkey] = true;
			Debug.message("[UI][ATTACH][ERR] 附加层 " + aid + " 绘制失败（不影响承载屏）：" + e.message);
		}
		drawn = 0;
	}
	if(UIScrAttachLogged["ok>" + lkey] !== true)
	{
		UIScrAttachLogged["ok>" + lkey] = true;
		Debug.message("[UI][ATTACH] 叠画附加层 " + aid + "（承载屏 " + holder + "，本对只记一次）");
	}
	return drawn;
}

// 附加层的命中（**优先级高于承载屏**）：返回 %[ action:, index:, hit:true ]；未命中返回 null
//   （调用方据此回落承载屏的命中链）。命中规则与 uiScreenClick 的通用分支一致：取最高 z
//   （同 z 时**声明在后者胜**——循环里用 `z < bestZ` 判定，等于覆盖前一个同 z 者）。
//   ★ 附加层里 action 留空的 hit = 整条开关（数据 note 的约定：展开/收起由 reveal 驱动，
//     不占用动作名）⇒ 按 UIScrQuickToggleAct 处理。（M1–M36 的整条把手 `quick.hit_toggle`
//     曾显式写 action="open_sysmenu"；★ **M37 起该元素已随「整条带」退场**，
//     本屏 12 个项热区各自带明确 action ⇒ 这条兜底路径当前**无数据可达**，
//     但作为契约保留：后人若再加「无 action 的整条热区」，行为与 M36 一致。）
//   ★ 诊断（B4 可达性断言用，同 UIScrHoverMsg/UIScrPressMsg 的做法）：命中的元素 id 记入
//     UIScrAttachHitId（未命中 = ""），使调用方能在不复制命中逻辑的前提下断言「胜者是谁」。
var UIScrAttachHitId = "";
function uiScreenAttachClick(x, y)
{
	UIScrAttachHitId = "";
	var aid = uiScreenAttachIdCurrent();
	if(aid == "") return null;
	var asc = UILayoutData.screens[aid];
	if(asc === void || asc === null || asc.elements === void) return null;
	uiScreenFlagsEnsureFor(aid);
	var els = asc.elements;
	var bestZ = -1, best = null;
	for(var i = 0; i < els.count; i++)
	{
		var el = els[i];
		if(el === void || el === null) continue;
		if(el.kind != "list" && el.kind != "hit") continue;
		if(!uiScreenElementVisible(el)) continue;
		var r = uiWidgetRect(el);
		if(x < r.x || x >= r.x + r.w || y < r.y || y >= r.y + r.h) continue;
		var z = uiWidgetNum(el, "z", 0);
		if(z < bestZ) continue;
		bestZ = z; best = el;
	}
	if(best === null) return null;
	UIScrAttachHitId = "" + best.id;
	if(best.kind == "list")
	{
		var pg = uiWidgetListPage(best, UIScrPage[best.id]);
		var hit = uiWidgetListHit(best, x, y, pg.page);
		if(hit < 0) return null;
		UIScrFocus[best.id] = hit;
		UIScrActiveList = "" + best.id;
		return %[ action: best.actions[hit], index: hit, hit: true ];
	}
	var act = "";
	if(best.action !== void && best.action !== null) act = "" + best.action;
	if(act == "") act = UIScrQuickToggleAct;
	return %[ action: act, index: -1, hit: true ];
}

// ------------------------------------------------------------
// 竖排快捷条：贴边呼出 / 延时收起 / 气泡（★ M2 · 契约③）
//   状态：reveal.flag 取值 "expanded"（展开）/ 其它（收起，默认 "collapsed"）；
//   reveal.tip_flag 写「当前悬停项 key」（空串 = 不显示气泡）；
//   收起用**滞回 + 延时**：x < out_x 时启动 delay_ms 计时，期间指针回到 ≥ out_x 即撤销。
//   **阈值一律来自该屏 `reveal` 数据**（in_x / out_x / delay_ms），脚本内不写死坐标/毫秒，
//   否则 工具/verify_ui.py 的检查 [4] 会判失败。
//   计时**搭车窗口的 blinkTimer**（startup.tjs 的 onBlinkTimer 每 120ms 调 uiScreenRevealTick），
//   不新建 Timer。
// ------------------------------------------------------------
var UIScrRevealOutTick = -1;    // 收起倒计时起点 tick（-1 = 未计时）
var UIScrRevealMsg     = "";    // 最近一次变化描述（诊断 / 日志）

function uiScreenTickNow()
{
	try { return System.getTickCount(); } catch(e) { return 0; }
}

// 从元素 id 取「项 key」：id 形如 `<前缀>hit_<key>` ⇒ 返回最后一个 "hit_" 之后的部分
//   （TJS2 无 String.lastIndexOf，见 引擎工作原理.md §5.1）。
//   ★★ 实机 + 源码实测（2026-09-22）：TJS2 的 `substring(start, count)` **第二参数是长度、
//   不是结束下标**（`tjs2/tjsInterCodeExec.cpp:2698-2714`：`count = *args[1]; if(start+count >
//   s_len) count = s_len - start;`）。写 `substring(k, k+4)` 得到的是「从 k 起 k+4 个字符」，
//   永远比不中 —— 竖条气泡曾因此恒为空。这里必须写 `substring(k, 4)`。
function uiScreenRevealKeyOfId(id)
{
	var s = "" + id;
	var at = -1;
	for(var k = 0; k + 4 <= s.length; k++)
	{
		if(s.substring(k, 4) == "hit_") at = k + 4;
	}
	return (at < 0) ? "" : s.substring(at);
}

// 该 key 是否属于**气泡 key 集**（★ 修复 1：与 HTML 端**同一条判据**，不再用「id 含 `.tx_`」）
//   口径（主代理 2026-09-22 裁决 D1，两端以此为准）：key 集 = 该屏内
//   「`vis_flag == reveal.tip_flag` 且 `vis_when != "*"`」的元素的 `vis_when` 取值。
//   · 本数据即 `quick.tx_*` 的 lock/save/…/option 共 12 个；★ M37 起另有同 flag 的
//     名称药丸 `quick.pl_*`（12 件）也取同一批 key —— 药丸与白字**同 key 同步显隐**，
//     集合按值去重后仍是这 12 个。
//     ★ 通配 `vis_when="*"`（非空即显示，如 M37 之前的 `quick.tips` 底图）**不是**项 key，
//     必须排除 —— 该条规则与数据无关，始终有效。
//   · 端点落点：krkr 本函数（`ui_screens.tjs:534` 起）｜ HTML `复刻/replica.js:1333-1338`
//     （`tipKeyAt()` 里那段 `keys[...]` 收集；函数本体 :1331 起），两处判据逐字相同。
function uiScreenRevealKeyKnown(screenObj, key)
{
	if(key == "") return false;
	if(screenObj === void || screenObj === null || screenObj.elements === void) return false;
	var rv = screenObj.reveal;
	if(rv === void || rv === null) return false;
	var tipFlag = (rv.tip_flag === void || rv.tip_flag === null) ? "" : ("" + rv.tip_flag);
	if(tipFlag == "") return false;
	var els = screenObj.elements;
	for(var i = 0; i < els.count; i++)
	{
		var el = els[i];
		if(el === void || el === null) continue;
		var vf = el.vis_flag;
		if(vf === void || vf === null) continue;
		if(("" + vf) != tipFlag) continue;          // 只认「说明气泡 flag」
		var vw = el.vis_when;
		if(vw === void || vw === null) continue;
		var w = "" + vw;
		if(w == "" || w == "*") continue;           // "*" = 非空即显示，不是项 key
		if(w == key) return true;
	}
	return false;
}

// 气泡「当前悬停项 key」判定（★ B1；判据与 HTML 端 `复刻/replica.js:1331-1350` 的
//   `tipKeyAt()` **逐条相同**，两端各自落点如下）：
//   ① **key 集** = 该屏内 `vis_flag == reveal.tip_flag 且 vis_when != "*"` 的元素取值
//      ⇒ krkr `uiScreenRevealKeyKnown()`（`ui_screens.tjs:534`）｜ HTML `replica.js:1333-1338`；
//   ② 候选 = 同屏 `kind=hit`、**`vis_flag` 非空**、id 尾段形如 `hit_<key>` 且 `<key>` 在 ① 中、
//      且当前**可见** —— 含点用**半开区间** `[x, x+w) × [y, y+h)`
//      ⇒ krkr 本函数（`:570`）｜ HTML `replica.js:1340-1347`（候选过滤 + 半开区间）；
//   ③ 取 **z 最高**，**同 z 时声明在后者胜**
//      ⇒ krkr `if(z < bestZ) continue;` ｜ HTML `replica.js:1349`（`if (z >= bestZ) {…}`）。
//   ★ 关键：②里「key 在 ① 中」是**候选过滤**（不是事后检查）—— 高 z 但 key 不在集合里的
//     hit 不参与竞争，这样两端在同一份数据上必然同解（旧实现先取 z 最高再判 key，会分叉）。
function uiScreenRevealTipAt(screenObj, x, y)
{
	if(screenObj === void || screenObj === null || screenObj.elements === void) return "";
	var els = screenObj.elements;
	var bestZ = -1, bestKey = "";
	for(var i = 0; i < els.count; i++)
	{
		var el = els[i];
		if(el === void || el === null || el.kind != "hit") continue;
		if(el.vis_flag === void || el.vis_flag === null || ("" + el.vis_flag) == "") continue;
		var key = uiScreenRevealKeyOfId(el.id);
		if(key == "") continue;
		if(!uiScreenRevealKeyKnown(screenObj, key)) continue;   // ①：key 集过滤（同 HTML）
		if(!uiScreenElementVisible(el)) continue;
		var r = uiWidgetRect(el);
		if(x < r.x || x >= r.x + r.w || y < r.y || y >= r.y + r.h) continue;
		var z = uiWidgetNum(el, "z", 0);
		if(z < bestZ) continue;
		bestZ = z; bestKey = key;
	}
	return bestKey;
}

// 指针移动时更新竖条状态；返回 true = 有变化（调用方据此重画）
function uiScreenRevealUpdate(x, y)
{
	var rv = uiScreenRevealData();
	if(rv === null) return false;
	var flagName = "" + rv.flag;
	if(flagName == "") return false;
	var tipName = (rv.tip_flag === void || rv.tip_flag === null) ? "" : ("" + rv.tip_flag);
	var inX  = uiWidgetNum(rv, "in_x", 0);
	var outX = uiWidgetNum(rv, "out_x", 0);
	var changed = false;

	if(uiScreenFlagGet(flagName) != "expanded")
	{
		// 收起态：指针贴到右端 → 展开（并撤销任何残留的收起计时）
		if(x >= inX)
		{
			UIScrRevealOutTick = -1;
			if(uiScreenFlagSet(flagName, "expanded"))
			{
				UIScrRevealMsg = "展开竖条（x >= in_x）@" + x + "," + y;
				changed = true;
			}
		}
		return changed;
	}

	// 展开态：气泡随指针
	if(tipName != "")
	{
		var tip = uiScreenRevealTipAt(uiScreenRevealTargetScreen(), x, y);
		if(uiScreenFlagSet(tipName, tip))
		{
			UIScrRevealMsg = "气泡 tip -> " + ((tip == "") ? "(无)" : tip) + "  @" + x + "," + y;
			changed = true;
		}
	}

	// 收起：钉住时**不自动收起**；否则 x < out_x 启动计时，回到 ≥ out_x 撤销
	//   （钉住 flag 名读 `reveal.pin_flag`，见 uiScreenRevealPinFlagName）
	var pinName = uiScreenRevealPinFlagName();
	if(pinName != "" && uiScreenFlagGet(pinName) == UIScrQuickPinOn)
	{
		if(UIScrRevealOutTick >= 0)
		{
			UIScrRevealOutTick = -1;
			UIScrRevealMsg = "钉住中：撤销收起计时（不自动收起）";
			changed = true;
		}
		return changed;
	}
	if(x < outX)
	{
		if(UIScrRevealOutTick < 0)
		{
			UIScrRevealOutTick = uiScreenTickNow();
			UIScrRevealMsg = "收起计时启动（x < out_x）@" + x + "," + y;
			changed = true;
		}
	}
	else if(UIScrRevealOutTick >= 0)
	{
		UIScrRevealOutTick = -1;
		UIScrRevealMsg = "撤销收起计时（x >= out_x）@" + x + "," + y;
		changed = true;
	}
	return changed;
}

// blinkTimer 节拍上的倒计时判定；返回 true = 有变化（调用方重画）
function uiScreenRevealTick()
{
	var rv = uiScreenRevealData();
	if(rv === null) { UIScrRevealOutTick = -1; return false; }
	var flagName = "" + rv.flag;
	if(flagName == "") return false;
	if(uiScreenFlagForced(flagName)) return false;                        // 强制展开期间不自动收起（契约⑦）
	var pinName = uiScreenRevealPinFlagName();
	if(pinName != "" && uiScreenFlagGet(pinName) == UIScrQuickPinOn) { UIScrRevealOutTick = -1; return false; }
	if(UIScrRevealOutTick < 0) return false;
	if(uiScreenFlagGet(flagName) != "expanded") { UIScrRevealOutTick = -1; return false; }
	var delay = uiWidgetNum(rv, "delay_ms", 0);
	if(delay < 0) delay = 0;
	if(uiScreenTickNow() - UIScrRevealOutTick < delay) return false;
	UIScrRevealOutTick = -1;
	var tipName = (rv.tip_flag === void || rv.tip_flag === null) ? "" : ("" + rv.tip_flag);
	var changed = uiScreenFlagSet(flagName, "collapsed");
	if(tipName != "")
	{
		if(uiScreenFlagSet(tipName, "")) changed = true;
	}
	if(changed) UIScrRevealMsg = "延时到点（delay_ms）-> 收起并清空气泡";
	return changed;
}

// ★ M2 契约④：`open_sysmenu` 的新语义 = **展开竖条（不钉住）**。
//   ★ M45（2026-09-23，用户裁定）：传统系统菜单屏 `sysmenu`（`20_sysmenu.json`）**已废除** ——
//   屏数据 / `_index.json` 条目 / 两端活引用 / 巡演白名单 / 文档屏清单全部清理，
//   快照归档在 `_工作\M45_旧素材归档\`。系统功能由本竖排快捷条（用户口中的「药丸按钮系统」）承担。
//   `open_sysmenu` 动作**保留不动**（uiScreenMapOpen 早已移除 open_sysmenu -> sysmenu 这条映射）。
//   返回可读描述（供动作 msg / 日志）。
function uiQuickbarOpen()
{
	var rv = uiScreenRevealData();
	if(rv === null) return "当前屏无竖排快捷条（layout 无 reveal 数据），open_sysmenu 忽略";
	var flagName = "" + rv.flag;
	if(flagName == "") return "reveal.flag 为空，open_sysmenu 忽略";
	UIScrRevealOutTick = -1;                       // 撤销收起计时
	var ch = uiScreenFlagSet(flagName, "expanded");
	UIScrRevealMsg = "open_sysmenu -> 展开竖条（" + flagName + "=expanded，未钉住）";
	return "展开竖排快捷条（" + flagName + "=expanded，未钉住）" + (ch ? "" : "（原本已是展开态）");
}

// ------------------------------------------------------------
// 悬停命中（★ M20）
//   目的：让带 state_assets 的 hit 在鼠标悬停时画 hover 图（标题屏菜单变金色）。
//   坐标口径：与 onClick / handleClick → uiScreenClick 完全一致 —— **直接用引擎传入的
//   x,y 当画布坐标**，不由调用方乘 1.5。★ **现行配置（第 16 批订正，2026-09-30）**：
//   窗口化 `setInnerSize(UI_WIN_W, UI_WIN_H)`（1280×720 客户区）＋ `setZoom(2,3)`
//   ⇒ **客户区尺寸 ≠ 画布尺寸**（画布 1920×1080）；旧注释称「客户区 = 画布」的前提已作废。
//   ⚠ **开口项（如实登记，勿当已验证）**：「引擎事件坐标是否已按 `setZoom` 换算」本工程
//   **从未实测**（巡演与闸门全走合成指针，不经 Window 事件）。判定方法＝窗口化模式下把鼠标
//   移到任一按钮上看 hover/按下态是否跟手；**若不跟手**，须把 `startup.tjs` 的 `onMouseMove`/
//   `onClick` 与本文件 `uiScreenClick` **一起**改为按 zoom 换算，两者不得分叉。
//   （资源组\04_1920画布与双分辨率方案.md §6.4 的「×1.5」即对应本配置。）
// ------------------------------------------------------------
function uiScreenHoverClear()
{
	UIScrHoverHit = "";
	UIScrHoverMsg = "";
	// ★ M35：换屏同时清按下态（旧屏的 id 必须不留；探针是验收用的，不清）
	UIScrPressHit = "";
	UIScrPressMsg = "";
	// ★ M46（一审 Minor-3）：指针坐标也一并归位 —— 否则「换屏后不清 hit」的将来改动
	//   会让陈旧坐标算出错误项序号。与该函数「换屏即清」的语义一致（-1 = 无有效指针）。
	UIScrPointerX = -1;
	UIScrPointerY = -1;
	UIScrHoverIndex = -1;
	UIScrPressIndex = -1;
	// ★ M47：换屏即结束滑块拖动与悬停（旧屏的 slider id 必须不留；理由同上面两条）
	UIScrDragSlider  = "";
	UIScrHoverSlider = "";
	// ★ M06：换屏即清逐项按钮的悬停/按下令牌（旧屏的 list id / 项序号必须不留，理由同上）
	UIScrHoverBtn = "";
	UIScrPressBtn = "";
}

// ------------------------------------------------------------
// 按下态（★ M35）
//   规则表（**与 复刻/replica.js 的 buildHit 必须逐条一致**，改一处就要改两处）：
//     ① 左键在元素上按下        -> 该元素进入按下态（同一时刻至多一个）
//     ② 左键抬起（不论位置）    -> 清除
//     ③ 指针移出该元素          -> 清除（按住期间移开 = 取消）
//     ④ 换屏                    -> 清除（见 uiScreenHoverClear）
//                                  注：krkr 只在换屏（reset/push/pop）时清；HTML 侧另需在
//                                  **同屏重渲染**时清（DOM 重建，否则台账悬挂）——那是实现差异，
//                                  不是语义差异（一审 Minor-3）。
//     ⑤ 绘制优先级              -> pressed > hover > normal，缺键逐级回落（见 ui_widget.tjs）
//   命中判据与悬停**完全相同**（复用 uiScreenHoverAt：只认带 state_assets 的可见 hit，取最高 z）。
// ------------------------------------------------------------
function uiScreenPressClear()
{
	// ★ M06：左键抬起 = 清除**逐项按钮**的按下态（不论抬起位置；锚定的令牌一并释放）。
	//   本条必须排在下面的「按下态清除」早退之前 —— 按钮按下期间 `UIScrPressHit` 可能为空
	//   （回想屏的 list 不在 uiScreenHoverAtIn 的候选并集里），否则这里会漏掉按钮按下态。
	var hadBtn = (UIScrPressBtn != "");
	if(hadBtn)
	{
		UIScrBtnMsg = "抬起 -> 清除逐项按钮按下态（原 " + UIScrPressBtn + "）";
		UIScrPressBtn = "";
	}
	// ★ M47：左键抬起 = **结束滑块拖动**（拖动语义的唯一出口之一；另一个是换屏，
	//   见 uiScreenHoverClear）。本条必须排在下面的「按下态清除」早退之前 ——
	//   拖动期间 UIScrPressHit 恒为空（见 uiScreenPressUpdate），否则这里会漏掉拖动。
	if(UIScrDragSlider != "")
	{
		UIScrDragMsg = "抬起 -> 结束滑块拖动（" + UIScrDragSlider + "）";
		UIScrDragSlider = "";
		UIScrHoverSlider = "";                  // 抬起后手柄回常态图（指针若仍在其上，下一次移动会重新置上）
		UIScrPressMsg = UIScrDragMsg;
		if(UIScrPressHit == "") return true;
	}
	if(UIScrPressHit == "") return hadBtn;
	UIScrPressMsg = "抬起 -> 清除（原 " + UIScrPressHit + "）";
	UIScrPressHit = "";
	UIScrPressIndex = -1;      // ★ M46：锁存的项序号一并复位（抬起 = 清除）
	return true;
}
// 置/改按下目标；返回 true = 目标发生变化（调用方须重画）
function uiScreenPressUpdate(x, y)
{
	UIScrPointerX = x; UIScrPointerY = y;        // ★ M46：记录指针位置（供列表逐项三态）
	if(UIScrPressProbe != "")
	{
		if(UIScrPressHit == UIScrPressProbe) return false;
		UIScrPressHit = UIScrPressProbe;
		// ★ M46：探针路径也锁存项序号（探针只给元素 id ⇒ 以当前指针位置为准，拿不到就 -1）
		UIScrPressIndex = uiScreenListItemIndexAtPoint(UIScrPressHit, x, y);
		UIScrPressMsg = "探针强制按下 -> " + UIScrPressProbe;
		return true;
	}
	// ★ M47：**滑块拖动优先** —— 命中带 `slider` 字段的 hit 即进入拖动，并按 x 立刻置值。
	//   为什么要单列一条命中（而不是复用 uiScreenHoverAt）：滑块的命中热区**不带
	//   state_assets / state_group**，按 uiScreenHoverAtIn 的候选并集它永远选不中
	//   （那条判据被 test_state_targets.py 的指纹盯着，不得放宽）⇒ 拖动需要自己的命中函数。
	//   另：拖动期间**不置** UIScrPressHit（拖动与「按钮按下图」是两条互斥路径），
	//   这样 M35 规则③（移出即取消）也不会把拖动打断 —— 见 uiScreenHoverUpdate 的注释。
	var shEl = uiScreenSliderHitEl(x, y);
	if(shEl !== null)
	{
		var slId = "" + shEl.slider;
		var started = (UIScrDragSlider != slId);
		UIScrDragSlider  = slId;
		UIScrHoverSlider = slId;
		if(UIScrPressHit != "")
		{
			UIScrPressMsg = "开始拖动滑块，清掉按钮按下态（原 " + UIScrPressHit + "）";
			UIScrPressHit = "";
			UIScrPressIndex = -1;
		}
		// ★ M06：同理清掉逐项按钮的按下令牌（拖动与按钮按下是两条互斥路径）
		if(UIScrPressBtn != "")
		{
			UIScrBtnMsg = "开始拖动滑块，清掉逐项按钮按下态（原 " + UIScrPressBtn + "）";
			UIScrPressBtn = "";
		}
		if(started) UIScrDragMsg = "开始拖动滑块 " + slId + "（命中热区 " + shEl.id + "）@" + x;
		uiScreenSliderDragTo(x);            // 按 x 立即置值（含 clamp + step 对齐 + 写仓）
		return true;
	}
	var id = uiScreenHoverAt(x, y);
	// ★ M06：**逐项按钮的按下**——按下时锁存按钮令牌（锚定在被按的那一个按钮上，
	//   与 HTML 的事件锚定同义）。必须算在下面「id 未变即返回 false」早退**之前**：
	//   同一个 list 内换按钮时 `id` 不变（都是 bl.list）而按钮变了 —— 与 M46 Minor-2
	//   「同一 list 内换项也必须算有变化」同源，否则按下态不会即时重画、还会粘住上一颗按钮。
	var btokP = uiScreenBtnTokenAt(x, y);
	var btnChanged = false;
	if(btokP != UIScrPressBtn)
	{
		UIScrPressBtn = btokP;
		if(btokP != "") UIScrBtnMsg = "按下逐项按钮 -> " + btokP + "  @ " + x + "," + y;
		btnChanged = true;
	}
	if(id == UIScrPressHit) return btnChanged;
	UIScrPressHit = id;
	// ★ M46（一审 Major-2 的收口）：按下时**锁存**项序号 —— 按下态必须**锚定在被按的那一项**上，
	//   不能每帧按指针重算（那会让「按下态跟着鼠标飘」，等于把 hover 当 pressed 用，且与 HTML
	//   （事件锚定）分叉）。规则表 ③「指针移出**该元素** → 清除」在逐项语境下就是「移出**该项**」。
	UIScrPressIndex = uiScreenListItemIndexAtPoint(id, x, y);
	UIScrPressMsg = "按下 -> " + ((id == "") ? "(无)" : id) + "  @ " + x + "," + y;
	return true;
}

// ★ M46：按「当前屏 + 指针坐标」算项序号（`uiScreenListItemIndexAt` 的薄包装，自动取屏对象）
function uiScreenListItemIndexAtPoint(id, x, y)
{
	if(("" + id) == "") return -1;
	var sid = uiScreenCurrent();
	if(!uiScreenExists(sid)) return -1;
	return uiScreenListItemIndexAt(UILayoutData.screens[sid], id, x, y);
}

// 当前屏 (x,y) 命中的、**参与状态检测的元素** id（取最高 z）；无则 ""
//   ★ M35b：判据 = 「**带 `state_assets` 的任何元素**」∪ 「**带非空 `state_group` 的 hit**」。
//     · 前半句：`image` 也能带三态图（文字按钮就靠这个），且**组绑定要求鼠标落在它上面也被检测到**。
//     · 后半句：热区迁移后退回**纯热区**（不持有美术，避免按 PSB 交互区矩形拉伸绘制），
//       但它仍必须是状态目标 —— 否则「悬停整条消息行」不会点亮旁边的喇叭图标。
//   ★★ 二审 Major-1 修：**判据收紧为「有组」的 hit，不能是「任何 hit」**。实测反例：
//     配置屏 `cfg.mute_hit`（z=95、组 config.mute）与 `cfg.it_facewindow_hit`（z=95、**无组**、
//     声明更晚、矩形覆盖静音勾选框）在勾选框处**同 z 平票**，而本函数的平票规则是「z >= bestZ 则后者胜」
//     ⇒ 放宽成「任何 hit」时，无组的那件会抢走命中 ⇒ `ctx.hoverGroup` 为空 ⇒
//     勾选框的 pressed 态（x_ui_check_on.png）画不出来。收紧后无组 hit 不再是候选，
//     `cfg.mute_hit` 胜出、组（config.mute）生效。
//     ★★ 2026-09-22 独立复审查实：旧注释里「数据侧另把它的 z 提到 96，让 HTML 的 DOM 顶层
//     归属也一致 —— 见 25_config.json 的 note」与「（改动前它是能画的）」**两句均不实**，
//     已删除。可核实的事实：① `cfg.mute_hit.z` 在**含该元素的 6 个 revision 里恒为 95**
//     （`git log` + `git show <rev>:…/25_config.json` 逐版本复算；触及该文件的 revision 共 9 个，
//     其中 `d2c6289`/`2aba6aa`/`d334f17` 三个早于该元素的引入，不含它）；
//     ② 本判据的真实作用就是「把**无组**的 hit 排除出候选」（无组的 `cfg.it_facewindow_hit`
//     与被它覆盖的组内元素同 z 平票且声明更晚 ⇒ 不排除就恒由它抢走命中 ⇒ `hoverGroup` 为空
//     ⇒ 组内元素的 hover/pressed 态都画不出来），与 z 值无关；两端同规则。
//   ★ 附带好处：纯热区（既无态图又无组）不再参与，鼠标划过它们不再触发无谓的整屏 redraw
//     （原先的「未变化不重画」在这一档上已不成立）。
function uiScreenHoverAtIn(screenObj, x, y)
{
	if(screenObj === void || screenObj === null || screenObj.elements === void) return "";
	var els = screenObj.elements;
	var bestZ = -1, bestId = "";
	for(var i = 0; i < els.count; i++)
	{
		var el = els[i];
		if(el === void || el === null) continue;
		if(el.state_assets === void)
		{
			if(el.kind == "list")
			{
				// ★ M46：**带逐项态图的 list** 也是「状态目标」——鼠标落在它上面要能点亮**项**
				//   （否则 `ctx.hoverHit` 永远指不到它，逐项三态无从触发）。
				if(el.item_frame === void || el.item_frame === null) continue;
				var fsa = el.item_frame.state_assets;
				if(fsa === void || fsa === null) continue;
			}
			else
			{
				if(el.kind != "hit") continue;
				if(uiWidgetStateGroup(el) == "") continue;   // 见上方判据：只认「有组」的热区
			}
		}
		if(!uiScreenElementVisible(el)) continue;        // ★ M1：统一走屏级 flag 谓词
		var r = uiWidgetRect(el);
		if(x < r.x || x >= r.x + r.w || y < r.y || y >= r.y + r.h) continue;
		var z = uiWidgetNum(el, "z", 0);
		if(z < bestZ) continue;
		bestZ = z; bestId = "" + el.id;
	}
	return bestId;
}

function uiScreenHoverAt(x, y)
{
	var id = uiScreenCurrent();
	if(id == "") return "";
	// ★ M2 契约①：附加层的命中优先级高于承载屏（附加层命中即返回）
	var aid = uiScreenAttachIdCurrent();
	if(aid != "")
	{
		var asc = UILayoutData.screens[aid];
		if(asc !== void && asc !== null && asc.elements !== void)
		{
			uiScreenFlagsEnsureFor(aid);
			var h = uiScreenHoverAtIn(asc, x, y);
			if(h != "") return h;
		}
	}
	if(!uiScreenExists(id)) return "";
	return uiScreenHoverAtIn(UILayoutData.screens[id], x, y);
}

// 更新悬停/按下目标；返回 true = 任一目标发生变化（调用方须重画）。未变化不重画（性能要求）。
function uiScreenHoverUpdate(x, y)
{
	UIScrPointerX = x; UIScrPointerY = y;        // ★ M46：记录指针位置（供列表逐项三态）
	var changed = false;

	// ★ M47：**滑块拖动中的连续更新** —— 按当前 x 更新被拖滑块的值（clamp 在
	//   uiWidgetSliderValueAt 里做，越界夹到两端，绝不取消拖动）。
	//   ⚠️ 与 M35 规则③（「按住期间指针移出按下目标即取消按下态」，见下方）**有意不同**：
	//     这是**拖动**语义 —— 按住不放、指针可以离开命中矩形甚至轨道两端而拖动继续
	//     （HTML 侧靠 setPointerCapture 表达同一件事，见 复刻/replica.js）。
	//     若照规则③取消，拖到轨道外就断连、手柄卡在半路。
	//     两个出口：左键抬起（uiScreenPressClear）、换屏/清悬停（uiScreenHoverClear）。
	if(UIScrDragSlider != "") changed = (uiScreenSliderDragTo(x) || changed);

	// ★ M47：未拖动时，指针落在某滑块的命中热区上 ⇒ 记下它（手柄画 hover 图）
	var hs = "";
	if(UIScrDragSlider == "")
	{
		var shEl = uiScreenSliderHitEl(x, y);
		if(shEl !== null) hs = "" + shEl.slider;
	}
	else hs = UIScrDragSlider;
	if(hs != UIScrHoverSlider)
	{
		UIScrHoverSlider = hs;
		changed = true;
	}

	var id = uiScreenHoverAt(x, y);
	if(id != UIScrHoverHit)
	{
		var from = UIScrHoverHit;
		UIScrHoverHit = id;
		UIScrHoverMsg = "悬停 " + ((from == "") ? "(无)" : from) + " -> "
			+ ((id == "") ? "(无)" : id) + "  @ " + x + "," + y;
		changed = true;
	}
	// ★ M46（一审 Minor-2）：**同一 list 内换项**（hoverHit 不变、hoverIndex 变）也必须算「有变化」，
	//   否则逐项态图的新形态要等下一次无条件重画（`onBlinkTimer`，实测 ≈120 ms）才出现，
	//   与元素级悬停的「即时重画」不同档。按下目标未变时同样要重画（按下态也跟着项序号走）。
	if(id != "") changed = (uiScreenListItemSyncIndex(id, x, y) || changed);
	// ★ M06：**逐项按钮**的悬停目标（与列表项、滑块并列的第三条状态轴）。
	//   只在按钮矩形上才有值；块内非按钮区恒为 ""（那时按钮的悬停态一律回落常态）。
	var btok = uiScreenBtnTokenAt(x, y);
	if(btok != UIScrHoverBtn)
	{
		UIScrBtnMsg = "按钮悬停 " + ((UIScrHoverBtn == "") ? "(无)" : UIScrHoverBtn)
			+ " -> " + ((btok == "") ? "(无)" : btok) + "  @ " + x + "," + y;
		UIScrHoverBtn = btok;
		changed = true;
	}
	// ★ M06 规则③（逐项按钮版）：按住期间指针移出**被按的那一个按钮** ⇒ 取消按下态。
	//   与 M46 的逐项口径逐条同义（按下态锚定在被按的那一件上，不跟着指针飘）；
	//   不作这条判定，引擎会「按下态跟着鼠标飘」而 HTML（事件锚定）不会 ⇒ 两端分叉。
	if(UIScrPressProbe == "" && UIScrPressBtn != "" && UIScrPressBtn != btok)
	{
		UIScrBtnMsg = "按钮按下取消（指针移出 " + UIScrPressBtn + "）";
		UIScrPressBtn = "";
		changed = true;
	}
	// ★ M35：规则 ③ —— 按住期间指针移出按下目标即取消按下态。
	//   放在这里而不是单开一个事件：悬停命中判据与按下**完全相同**，同一次计算即可得出。
	if(UIScrPressProbe == "" && UIScrPressHit != "" && UIScrPressHit != id)
	{
		UIScrPressMsg = "按下取消（指针移出 " + UIScrPressHit + "）";
		UIScrPressHit = "";
		UIScrPressIndex = -1;
		changed = true;
	}
	// ★ M46（一审 Major-2 的收口）：**逐项**版规则 ③ —— 按下目标仍是同一个 list，但指针已移到
	//   **另一项**（或移出所有项）⇒ 取消按下态。与 HTML 的逐项 `mouseleave`（项移出即复位）
	//   逐条同义；不这么做，引擎会「按下态跟着鼠标飘」而 HTML 不会 ⇒ 两端分叉。
	if(UIScrPressProbe == "" && UIScrPressIndex >= 0 && id == UIScrPressHit)
	{
		var nowIdx = uiScreenListItemIndexAtPoint(id, x, y);
		if(nowIdx != UIScrPressIndex)
		{
			UIScrPressMsg = "按下取消（指针移出该项 " + UIScrPressIndex + " -> " + nowIdx + "）";
			UIScrPressHit = "";
			UIScrPressIndex = -1;
			changed = true;
		}
	}
	return changed;
}

// ★ M46（一审 Minor-2）：把「指针当前落在该 list 的哪一项」缓存进 `UIScrHoverIndex`，
//   返回 true = 项序号发生变化（调用方据此重画）。只对**带逐项态图的 list** 有意义。
function uiScreenListItemSyncIndex(id, x, y)
{
	var idx = -1;
	var sid = uiScreenCurrent();
	if(uiScreenExists(sid))
		idx = uiScreenListItemIndexAt(UILayoutData.screens[sid], id, x, y);
	if(idx == UIScrHoverIndex) return false;
	UIScrHoverIndex = idx;
	return true;
}

// ------------------------------------------------------------
// ★ M47（2026-09-24 · ISSUE-20260924-01 · 方案 §三.1/§三.2）：滑块 element / hit / 拖动
//
//   数据契约（**冻结**）：
//     · `slider` 元素：min/max/step/value/setting/rail.asset(+nine)/handle.asset(+state_assets)
//     · **命中热区**：`kind:"hit"` + 字段 `slider:"<slider 元素 id>"`（action/label 留空即可）
//   为什么不复用 `uiScreenHoverAtIn` 找滑块热区：那条判据的候选并集只收「带 state_assets 的
//   元素 ∪ 带非空 state_group 的 hit」（被 工具/test_state_targets.py 的**判据指纹**盯着，
//   不得放宽）—— 滑块热区两样都没有 ⇒ 必须另有一处命中函数（本区块）。
// ------------------------------------------------------------
// 在**当前屏（优先其附加层）**按 id 找元素；找不到返回 null（**不抛**）
function uiScreenFindElementById(id)
{
	var k = "" + id;
	if(k == "") return null;
	var aid = uiScreenAttachIdCurrent();
	if(aid != "")
	{
		var asc = UILayoutData.screens[aid];
		if(asc !== void && asc !== null && asc.elements !== void)
		{
			var e0 = uiScreenFindElementIn(asc, k);
			if(e0 !== null) return e0;
		}
	}
	var sid = uiScreenCurrent();
	if(!uiScreenExists(sid)) return null;
	return uiScreenFindElementIn(UILayoutData.screens[sid], k);
}

// 在给定屏对象里按 id 找元素。★ 第 1 参**必须是屏对象**：TJS2 对**非 Dictionary** 取
//   不存在的成员会**抛异常**（"未找到 Member elements"），故先做 typeof 判定
//   （M46 的 uiScreenListItemIndexAt 就是栽在这里，见其注释）。
function uiScreenFindElementIn(sc, id)
{
	if(typeof sc != "Object") return null;
	if(sc.elements === void || sc.elements === null) return null;
	var els = sc.elements;
	for(var i = 0; i < els.count; i++)
	{
		var el = els[i];
		if(el === void || el === null) continue;
		if(("" + el.id) == id) return el;
	}
	return null;
}

// 在某屏对象里找 (x,y) 命中的**滑块热区**（带非空 `slider` 字段的可见 hit，取最高 z；
//   同 z 时声明在后者胜 —— 与 uiScreenHoverAtIn 的平票口径一致）。返回元素或 null。
//   ⚠️ 本函数**只在「带 slider 字段的候选集」内**取最高 z，**不是** (x,y) 处的全局胜者 ——
//      必须再经 uiScreenSliderHitEl 的**全局 z 序裁决**才能进入拖动（一审 C1，见那里）。
function uiScreenSliderHitIn(sc, x, y)
{
	if(typeof sc != "Object") return null;
	if(sc.elements === void || sc.elements === null) return null;
	var els = sc.elements;
	var bestZ = -1, best = null;
	for(var i = 0; i < els.count; i++)
	{
		var el = els[i];
		if(el === void || el === null) continue;
		if(el.kind != "hit") continue;
		if(el.slider === void || el.slider === null || ("" + el.slider) == "") continue;
		if(!uiScreenElementVisible(el)) continue;        // ★ M1：统一走屏级 flag 谓词（分页靠 vis_flag 控显隐）
		var r = uiWidgetRect(el);
		if(x < r.x || x >= r.x + r.w || y < r.y || y >= r.y + r.h) continue;
		var z = uiWidgetNum(el, "z", 0);
		if(z < bestZ) continue;
		bestZ = z; best = el;
	}
	return best;
}

// (x,y) 处**按全局 z 序胜出**的 hit / list 元素（附加层优先）；无 → null。
//   ★★ 判据与 `uiScreenClick` 的通用分支**逐条一致**（一审 C1 的修法依据）：
//     候选 = `kind == "hit" || kind == "list"` 且**可见**、矩形**半开区间**命中；
//     取最高 z，**同 z 时声明在后者胜**（`if(z < bestZ) continue;`）；附加层优先于承载屏。
//     只读、无副作用（不像 uiScreenAttachClick 会写焦点与命中台账）。
//   ⚠️ 局限（如实登记）：dialog 屏的点击走 `uiDialogClick`（另一套规则），本函数不模仿它；
//     当前**没有**屏把 slider 放在 dialog 上，故不影响。将来若如此，这里的「胜者」口径
//     需先与 uiDialogClick 对齐再使用。
function uiScreenTopHitIn(sc, x, y)
{
	if(typeof sc != "Object") return null;
	if(sc.elements === void || sc.elements === null) return null;
	var els = sc.elements;
	var bestZ = -1, best = null;
	for(var i = 0; i < els.count; i++)
	{
		var el = els[i];
		if(el === void || el === null) continue;
		if(el.kind != "hit" && el.kind != "list") continue;
		if(!uiScreenElementVisible(el)) continue;
		var r = uiWidgetRect(el);
		if(x < r.x || x >= r.x + r.w || y < r.y || y >= r.y + r.h) continue;
		var z = uiWidgetNum(el, "z", 0);
		if(z < bestZ) continue;
		bestZ = z; best = el;
	}
	return best;
}

function uiScreenTopHitEl(x, y)
{
	var aid = uiScreenAttachIdCurrent();
	if(aid != "")
	{
		var asc = UILayoutData.screens[aid];
		if(asc !== void && asc !== null && asc.elements !== void)
		{
			uiScreenFlagsEnsureFor(aid);
			var b0 = uiScreenTopHitIn(asc, x, y);
			if(b0 !== null) return b0;
		}
	}
	var sid = uiScreenCurrent();
	if(!uiScreenExists(sid)) return null;
	return uiScreenTopHitIn(UILayoutData.screens[sid], x, y);
}

// 当前屏 (x,y) 的滑块热区（附加层优先，同 uiScreenHoverAt 的优先级）；无 → null
//   ★★ 一审 C1 修（**引擎拖动命中忽略 z 序 ⇒ 点 MUTE 会静默改音量并落盘**）：
//   实机反例：声音页 6 条音量行的**行热区**（`cfg.sl_<x>_hit`，z=95，如 master 行
//   (244,318,620,21)）**100% 包住**该行的 MUTE 控件（`cfg.o_mute_vol_master_on_hit`
//   (843,318,21,21,z=96) 与 `..._off_hit` (775,318,68,21,z=96)）。旧实现只在
//   「带 slider 字段的候选集」内取最高 z ⇒ 按在 MUTE 上会**先进入拖动**、把 vol_master
//   写成该 x 对应的值（x 落在轨道右端之外 ⇒ clamp 到 100）**并随退出落盘**，抬起后又照常
//   toggle MUTE ⇒ 一次点击既静音又改音量。HTML 端按 DOM z 序命中 MUTE（z-index 9743 > 9646），
//   **不会**发生 ⇒ 两端分叉。
//   ⇒ 修法（本工程铁律二「具体控件赢」）：进入拖动前先按 `uiScreenClick` 的**同一平票规则**
//     求 (x,y) 的**全局最高 z** hit，**只有滑块热区正是那个全局胜者**时才认它。
//   ⇒ MUTE（z=96）在行热区（z=95）之上胜出 ⇒ 滑块分支让位，点击照原路径走到
//     `config_set_mute_vol_master`（toggle），音量不受影响。
function uiScreenSliderHitEl(x, y)
{
	var cand = null;
	var aid = uiScreenAttachIdCurrent();
	if(aid != "")
	{
		var asc = UILayoutData.screens[aid];
		if(asc !== void && asc !== null && asc.elements !== void)
		{
			uiScreenFlagsEnsureFor(aid);
			cand = uiScreenSliderHitIn(asc, x, y);
		}
	}
	if(cand === null)
	{
		var sid = uiScreenCurrent();
		if(!uiScreenExists(sid)) return null;
		cand = uiScreenSliderHitIn(UILayoutData.screens[sid], x, y);
	}
	if(cand === null) return null;
	// ★ 全局 z 序裁决（C1）：不是 (x,y) 处的胜者 ⇒ 当作没命中（让位给更高 z 的控件）
	var top = uiScreenTopHitEl(x, y);
	if(top === null) return null;
	if(("" + top.id) != ("" + cand.id)) return null;
	return cand;
}

// 把「当前拖动目标」按轨道 x 更新取值；返回 true = 值发生了变化（调用方重画）
function uiScreenSliderDragTo(x)
{
	var slId = UIScrDragSlider;
	if(slId == "") return false;
	var el = uiScreenFindElementById(slId);
	if(el === null || el.kind != "slider")
	{
		// 目标消失（换屏竞态 / 数据被换掉）⇒ 结束拖动，不让它悬挂
		UIScrDragMsg = "拖动目标 " + slId + " 已不存在，结束拖动";
		UIScrDragSlider = "";
		UIScrHoverSlider = "";
		return true;
	}
	return uiScreenSliderStore(el, uiWidgetSliderValueAt(el, x));
}

// 写入一个滑块的值：① 更新运行值仓（渲染唯一取数点）；
//   ② 有 `setting` ⇒ 写设置仓（**实时生效路径**：ctx 每帧读设置仓，见 ui_settings.tjs §3）。
//   写仓后再从仓里读回（仓会做自己的 clamp + step 对齐），保证**仓值与滑块值不分叉**。
function uiScreenSliderStore(el, nv)
{
	var id = "" + el.id;
	var old = uiWidgetSliderValue(el);
	var st = (el.setting === void || el.setting === null) ? "" : ("" + el.setting);
	if(st != "")
	{
		UISettingSet(st, nv);
		nv = UISettingGet(st);
	}
	UIScrSliderVal[id] = nv;
	if(old != nv)
	{
		UIScrDragMsg = "滑块 " + id + " -> " + nv
			+ ((st == "") ? "（纯视觉：未写设置仓）" : ("（设置仓 " + st + "）"));
		return true;
	}
	return false;
}

// 该屏所有 `slider` 元素按初值初始化运行值仓 —— **只在「该 id 尚无值」时写**
//   （方案要求「换屏回来应保留运行期值」，故绝不覆盖已有值）。
//   初值口径见 ui_widget.tjs 的 uiWidgetSliderDefault：有 setting 用仓值，否则用元素 value。
function uiScreenSliderInitFor(screenId)
{
	var sid = "" + screenId;
	if(sid == "") return 0;
	var sc = UILayoutData.screens[sid];
	if(sc === void || sc === null || sc.elements === void) return 0;
	var els = sc.elements;
	var n = 0;
	for(var i = 0; i < els.count; i++)
	{
		var el = els[i];
		if(el === void || el === null || el.kind != "slider") continue;
		var id = "" + el.id;
		if(UIScrSliderVal[id] !== void && UIScrSliderVal[id] !== null) continue;   // 已有运行值 ⇒ 保留
		UIScrSliderVal[id] = uiWidgetSliderClamp(el, uiWidgetSliderDefault(el));
		n++;
	}
	return n;
}

// 设置仓 → 滑块运行值的同步（挂到 ui_settings.tjs 的 UISettingSyncHook，见那边的注释）：
//   设置值一变（拖动 / config_reset / 读档 applyAll），把所有「setting == 该键」的滑块
//   运行值改成新值 ⇒ **手柄位置跟着走**（否则「初始化」后手柄会停在上一次拖动的位置）。
//   为什么要遍历屏清单：Dictionary 不能枚举 `UILayoutData.screens`，屏 id 清单由
//   uiTourCollectScreenIds() 在启动时填进 UIScrTourIdList（与巡演同一份）—— 启动早期
//   该表可能还是空的，此时**没有已初始化的滑块**，跳过即可（首次进屏会按仓值初始化）。
function uiScreenSliderSyncSetting(key, value)
{
	var k = "" + key;
	var n = 0;
	for(var i = 0; i < UIScrTourIdList.count; i++)
	{
		var sc = UILayoutData.screens[UIScrTourIdList[i]];
		if(sc === void || sc === null || sc.elements === void) continue;
		var els = sc.elements;
		for(var j = 0; j < els.count; j++)
		{
			var el = els[j];
			if(el === void || el === null || el.kind != "slider") continue;
			if(el.setting === void || el.setting === null || ("" + el.setting) != k) continue;
			UIScrSliderVal["" + el.id] = value;
			n++;
		}
	}
	return n;
}

// 装载本文件时把同步钩子挂上（本语句排在函数定义之后，确保引用时已定义）
UISettingSyncHook = uiScreenSliderSyncSetting;

// ------------------------------------------------------------
// ★ M47 追补（2026-09-24 · 主代理裁决「切页值标志派生规则」）：**值键的跨页泄漏** + **值记忆**
//
//   问题：数据侧一个元素只能带**一对** `vis_flag`/`vis_when`，而「值元素」
//   （ON/OFF 胶囊底与文字、MUTE 勾选图、角色选中胶囊与文字）需要**同时**表达
//   「页归属」与「当前值」两个维度。W2 保住了**值语义**（值元素只带 `cfg_v_<键>` /
//   `cfg_vchar`，与两个 vis_when 成对），代价是若不处理，*在系统页会看到声音页的
//   MUTE 勾选框、在声音页会看到系统页的 ON 胶囊*（W2 实测截图已确认）。
//
//   修法（**数据零改动**；页归属**从本屏数据导出**，机制里不写死第二份默认值）：
//     ① 切页时先 `uiScreenFlagSet("cfg_page", <sys|snd>)`；
//     ② 按数据建立「值键 → 所属页」映射：`action == "config_set_<键>"` 的 hit 的
//        `vis_when` 即该键的页（`config_set_mute_*` 的 hit 都在声音页）；角色链
//        （`action` 以 `config_char_` 开头）一律归 `cfg_vchar`，页取该 hit 的 `vis_when`；
//     ③ 非新页的值键：置**空串** ⇒ `vis_when` 的严格相等判定下两个值元素都不匹配
//        ⇒ 该页的值元素全不可见（**这就是挡泄漏的那一刀**）；
//        新页的值键：按下面的**三级优先链**恢复取值。
//
//   ★★ 取值优先链（**与 HTML 侧 `复刻/replica.js` 的 `cfgVarRemember` 同序，两端必须一致**）：
//        ① 设置仓（有设置项的键；且随存档持久化）
//        ② **切页值记忆** `UIScrCfgVarMemo[<值键名>]`（本次运行内的跨页记忆）
//        ③ `flags_default`（该屏数据里的初值）
//      为什么需要 ②（W4 实测的分叉点）：`cfg_vchar` **没有设置项可依**；若切页时严格按
//      「仓值，否则数据初值」，则「改成全屏 → 切页 → 切回」会**变回窗口模式**、
//      「选中角色 → 切页 → 切回」会**跳回首项** ⇒ 与「不丢状态」直接矛盾。
//      （本工程里 16 个开关键已入设置仓，故静音/画面模式走 ① 就够；② 是给
//       **无设置项**的值键与将来新增键兜底，并保证两端同序。）
//
//   ★★ 记忆表 `UIScrCfgVarMemo` 的**清理语义**（哪些该留、哪些该丢）：
//      · **留**：换屏（reset/push/pop 进出 config）、切页往返 —— 记忆就是「用户的选择」，
//        跨页/跨屏都该留（比 flag 本身更长寿：flag 每次进屏都会被 flags_default 重置）。
//        空串**不写入**记忆（空 = 无值，不得覆盖已有记忆）。
//      · **丢**：`config_reset`（初始化 ⇒ 全部恢复默认，旧记忆会盖住默认值，必须清）；
//        `uiStateLoad`（读档 ⇒ 按档内容重建，旧记忆是「上一次会话的值」，清掉，
//        否则会出现「档里 window、记忆里 full」而显示 full 的错位）。
//        两处都调 `uiScreenConfigMemoClear()`（见 ui_state.tjs 的 load 收尾）。
//   ★ 装入点（三处，缺一处就会漏）：屏进入（reset/push/pop）、切页动作（config_tab_1/2）、
//     「初始化」（config_reset）。
//   ★ 键名枚举**不用字典枚举**（TJS2 没有）：一律**遍历该屏 `elements`** 收集成并行数组。
// ------------------------------------------------------------
var UIScrCfgVarMemo = %[];     // 值键名 → 切页记忆（无设置项的值键靠它跨页保命）

// 记忆表写入/读取/清空（三个薄包装，便于两端对照实现）
function uiScreenConfigMemoSet(flagName, value)
{
	var k = "" + flagName;
	if(k == "") return false;
	var v = (value === void || value === null) ? "" : ("" + value);
	if(v == "") return false;                       // 空串不记忆（不得覆盖已有记忆）
	if(UIScrCfgVarMemo[k] === v) return false;
	UIScrCfgVarMemo[k] = v;
	return true;
}

function uiScreenConfigMemoOf(flagName)
{
	var v = UIScrCfgVarMemo["" + flagName];
	return (v === void || v === null) ? "" : ("" + v);
}

function uiScreenConfigMemoHas(flagName)
{
	var v = UIScrCfgVarMemo["" + flagName];
	return (v !== void && v !== null && ("" + v) != "");
}

// 清空记忆表（`config_reset` 与 `uiStateLoad` 调用；语义见上方区块注释）
function uiScreenConfigMemoClear()
{
	UIScrCfgVarMemo = %[];
	return true;
}

// 扫当前屏，导出「值键 → 所属页」映射（并行数组：flags / setkeys / pages）
//   flags[i]   = 值标志名（"cfg_v_<键>" 或 "cfg_vchar"）
//   setkeys[i] = 对应的**设置键名**（"" = 该值键没有设置项，如 cfg_vchar）
//   pages[i]   = 所属页（取自该 hit 的 `vis_when`；仅在 `vis_flag == "cfg_page"` 时采纳）
function uiScreenConfigMap(screenId)
{
	var flags = [], setkeys = [], pages = [];
	var seen = %[];
	var sc = UILayoutData.screens["" + screenId];
	if(sc === void || sc === null || sc.elements === void)
		return %[ flags: flags, setkeys: setkeys, pages: pages ];
	var els = sc.elements;
	for(var i = 0; i < els.count; i++)
	{
		var el = els[i];
		if(el === void || el === null) continue;
		if(el.kind != "hit") continue;                      // 页归属只认 hit（值元素本身不带页信息）
		var a = (el.action === void || el.action === null) ? "" : ("" + el.action);
		var fl = "", sk = "";
		if(uiScreenActionHasPrefix(a, "config_set_"))
		{
			sk = uiScreenActionSuffix(a, "config_set_");
			// ★ 动作串可带 `:<值>` 后缀（config_set_<键>:<值>，程序化派发用）⇒ 键名要截到冒号前
			var cx = sk.indexOf(":");
			if(cx >= 0) sk = sk.substring(0, cx);
			fl = "cfg_v_" + sk;
		}
		else if(uiScreenActionHasPrefix(a, "config_char_"))
		{
			fl = "cfg_vchar";
			sk = "";
		}
		else continue;
		if(fl == "" || fl == "cfg_v_") continue;
		if(seen[fl] === true) continue;
		var pg = "";
		if(el.vis_flag !== void && el.vis_flag !== null && ("" + el.vis_flag) == "cfg_page")
			pg = (el.vis_when === void || el.vis_when === null) ? "" : ("" + el.vis_when);
		if(pg == "") continue;          // 未声明页归属的键不进映射（不做无依据的置空）
		seen[fl] = true;
		flags.push(fl); setkeys.push(sk); pages.push(pg);
	}
	return %[ flags: flags, setkeys: setkeys, pages: pages ];
}

// 某值键的**当前有效值**（不含记忆）：有设置项 ⇒ 从**设置仓**取；否则取当前 flag 值
function uiScreenConfigValueOf(setKey, flagName)
{
	if(setKey != "" && uiSettingHas(setKey)) return "" + UISettingGet(setKey);
	return uiScreenFlagGet(flagName);
}

// 三角优先链取值：设置仓 → 切页记忆 → `flags_default`（与 HTML 侧同序）
function uiScreenConfigRestoreValue(screenId, setKey, flagName)
{
	if(setKey != "" && uiSettingHas(setKey) && uiSettingStored(setKey))
		return "" + UISettingGet(setKey);
	if(uiScreenConfigMemoHas(flagName)) return uiScreenConfigMemoOf(flagName);
	return uiScreenFlagDefaultFor("" + screenId, flagName);
}

// 诊断用：值标志的可读值（"" ⇒ "(空)"）—— 巡演日志里一眼看出「非本页的键已置空」
function uiScreenConfigValueLabel(flagName)
{
	var v = uiScreenFlagGet(flagName);
	return (v == "") ? "(空)" : v;
}

// 按页派生全部值标志（返回处理项数）。page 省略 = 用当前 cfg_page。
//   ★★ captureMemo（一审 C4）：是否**在本次调用里捕获记忆**。
//     · true（默认／用户动作与切页路径）：先把每个值键的当前有效值记进记忆表 —— 用户的选择
//       经由这条路径进入记忆。
//     · **false（进屏路径 uiScreenConfigFlagsInitFor 必须传 false）**：进屏那一刻 flag 刚被
//       `uiScreenFlagsInitFor` 重置成 `flags_default`，此时捕获等于**用默认值冲掉记忆**
//       ⇒ 「声页选小鸠 → 离开设置屏 → 再进设置 → 切声音页」会回落到 asu（实测复现；
//       只有 `cfg_vchar` 这种**无设置项**的键受害，其余值键走设置仓优先链无感）。
//       故进屏只做「播种 + 派生」，**不捕获**；记忆保持上次用户动作留下的值（符合
//       「换屏 = 留」的语义，见本区块顶部注释）。
function uiScreenConfigSyncPage(page, captureMemo)
{
	var sid = uiScreenCurrent();
	var mp = uiScreenConfigMap(sid);
	if(mp.flags.count == 0) return 0;      // 该屏没有「值键」⇒ 本机制不适用（零影响，别的屏原样）
	var pg = (page === void || page === null) ? "" : ("" + page);
	if(pg == "") pg = uiScreenFlagGet("cfg_page");
	var cap = (captureMemo !== false);     // 省略 / true ⇒ 捕获；显式 false ⇒ 不捕获（进屏路径）

	// ① **记忆**（仅 captureMemo 为真时）：把每个值键的**当前有效值**记进记忆表 ——
	//    必须排在**任何置空之前**（无设置项的值键，如 cfg_vchar，只能靠这里存活）。
	//    空值不记忆（`uiScreenConfigMemoSet` 内部已挡）。
	if(cap)
	for(var i = 0; i < mp.flags.count; i++)
		uiScreenConfigMemoSet(mp.flags[i], uiScreenConfigValueOf(mp.setkeys[i], mp.flags[i]));

	// ② **播种**：把「仓里还没有」的设置键按当前 flag 值（= 数据默认，进屏时由
	//    flags_default 铺好）写进设置仓 —— 同样必须排在置空之前，否则非本页的键会丢数据默认值。
	for(var k = 0; k < mp.flags.count; k++)
	{
		var sk0 = mp.setkeys[k];
		if(sk0 == "" || !uiSettingHas(sk0)) continue;
		if(uiSettingStored(sk0)) continue;
		UISettingSet(sk0, uiScreenFlagGet(mp.flags[k]), true);   // noApply：只播种
	}

	// ③ **派生**：新页的键按三级优先链取回；非新页的键置空串（挡泄漏）
	var n = 0;
	for(var j = 0; j < mp.flags.count; j++)
	{
		var fl = mp.flags[j];
		var sk = mp.setkeys[j];
		if(mp.pages[j] != pg)
		{
			uiScreenFlagSet(fl, "");
			n++;
			continue;
		}
		uiScreenFlagSet(fl, uiScreenConfigRestoreValue(sid, sk, fl));
		n++;
	}
	return n;
}

// 屏进入时的装入点：屏内存在「值键」才动作（其它屏零影响）
//   ★ C4：**captureMemo=false** —— 进屏时 flag 刚被 flags_default 重置，捕获会冲掉记忆。
function uiScreenConfigFlagsInitFor(screenId)
{
	var mp = uiScreenConfigMap(screenId);
	if(mp.flags.count == 0) return 0;
	return uiScreenConfigSyncPage(uiScreenFlagGet("cfg_page"), false);
}

// ------------------------------------------------------------
// ★ M1（2026-09-24 · ISSUE-20260924-08_鉴赏模式）：**鉴赏模式四页签 = 切屏** + 栏位内差分
//
//   接口裁决（跨模块，主代理 2026-09-24）：
//     · 四页 = 四个屏：`gallery`(CG) / `music`(BGM) / `dress`(立绘) / `replay`(情景回想)；
//     · 共享外壳（页签条 + 标题 + 返回键）= 单独一个**浮层屏** `gal_shell`，
//       四个页屏各自 `attach: "gal_shell"`（照快捷条「一个浮层挂多个承载屏」的先例）；
//     · 页屏自身元素**不带页 flag**（不需要页键派生）⇒ 切屏走**屏栈**语义；
//     · 动作：`gallery_tab_1..4` = **切到对应屏**；`gallery_page_prev/next` = 页内翻页；
//       `gallery_prev|next:<行号>` = 栏位内差分翻页（`item_variants`）。
//
//   外壳的**当前页签高亮**用 `gal_tab` flag（值 = 承载屏 id）表达 —— 这是**唯一**一处派生，
//   口径与 M47 的「切页值标志派生」同款：`flags_default`（外壳声明）+ `vis_flag/vis_when`
//   （页签高亮件）+ **派生出口**（本区块的 `uiScreenGalleryShellSyncFor`，装在 reset/push/pop
//   与 `gallery_tab_*` 三处）。**一元素一对 flag** 硬约束照旧。
//   页签值集**从外壳自己的数据导出**（`vis_flag == gal_tab` 的元素的 `vis_when` 取值）⇒
//   外壳数据改了不必改脚本；承载屏不在该值集里 ⇒ 派生返回 0（零副作用）。
// ------------------------------------------------------------
var UIScrGalleryShellId = "gal_shell";   // 外壳屏 id（**接口冻结**，与 39_gal_shell.json 一致）
var UIScrGalleryTabFlag = "gal_tab";     // 外壳「当前页签」flag 名（**接口冻结**）

// 页签动作 → 目标屏（**接口冻结**的四个页屏 id）
function uiScreenMapGalleryTab(action)
{
	var a = "" + action;
	if(a == "gallery_tab_1") return "gallery";
	if(a == "gallery_tab_2") return "music";
	if(a == "gallery_tab_3") return "dress";
	if(a == "gallery_tab_4") return "replay";
	return "";
}

// 该外壳屏的数据里，`gal_tab` 的取值集是否含 tabValue（= 该值有没有对应的页签高亮件）
function uiScreenGalleryTabKnown(shellId, tabValue)
{
	var sc = UILayoutData.screens["" + shellId];
	if(sc === void || sc === null || sc.elements === void) return false;
	var want = "" + tabValue;
	var els = sc.elements;
	for(var i = 0; i < els.count; i++)
	{
		var el = els[i];
		if(el === void || el === null) continue;
		if(el.vis_flag === void || el.vis_flag === null) continue;
		if(("" + el.vis_flag) != UIScrGalleryTabFlag) continue;
		if(el.vis_when === void || el.vis_when === null) continue;
		if(("" + el.vis_when) == want) return true;
	}
	return false;
}

// 派生出口：承载屏挂了鉴赏外壳 ⇒ 把 `gal_tab` 置成**承载屏 id**（页签高亮随之切换）。
//   返回 1 = 真的改了；0 = 该屏不适用 / 已是该值（**别的屏一律 0，零副作用**）。
function uiScreenGalleryShellSyncFor(screenId)
{
	if(screenId === void || screenId === null) return 0;
	var host = "" + screenId;
	if(uiScreenAttachId(host) != UIScrGalleryShellId) return 0;
	if(!uiScreenGalleryTabKnown(UIScrGalleryShellId, host)) return 0;
	if(uiScreenFlagGet(UIScrGalleryTabFlag) == host) return 0;
	uiScreenFlagSet(UIScrGalleryTabFlag, host);
	return 1;
}

// 差分序号的运行期存取（嵌套：listId -> { 全局行号 -> 序号 }；与 ctx.variantIndex 同构）
function uiScreenVarIdxGet(listId, row)
{
	var m = UIScrVarIdx["" + listId];
	if(m === void || m === null) return 0;
	var v = m["" + row];
	return (v === void || v === null) ? 0 : v;
}

function uiScreenVarIdxSet(listId, row, idx)
{
	var k = "" + listId;
	if(UIScrVarIdx[k] === void || UIScrVarIdx[k] === null) UIScrVarIdx[k] = %[];
	UIScrVarIdx[k]["" + row] = idx;
}

// 该屏声明的**页码 flag** 名（屏级 `page_flag` 字段；M8 一审 R3 新增，2026-09-24）。
//   空串 = 该屏不声明（如 dress 无 list 无页码 ⇒ 不参与页码 flag）。
//   语义：翻页动作把 **1 基页号**写进该 flag ⇒ 屏内的互斥页码文本（`vis_flag` = 该名、
//   `vis_when` = "1"/"2"/…）随页切换（CG 页 `gal.page_tx_01..12` / BGM `mu.pg_tx_1..2` /
//   情景回想 `rp.pg_tx_1..2`）。**名字一律从数据读，机制不写死**。
function uiScreenPageFlagOf(screenId)
{
	var sid = "" + screenId;
	if(!uiScreenExists(sid)) return "";
	var pf = UILayoutData.screens[sid].page_flag;
	if(pf === void || pf === null) return "";
	return "" + pf;
}

// 清掉某屏所有 list 的**页码**与**差分序号**（切页签时调用 ⇒ 新页从第 1 页 / 第 1 张开始）。
//   ★ M8 一审 R3（2026-09-24）：归零时**同步把该屏页码 flag 复位 "1"** —— 否则 flag 停在旧页号、
//   页码文本与实际页码分叉（page=0 但 gal_page="7" 之类）。
//   返回清理的 list 数。⚠️ 不用 `for-in`（TJS2 在本工程里语法报错，见 ui_widget.tjs 的记录），
//   故按该屏的 list 元素逐个清（这正是「嵌套结构」而非「扁平前缀键」的理由）。
function uiScreenPageVariantClearFor(screenId)
{
	var sid = "" + screenId;
	if(!uiScreenExists(sid)) return 0;
	var els = UILayoutData.screens[sid].elements;
	var n = 0;
	for(var i = 0; i < els.count; i++)
	{
		var el = els[i];
		if(el === void || el === null || el.kind != "list") continue;
		var lid = "" + el.id;
		if(UIScrPage[lid] !== void && UIScrPage[lid] !== null) UIScrPage[lid] = 0;
		UIScrVarIdx[lid] = %[];
		n++;
	}
	// ★ M8 一审 R3：页码 flag 复位 "1"（该屏声明了 page_flag 才动，别的屏零副作用）
	var gpflag = uiScreenPageFlagOf(sid);
	if(gpflag != "") uiScreenFlagSet(gpflag, "1");
	return n;
}

// ★ M8 一审 + 主代理追认项（2026-09-24）：**挂壳屏「重进」时页码/差分序号归零**。
//   「重进」= 栈语义上的**新鲜进入**：uiScreenReset（深链 / 巡演跳屏）/ uiScreenPush（入口
//   `open_gallery` 等）/ uiScreenPop（返回再进）三条路径；`uiScreenReplace`（页签切屏）**不在列**
//   —— 切屏时**离开页**已被 `gallery_tab_*` 处理器里的 `uiScreenPageVariantClearFor(from)` 清过、
//   目标页上次离开时也已清过，再清是冗余（且 replace 不产生新的「进入」语义）。
//   只对挂了鉴赏外壳的屏生效（别的屏零副作用）。返回清理的 list 数（0 = 不适用）。
function uiScreenGalleryEntryResetFor(screenId)
{
	var sid = "" + screenId;
	if(sid == "") return 0;
	if(uiScreenAttachId(sid) != UIScrGalleryShellId) return 0;
	return uiScreenPageVariantClearFor(sid);
}

// 当前屏里**第一个带 item_variants 的 list** 的元素 id（"" = 没有）—— 差分动作的目标。
function uiScreenVariantListId()
{
	var sid = uiScreenCurrent();
	if(!uiScreenExists(sid)) return "";
	var els = UILayoutData.screens[sid].elements;
	for(var i = 0; i < els.count; i++)
	{
		var el = els[i];
		if(el === void || el === null || el.kind != "list") continue;
		if(!uiScreenElementVisible(el)) continue;
		if(uiWidgetItemVariants(el) === null) continue;
		return "" + el.id;
	}
	return "";
}

// 当前屏里**第一个可见的 list** 的元素 id（"" = 没有）—— 页内翻页的目标。
function uiScreenFirstListId()
{
	var sid = uiScreenCurrent();
	if(!uiScreenExists(sid)) return "";
	var els = UILayoutData.screens[sid].elements;
	for(var i = 0; i < els.count; i++)
	{
		var el = els[i];
		if(el === void || el === null || el.kind != "list") continue;
		if(!uiScreenElementVisible(el)) continue;
		return "" + el.id;
	}
	return "";
}

// 某屏里按 id 找元素（找不到 = null）。★ M1：给差分/翻页动作定位元素用。
function uiScreenElById(screenId, id)
{
	var sid = "" + screenId;
	if(!uiScreenExists(sid)) return null;
	var els = UILayoutData.screens[sid].elements;
	for(var i = 0; i < els.count; i++)
	{
		if(els[i] !== void && els[i] !== null && ("" + els[i].id) == ("" + id)) return els[i];
	}
	return null;
}

// ------------------------------------------------------------
// 绘制上下文（每屏一份：高亮 / 页码 / 闪烁相位 / 悬停 / 按下 / 组绑定）
// ------------------------------------------------------------
// ★ M35b：取某元素 id 所属的 `state_group`（"" = 无组）。供 ctx 携带「当前悬停/按下元素
//   所属的组」，使**同组的其它元素**也能进入同一形态（图标 + 文字同步高亮）。
function uiScreenStateGroupOf(screen, id)
{
	if(screen === void || screen.elements === void) return "";
	if(id === void || id === null || ("" + id) == "") return "";
	var els = screen.elements;
	for(var i = 0; i < els.count; i++)
	{
		var el = els[i];
		if(("" + el.id) == ("" + id))
		{
			if(el.state_group === void || el.state_group === null) return "";
			var g = "" + el.state_group;
			return (g == "") ? "" : g;
		}
	}
	return "";
}

// ★ M46（2026-09-23，用户指令「让选择支能有三态效果」）：命中元素若是**带逐项态图的 list**
//   （`item_frame.state_assets` 非空），返回指针所在**全局项序号**（含分页偏移，`uiWidgetListHit`
//   已把 `pg.first` 加回）；否则 -1。供 `uiScreenCtx` 携带、交给 ui_widget.tjs 逐项选态图。
//   判据：只认「显式声明了逐项态图」的 list ⇒ 普通列表（`dlg.choices` 等无态图的）行为完全不变。
//   ★ 第 1 参是**屏对象**（不是屏 id 字符串！）：本函数要读 `screen.elements`，而 TJS2 对
//   **非 Dictionary** 对象读不存在的成员会**抛异常**（"未找到 Member elements"），不是返回 void。
//   M46 首轮巡演就栽在这里（`uiScreenSyntheticPointer` 误传 `uiScreenCurrent()`）。
//   故第 1 参做显式类型判定（一审 Minor-4：原先只判 void/null，对字符串/整数仍会抛）。
function uiScreenListItemIndexAt(screen, id, x, y)
{
	if(typeof screen != "Object") return -1;      // void / null / 字符串 / 整数 → 一律 -1，不抛
	if(screen.elements === void || screen.elements === null) return -1;
	if(id === void || id === null || ("" + id) == "") return -1;
	if(x < 0 || y < 0) return -1;
	var els = screen.elements;
	for(var i = 0; i < els.count; i++)
	{
		var el = els[i];
		if(("" + el.id) != ("" + id)) continue;
		if(el.kind != "list") return -1;
		if(el.item_frame === void || el.item_frame === null) return -1;
		var sa = el.item_frame.state_assets;
		if(sa === void || sa === null) return -1;
		var pg = UIScrPage[id];
		if(pg === void) pg = 0;
		return uiWidgetListHit(el, x, y, pg);
	}
	return -1;
}

// ------------------------------------------------------------
// ★ M06（2026-09-24 · ISSUE-20260924-06_回想屏重排 · 冻结书 §2）：**逐项按钮的子命中**
//
//   契约：`list` 元素可带 `item_buttons`（逐块按钮，**块内局部坐标**；绘制见 ui_widget.tjs
//   的 `uiWidgetDrawList`）。命中规则（两端逐条同口径，HTML 侧见 复刻/replica.js 的 buildList）：
//     · 指针落在**某按钮矩形内** ⇒ 该按钮是**最高优先命中**（先于整行热区）；
//     · 块内其余区域仍走既有 `actions[项]`；
//     · 悬停/按下态**只影响被指到的那一个按钮的那一行**（与 M46 逐项态同规矩）。
//
//   为什么单列一条命中函数（不复用 `uiScreenHoverAtIn`）：那条判据的候选并集是
//     「带 `state_assets` 的元素 ∪ 带**逐项**态图的 list ∪ 带非空 `state_group` 的 hit」，
//     被 工具/test_state_targets.py 的**判据指纹**盯着 ⇒ **不得放宽**。回想屏的 list 既无
//     元素级 `state_assets`、`item_frame` 也没有逐项态图 ⇒ 按那条判据它永远选不中，
//     按钮的悬停态就无从触发。这与 M47 给滑块另立命中函数（`uiScreenSliderHitEl`）同一先例。
//
//   几何一律来自数据：命中走 `uiWidgetItemButtonAt`（与绘制**共用同一张 item_buttons 表
//   与同一套结构校验**）⇒ 「画出来的」与「点得到的」永远同集，**机制里没有任何按钮几何字面量**。
// ------------------------------------------------------------
var UIScrHoverBtn = "";    // 悬停中的按钮令牌 `"<list元素id>:<全局项序号>:<按钮key>"`（"" = 无）
var UIScrPressBtn = "";    // **锁存**的按下按钮令牌（按下时锚定，指针移出该按钮即清）
var UIScrBtnMsg   = "";    // 最近一次按钮态变化的可读描述（诊断 / 日志）

// ★ M06：逐块按钮**派发的可观测状态**（`backlog_jump:<行号>` / `backlog_replay:<行号>`）。
//   本轮语义 = **接口冻结/占位**：引擎尚无音频代码（M47 已登记）⇒ `backlog_replay` 只做
//   「命中 → 派发 → 日志/状态可见」，`backlog_jump` 只做「派发 + 可观测状态」；
//   **音频接线与真正的跳转生效留给编程组**（不得声称已生效，见冻结书 §2 末段）。
//   这三个值就是「派发到的行号 = 点的那一行」的机检依据（巡演 `★M06BTN★` 直接读它们）。
var UIScrBacklogLastAct   = "";   // 最近一次派发的回想动作**原文**（含行号）
var UIScrBacklogLastRow   = -1;   // 最近一次派发解析出的行号（-1 = 无/非法）
var UIScrBacklogActCount  = 0;    // 累计派发次数（区分「真派发过」与「值恰好相同」）

// 在某屏对象上按 (x,y) 找命中的逐项按钮；无则 null。
//   返回 %[ id: <list 元素 id>, index: <全局项序号>, key:, bi:, action: ]
function uiScreenListItemBtnHit(screen, x, y)
{
	if(typeof screen != "Object") return null;         // void/null/字符串/整数 → null，不抛
	if(screen.elements === void || screen.elements === null) return null;
	var els = screen.elements;
	var bestZ = -1, best = null;
	for(var i = 0; i < els.count; i++)
	{
		var el = els[i];
		if(el === void || el === null) continue;
		if(el.kind != "list") continue;
		// ★ M1：`item_buttons` 或 `item_variants` 任一存在 ⇒ 该 list 参与逐项子命中
		if(!uiWidgetHasItemSub(el)) continue;
		if(!uiScreenElementVisible(el)) continue;          // ★ M1：统一走屏级 flag 谓词
		var r = uiWidgetRect(el);
		if(x < r.x || x >= r.x + r.w || y < r.y || y >= r.y + r.h) continue;
		var z = uiWidgetNum(el, "z", 0);
		if(z < bestZ) continue;                            // 同 z 时**声明在后者胜**（与 uiScreenClick 同口径）
		var pg = UIScrPage["" + el.id];
		if(pg === void) pg = 0;
		var bt = uiWidgetItemSubHitAt(el, x, y, pg);
		if(bt === null) continue;
		bestZ = z;
		best = %[ id: "" + el.id, index: bt.index, key: bt.key, bi: bt.bi, action: bt.action ];
	}
	return best;
}

// 当前屏 (x,y) 命中的按钮令牌（"" = 未命中任何按钮）。
//   优先级与 uiScreenHoverAt 一致：**附加层优先于承载屏**。
function uiScreenBtnTokenAt(x, y)
{
	var sid = uiScreenCurrent();
	if(!uiScreenExists(sid)) return "";
	var aid = uiScreenAttachIdCurrent();
	if(aid != "")
	{
		var asc = UILayoutData.screens[aid];
		if(asc !== void && asc !== null && asc.elements !== void)
		{
			uiScreenFlagsEnsureFor(aid);
			var h1 = uiScreenListItemBtnHit(asc, x, y);
			if(h1 !== null) return uiWidgetItemBtnToken(h1.id, h1.index, h1.key);
		}
	}
	var h2 = uiScreenListItemBtnHit(UILayoutData.screens[sid], x, y);
	if(h2 === null) return "";
	return uiWidgetItemBtnToken(h2.id, h2.index, h2.key);
}

// 行号严格解析（**只接受非负十进制整数字面量**，其余一律 -1）：
//   为什么不用 uiFlowAtoi —— 它对 "abc" 返回 **0**（`!seen` 分支）⇒ 会把非法动作名
//   静默当成第 0 行。派发 `backlog_jump:<行号>` 时用它守住行号（拒绝而不猜）。
function uiScreenRowNumber(s)
{
	var t = "" + s;
	if(t == "") return -1;
	for(var i = 0; i < t.length; i++)
	{
		var c = t.charAt(i);
		if(c < "0" || c > "9") return -1;
	}
	return uiFlowAtoi(t);
}

// 动作串里的 `%row%` → 全局项序号（含分页偏移）；无占位符则原样返回。
function uiScreenRowAction(act, row)
{
	var s = "" + act;
	var rs = "" + row;
	var pos = s.indexOf("%row%");
	while(pos >= 0)
	{
		s = s.substring(0, pos) + rs + s.substring(pos + 5);
		pos = s.indexOf("%row%", pos + rs.length);
	}
	return s;
}

function uiScreenCtx(screen)
{
	var hid = UIScrHoverHit;
	var pid = (UIScrPressProbe != "") ? UIScrPressProbe : UIScrPressHit;
	var ctx = %[ page: %[], focus: %[], hide: %[], textOverride: %[], boxOverride: %[],
	             opacityOverride: %[],
	             phase: UIScrBlinkPhase, hoverHit: hid, pressHit: pid,
	             hoverGroup: "", pressGroup: "" ];
	// ★ M47（方案 §三.3「实时生效的唯一实现路径」）：
	//   **本屏的 ctx 以前连 `opacityOverride` 这个键都没有** ⇒ ui_widget.tjs 里的
	//   `ctx.opacityOverride[id]` 读取点（image 分支，ui_widget.tjs:292 附近）是一条**死路径**
	//   （任何元素都不可能被覆盖 opacity）。现在补出**键 + 两个写入者**：
	//     ① dlg.mask_bottom —— 对话框底部遮罩的浓度；
	//     ② cfg.pv_mask      —— 设置页预览框里的遮罩（与①**同一张素材、同一算法口径**，
	//        故预览浓淡与实机对话框一致）。
	//   值 = floor(255 * 设置值 / 100)，设置值是「文本窗口的不透明度」滑块写进设置仓的
	//   （见 ui_settings.tjs / ui_screenSliderStore）⇒ 拖动即改遮罩，无需重出素材
	//   （M39 定下的旋钮就是元素 opacity，见 layout/_schema.md 的遮罩条目）。
	ctx.opacityOverride["dlg.mask_bottom"] = Math.floor(255 * UISettingGet("dlg_winopac") / 100);
	ctx.opacityOverride["cfg.pv_mask"]      = Math.floor(255 * UISettingGet("dlg_winopac") / 100);
	// ★ M47：滑块拖动 / 悬停目标（ui_widget.tjs 的滑块绘制据此选手柄 hover 图）
	ctx.dragSlider  = (UIScrDragSlider == "")  ? "" : ("" + UIScrDragSlider);
	ctx.hoverSlider = (UIScrHoverSlider == "") ? "" : ("" + UIScrHoverSlider);
	// ★ M46：「列表逐项三态」的项序号（-1 = 非列表/未命中某项）。
	//   仅当该元素是**带逐项态图的 list**（`item_frame.state_assets` 非空）时才有意义，
	//   由 `uiScreenListItemIndexAt` 用记录下来的指针坐标 + 该元素当前页算出（含分页偏移）。
	ctx.hoverIndex = uiScreenListItemIndexAt(screen, hid, UIScrPointerX, UIScrPointerY);
	// ★ 按下项序号用**锁存值**（按下时锚定），不是按指针重算 —— 见 uiScreenPressUpdate 注释。
	ctx.pressIndex = (pid != "") ? UIScrPressIndex : -1;
	// ★ M06：**逐项按钮**的悬停/按下令牌（ui_widget.tjs 的 uiWidgetItemButtonState 据此选态图）。
	//   与 hoverIndex/pressIndex 是并列的第三条状态轴：那两条表达「哪一项」，这两条表达
	//   「哪一项的哪一个按钮」（同一个 list 内可同时有 N 项 × M 按钮）。
	ctx.hoverBtn = UIScrHoverBtn;
	ctx.pressBtn = UIScrPressBtn;
	// ★ M1：**栏位内差分**的运行期序号（嵌套：listId -> { 全局行号 -> 序号 }）。
	//   直接传引用（渲染器只读）⇒ 每帧零拷贝；键口径与 `uiWidgetVariantIdx` 一致。
	ctx.variantIndex = UIScrVarIdx;
	// 组绑定：把「当前悬停/按下元素」的 state_group 也放进 ctx，供 ui_widget.tjs 判同组元素
	ctx.hoverGroup = uiScreenStateGroupOf(screen, hid);
	ctx.pressGroup = uiScreenStateGroupOf(screen, pid);
	if(screen === void || screen.elements === void) return ctx;
	var els = screen.elements;
	for(var i = 0; i < els.count; i++)
	{
		var el = els[i];
		var id = "" + el.id;
		if(UIScrPage[id] !== void)  ctx.page[id]  = UIScrPage[id];
		if(UIScrFocus[id] !== void) ctx.focus[id] = UIScrFocus[id];
	}
	return ctx;
}

// ------------------------------------------------------------
// 合成鼠标事件（★ M13，仅巡演用）
//   自动巡演不产生真实鼠标事件，右键呼出的 sysicons 屏无法被巡演覆盖。
//   这里直接调用窗口的 onMouseDown —— 即引擎处理真实鼠标按下时走的**同一个入口**
//   （源码 environ/win32/TVPWindow.cpp:77-145 → WindowIntf.cpp:346）。
//   局限（如实登记，见 _工作/M13_报告.md §未决问题）：本函数只证明「处理器 + 键码分支」
//   正确，**不能**证明引擎对真实右键传入的 mb 值；后者依据源码
//   （visual/tvpinputdefs.h:20-26 枚举 mbLeft,mbRight,mbMiddle + base/ScriptMgnIntf.cpp:65
//   注册 mbLeft=0/mbRight=1/mbMiddle=2 + TVPWindow.cpp:110 WM_RBUTTONDOWN→mbRight），
//   真实鼠标右键的实测需人工在 run_loose.bat 下按一次右键。
// ------------------------------------------------------------
function uiScreenSyntheticMouse(which)
{
	var mb = 1;                      // 1 = mbRight（见上方源码依据）；左键 = 0
	if(which == "left") mb = 0;
	if(UIScrMouseSink === null || UIScrMouseSink === void)
	{
		UIScrMouseLastMsg = "窗口未登记（UIScrMouseSink=null），合成鼠标跳过";
		Debug.message("[UI][MOUSE] " + UIScrMouseLastMsg);
		return UIScrMouseLastMsg;
	}
	var cx = Math.floor(uiThemeCanvasW() / 2);
	var cy = Math.floor(uiThemeCanvasH() / 2);
	Debug.message("[UI][MOUSE] 合成鼠标按下（巡演）：which=" + which + " mb=" + mb
		+ " at " + cx + "," + cy + " —— 走 onMouseDown 同一入口");
	UIScrSynthMouse = true;
	try { UIScrMouseSink.onMouseDown(cx, cy, mb, 0); }
	catch(e) { Debug.message("[UI][MOUSE] 合成鼠标 EXCEPTION：" + e.message); }
	UIScrSynthMouse = false;
	UIScrMouseLastMsg = "合成鼠标 " + which + "（mb=" + mb + "）-> 当前屏 " + uiScreenCurrent();
	return UIScrMouseLastMsg;
}

// ------------------------------------------------------------
// 合成指针定位（★ M46，仅巡演验收用）
//   用途：把指针**放到某个 list 的具体一项上**，验证「列表逐项三态」（hover/pressed 态图）。
//   走的是与真实鼠标移动**同一批入口**：uiScreenHoverUpdate / uiScreenPressUpdate
//   （即 startup.tjs onMouseMove → 这两个函数；onMouseDown → uiScreenPressUpdate）。
//   spec 语法：`<元素id>:<项序号>[:press]`；项序号是**全局序号**（含分页偏移，与
//   复刻/replica.js 的 data-ui-index 同义）。返回一行可读结论，含 PASS/FAIL 判词 ——
//   判词比对「机制算出的项序号 + 选出的态图」与「期望值」，直接写进巡演日志，
//   使"日志无 error"以外的**目标级**证据可机检。
//   局限（如实登记）：本函数只覆盖「命中 → 项序号 → 态图」这条链路；真实鼠标的
//   移动事件本身仍由引擎分发（M13 合成鼠标同款局限，见 uiScreenSyntheticMouse 注释）。
// ------------------------------------------------------------
function uiScreenSyntheticPointer(spec)
{
	var s = "" + spec;
	var p1 = s.indexOf(":");
	if(p1 <= 0) return "★M46PTR-REJECT★ spec 应为 <元素id>:<项序号>[:press]，实收 " + s;
	var id  = s.substring(0, p1);
	var rest = s.substring(p1 + 1);
	var mode = "";
	var p2 = rest.indexOf(":");
	if(p2 >= 0) { mode = rest.substring(p2 + 1); rest = rest.substring(0, p2); }
	var idx = uiFlowAtoi(rest);
	if(idx < 0) return "★M46PTR-REJECT★ 项序号非数字（spec 应为 <元素id>:<项序号>[:press]）：" + rest;

	var sid = uiScreenCurrent();
	if(!uiScreenExists(sid)) return "★M46PTR-REJECT★ 当前屏 " + sid + " 未登记，无法定位";
	var sc = UILayoutData.screens[sid];
	var els = sc.elements;
	var el = null;
	for(var i = 0; i < els.count; i++)
		if(("" + els[i].id) == id) { el = els[i]; break; }
	if(el === null) return "★M46PTR-REJECT★ 当前屏 " + sid + " 无元素 " + id + "（走『元素不存在』守卫）";
	if(el.kind != "list") return "★M46PTR-REJECT★ " + id + " 不是 list（kind=" + ("" + el.kind) + "）";
	if(el.item_frame === void || el.item_frame === null || el.item_frame.state_assets === void)
		return "★M46PTR-REJECT★ " + id + " 未声明逐项态图（item_frame.state_assets）";

	var pg = UIScrPage[id];
	if(pg === void) pg = 0;
	var pgi = uiWidgetListPage(el, pg);
	var local = idx - pgi.first;
	if(local < 0 || local >= pgi.visibleCount)
		return "★M46PTR-REJECT★ 项序号 " + idx + " 不在本页可见范围（本页 " + pgi.first + ".."
			+ (pgi.first + pgi.visibleCount - 1) + "）";
	var ir = uiWidgetListItemRect(el, local);
	var cx = ir.x + Math.floor(ir.w / 2);
	var cy = ir.y + Math.floor(ir.h / 2);

	// ★ 一审 Minor-2 的旁证：hover 变化标志必须为 1 —— 即使悬停**元素 id 没变**、
	//   只是**项序号**变了（相邻两步 ptr 就是这种情形），也要报「有变化」才会即时重画。
	var hoverChanged = uiScreenHoverUpdate(cx, cy);
	if(mode == "press") uiScreenPressUpdate(cx, cy);
	else uiScreenPressClear();

	var hid = UIScrHoverHit;
	// 注意：uiScreenListItemIndexAt 的第 1 参是**屏对象**（内部取 screen.elements 做守卫），
	// 不是屏 id 字符串 —— TJS2 对**非 Dictionary** 对象读不存在的成员会**抛异常**
	// （"未找到 Member elements"），而不是返回 void。M46 首轮巡演就栽在这里（已修）。
	var got = uiScreenListItemIndexAt(sc, id, cx, cy);
	var pidNow = (mode == "press") ? ("" + id) : "";
	// ★ 用**真实全局状态**造 ctx（而不是把 got 抄成 pressIndex）：pressIndex 走的是按下时
	//   锁存值 UIScrPressIndex（uiScreenCtx 同口径）—— 探针若没走到锁存路径，这里立刻露馅。
	var ctx = %[ hoverHit: hid, pressHit: pidNow, hoverIndex: got, pressIndex: UIScrPressIndex ];
	var st  = uiWidgetListItemState(el, ctx, idx);
	var sa  = el.item_frame.state_assets;
	var wantKey = (mode == "press") ? "pressed" : "hover";
	var want = (mode == "press") ? sa.pressed : sa.hover;
	var gotAsset = uiWidgetItemFrameAsset(el.item_frame, st);
	var ok = (st == wantKey) && (("" + gotAsset) == ("" + want));

	return "★M46PTR★ " + (ok ? "PASS" : "FAIL")
		+ "  " + id + " 第 " + idx + " 项中心=" + cx + "," + cy
		+ "  命中项序号=" + got + "（期望 " + idx + "）"
		+ "  锁存按下项序号=" + UIScrPressIndex
		+ "  hover变化=" + ((hoverChanged) ? 1 : 0)
		+ "  态=" + ((st == "") ? "(normal)" : st) + "（期望 " + wantKey + "）"
		+ "  选图=" + ("" + gotAsset)
		+ (ok ? "" : ("（期望 " + ("" + want) + "）"));
}

// ------------------------------------------------------------
// ★ ISSUE-20260929-05（第 13 批 · 模式入口）：**模式入口三态真值探针**（仅巡演验收用）
//   目的：证明 `_over` / `_press` **真的被换用**（不是只写在数据里）—— 本工程此前登记过
//   「hover 态从未被渲染验证」的缺口（M35b 时代遗留，见 `_工作\M35_悬停按下态_代码缺口诊断.md`）。
//   走的是与真实鼠标**同一批入口**：uiScreenHoverUpdate / uiScreenPressUpdate / uiScreenPressClear
//   （与 M46 的 `kind:"ptr"`、M47 的 `kind:"click"` 同款）。
//
//   spec 语法：`<hit元素id>[|<交叉探针元素id>][:press]`
//     · `<hit元素id>`：必带**非空 `state_group`** 的 hit —— z 最高 ⇒ 指针落在它的矩形中心必由它胜出；
//     · `|<交叉探针id>`：可选。给**另一个 `state_group`** 的 image id ⇒ 断言它**仍为 normal**（负向对照：
//       证明「组绑定是同组联动」不是「全局恒亮」）；
//     · `:press`：按住而非悬停（应取 `pressed`，否则应取 `hover`）。
//   特例：`clear` ⇒ 指针移到 (0,0) 并清按下，断言两枚模式入口的 `_glow` **回到 normal**（复位闭环）。
//   判词 `★MODESTATE★ PASS|FAIL …`；守卫 `★MODESTATE-REJECT★ …`（元素不存在 / 非 hit / 无组 / 无配对底光图）。
//   局限（如实登记，同 M46）：只证「命中 → ctx.hoverGroup/pressGroup → 选图」这条链路与事件处理器正确，
//   **不产生真实设备事件**。
// ------------------------------------------------------------
function uiScreenSyntheticModeState(spec)
{
	var s = "" + spec;
	var mode = "";
	// ⚠ TJS2 的 String **没有 `lastIndexOf`**（本批实测踩到：`未找到 Member "lastIndexOf"`）⇒
	//   用后缀判定 `:press`（与既有 `uiScreenSyntheticPointer` 用 `indexOf` 的同款约束一致）。
	if(s.length > 6 && s.substring(s.length - 6) == ":press")
	{
		mode = "press";
		s = s.substring(0, s.length - 6);
	}
	if(s == "clear")
	{
		var changed = uiScreenHoverUpdate(0, 0);
		uiScreenPressClear();
		var scC = UILayoutData.screens["flowchart"];
		var ctxC = uiScreenCtx(scC);
		var nrm = true, det = "";
		if(scC !== void && scC !== null)
		{
			for(var k = 0; k < scC.elements.count; k++)
			{
				var eC = scC.elements[k];
				var idC = "" + eC.id;
				if(idC == "fc.mode_main_glow" || idC == "fc.mode_frag_glow")
				{
					var aC = uiWidgetStateAsset(eC, ctxC);
					var wC = (eC.state_assets !== void && eC.state_assets !== null) ? eC.state_assets.normal : eC.asset;
					det += "  " + idC + " 选图=" + ("" + aC);
					if(("" + aC) != ("" + wC)) nrm = false;
				}
			}
		}
		return "★MODESTATE★ " + (nrm ? "PASS" : "FAIL")
			+ "  clear（指针移到 0,0 + 清按下）  hover变化=" + ((changed) ? 1 : 0)
			+ "  两枚 `_glow` 应回 normal：" + det + (nrm ? "" : "（**未复位**）");
	}

	var probe = "";
	var p2 = s.indexOf("|");
	if(p2 >= 0) { probe = s.substring(p2 + 1); s = s.substring(0, p2); }
	var id = s;
	if(id == "")
		return "★MODESTATE-REJECT★ spec 应为 <hit元素id>[|<交叉探针id>][:press] 或 clear，实收 " + ("" + spec);

	var sid = uiScreenCurrent();
	if(!uiScreenExists(sid)) return "★MODESTATE-REJECT★ 当前屏 " + sid + " 未登记，无法定位";
	var sc = UILayoutData.screens[sid];
	var els = sc.elements;
	var el = null;
	for(var i = 0; i < els.count; i++)
		if(("" + els[i].id) == id) { el = els[i]; break; }
	if(el === null) return "★MODESTATE-REJECT★ 当前屏 " + sid + " 无元素 " + id + "（走『元素不存在』守卫）";
	if(el.kind != "hit") return "★MODESTATE-REJECT★ " + id + " 不是 hit（kind=" + ("" + el.kind) + "）⇒ 不是指针目标";
	var grp = uiWidgetStateGroup(el);
	if(grp == "") return "★MODESTATE-REJECT★ " + id + " 无 `state_group` ⇒ 没有可联动的底光图";

	// 同组、带 `state_assets` 的 image（本屏每组合法只有一件）
	var glow = null;
	for(var j = 0; j < els.count; j++)
	{
		var e2 = els[j];
		if(e2.kind != "image") continue;
		if(uiWidgetStateGroup(e2) != grp) continue;
		if(e2.state_assets === void || e2.state_assets === null) continue;
		glow = e2;
	}
	if(glow === null)
		return "★MODESTATE-REJECT★ " + id + " 的组 " + grp + " 找不到带 `state_assets` 的同组 image";

	var cx = el.x + Math.floor(el.w / 2);
	var cy = el.y + Math.floor(el.h / 2);
	var hoverChanged = uiScreenHoverUpdate(cx, cy);
	if(mode == "press") uiScreenPressUpdate(cx, cy);
	else uiScreenPressClear();

	var ctx = uiScreenCtx(sc);
	var f = uiWidgetStateFlags(glow, ctx);
	var got = uiWidgetStateAsset(glow, ctx);
	var sa = glow.state_assets;
	var wantKey = (mode == "press") ? "pressed" : "hover";
	var want = (mode == "press") ? sa.pressed : sa.hover;
	var tok = (mode == "press") ? ctx.pressGroup : ctx.hoverGroup;
	var ok = (("" + got) == ("" + want)) && (("" + tok) == grp);
	// 交叉探针先算完（决定 ok），再拼判词 —— 判词里的 PASS/FAIL 必须与 ok **同刻同值**
	var crossTxt = "";
	if(probe != "")
	{
		var pv = null;
		for(var m = 0; m < els.count; m++)
			if(("" + els[m].id) == probe) { pv = els[m]; break; }
		if(pv === null)
		{
			crossTxt = "  ｜ ★MODESTATE-REJECT★ 交叉探针元素不存在：" + probe;
			ok = false;
		}
		else
		{
			var pg = uiWidgetStateGroup(pv);
			var pa = uiWidgetStateAsset(pv, ctx);
			var pn = (pv.state_assets !== void && pv.state_assets !== null) ? pv.state_assets.normal : pv.asset;
			var pok = (("" + pa) == ("" + pn)) && (pg != grp);
			if(!pok) ok = false;
			crossTxt = "  ｜ 交叉探针 " + probe + "（组 " + pg + "）选图=" + ("" + pa)
				+ "（期望 normal " + ("" + pn) + "）⇒ " + (pok ? "✓ 未串组" : "✗ **串组**");
		}
	}
	return "★MODESTATE★ " + (ok ? "PASS" : "FAIL")
		+ "  " + id + " 中心=" + cx + "," + cy + "（组 " + grp + "）"
		+ "  " + ((mode == "press") ? "按下" : "悬停") + " 令牌=" + ("" + tok)
		+ "  hover变化=" + ((hoverChanged) ? 1 : 0)
		+ "  " + glow.id + " 选图=" + ("" + got) + "（期望 " + ("" + want) + "）"
		+ crossTxt;
}

// ------------------------------------------------------------
// ★ M06（2026-09-24 · ISSUE-20260924-06_回想屏重排 · 冻结书 §4 第 2/3 条）：
//   **逐块按钮的合成指针 / 点击 / 守卫**（仅巡演验收用）
//
//   用途（可机检的目标级证据）：
//     ① `itembtn`  —— 第 N 行的某个按钮**中心**各自命中**自身**按钮（不是整行、不是别的块），
//        且 `backlog_replay:<行号>` / `backlog_jump:<行号>` **派发到的行号 = 所点的那一行**；
//     ② `itemrow`  —— **负向对照**：块内**非按钮区**（两按钮之间 / 块右侧文案区）命中**整行**
//        （按钮命中为「无」、悬停令牌为空、整行 action 按数据原样返回）；
//     ③ `itemguard`—— **机制守卫的负向对照**：把 `item_buttons` 逐条改坏（空 action /
//        矩形出块 / 零面积 / key 为空 / 非对象项），断言**同一个校验函数**（绘制路径用的那个）
//        逐条产出 `★M06ITEMBTN-REJECT★` 判词。**不写任何磁盘数据**（只在内存里改副本）。
//
//   走的是**真实入口**：`uiScreenHoverUpdate` / `uiScreenPressUpdate` / `uiScreenClick` /
//   `uiActionDispatch`（与真实鼠标同一批函数 —— 同 M46 的 `kind:"ptr"`、M47 的 `kind:"click"`）。
//   局限（如实登记）：只证明「命中 → 令牌 → 选图 → 派发」这条链路与事件处理器的正确性，
//   **不产生真实设备事件**（同 M13 合成鼠标 / M46 合成指针的既有局限）。
// ------------------------------------------------------------

// `itembtn`：spec = `<list元素id>:<行号>:<按钮key>[:press]` ｜ 判词 `★M06BTN★ PASS|FAIL`
function uiScreenSyntheticItemBtn(spec)
{
	var s = "" + spec;
	var p1 = s.indexOf(":");
	if(p1 <= 0) return "★M06BTN-REJECT★ spec 应为 <list元素id>:<行号>:<按钮key>[:press]，实收 " + s;
	var id = s.substring(0, p1);
	var rest = s.substring(p1 + 1);
	var p2 = rest.indexOf(":");
	if(p2 < 0) return "★M06BTN-REJECT★ spec 缺按钮 key（应为 <list元素id>:<行号>:<按钮key>[:press]）：" + s;
	var rowS = rest.substring(0, p2);
	rest = rest.substring(p2 + 1);
	var mode = "";
	var p3 = rest.indexOf(":");
	if(p3 >= 0) { mode = rest.substring(p3 + 1); rest = rest.substring(0, p3); }
	var key = rest;
	if(key == "") return "★M06BTN-REJECT★ 按钮 key 不得为空：" + s;
	if(mode != "" && mode != "press") return "★M06BTN-REJECT★ 模式只允许空串或 press，实收 " + mode;
	var row = uiScreenRowNumber(rowS);
	if(row < 0) return "★M06BTN-REJECT★ 行号非「非负十进制整数」：" + rowS;

	var sid = uiScreenCurrent();
	if(!uiScreenExists(sid)) return "★M06BTN-REJECT★ 当前屏 " + sid + " 未登记，无法定位";
	var sc = UILayoutData.screens[sid];
	var els = sc.elements;
	var el = null;
	for(var i = 0; i < els.count; i++)
		if(("" + els[i].id) == id) { el = els[i]; break; }
	if(el === null) return "★M06BTN-REJECT★ 当前屏 " + sid + " 无元素 " + id + "（走『元素不存在』守卫）";
	if(el.kind != "list") return "★M06BTN-REJECT★ " + id + " 不是 list（kind=" + ("" + el.kind) + "）";
	var arr = uiWidgetItemButtons(el);
	if(arr === null) return "★M06BTN-REJECT★ " + id + " 未声明 item_buttons（逐块按钮）";
	// 机制守卫（**与绘制路径共用同一校验函数**）—— 非法结构在这里也必须被挡下并打判词
	var probs = uiWidgetItemButtonProblems(el);
	for(var q = 0; q < probs.count; q++)
		uiWidgetItemBtnReject(id, probs[q].key, probs[q].reason);

	var pg = UIScrPage[id];
	if(pg === void) pg = 0;
	var pgi = uiWidgetListPage(el, pg);
	var local = row - pgi.first;
	if(local < 0 || local >= pgi.visibleCount)
		return "★M06BTN-REJECT★ 行号 " + row + " 不在本页可见范围（本页 "
			+ pgi.first + ".." + (pgi.first + pgi.visibleCount - 1) + "）";
	var bi = -1;
	for(var k2 = 0; k2 < arr.count; k2++)
		if(("" + arr[k2].key) == key) { bi = k2; break; }
	if(bi < 0) return "★M06BTN-REJECT★ " + id + " 无按钮 key=" + key
		+ "（现有：" + uiScreenItemBtnKeyList(arr) + "）";
	for(var q2 = 0; q2 < probs.count; q2++)
		if(("" + probs[q2].key) == key)
			return "★M06BTN-REJECT★ " + id + "[" + key + "] 结构非法：" + probs[q2].reason;

	var br = uiWidgetItemButtonRect(el, local, bi);
	var cx = br.x + Math.floor(br.w / 2);
	var cy = br.y + Math.floor(br.h / 2);
	var wantTok = uiWidgetItemBtnToken(id, row, key);
	var sa = arr[bi].state_assets;
	var wantHover = (sa !== void && sa !== null && sa.hover !== void) ? ("" + sa.hover) : ("" + arr[bi].asset);
	var wantPress = (sa !== void && sa !== null && sa.pressed !== void) ? ("" + sa.pressed) : wantHover;

	// ---- ① 悬停（真实入口）----
	var hoverChanged = uiScreenHoverUpdate(cx, cy);
	var hoverTok = UIScrHoverBtn;
	var ctxH = %[ hoverBtn: UIScrHoverBtn, pressBtn: UIScrPressBtn ];
	var stHover = uiWidgetItemButtonState(el, ctxH, row, key);
	var assetHover = "" + uiWidgetItemButtonAsset(arr[bi], stHover);
	var okHover = (hoverTok == wantTok) && (stHover == "hover") && (assetHover == wantHover);

	// ---- ② 按下（真实入口；锚定在被按的那**一个按钮**上）----
	uiScreenPressUpdate(cx, cy);
	var ctxP = %[ hoverBtn: UIScrHoverBtn, pressBtn: UIScrPressBtn ];
	var stPress = uiWidgetItemButtonState(el, ctxP, row, key);
	var assetPress = "" + uiWidgetItemButtonAsset(arr[bi], stPress);
	var okPress = (stPress == "pressed") && (assetPress == wantPress);

	// ---- ③ 点击 + 派发（真实入口；`%row%` 必须换成**点中的那一行**）----
	var r = uiScreenClick(void, cx, cy);
	var gotAct = (r.action === void) ? "" : ("" + r.action);
	var gotIdx = (r.index === void) ? -1 : r.index;
	var wantAct = uiScreenRowAction(arr[bi].action, row);
	var dispMsg = "";
	if(gotAct != "")
	{
		var res = uiActionDispatch(gotAct, gotIdx);
		dispMsg = (res.msg === void) ? "" : ("" + res.msg);
	}
	var okClick = (gotAct == wantAct) && (gotIdx == row)
		&& (UIScrBacklogLastAct == wantAct) && (UIScrBacklogLastRow == row);

	// ---- ④ 抬起（非 press 模式释放；press 模式留在画面上供导图目视）----
	if(mode != "press") uiScreenPressClear();

	var ok = okHover && okPress && okClick;
	return "★M06BTN★ " + (ok ? "PASS" : "FAIL")
		+ "  " + id + " 行=" + row + " 键=" + key + " 中心=" + cx + "," + cy
		+ "  命中令牌=" + ((hoverTok == "") ? "(无)" : hoverTok) + "（期望 " + wantTok + "）"
		+ "  悬停态=" + ((stHover == "") ? "(normal)" : stHover) + "（期望 hover）"
		+ "选图=" + assetHover + "（期望 " + wantHover + "）"
		+ "  按下态=" + ((stPress == "") ? "(normal)" : stPress) + "（期望 pressed）"
		+ "选图=" + assetPress + "（期望 " + wantPress + "）"
		+ "  派发=" + ((gotAct == "") ? "(空)" : gotAct) + "（期望 " + wantAct + "）"
		+ "  派发行号=" + UIScrBacklogLastRow + "（期望 " + row + "）"
		+ "  hover变化=" + (hoverChanged ? 1 : 0)
		+ (dispMsg == "" ? "" : "  msg=" + dispMsg);
}

function uiScreenItemBtnKeyList(arr)
{
	var out = [];
	for(var i = 0; i < arr.count; i++)
	{
		var b = arr[i];
		if(b === void || b === null || typeof b != "Object") { out.push("(非对象)"); continue; }
		out.push("" + b.key);
	}
	return out.join("/");
}

// `itemrow`：spec = `<list元素id>:<行号>:<dx>,<dy>`（块内局部点）｜ 判词 `★M06ROW★ PASS|FAIL`
//   **负向对照**：块内非按钮区必须命中**整行**（按钮命中 = 无、按钮悬停令牌 = 空），
//   且 `uiScreenClick` 返回的行号是所点的那一行、action 是**数据里的整行 action**
//   （回想屏数据为 `""` ⇒ 按既有契约「允许空 action」不派发 —— 这本身就是空 action 守卫的证据）。
function uiScreenSyntheticItemRow(spec)
{
	var s = "" + spec;
	var p1 = s.indexOf(":");
	if(p1 <= 0) return "★M06ROW-REJECT★ spec 应为 <list元素id>:<行号>:<dx>,<dy>，实收 " + s;
	var id = s.substring(0, p1);
	var rest = s.substring(p1 + 1);
	var p2 = rest.indexOf(":");
	if(p2 < 0) return "★M06ROW-REJECT★ spec 缺局部坐标（应为 <list元素id>:<行号>:<dx>,<dy>）：" + s;
	var rowS = rest.substring(0, p2);
	var xyS = rest.substring(p2 + 1);
	var comma = xyS.indexOf(",");
	if(comma < 0) return "★M06ROW-REJECT★ 局部坐标应为 <dx>,<dy>：" + xyS;
	var dx = uiFlowAtoi(xyS.substring(0, comma));
	var dy = uiFlowAtoi(xyS.substring(comma + 1));
	var row = uiScreenRowNumber(rowS);
	if(row < 0) return "★M06ROW-REJECT★ 行号非「非负十进制整数」：" + rowS;

	var sid = uiScreenCurrent();
	if(!uiScreenExists(sid)) return "★M06ROW-REJECT★ 当前屏 " + sid + " 未登记，无法定位";
	var els = UILayoutData.screens[sid].elements;
	var el = null;
	for(var i = 0; i < els.count; i++)
		if(("" + els[i].id) == id) { el = els[i]; break; }
	if(el === null) return "★M06ROW-REJECT★ 当前屏 " + sid + " 无元素 " + id;
	if(el.kind != "list") return "★M06ROW-REJECT★ " + id + " 不是 list（kind=" + ("" + el.kind) + "）";

	var pg = UIScrPage[id];
	if(pg === void) pg = 0;
	var pgi = uiWidgetListPage(el, pg);
	var local = row - pgi.first;
	if(local < 0 || local >= pgi.visibleCount)
		return "★M06ROW-REJECT★ 行号 " + row + " 不在本页可见范围（本页 "
			+ pgi.first + ".." + (pgi.first + pgi.visibleCount - 1) + "）";
	var ir = uiWidgetListItemRect(el, local);
	if(dx < 0 || dy < 0 || dx >= ir.w || dy >= ir.h)
		return "★M06ROW-REJECT★ 局部点 " + dx + "," + dy + " 不在项矩形 " + ir.w + "×" + ir.h + " 内";
	var px = ir.x + dx, py = ir.y + dy;

	uiScreenHoverUpdate(px, py);
	var bt = uiWidgetItemButtonAt(el, px, py, pg);
	var hitRow = uiWidgetListHit(el, px, py, pg);
	var r = uiScreenClick(void, px, py);
	var gotAct = (r.action === void) ? "" : ("" + r.action);
	var gotIdx = (r.index === void) ? -1 : r.index;
	var rowAct = (el.actions === void || el.actions === null) ? "" : ("" + el.actions[row]);
	var dispMsg = "";
	if(gotAct != "")
	{
		var res = uiActionDispatch(gotAct, gotIdx);
		dispMsg = (res.msg === void) ? "" : ("" + res.msg);
	}
	var ok = (bt === null) && (UIScrHoverBtn == "") && (hitRow == row)
		&& (gotIdx == row) && (gotAct == rowAct);
	return "★M06ROW★ " + (ok ? "PASS" : "FAIL")
		+ "  " + id + " 行=" + row + " 局部点=" + dx + "," + dy + " 画布点=" + px + "," + py
		+ "  按钮命中=" + ((bt === null) ? "(无，期望无)" : ("★有 " + bt.key + "（期望无）"))
		+ "  按钮悬停令牌=" + ((UIScrHoverBtn == "") ? "(空)" : UIScrHoverBtn)
		+ "  整行命中行号=" + hitRow + "（期望 " + row + "）"
		+ "  点击返回=" + ((gotAct == "") ? "(空)" : gotAct) + " 行号=" + gotIdx + "（期望 " + row + "）"
		+ "  数据整行动作=" + ((rowAct == "") ? "(空 ⇒ 按契约不派发)" : rowAct)
		+ (dispMsg == "" ? "" : "  msg=" + dispMsg);
}

// `itemguard`：spec = `<list元素id>` ｜ 判词 `★M06GUARD★ PASS|FAIL`
//   **机制守卫的负向对照**：把该 list 的 `item_buttons` 逐条改坏（**只在内存里改副本，
//   不写任何磁盘数据**），断言 `uiWidgetItemButtonProblems`（= 绘制路径调用的是同一个函数）
//   逐条给出预期的拒绝理由，且 `★M06ITEMBTN-REJECT★` 判词条数按预期增长。
function uiScreenSyntheticItemGuard(spec)
{
	var id = "" + spec;
	if(id == "") return "★M06GUARD-REJECT★ spec 应为 <list元素id>，实收空串";
	var sid = uiScreenCurrent();
	if(!uiScreenExists(sid)) return "★M06GUARD-REJECT★ 当前屏 " + sid + " 未登记，无法定位";
	var els = UILayoutData.screens[sid].elements;
	var el = null;
	for(var i = 0; i < els.count; i++)
		if(("" + els[i].id) == id) { el = els[i]; break; }
	if(el === null) return "★M06GUARD-REJECT★ 当前屏 " + sid + " 无元素 " + id;
	if(el.kind != "list") return "★M06GUARD-REJECT★ " + id + " 不是 list（kind=" + ("" + el.kind) + "）";
	var arr = uiWidgetItemButtons(el);
	if(arr === null || arr.count <= 0) return "★M06GUARD-REJECT★ " + id + " 无 item_buttons 可取样本";
	if(uiWidgetItemButtonProblems(el).count > 0)
		return "★M06GUARD-REJECT★ " + id + " 的真实 item_buttons 本身已非法，无法作为守卫自证样本";

	// 取第 0 条按钮做样本，逐条改坏（**内存副本**；字段显式列举，避免共享引用）。
	//   ⚠️ **不用嵌套函数**：TJS2（krkrz 1.4.0.8 / TJS2 2.4.28）在这里**不做闭包捕获** ——
	//   写成 `function guardBtn(){ … arr … }` 时 `arr` 会在**全局**作用域找，实测直接抛
	//   `An exception occured at ui_screens.tjs[(function) guardBtn]` → 巡演当场中止。
	//   故全部展开在循环体内（下面 `cases` 的每条按 `mut` 逐字段改）。
	var cases = [
		%[ name: "空 action",    mut: "emptyact",  want: "action 为空" ],
		%[ name: "矩形出块",     mut: "outblock",  want: "矩形出块" ],
		%[ name: "矩形零面积",   mut: "zerorect",  want: "零/负面积" ],
		%[ name: "key 为空",     mut: "nokey",     want: "缺 key" ],
		%[ name: "非对象项",     mut: "notobject", want: "不是对象" ]
	];
	var b0 = arr[0];
	var baseKey = (b0.key === void || b0.key === null) ? "" : ("" + b0.key);
	var baseAct = (b0.action === void || b0.action === null) ? "" : ("" + b0.action);
	var baseAsset = (b0.asset === void || b0.asset === null) ? void : ("" + b0.asset);
	var before = UIWidgetItemBtnRejectLines.count;
	var lines = [];
	var okAll = true;
	for(var c = 0; c < cases.count; c++)
	{
		var cs = cases[c];
		var mut = "" + cs.mut;
		var eKey = baseKey, eX = uiWidgetNum(b0, "x", 0), eY = uiWidgetNum(b0, "y", 0);
		var eW = uiWidgetNum(b0, "w", 0), eH = uiWidgetNum(b0, "h", 0), eAct = baseAct;
		if(mut == "emptyact")      eAct = "";
		else if(mut == "outblock") { eX = 1300; eY = 190; eW = 200; eH = 60; }
		else if(mut == "zerorect") { eW = 0; eH = 0; }
		else if(mut == "nokey")    eKey = "";
		var entry = %[ key: eKey, x: eX, y: eY, w: eW, h: eH, action: eAct ];
		if(baseAsset !== void) entry.asset = baseAsset;
		if(mut == "notobject") entry = "oops";     // 非对象项：整条替换成字符串
		var e2 = %[ id: id, kind: "list",
			orientation: (el.orientation !== void) ? el.orientation : "v",
			item_h: uiWidgetNum(el, "item_h", 0),
			w: uiWidgetNum(el, "w", 0) ];
		if(el.item_w !== void) e2.item_w = uiWidgetNum(el, "item_w", 0);
		e2.item_buttons = [entry];
		var pr = uiWidgetItemButtonProblems(e2);
		var got = (pr.count > 0) ? ("" + pr[0].reason) : "(无拒绝)";
		var okc = (pr.count > 0) && (got.indexOf("" + cs.want) >= 0);
		if(!okc) okAll = false;
		if(pr.count > 0) uiWidgetItemBtnReject(id, pr[0].key, got);    // 与绘制路径同一判词出口
		lines.push(cs.name + "→" + got + (okc ? " ✓" : " ✗（期望含「" + cs.want + "」）"));
	}
	var grew = UIWidgetItemBtnRejectLines.count - before;
	var ok = okAll && (grew >= 1);
	return "★M06GUARD★ " + (ok ? "PASS" : "FAIL")
		+ "  " + id + " 注入 " + cases.count + " 例（内存副本，未写磁盘）→ "
		+ lines.join(" ｜ ")
		+ "  ｜ REJECT 判词新增 " + grew + " 条（合计 " + UIWidgetItemBtnRejectLines.count + "）";
}

// `itempage`：spec = `<list元素id>:<max_rows>:<全局行号>:<按钮key>` ｜ 判词 `★M06PAGE★ PASS|FAIL`
//   **分页/滚动后按钮随块走**（冻结书 §2 第 5 条）：把该 list 的 `max_rows` **临时**改小（内存副本，
//   不写磁盘）⇒ 页数变多，翻到「含目标行的那一页」后，**同一屏坐标上的按钮**必须属于**目标行**
//   （全局序号 = 行号），且点击派发的还是该行的动作。这正是「逐项渲染 ⇒ 按钮天然随块走」的机检。
function uiScreenSyntheticItemPage(spec)
{
	var s = "" + spec;
	var parts = s.split(":");
	if(parts.count != 4) return "★M06PAGE-REJECT★ spec 应为 <list元素id>:<max_rows>:<全局行号>:<按钮key>，实收 " + s;
	var id = parts[0], mrS = parts[1], rowS = parts[2], key = parts[3];
	var sid = uiScreenCurrent();
	if(!uiScreenExists(sid)) return "★M06PAGE-REJECT★ 当前屏 " + sid + " 未登记，无法定位";
	var els = UILayoutData.screens[sid].elements;
	var el = null;
	for(var i = 0; i < els.count; i++)
		if(("" + els[i].id) == id) { el = els[i]; break; }
	if(el === null) return "★M06PAGE-REJECT★ 当前屏 " + sid + " 无元素 " + id;
	if(el.kind != "list") return "★M06PAGE-REJECT★ " + id + " 不是 list（kind=" + ("" + el.kind) + "）";
	var arr = uiWidgetItemButtons(el);
	if(arr === null) return "★M06PAGE-REJECT★ " + id + " 未声明 item_buttons（逐块按钮）";
	var mr = uiScreenRowNumber(mrS), row = uiScreenRowNumber(rowS);
	if(mr <= 0) return "★M06PAGE-REJECT★ max_rows 非法：" + mrS;
	if(row < 0) return "★M06PAGE-REJECT★ 行号非法：" + rowS;
	var nLab = (el.labels === void) ? 0 : el.labels.count;
	if(row >= nLab) return "★M06PAGE-REJECT★ 行号 " + row + " 超出 labels（0.." + (nLab - 1) + "）";
	var bi = -1;
	for(var k2 = 0; k2 < arr.count; k2++)
		if(("" + arr[k2].key) == key) { bi = k2; break; }
	if(bi < 0) return "★M06PAGE-REJECT★ " + id + " 无按钮 key=" + key
		+ "（现有：" + uiScreenItemBtnKeyList(arr) + "）";
	var probs = uiWidgetItemButtonProblems(el);
	for(var q = 0; q < probs.count; q++)
		if(("" + probs[q].key) == key)
			return "★M06PAGE-REJECT★ " + id + "[" + key + "] 结构非法：" + probs[q].reason;

	// ---- 临时改小 max_rows 并翻到含目标行的那一页（**内存副本，退出时逐字段还原**）----
	var keepMR = el.max_rows;
	var keepPage = (UIScrPage[id] === void) ? 0 : UIScrPage[id];
	var page = Math.floor(row / mr);
	el.max_rows = mr;
	UIScrPage[id] = page;
	var pg = uiWidgetListPage(el, page);
	var local = row - pg.first;
	if(local < 0 || local >= pg.visibleCount)
	{
		el.max_rows = keepMR; UIScrPage[id] = keepPage;
		return "★M06PAGE-REJECT★ 行 " + row + " 不在第 " + page + " 页可见范围（本页 "
			+ pg.first + ".." + (pg.first + pg.visibleCount - 1) + "）";
	}
	var br = uiWidgetItemButtonRect(el, local, bi);
	var cx = br.x + Math.floor(br.w / 2);
	var cy = br.y + Math.floor(br.h / 2);
	var yLocal0 = uiWidgetListItemRect(el, 0).y;      // 第 0 行在本页的 y（= 屏上第一块）

	uiScreenHoverUpdate(cx, cy);
	var tok = UIScrHoverBtn;
	var wantTok = uiWidgetItemBtnToken(id, row, key);
	var r = uiScreenClick(void, cx, cy);
	var gotAct = (r.action === void) ? "" : ("" + r.action);
	var gotIdx = (r.index === void) ? -1 : r.index;
	var wantAct = uiScreenRowAction(arr[bi].action, row);
	var dispMsg = "";
	if(gotAct != "")
	{
		var res = uiActionDispatch(gotAct, gotIdx);
		dispMsg = (res.msg === void) ? "" : ("" + res.msg);
	}
	uiScreenPressClear();
	el.max_rows = keepMR;                              // 还原
	UIScrPage[id] = keepPage;
	uiScreenHoverUpdate(-1, -1);                       // 收尾：指针位置与悬停令牌归位

	var ok = (tok == wantTok) && (gotAct == wantAct) && (gotIdx == row) && (UIScrBacklogLastRow == row);
	return "★M06PAGE★ " + (ok ? "PASS" : "FAIL")
		+ "  " + id + " 临时 max_rows=" + mr + " ⇒ 共 " + pg.pages + " 页，翻到第 " + page
		+ " 页（全局行 " + pg.first + ".." + (pg.first + pg.visibleCount - 1) + "）"
		+ "  目标行=" + row + " 键=" + key + " 中心=" + cx + "," + cy
		+ "（本页第 0 块 y=" + yLocal0 + "）"
		+ "  命中令牌=" + ((tok == "") ? "(无)" : tok) + "（期望 " + wantTok + "）"
		+ "  派发=" + ((gotAct == "") ? "(空)" : gotAct) + "（期望 " + wantAct + "）"
		+ "  派发行号=" + UIScrBacklogLastRow + "（期望 " + row + "）"
		+ "  ★ 同一屏坐标上的按钮随页归属到**目标行**（逐项渲染 ⇒ 按钮随块走）"
		+ (dispMsg == "" ? "" : "  msg=" + dispMsg);
}

// ------------------------------------------------------------
// ★ M1（2026-09-24 · ISSUE-20260924-08_鉴赏模式）：四条**目标级**巡演步骤
//   全部走**真实入口**（`uiActionDispatch` / `uiScreenHoverUpdate` / `uiScreenPressUpdate` /
//   `uiScreenClick` —— 与真实鼠标同一批函数），判词直接写进巡演日志，可机检。
//   判词：`★M08TAB★` / `★M08PAGE★` / `★M08VAR★` / `★M08GUARD★`（负向为 `…-REJECT★`）。
// ------------------------------------------------------------

// `galtab`：spec = `<1..4>`（正例）｜ `bad`（负例：未知页签必须被守卫挡下）
//   **切屏口径验收**：① 当前屏 = 目标屏；② **上一页完全不在栈里**（同级换屏）；
//   ③ 外壳页签 flag `gal_tab` = 目标屏；④ 目标屏有元素（真的画得出来）。
function uiScreenSyntheticGalTab(spec)
{
	var s = "" + spec;
	var neg = (s == "bad");
	var n = uiScreenRowNumber(s);
	if(!neg && (n < 1 || n > 4))
		return "★M08TAB-REJECT★ spec 应为 1..4 或 bad，实收 " + s;
	var act = neg ? "gallery_tab_9" : ("gallery_tab_" + n);
	var want = uiScreenMapGalleryTab(act);
	var sid = uiScreenCurrent();
	if(!uiScreenExists(sid)) return "★M08TAB-REJECT★ 当前屏 " + sid + " 未登记，无法定位";
	var from = sid;
	var stackBefore = uiScreenStackText();
	if(uiScreenAttachIdCurrent() != UIScrGalleryShellId)
		return "★M08TAB-REJECT★ 当前屏 " + sid + " 未挂鉴赏外壳（attach != " + UIScrGalleryShellId
			+ "）⇒ 切屏步骤无意义（请先进入鉴赏模式）";
	if(neg)
	{
		var cnt0 = UIScrGalActCount;
		var r0 = uiActionDispatch(act, 0);
		var m0 = (r0.msg === void) ? "" : ("" + r0.msg);
		var rejected = (m0.indexOf("★M08TAB-REJECT★") >= 0);
		var ok0 = rejected && (uiScreenCurrent() == from) && (UIScrGalActCount == cnt0);
		return "★M08TAB★ " + (ok0 ? "PASS" : "FAIL")
			+ "  负向对照：派发 " + act + " ⇒ " + ((m0 == "") ? "(无 msg)" : m0)
			+ "；当前屏仍=" + uiScreenCurrent() + "（期望 " + from + "）"
			+ "；派发计数 " + cnt0 + " -> " + UIScrGalActCount + "（期望不变）";
	}
	var cnt1 = UIScrGalActCount;
	var r = uiActionDispatch(act, 0);
	var msg = (r.msg === void) ? "" : ("" + r.msg);
	var now = uiScreenCurrent();
	var stackAfter = uiScreenStackText();
	var inStack = false;
	var parts = stackAfter.split(" > ");
	for(var i = 0; i < parts.count; i++)
		if(("" + parts[i]) == from) inStack = true;
	var nel = 0;
	if(uiScreenExists(now)) nel = UILayoutData.screens[now].elements.count;
	var tabFlag = uiScreenFlagGet(UIScrGalleryTabFlag);
	var ok = (now == want) && (!inStack) && (tabFlag == want) && (nel > 0)
		&& (UIScrGalActCount == cnt1 + 1) && (UIScrGalLastTab == want);
	return "★M08TAB★ " + (ok ? "PASS" : "FAIL")
		+ "  " + act + "：" + from + " → " + now + "（期望 " + want + "）"
		+ "  栈 " + stackBefore + " ⇒ " + stackAfter
		+ "  上一屏仍在栈里=" + (inStack ? "★是（期望否）" : "否")
		+ "  目标屏元素数=" + nel + "（期望 >0）"
		+ "  " + UIScrGalleryTabFlag + "=" + ((tabFlag == "") ? "(空)" : tabFlag)
		+ "（期望 " + want + "）"
		+ "  派发计数 " + cnt1 + " -> " + UIScrGalActCount
		+ (msg == "" ? "" : "  msg=" + msg);
}

// `galpage`：spec = `<list元素id>:<prev|next>` ｜ 判词 `★M08PAGE★ PASS|FAIL`
//   页内翻页：断言页码按 ±1 变（到边界钳制），且翻页后**本页第一栏的全局序号 = page×perPage**。
function uiScreenSyntheticGalPage(spec)
{
	var s = "" + spec;
	var p1 = s.indexOf(":");
	if(p1 <= 0) return "★M08PAGE-REJECT★ spec 应为 <list元素id>:<prev|next>，实收 " + s;
	var id = s.substring(0, p1);
	var dir = s.substring(p1 + 1);
	if(dir != "prev" && dir != "next")
		return "★M08PAGE-REJECT★ 方向只认 prev|next，实收 " + dir;
	if(id == "auto") id = uiScreenFirstListId();       // ★ 页内翻页的目标可自动取当前屏第一个可见 list
	if(id == "") return "★M08PAGE-REJECT★ 当前屏 " + uiScreenCurrent() + " 没有可见的 list（auto 取不到）";
	var sid = uiScreenCurrent();
	if(!uiScreenExists(sid)) return "★M08PAGE-REJECT★ 当前屏 " + sid + " 未登记，无法定位";
	var el = uiScreenElById(sid, id);
	if(el === null) return "★M08PAGE-REJECT★ 当前屏 " + sid + " 无元素 " + id;
	if(el.kind != "list") return "★M08PAGE-REJECT★ " + id + " 不是 list（kind=" + ("" + el.kind) + "）";
	var act = (dir == "next") ? "gallery_page_next" : "gallery_page_prev";
	var before = UIScrPage[id];
	if(before === void || before === null) before = 0;
	var pi0 = uiWidgetListPage(el, before);
	var cnt0 = UIScrGalActCount;
	var r = uiActionDispatch(act, 0);
	var msg = (r.msg === void) ? "" : ("" + r.msg);
	var after = UIScrPage[id];
	if(after === void || after === null) after = 0;
	var pi1 = uiWidgetListPage(el, after);
	var wantPage = before + ((dir == "next") ? 1 : -1);
	if(wantPage < 0) wantPage = 0;
	if(wantPage > pi0.pages - 1) wantPage = pi0.pages - 1;
	// 翻页后本页第一栏的全局序号必须是 page×perPage（内容与数据对应）
	var firstGlobal = pi1.first;
	var wantFirst = pi1.page * pi1.perPage;
	// ★ M8 一审 R3（2026-09-24）：翻页后**页码 flag** 必须同步成 1 基页号（该屏声明了 page_flag 才判）
	var gpflag = uiScreenPageFlagOf(sid);
	var flagNow = (gpflag == "") ? "" : uiScreenFlagGet(gpflag);
	var flagOk = (gpflag == "") || (flagNow == "" + (after + 1));
	var ok = (after == wantPage) && (firstGlobal == wantFirst) && flagOk
		&& (UIScrGalActCount == cnt0 + 1) && (pi1.total == pi0.total);
	return "★M08PAGE★ " + (ok ? "PASS" : "FAIL")
		+ "  " + act + "：" + id + " 第 " + (before + 1) + "/" + pi0.pages + " 页 → 第 "
		+ (after + 1) + "/" + pi1.pages + " 页（期望第 " + (wantPage + 1) + " 页）"
		+ "  每页 " + pi1.perPage + " 栏 / 共 " + pi1.total + " 栏"
		+ "  本页首栏全局序号=" + firstGlobal + "（期望 " + wantFirst + "）"
		+ (gpflag == "" ? "" : "  页码flag " + gpflag + "=" + flagNow + "（期望 " + (after + 1) + "）")
		+ (msg == "" ? "" : "  msg=" + msg);
}

// `galpageassert`：spec = `<期望 1 基页号>` ｜ 判词 `★M08PAGE★ PASS|FAIL`
//   ★ M8 一审 R3 + 主代理追认项⑥（2026-09-24）：**只读断言**，不派发任何动作 ——
//   断言 ① 当前屏第一个可见 list 的页码 = 期望页号 − 1；② 该屏声明了 `page_flag` 时，
//   flag 值 = 期望页号（1 基字符串）。给「翻页后 flag 同步」（R3）与「重进归零」（⑥）作机检。
function uiScreenSyntheticGalPageAssert(spec)
{
	var s = "" + spec;
	var want = uiScreenRowNumber(s);
	if(want < 1) return "★M08PAGE-REJECT★ spec 应为 ≥1 的页号（1 基），实收 " + s;
	var sid = uiScreenCurrent();
	if(!uiScreenExists(sid)) return "★M08PAGE-REJECT★ 当前屏 " + sid + " 未登记";
	var id = uiScreenFirstListId();
	if(id == "") return "★M08PAGE-REJECT★ 当前屏 " + sid + " 没有可见的 list（无法取页码）";
	var pg = UIScrPage[id];
	if(pg === void || pg === null) pg = 0;
	var gpflag = uiScreenPageFlagOf(sid);
	var flagNow = (gpflag == "") ? "" : uiScreenFlagGet(gpflag);
	var pageOk = (pg == want - 1);
	var flagOk = (gpflag == "") || (flagNow == "" + want);
	var ok = pageOk && flagOk;
	return "★M08PAGE★ " + (ok ? "PASS" : "FAIL")
		+ "  页码断言（只读）：" + id + " 实际第 " + (pg + 1) + " 页（期望 " + want + "）"
		+ (gpflag == "" ? "  该屏未声明 page_flag（跳过 flag 断言）"
			: "  页码flag " + gpflag + "=" + ((flagNow == "") ? "(空)" : flagNow) + "（期望 " + want + "）");
}

// `galvar`：spec = `<list元素id>:<全局行号>:<prev|next>` ｜ 判词 `★M08VAR★ PASS|FAIL`
//   **栏位内差分翻页**（本轮核心）：走真实入口（合成指针 → 按下 → 点击 → 派发），断言
//   ① 命中的令牌 = `<list>:<行>:<按钮key>`（不是整行、不是别的栏）；
//   ② `uiScreenClick` 返回的 action = 数据里的 `gallery_prev/next:%row%` 且行号换成**该栏**；
//   ③ 翻页后**该栏缩略图素材确实换图**（frames[row][idx] 变了）；
//   ④ `n/N` 文本随之更新（引擎绘制的字符串由同一套数据算出）；
//   ⑤ 到边界时**钳制**（序号不变、仍派发）。
function uiScreenSyntheticGalVar(spec)
{
	var s = "" + spec;
	var parts = s.split(":");
	if(parts.count != 3)
		return "★M08VAR-REJECT★ spec 应为 <list元素id>:<全局行号>:<prev|next>，实收 " + s;
	var id = parts[0], rowS = parts[1], which = parts[2];
	if(which != "prev" && which != "next")
		return "★M08VAR-REJECT★ 方向只认 prev|next，实收 " + which;
	// ★ `auto` 的 list id：自动取当前屏**第一个带 item_variants 的可见 list**
	//   （M2/M3/M4 的元素 id 由各模块定，机制侧不写死 ⇒ 数据改名不必改脚本）
	if(id == "auto") id = uiScreenVariantListId();
	if(id == "") return "★M08VAR-REJECT★ 当前屏 " + uiScreenCurrent() + " 没有带 item_variants 的可见 list（auto 取不到）";
	var row = -1;
	if(rowS == "auto") row = -2;                        // 见下：自动挑一栏（N≥2）
	else
	{
		row = uiScreenRowNumber(rowS);
		if(row < 0) return "★M08VAR-REJECT★ 行号非「非负十进制整数」：" + rowS;
	}
	var sid = uiScreenCurrent();
	if(!uiScreenExists(sid)) return "★M08VAR-REJECT★ 当前屏 " + sid + " 未登记，无法定位";
	var el = uiScreenElById(sid, id);
	if(el === null) return "★M08VAR-REJECT★ 当前屏 " + sid + " 无元素 " + id;
	if(el.kind != "list") return "★M08VAR-REJECT★ " + id + " 不是 list（kind=" + ("" + el.kind) + "）";
	var vv = uiWidgetItemVariants(el);
	if(vv === null) return "★M08VAR-REJECT★ " + id + " 未声明 item_variants（栏位内差分）";
	var probs = uiWidgetItemVariantProblems(el);
	if(probs.count > 0)
		return "★M08VAR-REJECT★ " + id + " 的 item_variants 结构非法：" + probs[0].reason;
	var pg = UIScrPage[id];
	if(pg === void || pg === null) pg = 0;
	var pgi = uiWidgetListPage(el, pg);
	// `auto`：在本页可见栏里挑**第一栏 N≥2**（保证「确实换图」这一条可判），
	//   并把序号预置到**非钳制的一端**（next ⇒ 0；prev ⇒ N-1）。
	if(row == -2)
	{
		for(var a = 0; a < pgi.visibleCount; a++)
		{
			var g0 = pgi.first + a;
			if(uiWidgetItemVariantRowProblem(el, g0) != "") continue;
			var f0 = uiWidgetVariantFramesRow(el, g0);
			if(f0 === null || f0.count < 2) continue;
			row = g0;
			break;
		}
		if(row < 0)
			return "★M08VAR-REJECT★ " + id + " 本页可见栏里没有 N≥2 的栏（无法验「确实换图」）";
	}
	var rp = uiWidgetItemVariantRowProblem(el, row);
	if(rp != "") return "★M08VAR-REJECT★ " + id + "[" + row + "] " + rp;
	var fr = uiWidgetVariantFramesRow(el, row);
	if(fr === null || fr.count == 0)
		return "★M08VAR-REJECT★ " + id + " 第 " + row + " 栏没有差分内容（留空）";
	var specBtn = (which == "prev") ? vv.prev : vv.next;
	if(specBtn === void || specBtn === null || typeof specBtn != "Object")
		return "★M08VAR-REJECT★ " + id + " 未声明 item_variants." + which;
	var bkey = uiWidgetVariantBtnKey(specBtn, which);
	var local = row - pgi.first;
	if(local < 0 || local >= pgi.visibleCount)
		return "★M08VAR-REJECT★ 行 " + row + " 不在本页可见范围（本页 " + pgi.first + ".."
			+ (pgi.first + pgi.visibleCount - 1) + "）";
	var br = uiWidgetVariantRect(el, local, which);
	if(br === null) return "★M08VAR-REJECT★ " + id + " 取不到 " + which + " 的矩形";
	var cx = br.x + Math.floor(br.w / 2);
	var cy = br.y + Math.floor(br.h / 2);
	var n = fr.count;
	// auto 模式：把序号预置到非钳制的一端（保证这次点击**必然**换图）
	if(rowS == "auto") uiScreenVarIdxSet(id, row, (which == "next") ? 0 : (n - 1));
	var idx0 = uiScreenVarIdxGet(id, row);
	if(idx0 < 0) idx0 = 0;
	if(idx0 >= n) idx0 = n - 1;
	var asset0 = "" + fr[idx0];
	var text0 = "" + (idx0 + 1) + "/" + n;

	uiScreenHoverUpdate(cx, cy);
	var tok = UIScrHoverBtn;
	var wantTok = uiWidgetVariantBtnToken(id, row, bkey);
	var stHover = uiWidgetItemButtonState(el, uiScreenCtx(UILayoutData.screens[sid]), row, bkey);
	uiScreenPressUpdate(cx, cy);
	var stPress = uiWidgetItemButtonState(el, uiScreenCtx(UILayoutData.screens[sid]), row, bkey);
	var r = uiScreenClick(void, cx, cy);
	var gotAct = (r.action === void) ? "" : ("" + r.action);
	var gotIdx = (r.index === void) ? -1 : r.index;
	var wantAct = uiScreenRowAction("" + specBtn.action, row);
	var dispMsg = "";
	if(gotAct != "")
	{
		var res = uiActionDispatch(gotAct, gotIdx);
		dispMsg = (res.msg === void) ? "" : ("" + res.msg);
	}
	var idx1 = uiScreenVarIdxGet(id, row);
	if(idx1 < 0) idx1 = 0;
	if(idx1 >= n) idx1 = n - 1;
	var asset1 = "" + fr[idx1];
	var text1 = "" + (idx1 + 1) + "/" + n;
	var wantIdx = idx0 + ((which == "next") ? 1 : -1);
	var clamped = false;
	if(wantIdx < 0) { wantIdx = 0; clamped = true; }
	if(wantIdx > n - 1) { wantIdx = n - 1; clamped = true; }
	var okHover = (stHover == "hover");
	var okPress = (stPress == "pressed");
	var okTok = (tok == wantTok);
	var okAct = (gotAct == wantAct) && (gotIdx == row) && (UIScrGalLastRow == row);
	var okIdx = (idx1 == wantIdx);
	var okText = (text1 == ("" + (idx1 + 1) + "/" + n));
	// 「缩略图确实换图」：非边界时素材名必须变；边界（钳制）时**允许不变**（且此时必须有 clamped）
	var okThumb = (asset1 != asset0) || (clamped && (idx1 == idx0));
	uiScreenPressClear();
	uiScreenHoverUpdate(-1, -1);
	var ok = okHover && okPress && okTok && okAct && okIdx && okText && okThumb;
	return "★M08VAR★ " + (ok ? "PASS" : "FAIL")
		+ "  " + id + " 行=" + row + " 按钮=" + which + "(" + bkey + ") 中心=" + cx + "," + cy
		+ "  悬停态=" + ((stHover == "") ? "(normal)" : stHover) + "（期望 hover）"
		+ "  按下态=" + ((stPress == "") ? "(normal)" : stPress) + "（期望 pressed）"
		+ "  命中令牌=" + ((tok == "") ? "(无)" : tok) + "（期望 " + wantTok + "）"
		+ "  派发=" + ((gotAct == "") ? "(空)" : gotAct) + "（期望 " + wantAct + "）"
		+ "  派发行号=" + UIScrGalLastRow + "（期望 " + row + "）"
		+ "  缩略图 " + asset0 + " → " + asset1 + (okThumb ? "（已换图）" : "（未换图）")
		+ "  n/N " + text0 + " → " + text1
		+ "  序号 " + idx0 + " → " + idx1 + "（期望 " + wantIdx + "）"
		+ (clamped ? "  边界钳制=是" : "")
		+ (dispMsg == "" ? "" : "  msg=" + dispMsg);
}

// `galguard`：spec = `<list元素id>` ｜ 判词 `★M08GUARD★ PASS|FAIL`
//   **机制守卫的负向对照**：把 `item_variants` 逐条改坏（**只在内存里改副本，不写磁盘**），
//   断言 `uiWidgetItemVariantProblems` / `uiWidgetItemVariantRowProblem`（= 绘制与命中调用的
//   同一套函数）逐条给出预期的拒绝理由，且 `★M08VARIANT-REJECT★` 判词条数按预期增长。
function uiScreenSyntheticGalGuard(spec)
{
	var id = "" + spec;
	if(id == "") return "★M08GUARD-REJECT★ spec 应为 <list元素id>（或 auto），实收空串";
	if(id == "auto") id = uiScreenVariantListId();      // ★ 自动取当前屏第一个带 item_variants 的可见 list
	if(id == "") return "★M08GUARD-REJECT★ 当前屏 " + uiScreenCurrent() + " 没有带 item_variants 的可见 list（auto 取不到）";
	var sid = uiScreenCurrent();
	if(!uiScreenExists(sid)) return "★M08GUARD-REJECT★ 当前屏 " + sid + " 未登记，无法定位";
	var el = uiScreenElById(sid, id);
	if(el === null) return "★M08GUARD-REJECT★ 当前屏 " + sid + " 无元素 " + id;
	if(el.kind != "list") return "★M08GUARD-REJECT★ " + id + " 不是 list（kind=" + ("" + el.kind) + "）";
	if(uiWidgetItemVariants(el) === null)
		return "★M08GUARD-REJECT★ " + id + " 未声明 item_variants";
	var probs0 = uiWidgetItemVariantProblems(el);
	if(probs0.count > 0)
		return "★M08GUARD-REJECT★ " + id + " 的真实 item_variants 本身已非法（"
			+ probs0[0].reason + "），无法作为守卫自证样本";
	//   ⚠️ **变量名不得用 `real`**：TJS2 里 `real` 是**类型关键字**（与 `int`/`string` 同列），
	//   拿它当变量名会让整份脚本报 `语法有误`（实测：装载 FAIL，行号指向该语句）。
	var realV = el.item_variants;
	var goodPrev = realV.prev;
	if(goodPrev === void || goodPrev === null || typeof goodPrev != "Object")
		return "★M08GUARD-REJECT★ " + id + " 未声明 item_variants.prev，无法取样";
	// 基础元素副本（**内存**；字段显式列举，避免共享引用）
	var e2 = %[ id: "" + el.id, kind: "list",
		orientation: (el.orientation !== void) ? el.orientation : "v",
		item_h: uiWidgetNum(el, "item_h", 0),
		w: uiWidgetNum(el, "w", 0) ];
	if(el.item_w !== void) e2.item_w = uiWidgetNum(el, "item_w", 0);
	var bp = %[ key: "" + goodPrev.key, x: uiWidgetNum(goodPrev, "x", 0),
		y: uiWidgetNum(goodPrev, "y", 0), w: uiWidgetNum(goodPrev, "w", 0),
		h: uiWidgetNum(goodPrev, "h", 0), action: "" + goodPrev.action,
		asset: "ui/x_ui_galshell_tab_off.png" ];
	var cases = [
		%[ name: "item_variants 非对象",   mut: "notobj",   want: "item_variants 不是对象" ],
		%[ name: "frames 非数组",          mut: "frames",   want: "frames 不是数组" ],
		%[ name: "frames[行] 非数组",      mut: "rowarr",   want: "差分列表不是数组" ],
		%[ name: "frames[行] 空素材",      mut: "rowempty", want: "差分素材为空" ],
		%[ name: "prev 出块",              mut: "outblock", want: "矩形出块" ],
		%[ name: "prev 零面积",            mut: "zerorect", want: "零/负面积" ],
		%[ name: "prev 缺 key",            mut: "nokey",    want: "缺 key" ],
		%[ name: "prev action 为空",       mut: "emptyact", want: "action 为空" ],
		%[ name: "prev 无 asset/态图",     mut: "noasset",  want: "既无 asset 也无 state_assets" ],
		%[ name: "text 出块",              mut: "textblock", want: "文本区出块" ],
		%[ name: "text 零面积",            mut: "textzero", want: "文本区零/负面积" ],
		%[ name: "edge 取值非法",          mut: "edge",     want: "edge 取值非法" ]
	];
	var before = UIWidgetVariantRejectLines.count;
	var lines = [];
	var okAll = true;
	for(var c = 0; c < cases.count; c++)
	{
		var cs = cases[c];
		var mut = "" + cs.mut;
		// 每例都从**合法副本**出发，只改一处
		//   （内层数组先建变量：只为可读性；嵌套数组字面量本身在本引擎可用 —— 注入的
		//    `ui_layout.tjs` 里 `frames: [["a","b"],…]` 装载正常，已实测。）
		var oneFrame = [ "ui/x_ui_galshell_tab_off.png" ];
		var oneEmpty = [ "" ];
		var vi = %[];
		vi.frames = [ oneFrame ];
		vi.prev = %[ key: bp.key, x: bp.x, y: bp.y, w: bp.w, h: bp.h,
			action: bp.action, asset: bp.asset ];
		vi.next = %[ key: "vnext_mut", x: bp.x, y: bp.y, w: bp.w, h: bp.h,
			action: "gallery_next:%row%", asset: bp.asset ];
		vi.text = %[ x: 0, y: 0, w: uiWidgetNum(el, "item_w", uiWidgetNum(el, "w", 1)),
			h: uiWidgetNum(el, "item_h", 1) ];
		if(mut == "notobj")        vi = "oops";
		else if(mut == "frames")   vi.frames = "oops";
		else if(mut == "rowarr")   vi.frames = [ "oops" ];
		else if(mut == "rowempty") vi.frames = [ oneEmpty ];
		else if(mut == "outblock") { vi.prev.x = 9999; vi.prev.y = 9999; }
		else if(mut == "zerorect") { vi.prev.w = 0; vi.prev.h = 0; }
		else if(mut == "nokey")    vi.prev.key = "";
		else if(mut == "emptyact") vi.prev.action = "";
		else if(mut == "noasset")  { vi.prev.asset = void; }
		else if(mut == "textblock") { vi.text.x = 9999; vi.text.y = 9999; }
		else if(mut == "textzero")  { vi.text.w = 0; vi.text.h = 0; }
		else if(mut == "edge")      vi.edge = "wrap";
		e2.item_variants = vi;
		var got = "(无拒绝)";
		var pr = uiWidgetItemVariantProblems(e2);
		if(pr.count > 0) got = "" + pr[0].reason;
		else
		{
			var rq = uiWidgetItemVariantRowProblem(e2, 0);
			if(rq != "") got = "" + rq;
		}
		var okc = (got.indexOf("" + cs.want) >= 0);
		if(!okc) okAll = false;
		if(got != "(无拒绝)") uiWidgetItemVariantReject(id, "guard", got);   // 与绘制路径同一判词出口
		lines.push(cs.name + "→" + got + (okc ? " ✓" : " ✗（期望含「" + cs.want + "」）"));
	}
	var grew = UIWidgetVariantRejectLines.count - before;
	var ok = okAll && (grew >= 1);
	return "★M08GUARD★ " + (ok ? "PASS" : "FAIL")
		+ "  " + id + " 注入 " + cases.count + " 例（内存副本，未写磁盘）→ "
		+ lines.join(" ｜ ")
		+ "  ｜ REJECT 判词新增 " + grew + " 条（合计 " + UIWidgetVariantRejectLines.count + "）";
}

// `galattach`：spec = `<承载屏 id>` ｜ 判词 `★M08ATTACH★ PASS|FAIL`
//   **attach 能否被四个不同承载屏复用**（主代理要求实测的一件事）：
//     ① 承载屏的 `attach` 确实指向鉴赏外壳；
//     ② 外壳元素**可见数 > 0**（真的画得出来；具体像素由本步导出的 PNG 见证）；
//     ③ 外壳的**每个热区**在自身中心被**真实命中链**命中（`uiScreenAttachClick`
//        = `uiScreenClick` 的附加层分支）且派发的是它自己的 action；
//     ④ 外壳页签 flag `gal_tab` 被派生成本承载屏 id。
function uiScreenSyntheticGalAttach(spec)
{
	var host = "" + spec;
	if(host == "") return "★M08ATTACH-REJECT★ spec 应为 <承载屏 id>，实收空串";
	if(!uiScreenExists(host)) return "★M08ATTACH-REJECT★ 屏 " + host + " 未登记，无法定位";
	uiScreenReplace(host);                       // 同级换屏到该承载屏（栈深不变）
	var aid = uiScreenAttachIdCurrent();
	if(aid != UIScrGalleryShellId)
		return "★M08ATTACH★ FAIL  承载屏 " + host + " 的 attach="
			+ ((aid == "") ? "(无)" : aid) + "（期望 " + UIScrGalleryShellId + "）";
	var asc = UILayoutData.screens[aid];
	if(asc === void || asc === null || asc.elements === void)
		return "★M08ATTACH★ FAIL  外壳 " + aid + " 无布局数据";
	var nel = asc.elements.count;
	var vis = 0;
	for(var j = 0; j < nel; j++)
		if(uiScreenElementVisible(asc.elements[j])) vis++;
	// 逐热区做**真实命中**（与真实鼠标同一入口：uiScreenClick → uiScreenAttachClick）
	var hits = 0, hitOk = 0, hitBad = [];
	for(var i = 0; i < nel; i++)
	{
		var el = asc.elements[i];
		if(el === void || el === null || el.kind != "hit") continue;
		if(!uiScreenElementVisible(el)) continue;
		hits++;
		var r = uiWidgetRect(el);
		var cx = r.x + Math.floor(r.w / 2);
		var cy = r.y + Math.floor(r.h / 2);
		var got = uiScreenAttachClick(cx, cy);
		var ga = (got === null) ? "" : ("" + got.action);
		if(ga == ("" + el.action)) hitOk++;
		else hitBad.push(el.id + " 得 " + ((ga == "") ? "(无)" : ga) + "，期望 " + el.action);
	}
	var tabFlag = uiScreenFlagGet(UIScrGalleryTabFlag);
	var ok = (nel > 0) && (vis > 0) && (hits > 0) && (hitOk == hits) && (tabFlag == host);
	return "★M08ATTACH★ " + (ok ? "PASS" : "FAIL")
		+ "  承载屏 " + host + "：attach=" + aid
		+ "  外壳元素=" + nel + " 可见=" + vis + "（期望 >0）"
		+ "  热区命中 " + hitOk + "/" + hits + "（期望全中）"
		+ "  " + UIScrGalleryTabFlag + "=" + ((tabFlag == "") ? "(空)" : tabFlag)
		+ "（期望 " + host + "）"
		+ "  命中件 id=" + ((UIScrAttachHitId == "") ? "(无)" : UIScrAttachHitId)
		+ (hitBad.count ? "  失败：" + hitBad.join("；") : "");
}

// ------------------------------------------------------------
// ★ M47 追补：**值标志断言**（巡演用）—— spec 形如 `<flag 名>:<期望值>`
//   用途：证明「切页往返不丢值」（例如 config_set_display:full → config_tab_1 →
//   断言 cfg_v_display 仍为 full）。判词 `★M47FLAG★ PASS|FAIL`，带**实际值**与
//   （若该 flag 对应设置仓里的键）设置仓值，以及当前页签 —— 一眼可判。
//   负向/用法错：spec 缺项 ⇒ `★M47FLAG-REJECT★`（照 M46/M47 的先例）。
// ------------------------------------------------------------
function uiScreenSyntheticFlagCheck(spec)
{
	var s = "" + spec;
	var p1 = s.indexOf(":");
	if(p1 <= 0) return "★M47FLAG-REJECT★ spec 应为 <flag名>:<期望值>，实收 " + s;
	var fl = s.substring(0, p1);
	var want = s.substring(p1 + 1);
	if(fl == "" || want == "") return "★M47FLAG-REJECT★ flag 名 / 期望值不得为空：" + s;
	var got = uiScreenFlagGet(fl);
	var extra = "";
	if(uiScreenActionHasPrefix(fl, "cfg_v_"))
	{
		var sk = uiScreenActionSuffix(fl, "cfg_v_");
		if(uiSettingHas(sk))
			extra = "  设置仓 " + sk + "=" + UISettingGet(sk)
				+ "  切页记忆=" + ((uiScreenConfigMemoHas(fl)) ? uiScreenConfigMemoOf(fl) : "(无)");
	}
	var ok = (got == want);
	return "★M47FLAG★ " + (ok ? "PASS" : "FAIL")
		+ "  " + fl + "=" + ((got == "") ? "(空)" : got) + "（期望 " + want + "）"
		+ extra
		+ "  页签=" + ((uiScreenFlagGet("cfg_page") == "") ? "(未设)" : uiScreenFlagGet("cfg_page"));
}

// ------------------------------------------------------------
// ★ M47 三轮：**合成点击**（巡演用）—— spec 形如 `<hit 元素id>[:<观测的设置键>]`
//   用途：证明一审 C1「按在 MUTE 上不得改动音量、且 MUTE 正常取反」。走的入口与真实鼠标
//   **同一批**（就是 startup.tjs 的 onMouseDown / onClick / handleClick 内部调用的那几个）：
//     ① `uiScreenPressUpdate`（= onMouseDown 左键分支的调用）
//     ② `uiScreenPressClear`（= onClick 开头的调用）
//     ③ `uiScreenClick` + `uiActionDispatch`（= handleClick 的核心两步）
//   ⚠️ 局限（如实登记）：它证明的是**机制路径**（含 z 序裁决、拖动是否被挡、动作解析与分发），
//   **不**证明真实设备事件的产生（与 M13 合成鼠标、M46 合成指针同款局限）。
//   判词 `★M47CLICK★ PASS|FAIL` 断言四件事：
//     · 按下时**没有**进入滑块拖动（`UIScrDragSlider` 仍为空）；
//     · 被观测的设置键值**未变**（C1 的核心：点 MUTE 不该改音量）；
//     · 点击解析出的动作与预期前缀一致（可选：`:期望动作` 第三段）；
//     · 分发后值键**已取反**（MUTE 是 toggle）。
// ------------------------------------------------------------
function uiScreenSyntheticClick(spec)
{
	var s = "" + spec;
	var p1 = s.indexOf(":");
	var hitId = (p1 > 0) ? s.substring(0, p1) : s;
	var rest  = (p1 > 0) ? s.substring(p1 + 1) : "";
	var watchKey = "", wantAct = "";
	if(rest != "")
	{
		var p2 = rest.indexOf(":");
		if(p2 >= 0) { wantAct = rest.substring(p2 + 1); watchKey = rest.substring(0, p2); }
		else watchKey = rest;
	}
	var sid = uiScreenCurrent();
	if(!uiScreenExists(sid)) return "★M47CLICK-REJECT★ 当前屏 " + sid + " 未登记，无法定位控件";
	var hit = uiScreenFindElementById(hitId);
	if(hit === null) return "★M47CLICK-REJECT★ 当前屏 " + sid + " 无元素 " + hitId + "（走『元素不存在』守卫）";
	if(hit.kind != "hit") return "★M47CLICK-REJECT★ " + hitId + " 不是 hit（kind=" + ("" + hit.kind) + "）";
	if(!uiScreenElementVisible(hit))
		return "★M47CLICK-REJECT★ " + hitId + " 当前不可见（vis_flag="
			+ ((hit.vis_flag === void || hit.vis_flag === null) ? "(无)" : ("" + hit.vis_flag))
			+ "）——多半是所在页签未激活";

	var hr = uiWidgetRect(hit);
	var cx = hr.x + Math.floor(hr.w / 2);
	var cy = hr.y + Math.floor(hr.h / 2);
	var top = uiScreenTopHitEl(cx, cy);
	var topId = (top === null) ? "(无)" : ("" + top.id);

	// 观测目标（**必须在按下之前定好并读数**）：被点击动作真正会改的那个值标志，按**期望动作名**
	//   推导（规则与 uiActionDispatch 一致：`config_set_<键>` ⇒ `cfg_v_<键>`）。
	//   ★ 不要用「观测设置键」去拼 flag：MUTE 的动作键是 `mute_vol_master`，而音量键是 `vol_master`，
	//     两者**不是**同一个键（首轮判词因此误判 FAIL，已修）。
	//   ★ 也**不能**在按下之后再读基线：C1 的故障表现正是「按下那一刻就把音量写了」
	//     ⇒ 先按后读会把被污染的值当成基线（变异轮实测：读到 100 -> 100「未变」而漏报）。
	var watchFlag = "";
	if(uiScreenActionHasPrefix(wantAct, "config_set_"))
	{
		var wk = uiScreenActionSuffix(wantAct, "config_set_");
		var wc = wk.indexOf(":");
		if(wc >= 0) wk = wk.substring(0, wc);
		watchFlag = "cfg_v_" + wk;
	}
	var beforeVal  = (watchKey != "" && uiSettingHas(watchKey)) ? ("" + UISettingGet(watchKey)) : "";
	var beforeFlag = (watchFlag == "") ? "" : uiScreenFlagGet(watchFlag);

	// ① 按下（onMouseDown 左键分支的同一个入口）—— **不得**进入拖动
	uiScreenPressUpdate(cx, cy);
	var dragStarted = (UIScrDragSlider != "");
	var dragId = "" + UIScrDragSlider;
	// ② 抬起（onClick 开头清按下态）
	uiScreenPressClear();

	// ③ 解析动作（handleClick 的第一步；config 屏不依赖 stage，传 void 不抛）
	var act = "", idx = -1;
	try
	{
		var r = uiScreenClick(void, cx, cy);
		if(r !== void && r !== null)
		{
			act = (r.action === void || r.action === null) ? "" : ("" + r.action);
			idx = (r.index === void) ? -1 : r.index;
		}
	}
	catch(eC) { act = ""; }

	// ④ 分发（handleClick 的第二步）
	var msg = "";
	if(act != "")
	{
		try
		{
			var res = uiActionDispatch(act, idx);
			msg = (res !== void && res.msg !== void) ? ("" + res.msg) : "";
		}
		catch(eA) { msg = "分发异常：" + eA.message; }
	}
	var afterVal  = (watchKey != "" && uiSettingHas(watchKey)) ? ("" + UISettingGet(watchKey)) : "";
	var afterFlag = (watchFlag == "") ? "" : uiScreenFlagGet(watchFlag);

	var okDrag  = (!dragStarted);
	var okValue = (watchKey == "" || beforeVal == afterVal);         // C1 核心：音量不得被按下改动
	var okAct   = (wantAct == "" || act == wantAct);
	var okFlag  = (watchFlag == "" || beforeFlag != afterFlag);      // MUTE 是 toggle ⇒ 必须翻面
	var ok = okDrag && okValue && okAct && okFlag;

	return "★M47CLICK★ " + (ok ? "PASS" : "FAIL")
		+ "  " + hitId + " 中心=" + cx + "," + cy + "  全局最高 z 命中的 id=" + topId
		+ "  拖动未启动=" + (okDrag ? 1 : 0) + (dragStarted ? ("（竟拖动了 " + dragId + "）") : "")
		+ "  动作=" + ((act == "") ? "(空)" : act)
		+ ((watchKey == "") ? "" :
			("  观测设置键 " + watchKey + "：" + beforeVal + " -> " + afterVal
				+ (okValue ? "（未变 ✓）" : "（**被改动 ✗**）")))
		+ ((watchFlag == "") ? "" :
			("  观测值标志 " + watchFlag + "：" + ((beforeFlag == "") ? "(空)" : beforeFlag) + " -> "
				+ ((afterFlag == "") ? "(空)" : afterFlag)
				+ (okFlag ? "（已翻面 ✓）" : "（**未翻面 ✗**）")))
		+ "  页签=" + ((uiScreenFlagGet("cfg_page") == "") ? "(未设)" : uiScreenFlagGet("cfg_page"))
		+ (msg == "" ? "" : ("  msg=" + msg));
}

// ------------------------------------------------------------
// ------------------------------------------------------------
// ★★ ISSUE-20260928-02（第 2 步）· 流程图「运行态 / 层」的巡演验收件 ★★
//   两个步骤类型（见 UIScrTourSteps 的「运行态」块）：
//     · `flowstate` —— **只读**断言：读当前屏数据报「节点 `flow_state` 分布 / 连线 `state`
//       档位分布 / 应画 `current` 环条数 / 层 flag 当前值」。对 `--preset states` 即
//       「五档节点 + 三档连线同屏」的自证；对默认预设即「无 `flow_state` ⇒ 0 环」的负向自证。
//     · `flowclick` —— **走真实点击入口**（按下 -> 抬起 -> `uiScreenClick` 命中 -> 参数 ->
//       `uiActionDispatch`，与 `handleClick` / M47 合成点击同批入口）去点「层切换热区」
//       （数据里 `action=="flow_layer"` 且 `layer==<v>` 的那个 hit）。
//       · 本屏数据**没有该层元素** ⇒ **明确跳过**（`★FLOWLAYER-SKIP★`）且**不做任何状态变更**
//         —— 默认 / `states` / `ref150` / `screen2` 预设本就没有番外独立层元素，跳过才是对的；
//         `frag` 预设才会真切换。
//       · 判词 `★FLOWLAYER★ PASS|FAIL` 直接落进巡演日志（可机检）。
//   为什么走真实点击而不是直接写 flag：本步骤要证明的是「**热区 -> 命中参数 -> 动作 -> flag ->
//   重绘/命中集**」这条链通着；直接写 flag 只能证明 flag 可写（那是对实现的复述）。
// ------------------------------------------------------------
function uiScreenFlowStateLine()
{
	var sid = uiScreenCurrent();
	if(!uiScreenExists(sid) || sid != "flowchart")
		return "★FLOWSTATE-SKIP★ 当前屏=" + sid + "（本断言只在流程图屏有效，跳过）";
	var sc = UILayoutData.screens[sid];
	var els = sc.elements;

	// ① 节点 `flow_state` 分布（只有节点底图带该字段；缺省不写 = available，冻结 §一.1）
	var stKeys = ["locked", "available", "visited", "current", "new"];
	var stCnt  = [0, 0, 0, 0, 0];
	var curIds = [];
	var unset  = 0;
	for(var i = 0; i < els.count; i++)
	{
		var el = els[i];
		if(el.kind != "image") continue;
		var st = el.flow_state;
		if(st === void || st === null || ("" + st) == "") { unset++; continue; }
		var sv = "" + st;
		var found = false;
		for(var k = 0; k < stKeys.count; k++)
		{
			if(stKeys[k] == sv) { stCnt[k]++; found = true; break; }
		}
		if(!found) unset++;
		if(sv == "current") curIds.push("" + el.id);
	}
	var withState = stCnt[0] + stCnt[1] + stCnt[2] + stCnt[3] + stCnt[4];

	// ② 连线 `state` 档位分布（顶层键 links；色/宽/箭头已由生成器解析，两端不判配色）
	var lkCnt = [0, 0, 0];
	if(sc.links !== void && sc.links !== null && sc.links.count !== void)
	{
		for(var m = 0; m < sc.links.count; m++)
		{
			var sv2 = "" + sc.links[m].state;
			if(sv2 == "normal") lkCnt[0]++;
			else if(sv2 == "visited") lkCnt[1]++;
			else if(sv2 == "noroute") lkCnt[2]++;
		}
	}
	var lkTotal = lkCnt[0] + lkCnt[1] + lkCnt[2];

	// ③ 层 flag 当前值（flag 名从数据推导；连线模块缺失时用层模块的兜底名）
	var lflag = "";
	if(UIScrFlowLinksOK) lflag = uiFlowLinkLayerFlagName(sc);
	if(lflag == "" && UIScrFlowLayerOK) lflag = UIFlowLayerFlagFallback;
	var lval = (lflag == "") ? "(无层 flag)"
		: (lflag + "=" + ((uiScreenFlagGet(lflag) == "") ? "(空)" : uiScreenFlagGet(lflag)));

	var cur3 = "";
	for(var c = 0; c < curIds.count && c < 3; c++) cur3 = cur3 + ((c > 0) ? "," : "") + curIds[c];

	return "★FLOWSTATE★ 屏=" + sid + " 元素=" + els.count
		+ " ｜ flow_state：有字段 " + withState + " 件（"
		+ stKeys[0] + "=" + stCnt[0] + " " + stKeys[1] + "=" + stCnt[1] + " "
		+ stKeys[2] + "=" + stCnt[2] + " " + stKeys[3] + "=" + stCnt[3] + " "
		+ stKeys[4] + "=" + stCnt[4] + "）｜ 无该字段 " + unset + " 件（缺省=available）"
		+ " ｜ 应画 current 环 " + stCnt[3] + " 个" + ((cur3 == "") ? "" : ("[" + cur3 + "]"))
		+ " ｜ 连线 " + lkTotal + " 条（normal=" + lkCnt[0] + " visited=" + lkCnt[1] + " noroute=" + lkCnt[2] + "）"
		+ " ｜ 层 " + lval
		+ " ｜ 环实画（上一帧）=" + (UIScrFlowLayerOK ? ("" + UIFlowLayerRingDrawn) : "(模块缺失)");
}

function uiScreenSyntheticFlowClick(spec)
{
	var layer = "" + spec;
	var sid = uiScreenCurrent();
	if(!uiScreenExists(sid) || sid != "flowchart")
		return "★FLOWLAYER-SKIP★ 当前屏=" + sid + "（本步骤只在流程图屏有效，跳过）";
	var sc = UILayoutData.screens[sid];

	// 层 flag 名（数据推导优先）
	var lflag = "";
	if(UIScrFlowLinksOK) lflag = uiFlowLinkLayerFlagName(sc);
	if(lflag == "" && UIScrFlowLayerOK) lflag = UIFlowLayerFlagFallback;
	if(lflag == "")
		return "★FLOWLAYER-SKIP★ 本屏元素 vis_flag 全为空（无层 flag），跳过";

	// ① 目标层守卫：本屏数据里有没有该层的元素（`vis_when == layer` 且带层 flag）
	var layerEls = 0;
	for(var i = 0; i < sc.elements.count; i++)
	{
		var e0 = sc.elements[i];
		if(("" + e0.vis_flag) != lflag) continue;
		if(("" + e0.vis_when) == layer) layerEls++;
	}
	if(layerEls <= 0)
		return "★FLOWLAYER-SKIP★ 本屏数据无「" + layer + "」层元素 ⇒ 跳过（**不做任何状态变更**；"
			+ "默认/states/ref150/screen2 预设没有番外独立层元素，只有 --preset frag 才有）";

	// ② 找该层的层切换热区
	//   ★★ M1 修（2026-09-28 一审独立发现 · 真缺陷）★★
	//   原写法：取**第一个** `layer=="<层>"` 的候选就 `break`，之后（③）再单独判它可见性。
	//   后果：`layer=="main"` 的候选里 `fc.frag1_back_hit` 排在前面 ⇒ 当前层为 frag2..frag6 时
	//   取到的永远是**不可见**的 `fc.frag1_back_hit` ⇒ ③ 判 SKIP ⇒ **2..6 组永远回不了主干**，
	//   且巡演里「返回主干」步必 SKIP（一次巡演根本验不了 6 组闭环）。
	//   改为：**可见性过滤放在选点里** —— 遍历全部候选，取第一个**可见**者；全部候选都不可见才 SKIP。
	//   SKIP 判词分开保留：「没有该层热区」与「有热区但都不可见」是两件事（便于巡演日志判读）。
	var hit = null;
	var candTotal = 0;
	var candFirst = "";
	for(var j = 0; j < sc.elements.count; j++)
	{
		var e1 = sc.elements[j];
		if(e1.kind != "hit") continue;
		if(("" + e1.action) != "flow_layer") continue;
		var lv = e1.layer;
		if(lv === void || lv === null) continue;
		if(("" + lv) != layer) continue;
		candTotal++;
		if(candFirst == "") candFirst = "" + e1.id;
		if(!uiScreenElementVisible(e1)) continue;      // ★ M1：不可见的候选直接淘汰（与真实命中同一谓词）
		hit = e1;
		break;
	}
	if(hit === null)
	{
		if(candTotal <= 0)
			return "★FLOWLAYER-SKIP★ 本屏有「" + layer + "」层元素（" + layerEls
				+ " 件）但**没有** layer=\"" + layer + "\" 的 flow_layer 热区 ⇒ 跳过";
		return "★FLOWLAYER-SKIP★ layer=\"" + layer + "\" 的 flow_layer 热区共 " + candTotal
			+ " 件（首个=" + candFirst + "）**全部当前不可见**（vis_flag=" + lflag
			+ "＜当前层=" + uiScreenFlagGet(lflag) + "）⇒ 跳过";
	}

	// ④ 真实点击路径（与 handleClick / M47 合成点击同批入口）
	var hr = uiWidgetRect(hit);
	var cx = hr.x + Math.floor(hr.w / 2);
	var cy = hr.y + Math.floor(hr.h / 2);
	var before = uiScreenFlagGet(lflag);
	uiScreenPressUpdate(cx, cy);
	var dragged = (UIScrDragSlider != "");
	uiScreenPressClear();
	var act = "", idx = -1;
	try
	{
		var r = uiScreenClick(void, cx, cy);
		if(r !== void && r !== null)
		{
			act = (r.action === void || r.action === null) ? "" : ("" + r.action);
			idx = (r.index === void) ? -1 : r.index;
		}
	}
	catch(eC) { act = ""; }
	var hitParam = uiScreenHitLayer();
	var msg = "";
	if(act != "")
	{
		try
		{
			var res = uiActionDispatch(act, idx);
			msg = (res !== void && res.msg !== void) ? ("" + res.msg) : "";
		}
		catch(eA) { msg = "分发异常：" + eA.message; }
	}
	var after = uiScreenFlagGet(lflag);
	var ok = (act == "flow_layer") && (after == layer);
	return "★FLOWLAYER★ " + (ok ? "PASS" : "FAIL")
		+ "  目标层=" + layer + "  点击热区=" + hit.id + " 中心=" + cx + "," + cy
		+ "  命中动作=" + ((act == "") ? "(空)" : act)
		+ "  命中参数 layer=" + ((hitParam == "") ? "(空)" : hitParam)
		+ "  层值 " + ((before == "") ? "(空)" : before) + " -> " + ((after == "") ? "(空)" : after)
		+ "  拖动=" + (dragged ? ("启动(" + UIScrDragSlider + ")") : "未启动")
		+ "  重绘=下一步 tourTick（本步骤返回后由巡演统一 redraw）"
		+ (msg == "" ? "" : ("  msg=" + msg));
}

// ------------------------------------------------------------
// ★★ ISSUE-20260929-02（右栏大改）· 播放/暂停切换的**巡演验收件**（走真实点击入口）★★
//   spec：
//     · "auto"     —— 目标热区**从数据推**：当前屏里 action == `flow_replay_toggle` 的那个 hit；
//     · "<元素id>" —— 显式指定目标（**负向对照**用：不存在的 id / 非 hit / 非本动作的 hit）。
//   判词三态：`★REPLAYTOGGLE★ PASS|FAIL`（正向四断言）/ `★REPLAYTOGGLE-REJECT★ <id> <理由>`
//   （守卫挡下，**状态不变**）/ `★REPLAYTOGGLE-SKIP★ <理由>`（前台屏没有该机制，不假跑）。
//   四断言（逐条打印**实际值**）：
//     ① 点击前 `fc_replay` 的值；
//     ② 走**真实点击入口**（顶部命中 -> `UIScrHitLayer` -> `uiActionDispatch`，与 handleClick /
//        M47 合成点击同批入口）之后，该值**已翻转**（且等于按判据算出的期望值）；
//     ③ 用引擎自己的 `uiScreenElementVisible` **复算**两个键（播放/暂停）的可见性：
//        **恰好一真一假**，且每个键的可见性与「当前 flag 是否等于它的 `vis_when`」逐一相符
//        —— 这是「同一时刻只有一个键能显示」的直接证据（同一谓词驱动绘制与命中）；
//     ④ 再点一次必须**翻回点击前的原值**（幂等闭环）。
//   ⚠ 巡演步由**每屏 2 秒**的定时器驱动：本步不依赖任何额外延时（全部同步完成）。
//   ⚠ 语义边界：本步只证明「UI 状态翻转 + 换显」；画面播放（`fc.play_view` 的
//     `dynamic:"flow_scene_frames"` 填充 / 帧序列 / 时序 / 音频）属**编程组**，本步**不得**
//     也不声称其已生效。
//   ⚠ 常量来源：flag 名 / 两个取值 / 动作名一律取 **ui_flow.tjs 的具名常量**
//     （`UIFlowReplayFlag` 等，冻结接口的唯一出处）；该模块未装载时回落本文件顶部的同值兜底。
// ------------------------------------------------------------
var UIScrReplayActFallback   = "flow_replay_toggle";
var UIScrReplayFlagFallback  = "fc_replay";
var UIScrReplayPlayFallback  = "play";
var UIScrReplayPauseFallback = "pause";

function uiScreenReplayConst()
{
	var c = %[ act: UIScrReplayActFallback, flag: UIScrReplayFlagFallback,
	           play: UIScrReplayPlayFallback, pause: UIScrReplayPauseFallback ];
	try
	{
		// ★ 逐条 `!== void` 守卫：`ui_flow.tjs` 未装载时这些顶层 var **不存在**，
		//   直接 `"" + <未定义>` 在 TJS2 里可能抛「不能将 (void) 转换为 String」——
		//   故先判存在再取（与 ui_flow.tjs 自身的 `uiScreenDraw === void` 同款判法）。
		if(UIFlowReplayActName  !== void) c.act   = "" + UIFlowReplayActName;
		if(UIFlowReplayFlag     !== void) c.flag  = "" + UIFlowReplayFlag;
		if(UIFlowReplayPlayVal  !== void) c.play  = "" + UIFlowReplayPlayVal;
		if(UIFlowReplayPauseVal !== void) c.pause = "" + UIFlowReplayPauseVal;
	}
	catch(e)
	{
		// 保持兜底值（与冻结接口同值，见上）。
	}
	return c;
}

// 目标热区：auto ⇒ **数据推**（action == C.act 的第一个 hit）；否则按 id 取。
//   返回 null = 没取到（调用方据此 SKIP / REJECT，**不静默**）。
function uiScreenReplayFindHit(sc, spec, C)
{
	if(("" + spec) != "auto") return uiScreenFindElementById("" + spec);
	for(var i = 0; i < sc.elements.count; i++)
	{
		var e = sc.elements[i];
		if(e === void || e === null) continue;
		if(e.kind != "hit") continue;
		if(("" + e.action) == C.act) return e;
	}
	return null;
}

function uiScreenSyntheticReplayToggle(spec)
{
	var C = uiScreenReplayConst();
	var sid = uiScreenCurrent();
	if(!uiScreenExists(sid) || sid != "flowchart")
		return "★REPLAYTOGGLE-SKIP★ 当前屏=" + sid + "（本步骤只在流程图屏有效，跳过）";
	var sc = UILayoutData.screens[sid];

	// 机制前置：本屏必须真有该动作的热区，否则**明确跳过、不做任何状态变更**
	var autoHit = uiScreenReplayFindHit(sc, "auto", C);
	if(autoHit === null)
		return "★REPLAYTOGGLE-SKIP★ 本屏数据无 action==" + C.act
			+ " 的热区（该屏未接播放/暂停切换）⇒ 跳过，不做任何状态变更";

	var want = "" + spec;
	var hit  = uiScreenReplayFindHit(sc, want, C);
	var how  = (want == "auto") ? "auto(数据推:action)" : "explicit id";

	// ---- 守卫：全部在**任何状态变更之前**判定；不合格 ⇒ 显式 REJECT（不静默）----
	if(hit === null)
		return "★REPLAYTOGGLE-REJECT★ " + want + " 不在当前屏 " + sid + " 的元素表里（『元素不存在』守卫）";
	if(hit.kind != "hit")
		return "★REPLAYTOGGLE-REJECT★ " + want + " 不是 hit（kind=" + ("" + hit.kind)
			+ "）⇒ 它没有派发入口，点不出动作";
	if(("" + hit.action) != C.act)
		return "★REPLAYTOGGLE-REJECT★ " + want + " 的 action="
			+ ((("" + hit.action) == "") ? "(空)" : ("" + hit.action)) + "，不是 " + C.act + " 热区";
	if(!uiScreenElementVisible(hit))
		return "★REPLAYTOGGLE-REJECT★ " + want + " 当前不可见（vis_flag="
			+ ((hit.vis_flag === void || hit.vis_flag === null) ? "(无)" : ("" + hit.vis_flag))
			+ "=" + uiScreenFlagGet(hit.vis_flag) + "）⇒ 点不到";

	// ---- 数据侧：播放/暂停两个键（**从数据取，不写死 id**）----
	var keys = [];
	for(var k = 0; k < sc.elements.count; k++)
	{
		var e2 = sc.elements[k];
		if(e2 === void || e2 === null) continue;
		if(("" + e2.vis_flag) != C.flag) continue;
		keys.push(e2);
	}
	if(keys.count < 2)
		return "★REPLAYTOGGLE-REJECT★ 本屏带 flag " + C.flag + " 的件只有 " + keys.count
			+ " 件（需 2 件互斥键）⇒ 换显无从验证";

	// ---- ① 点击前的值 ----
	var before = uiScreenFlagGet(C.flag);

	// ---- ② 真实点击入口（与 handleClick 同批）：顶部命中 -> UIScrHitLayer -> 派发 ----
	var hr = uiWidgetRect(hit);
	var cx = hr.x + Math.floor(hr.w / 2);
	var cy = hr.y + Math.floor(hr.h / 2);
	uiScreenPressUpdate(cx, cy);
	uiScreenPressClear();
	var act = "", idx = -1;
	try
	{
		var r = uiScreenClick(void, cx, cy);
		if(r !== void && r !== null)
		{
			act = (r.action === void || r.action === null) ? "" : ("" + r.action);
			idx = (r.index === void) ? -1 : r.index;
		}
	}
	catch(eC) { act = ""; }
	// 本动作**不带参数**（目标键由屏级 flag 决定）⇒ UIScrHitLayer 对这件应为空；如实打印。
	var hitParam = uiScreenHitLayer();
	var msg = "";
	if(act != "")
	{
		try
		{
			var res = uiActionDispatch(act, idx);
			msg = (res !== void && res.msg !== void) ? ("" + res.msg) : "";
		}
		catch(eA) { msg = "dispatch exception: " + eA.message; }
	}
	var after  = uiScreenFlagGet(C.flag);
	var expect = (before == C.pause) ? C.play : C.pause;      // 判据：pause ⇒ play；否则 ⇒ pause
	var okAct  = (act == C.act);
	var okFlip = (after == expect) && (after != before);

	// ---- ③ 用引擎自己的谓词复算两键可见性：恰好一真一假、且与 flag 逐一相符 ----
	var nVis = 0, okConsist = true, visStr = "";
	for(var v = 0; v < keys.count; v++)
	{
		var vis  = uiScreenElementVisible(keys[v]);
		var when = (keys[v].vis_when === void || keys[v].vis_when === null) ? "" : ("" + keys[v].vis_when);
		if(vis) nVis++;
		if(vis != (when == after)) okConsist = false;
		visStr = visStr + ((v > 0) ? " " : "") + ("" + keys[v].id) + "(" + when + ")=" + (vis ? "V" : "x");
	}
	var okVis = (nVis == 1) && okConsist;

	// ---- ④ 再点一次必须翻回原值（幂等闭环）----
	var act2 = "", after2 = "";
	try
	{
		var r2 = uiScreenClick(void, cx, cy);
		if(r2 !== void && r2 !== null) act2 = (r2.action === void || r2.action === null) ? "" : ("" + r2.action);
	}
	catch(e2) { act2 = ""; }
	if(act2 != "") { try { uiActionDispatch(act2, -1); } catch(e3) { } }
	after2 = uiScreenFlagGet(C.flag);
	var okIdem = (act2 == C.act) && (after2 == before) && (after2 != after);

	var ok = okAct && okFlip && okVis && okIdem;
	return "★REPLAYTOGGLE★ " + (ok ? "PASS" : "FAIL")
		+ "  目标=" + hit.id + "[" + how + "] 中心=" + cx + "," + cy
		+ "  ①点击前 " + C.flag + "=" + ((before == "") ? "(空)" : before)
		+ "  ②点击=" + ((act == "") ? "(空)" : act) + " -> " + ((after == "") ? "(空)" : after)
		+ "（期望 " + expect + "，命中参数 layer=" + ((hitParam == "") ? "(空)" : hitParam) + "）"
		+ "  ③引擎谓词复算 " + visStr + " ⇒ 可见 " + nVis + " 件、与 flag 相符=" + (okConsist ? "是" : "否")
		+ "  ④再点=" + ((act2 == "") ? "(空)" : act2) + " -> " + ((after2 == "") ? "(空)" : after2)
		+ "（应回 " + ((before == "") ? "(空)" : before) + "）"
		+ "  键数=" + keys.count + " flag=" + C.flag
		+ "  重绘=下一步 tourTick（本步骤返回后由巡演统一 redraw）"
		+ "  播放实现=未接（编程组）"
		+ (msg == "" ? "" : ("  msg=" + msg));
}

// ------------------------------------------------------------
// ★★ ISSUE-20260930-02（章节详情）· 详情浮层的开合（动作 `flow_intro_open` / `flow_intro_close`）★★
//   冻结接口（`_工作\ISSUE-20260930-02_章节详情\接口冻结.md` §四 动作名表）：
//     `flow_intro_open`  ← `fc.p_plus_hit`（说明框右上角的加号热区）⇒ 屏级 flag `fc_intro` 置 `open`
//     `flow_intro_close` ← `fc.intro_scrim_hit`（整屏压暗热区）⇒ 置 `closed`
//   形制照 `flow_replay_toggle`（`ui_flow.tjs::uiFlowReplayToggle`）：
//     · 判据 = **显式置值**（不是 toggle）：open 动作写 "open"、close 动作写 "closed"；
//     · 只翻屏级 flag（重绘由调用方：`startup.tjs` 的 handleClick / 巡演 uiTourStep 都在派发后 redraw）；
//     · flag 名 / 两个取值 / 两个动作名一律**具名常量**（下方 `UIScrIntro*Fallback`）——不散落魔法串。
//   ★ **优雅降级**（M3 的数据尚未落地时不得抛错、不得假成功）：
//     ① 当前屏未登记；② 本屏 `flags_default` 未声明该 flag（机制与数据不同版）；
//     ③ 本屏无任何元素带该 flag（浮层件未落地）——三种一律返回 `handled:false` + 可读 msg，
//     状态**一字未动**（同 `flow_replay_toggle` 的 REFUSE 形制）。
//   ★ 数据形态假定（留编程组/M3 核对）：`fc.p_plus_hit.action == "flow_intro_open"`、
//     `fc.intro_scrim_hit.action == "flow_intro_close"`，且本屏 `flags_default` 追加
//     `"fc_intro": "closed"`、浮层件带 `vis_flag:"fc_intro"` / `vis_when:"open"`（冻结书 §三.2）。
// ------------------------------------------------------------
var UIScrIntroFlagFallback      = "fc_intro";           // 屏级 flag 名（冻结 §三.2）
var UIScrIntroOpenActFallback   = "flow_intro_open";    // 动作名：开（唯一发出方 `fc.p_plus_hit`）
var UIScrIntroCloseActFallback  = "flow_intro_close";   // 动作名：关（唯一发出方 `fc.intro_scrim_hit`）
var UIScrIntroOpenValFallback   = "open";               // 取值：显示浮层
var UIScrIntroCloseValFallback  = "closed";             // 取值：隐藏浮层（= 进屏默认）

function uiScreenIntroConst()
{
	var c = %[ flag: UIScrIntroFlagFallback,
	           openAct: UIScrIntroOpenActFallback, closeAct: UIScrIntroCloseActFallback,
	           openVal: UIScrIntroOpenValFallback, closeVal: UIScrIntroCloseValFallback ];
	try
	{
		// 与 `uiScreenReplayConst()` 同款：`ui_flow.tjs` 若日后给出同名具名常量则以它为准
		// （逐条 `!== void` 守卫：未定义标识符直接 `"" +` 会抛「不能将 (void) 转换为 String」）。
		if(UIFlowIntroFlag     !== void) c.flag     = "" + UIFlowIntroFlag;
		if(UIFlowIntroOpenAct  !== void) c.openAct  = "" + UIFlowIntroOpenAct;
		if(UIFlowIntroCloseAct !== void) c.closeAct = "" + UIFlowIntroCloseAct;
		if(UIFlowIntroOpenVal  !== void) c.openVal  = "" + UIFlowIntroOpenVal;
		if(UIFlowIntroCloseVal !== void) c.closeVal = "" + UIFlowIntroCloseVal;
	}
	catch(e)
	{
		// 保持兜底值（= 冻结接口同值）。
	}
	return c;
}

// 本屏带某 flag 的元素件数（数据侧事实；Dictionary 不能枚举 ⇒ 只能按元素数组数）。
function uiScreenIntroFlagCount(sc, flag)
{
	if(sc === void || sc === null || sc.elements === void || sc.elements === null) return 0;
	var els = sc.elements;
	var n = 0;
	for(var i = 0; i < els.count; i++)
	{
		var el = els[i];
		if(el === void || el === null) continue;
		if(("" + el.vis_flag) == flag) n++;
	}
	return n;
}

// 本屏 `flags_default` 是否声明了该 flag（机制与数据是否同版）。
function uiScreenIntroFlagDeclared(sc, flag)
{
	if(sc === void || sc === null) return false;
	var def = sc.flags_default;
	if(def === void || def === null) return false;
	var v = def["" + flag];
	return (v !== void && v !== null);
}

// ★ 动作本体：把 flag 显式置成 `want`（"open" / "closed"），带三条降级守卫。
function uiScreenIntroApply(want, act)
{
	var C = uiScreenIntroConst();
	var sid = uiScreenCurrent();
	if(!uiScreenExists(sid))
		return %[ handled: false, effect: "",
			msg: "【详情浮层降级】当前屏未登记，无浮层可开合（动作 " + ("" + act) + " 忽略）" ];

	var sc = UILayoutData.screens[sid];
	if(!uiScreenIntroFlagDeclared(sc, C.flag))
		return %[ handled: false, effect: "",
			msg: "【详情浮层降级】本屏 " + sid + " 的 flags_default 未声明 " + C.flag
				+ "（机制与数据不同版）⇒ " + ("" + act) + " 无效，状态未变" ];

	var n = uiScreenIntroFlagCount(sc, C.flag);
	if(n <= 0)
		return %[ handled: false, effect: "",
			msg: "【详情浮层降级】本屏 " + sid + " 没有元素带 vis_flag=" + C.flag
				+ "（浮层件未落地）⇒ " + ("" + act) + " 无效，状态未变" ];

	var before = uiScreenFlagGet(C.flag);
	var changed = uiScreenFlagSet(C.flag, want);
	return %[ handled: true, effect: "",
		msg: "详情浮层 " + C.flag + " " + ((before == "") ? "(空)" : before) + " -> " + want
			+ (changed ? "" : "（原本已是该值）")
			+ "（" + ("" + act) + "；带该 flag 的件 " + n + " 件；重绘=调用方）" ];
}

// ------------------------------------------------------------
// ★★ ISSUE-20260930-02 · 详情浮层开合的**巡演验收件**（走真实点击入口）★★
//   spec：
//     · "open" / "close"          —— 目标热区**从数据推**（该动作的唯一 hit）；判词
//                                    `★INTROOPEN★` / `★INTROCLOSE★ PASS|FAIL`；
//                                    数据未落（M3 前）⇒ `★INTROOPEN-SKIP★` / `★INTROCLOSE-SKIP★`（不算失败）。
//     · "open:<元素id>" / "close:<元素id>" —— 显式指定（**负向对照**：不存在的 id / 非 hit /
//                                    动作不匹配的 hit）⇒ 必须打 `★INTROOPEN-REJECT★` /
//                                    `★INTROCLOSE-REJECT★` 且**状态不变**。
//   正向断言（逐条打印实际值）：
//     ① 归一化前置：把 flag 先置成反面值（open 步 ⇒ closed；close 步 ⇒ open），如实打印原值；
//     ② 走**真实点击入口**（顶部命中 -> `uiScreenClick` -> `uiActionDispatch`，与 handleRealClick
//        同批函数）⇒ 命中动作 == 该动作名、且 flag 已变成期望值（≠ 点击前）；
//     ③ 用引擎自己的 `uiScreenElementVisible` **复算**带该 flag 的浮层件：open ⇒ 全部可见、
//        close ⇒ 全部不可见（同谓词驱动绘制与命中 ⇒ 是「浮层真的显/隐」的直接证据）；
//     ④ open 步另加「**其余热区不可达**」：取一件**非浮层**的可见热区，在其中心做一次
//        `uiScreenClick`（**只判定、不派发**）⇒ 顶层动作必须**不是**该热区的动作（被压暗层吃掉）。
//     ⑤ close 步另加幂等：再点一次仍是 `closed`。
//   ⚠ 语义边界：本步只证明「命中 → flag 翻转 → 显隐谓词翻面」；浮层正文/标题的**真实取数**
//     属编程组（冻结书 §四 末段），本步不得也不声称已接真实数据。
// ------------------------------------------------------------
function uiScreenIntroFindHit(sc, actName)
{
	if(sc === void || sc === null || sc.elements === void || sc.elements === null) return null;
	var els = sc.elements;
	for(var i = 0; i < els.count; i++)
	{
		var e = els[i];
		if(e === void || e === null) continue;
		if(e.kind != "hit") continue;
		if(("" + e.action) == actName) return e;
	}
	return null;
}

// 一件**非浮层**的可见热区（供「其余热区不可达」探针用）；找不到返回 null。
function uiScreenIntroFindOtherHit(sc, flag)
{
	if(sc === void || sc === null || sc.elements === void || sc.elements === null) return null;
	var els = sc.elements;
	for(var i = 0; i < els.count; i++)
	{
		var e = els[i];
		if(e === void || e === null) continue;
		if(e.kind != "hit") continue;
		if(("" + e.vis_flag) == flag) continue;          // 浮层自己的热区不算
		if(!uiScreenElementVisible(e)) continue;
		return e;
	}
	return null;
}

function uiScreenSyntheticIntroToggle(spec)
{
	var C = uiScreenIntroConst();
	var sid = uiScreenCurrent();
	if(!uiScreenExists(sid) || sid != "flowchart")
		return "★INTROOPEN-SKIP★ 当前屏=" + sid + "（本步骤只在流程图屏有效，跳过）";
	var sc = UILayoutData.screens[sid];

	// ---- spec 解析：`<open|close>`（auto）或 `<open|close>:<元素id>`（显式/负向对照）----
	var s = "" + spec;
	var colon = s.indexOf(":");
	var mode = (colon >= 0) ? s.substring(0, colon) : s;
	var tid  = (colon >= 0) ? s.substring(colon + 1) : "";
	var isClose = (mode == "close");
	var actName = isClose ? C.closeAct : C.openAct;
	var wantVal = isClose ? C.closeVal : C.openVal;
	var tag    = isClose ? "★INTROCLOSE★" : "★INTROOPEN★";
	var skipTag = isClose ? "★INTROCLOSE-SKIP★" : "★INTROOPEN-SKIP★";
	var rejTag  = isClose ? "★INTROCLOSE-REJECT★" : "★INTROOPEN-REJECT★";
	var auto = (tid == "");

	// ---- auto 模式的机制前置：热区 / flag 声明 / 浮层件三样齐备才算「数据已落」----
	if(auto)
	{
		if(uiScreenIntroFindHit(sc, actName) === null)
			return skipTag + " 本屏数据无 action==" + actName
				+ " 的热区（M3 数据未落）⇒ 跳过，不做任何状态变更";
		if(!uiScreenIntroFlagDeclared(sc, C.flag))
			return skipTag + " 本屏 flags_default 未声明 " + C.flag
				+ "（M3 数据未落）⇒ 跳过，不做任何状态变更";
		if(uiScreenIntroFlagCount(sc, C.flag) <= 0)
			return skipTag + " 本屏无元素带 vis_flag=" + C.flag
				+ "（浮层件未落地）⇒ 跳过，不做任何状态变更";
	}

	// ---- 目标热区 ----
	var hit = null;
	if(auto) hit = uiScreenIntroFindHit(sc, actName);
	else     hit = uiScreenFindElementById(tid);
	var how = auto ? "auto(数据推:action)" : "explicit id";

	// ---- 守卫：全部在**任何状态变更之前**判定；不合格 ⇒ 显式 REJECT（不静默）----
	if(hit === null)
		return rejTag + " " + ((tid == "") ? "(auto)" : tid)
			+ " 不在当前屏 " + sid + " 的元素表里（『元素不存在』守卫）";
	if(hit.kind != "hit")
		return rejTag + " " + hit.id + " 不是 hit（kind=" + ("" + hit.kind)
			+ "）⇒ 它没有派发入口，点不出动作";
	if(("" + hit.action) != actName)
		return rejTag + " " + hit.id + " 的 action="
			+ ((("" + hit.action) == "") ? "(空)" : ("" + hit.action)) + "，不是 " + actName + " 热区";
	if(!uiScreenElementVisible(hit))
		return rejTag + " " + hit.id + " 当前不可见（vis_flag="
			+ ((hit.vis_flag === void || hit.vis_flag === null) ? "(无)" : ("" + hit.vis_flag))
			+ "=" + uiScreenFlagGet(hit.vis_flag) + "）⇒ 点不到";

	// ---- ① 归一化前置（如实打印原值；保证「closed ⇒ open」「open ⇒ closed」是真观测）----
	var beforeRaw = uiScreenFlagGet(C.flag);
	var preNorm = "";
	if(beforeRaw != (isClose ? C.openVal : C.closeVal))
	{
		uiScreenFlagSet(C.flag, isClose ? C.openVal : C.closeVal);
		preNorm = "（前置归一化为 " + (isClose ? C.openVal : C.closeVal) + "，原值="
			+ ((beforeRaw == "") ? "(空)" : beforeRaw) + "）";
	}
	var before = uiScreenFlagGet(C.flag);

	// ---- ② 真实点击入口（与 handleClick / M47 合成点击同批函数）----
	var hr = uiWidgetRect(hit);
	var cx = hr.x + Math.floor(hr.w / 2);
	var cy = hr.y + Math.floor(hr.h / 2);
	//   close 步注意：`fc.intro_scrim_hit` 是**整屏**热区，其中心落在面板（`fc.intro_panel_hit`，
	//   空动作＝吞点击）之内 ⇒ 必须挑一个**面板之外**、压暗层之内的点。
	if(isClose)
	{
		var panel = uiScreenFindElementById("fc.intro_panel_hit");
		if(panel !== null)
		{
			var pr = uiWidgetRect(panel);
			var cands = [[cx, hr.y + 20], [cx, hr.y + hr.h - 20], [hr.x + 20, cy], [hr.x + hr.w - 20, cy]];
			for(var ci = 0; ci < cands.count; ci++)
			{
				var px0 = cands[ci][0], py0 = cands[ci][1];
				var inside = (px0 >= pr.x && px0 < pr.x + pr.w && py0 >= pr.y && py0 < pr.y + pr.h);
				if(!inside && px0 >= hr.x && px0 < hr.x + hr.w && py0 >= hr.y && py0 < hr.y + hr.h)
				{ cx = px0; cy = py0; break; }
			}
		}
	}
	uiScreenPressUpdate(cx, cy);
	uiScreenPressClear();
	var act = "", idx = -1;
	try
	{
		var r = uiScreenClick(void, cx, cy);
		if(r !== void && r !== null)
		{
			act = (r.action === void || r.action === null) ? "" : ("" + r.action);
			idx = (r.index === void) ? -1 : r.index;
		}
	}
	catch(eC) { act = ""; }
	var msg = "";
	if(act != "")
	{
		try
		{
			var res = uiActionDispatch(act, idx);
			msg = (res !== void && res.msg !== void) ? ("" + res.msg) : "";
		}
		catch(eA) { msg = "dispatch exception: " + eA.message; }
	}
	var after = uiScreenFlagGet(C.flag);
	var okAct  = (act == actName);
	var okFlip = (after == wantVal) && (after != before);

	// ---- ③ 用引擎自己的谓词复算浮层件（open ⇒ 全可见；close ⇒ 全不可见）----
	var nVis = 0, nAll = 0, visStr = "";
	if(sc.elements !== void && sc.elements !== null)
	{
		var els2 = sc.elements;
		for(var v = 0; v < els2.count; v++)
		{
			var ev = els2[v];
			if(ev === void || ev === null) continue;
			if(("" + ev.vis_flag) != C.flag) continue;
			nAll++;
			var vis = uiScreenElementVisible(ev);
			if(vis) nVis++;
			visStr = visStr + ((nAll > 1) ? " " : "") + ("" + ev.id) + "=" + (vis ? "V" : "x");
		}
	}
	var okVis = (nAll > 0) && (isClose ? (nVis == 0) : (nVis == nAll));

	// ---- ④ open 步：其余热区不可达（取一件非浮层可见热区，中心**只判定不派发**）----
	var cover = "", okCover = true;
	if(!isClose)
	{
		var other = uiScreenIntroFindOtherHit(sc, C.flag);
		if(other === null) cover = "(本屏无非浮层可见热区 ⇒ 不适用)";
		else
		{
			var orr = uiWidgetRect(other);
			var ocx = orr.x + Math.floor(orr.w / 2), ocy = orr.y + Math.floor(orr.h / 2);
			var top = uiScreenClick(void, ocx, ocy);        // ⚠ 只判定，不派发（不改状态）
			var topAct = (top === void || top.action === void || top.action === null) ? "" : ("" + top.action);
			okCover = (topAct != ("" + other.action));
			cover = other.id + "@" + ocx + "," + ocy + " 顶层动作="
				+ ((topAct == "") ? "(空/被吞)" : topAct) + (okCover ? " ✓不可达" : " ✗**仍可达**");
		}
	}

	// ---- ⑤ close 步：幂等（再点一次仍 closed）----
	var idem = "", okIdem = true;
	if(isClose)
	{
		var act2 = "";
		try
		{
			var r2 = uiScreenClick(void, cx, cy);
			if(r2 !== void && r2 !== null) act2 = (r2.action === void || r2.action === null) ? "" : ("" + r2.action);
		}
		catch(e2) { act2 = ""; }
		if(act2 != "") { try { uiActionDispatch(act2, -1); } catch(e3) { } }
		// ★ 第 15 批订正：close 步的幂等**不能**要求「同一点再点仍派发本动作」——
		//   浮层件带 `vis_when:"open"`，关门后遮罩即不可见 ⇒ 再点**必然不派发**（act2 == ""），
		//   那正是幂等的表现。断言改为「不再派发（或仍派发本动作）**且**旗标仍为 closed」；
		//   若机制被改坏（例如再点把它翻回 open），`after2 != wantVal` 仍会 FAIL ⇒ 判据未被放松。
		okIdem = ((act2 == "") || (act2 == actName)) && (uiScreenFlagGet(C.flag) == wantVal);
		idem = "再点=" + ((act2 == "") ? "(空)" : act2) + " -> "
			+ ((uiScreenFlagGet(C.flag) == "") ? "(空)" : uiScreenFlagGet(C.flag));
	}

	var ok = okAct && okFlip && okVis && okCover && okIdem;
	return tag + " " + (ok ? "PASS" : "FAIL")
		+ "  目标=" + hit.id + "[" + how + "] 中心=" + cx + "," + cy
		+ "  ①点击前 " + C.flag + "=" + ((before == "") ? "(空)" : before) + preNorm
		+ "  ②点击=" + ((act == "") ? "(空)" : act) + " -> " + ((after == "") ? "(空)" : after)
		+ "（期望 " + wantVal + "）"
		+ "  ③引擎谓词复算 " + ((nAll > 0) ? visStr : "(无浮层件)") + " ⇒ 可见 " + nVis + "/" + nAll
		+ "  ④" + ((isClose ? ("幂等 " + idem) : ("遮罩 " + cover)))
		+ "  flag=" + C.flag
		+ "  重绘=下一步 tourTick（本步骤返回后由巡演统一 redraw）"
		+ "  浮层取数=未接（编程组）"
		+ (msg == "" ? "" : ("  msg=" + msg));
}


// ------------------------------------------------------------
// ★★ ISSUE-20260930-02 · 第 2 轮：超框省略号的**引擎侧**自检（`uiThemeWrap`）★★
//   为什么需要（一审与本轮复核共同点名的**证据缺口**）：省略号规则有三处实现 ——
//   ① 引擎 `krkr/game/ui_theme.tjs::uiThemeWrap`；② HTML `复刻/replica.js::wrapEllipsisLines`；
//   ③ Python `工具/gen_flow_layout.py::apply_ellipsis`。此前**只有 ②③ 有机器判据**
//   （`工具/test_text_ellipsis.py` 的冻结期望表两端交叉），**引擎侧只有逻辑审阅** ——
//   交付样例各槽的 `sample` 文字都太短、巡演任何一步都走不到「超框」分支 ⇒ **上机实现未被验过**。
//   本步在巡演里**直调渲染路径用的那一支**（`uiThemeWrap` 正是 `uiThemeLayoutText` 调的函数），
//   用**合成的超长中文串**触发三个分支，打 `★WRAPELLIP★ PASS|FAIL`（含每条断言的读数）。
//
//   判据（与冻结书 §五 的四条规则一一对应）：
//     · `layer` 取窗口已登记的 `UIScrMouseSink.stageLayer`（文字度量必须用引擎自己的
//       `Font.getTextWidth`），并**先**把 body 字号套上去 ⇒ 「maxW=300 对 24px」这个对应关系确定。
//       下一帧绘制会自行重设字体（`uiThemeApplyFont` 由 uiThemeLayoutText 逐元素调用）⇒ 不污染画面。
//     · 合成长串的字数按**实测字宽**反推（`need = ceil(maxW×(maxLines+2)/字宽)+8`，再与 216 取大）
//       ⇒ 保证「自然折行 > maxLines」，不赌某个固定字号（TJS2 无 `parseInt` ⇒ 用 `Math.ceil`）。
//     A 长文本 ＋ maxW=300 ＋ maxLines=4 ⇒ ① 行数 == 4；② 末行以「……」结尾（两个 U+2026）；
//       ③ 末行**实测宽 ≤ maxW**（省略号路径保证的强判据）；④ **其余行不含「……」**；
//     B 短文本（远不足 3 行）⇒ 行数 < 4 且**任何行都不含「……」**（不得误加省略号）；
//     C 极窄 maxW（保证 `maxW − 宽度("……") ≤ 0`）＋ 长文本 ⇒ **行数 == 3**（规则③「该行不画」
//       ⇒ 比 maxLines 少一行）且无「……」。
//   spec：`long`（默认；跑 A/B/C 三支）/ 其它 ⇒ `★WRAPELLIP-REJECT★`（负向对照：未知 spec
//   必须显式拒绝、不静默放过）。
//   ⚠ TJS2 约束：**无 `for...in` / 无 `lastIndexOf` / 无 `parseInt`**；字符串只用
//     `substring`/`length`/`indexOf`；宽度只用 `uiThemeTextWidth`。
// ------------------------------------------------------------
//   被验槽位的字号：冻结 §三.2 的「说明」槽与浮层正文**都是 24px**，且生成器算这两个槽的
//   `max_lines` 容量时用的也是 24px 行盒（`floor(24 × 1.4) = 33`）⇒ 本步按 24px 度量，
//   「maxW=300 对 24px」的对应关系与交付数据一致（否则测的是别的字号下的另一档容量）。
var UIScrWrapEllipSize = 24;

function uiScreenWrapEllipHasDots(lines, dots, upto)
{
	// upto < 0 ⇒ 扫全部行；否则只扫 [0, upto)
	var last = (upto < 0) ? lines.count : upto;
	for(var k = 0; k < last; k++)
		if(("" + lines[k]).indexOf(dots) >= 0) return true;
	return false;
}

function uiScreenWrapEllipEndsDots(s, dots)
{
	var t = "" + s;
	if(t.length < dots.length) return false;
	return (t.substring(t.length - dots.length) == dots);
}

function uiScreenSyntheticWrapEllip(spec)
{
	var s = "" + spec;
	if(s != "long")
		return "★WRAPELLIP-REJECT★ 未知 spec=\"" + s + "\"（本步只认 long；负向对照必须显式拒绝、不静默放过）";

	// ---- layer：与渲染路径同一个 stage（度量必须走引擎自己的 Font）----
	var layer = void;
	if(UIScrMouseSink !== null && UIScrMouseSink !== void)
	{
		try { layer = UIScrMouseSink.stageLayer; } catch(eS) { layer = void; }
	}
	if(layer === void || layer === null)
		return "★WRAPELLIP★ FAIL  度量层不可用（UIScrMouseSink.stageLayer 取不到）⇒ 无法实测，**不判 PASS**";

	var maxW = 300, maxLines = 4, maxNarrow = 24;
	var dots = UIThemeEllipsisDots;                     // "……"（两个 U+2026）

	// 套上**被验槽位自己的字号**（冻结 §三.2：说明槽 / 浮层正文均为 24px；`gen_flow_layout.py`
	// 里两槽的 `max_lines:4` 容量算式也是按 24px 行盒 33px 推的）⇒ 「maxW=300 对 24px」这个
	// 对应关系与交付数据一致，不是拿别的字号凑。下一帧绘制会自行重设字体（`uiThemeApplyFont`
	// 由 `uiThemeLayoutText` 逐元素调用）⇒ 不污染画面。
	var size = UIScrWrapEllipSize;                       // 24（＝冻结 §三.2 两槽的 font.size）
	try { uiThemeApplyFont(layer, %[ size: size ], void); }
	catch(eF) { return "★WRAPELLIP★ FAIL  字体设置失败（uiThemeApplyFont）：" + eF.message; }

	// ---- 合成长串：字数按实测字宽反推，保证「自然折行 > maxLines」----
	var unit = "字";
	var cw = uiThemeTextWidth(layer, unit);
	var n = 216;
	if(cw > 0)
	{
		var need = Math.ceil(maxW * (maxLines + 2) / cw) + 8;
		if(need > n) n = need;
	}
	var longS = "";
	for(var i = 0; i < n; i++) longS = longS + unit;
	var shortS = "章节简介短文";                        // 6 字 ⇒ 任何正常字号下都远不足 3 行

	// ---- A 长文本：四个断言 ----
	var ra = uiThemeWrap(layer, longS, maxW, maxLines);
	var la = ra.lines;
	var cntA = la.count;
	var lastA = (cntA > 0) ? ("" + la[cntA - 1]) : "";
	var lastWA = uiThemeTextWidth(layer, lastA);
	var a1 = (cntA == maxLines);
	var a2 = uiScreenWrapEllipEndsDots(lastA, dots);
	var a3 = (cntA > 0) && (lastWA <= maxW);
	var a4 = !uiScreenWrapEllipHasDots(la, dots, cntA - 1);      // 其余行（末行之前）不得含省略号
	var aTrunc = (ra.truncated === true);

	// ---- B 短文本：不得误加省略号 ----
	var rb = uiThemeWrap(layer, shortS, maxW, maxLines);
	var lb = rb.lines;
	var cntB = lb.count;
	var b1 = (cntB < maxLines);
	var b2 = !uiScreenWrapEllipHasDots(lb, dots, -1);

	// ---- C 极窄 maxW：规则③「连省略号都放不下 ⇒ 该行不画」----
	var dw = uiThemeTextWidth(layer, dots);
	var narrow = maxNarrow;
	if(dw > 0 && narrow >= dw) narrow = Math.max(1, Math.floor(dw / 2));   // 保证 maxW − dotsW ≤ 0
	var rc = uiThemeWrap(layer, longS, narrow, maxLines);
	var lc = rc.lines;
	var cntC = lc.count;
	var c1 = (cntC == maxLines - 1);
	var c2 = !uiScreenWrapEllipHasDots(lc, dots, -1);
	var cGap = narrow - dw;

	var ok = a1 && a2 && a3 && a4 && aTrunc && b1 && b2 && c1 && c2;
	return "★WRAPELLIP★ " + (ok ? "PASS" : "FAIL")
		+ "  引擎 `uiThemeWrap`（＝ `uiThemeLayoutText` 调的那一支；layer＝窗口 stageLayer）"
		+ " ｜ 字号 " + size + "px ｜ 合成串 " + n + " 字（实测单字宽 " + cw + "px）"
		+ "  A 长文本[maxW=" + maxW + ",maxLines=" + maxLines + "]：行数 " + cntA + (a1 ? " ✓" : " ✗")
		+ " ｜末行「" + lastA + "」实测 " + lastWA + "px ≤ " + maxW + (a3 ? " ✓" : " ✗")
		+ " ｜末行以「" + dots + "」结尾" + (a2 ? " ✓" : " ✗")
		+ " ｜其余 " + (cntA - 1) + " 行不含「" + dots + "」" + (a4 ? " ✓" : " ✗")
		+ " ｜truncated=" + aTrunc + (aTrunc ? " ✓" : " ✗")
		+ "  B 短文本「" + shortS + "」：行数 " + cntB + " < " + maxLines + (b1 ? " ✓" : " ✗")
		+ " ｜任何行不含「" + dots + "」" + (b2 ? " ✓" : " ✗")
		+ "  C 极窄 maxW=" + narrow + "（" + narrow + " − " + dw + " = " + cGap + " ≤ 0 ⇒ 规则③该行不画）："
		+ "行数 " + cntC + "（期望 " + (maxLines - 1) + "）" + (c1 ? " ✓" : " ✗")
		+ " ｜无「" + dots + "」" + (c2 ? " ✓" : " ✗")
		+ "  ⇒ " + (ok ? "全部通过" : "**存在失败项**");
}


//   为什么需要：环的绘制入口在 `ui_flow_layer.tjs`（post-pass），要证明它「画了、画在哪、
//   画了几个、哪些**不该**画」；本体屏数据（交付样例 screen1/screen2）**不含** `flow_state`
//   （冻结 §一.1：缺省不写 ⇒ 无环），而含五态声明的 `--preset states` 屏数据当前**引擎
//   加载不了**（生成器缺陷，见 E2 报告「阻塞项」）⇒ 在本巡演步骤里做一支**独立**取证：
//   · `set`：把 3 个节点底图**在内存里**标成 `flow_state="current"`（2 个保持可见，
//     第 3 个把 `vis_when` 改成**不可达层名**）——下一步的帧就会画 2 个环、跳过 1 个；
//   · `clear`：先读**上一帧**的环计数（由 ui_flow_layer.tjs 记）+ 打 PASS/FAIL 判词，
//     再把内存副本还原（`flow_state` / `vis_when` 逐字段回填）。
//   ★ 与 M06/M08 的「内存副本夹具」同一套路：**不写盘**，只改运行期对象；`clear` 一定还原。
//   ★ 预期：2 画 / 1 跳过 —— 后者是**冻结 §四.5「命中与绘制恒同集」**的自证
//     （`vis_when` 不满足的节点既不可点、也不画环）。
//   ★ 判词**三态**（第 2 轮补）：`★FLOWRING★ PASS|FAIL` 之外，插件/模块不可用时打
//     `★FLOWRING-SKIP★ 插件不可用（降级）`（前置判据 = `UIScrFlowLayerOK &&
//     uiFlowLayerPluginOK()`，单一来源，见 clear 分支内注释；谓词在 `ui_flow_layer.tjs`）。
// ------------------------------------------------------------
var UIScrFlowRingBackup = null;      // Array<Dictionary>：{el, prev, hasVisw, prevVisw}
var UIScrFlowRingBase = -1;        // set 步记下的**基线**：屏上原有几个 current
var UIScrFlowRingBaseSkip = -1;    // 基线里**不可见**（因而本就不画环）的几个


function uiScreenFlowRingNodeList(sc)
{
	var out = [];
	for(var i = 0; i < sc.elements.count; i++)
	{
		var el = sc.elements[i];
		if(el.kind != "image") continue;
		var sid = "" + el.id;
		if(sid.indexOf("fc.node.") != 0) continue;
		if(sid.indexOf("_") >= 0) continue;      // 只要节点**底图**（不带 _tx/_hit/_dim/_new）
		out.push(el);
	}
	return out;
}

// 找一个**不等于**当前层值的层名（用于把第 3 个节点改成不可见；不写死任何具体层名）
function uiScreenFlowRingOtherLayer(sc, cur)
{
	var lflag = "";
	if(UIScrFlowLinksOK) lflag = uiFlowLinkLayerFlagName(sc);
	if(lflag == "") return "★not-a-layer★";
	for(var i = 0; i < sc.elements.count; i++)
	{
		var el = sc.elements[i];
		if(("" + el.vis_flag) != lflag) continue;
		var w = el.vis_when;
		if(w === void || w === null) continue;
		if(("" + w) != cur) return "" + w;
	}
	return "★not-a-layer★";
}

function uiScreenSyntheticFlowRing(spec)
{
	var mode = "" + spec;
	var sid = uiScreenCurrent();
	if(!uiScreenExists(sid) || sid != "flowchart")
		return "★FLOWRING-SKIP★ 当前屏=" + sid + "（本步骤只在流程图屏有效，跳过）";
	var sc = UILayoutData.screens[sid];

	if(mode == "clear")
	{
		// ★ 顺序要紧：先读**上一帧**的环计数（那是 set 之后那一帧画的），再还原内存副本
		var drawn = UIScrFlowLayerOK ? UIFlowLayerRingDrawn : -1;
		var skip  = UIScrFlowLayerOK ? UIFlowLayerRingSkip : -1;
		var n = 0;
		if(UIScrFlowRingBackup !== null)
		{
			for(var i = 0; i < UIScrFlowRingBackup.count; i++)
			{
				var b = UIScrFlowRingBackup[i];
				b.el.flow_state = b.prev;
				if(b.hasVisw === true) b.el.vis_when = b.prevVisw;
				n++;
			}
			UIScrFlowRingBackup = null;
		}
		// ★★ 前置判据（**单一来源** · 主代理 2026-09-28 裁决 · ISSUE-20260928-02 第 2 轮）：
		//   `UIScrFlowLayerOK && uiFlowLayerPluginOK()` 为假 ⇒ 模块/插件不可用 ⇒「实画 0」
		//   是**降级预期**、不是失败 ⇒ 打 `★FLOWRING-SKIP★`，**不做计数判定**
		//   （与连线模块的 `LINK=FAIL` 同一口径，不混为一谈）。判据只此**一处**，
		//   不复制第二个条件表达式（复制即两处分叉的种子）。
		//   · 短路求值已核源码：`tjs2/tjsInterCodeGen.cpp:1412-1435`（`T_LOGICALAND`）
		//     注释原文 "AND : does not evaluate right when left results false"
		//     ⇒ `UIScrFlowLayerOK` 为假时**不会**去调未定义的 `uiFlowLayerPluginOK()`
		//       （否则会抛「未找到 Member」——本工程纪律：不用抛异常当控制流）。
		//   · 位置在**还原内存副本之后** ⇒ 这条被拒路径同样不留残留状态。
		if(!(UIScrFlowLayerOK && uiFlowLayerPluginOK()))
			return "★FLOWRING-SKIP★ 插件不可用（降级）"
				+ "  layerExDraw 未挂载 ⇒ 环本就画不出（上一帧环实画="
				+ (UIScrFlowLayerOK ? ("" + drawn) : "未记录") + "，本步不做计数判定）"
				+ "  已还原 " + n + " 件（本步骤不写盘）";
		// ★ 判词口径 = **增量**，不是绝对数：屏上原有 N 个 current（states 预设里有 2 个）
		//   是**数据**，注入的 3 件是**本次增量**；首版写成「期望恒为 2/1」⇒ 在 states 预设
		//   上真画了 4 个却判 FAIL（错的是判词，不是机制 —— 实机轮已暴露并修正）。
		var eb = (UIScrFlowRingBase < 0) ? 0 : UIScrFlowRingBase;
		var ebs = (UIScrFlowRingBaseSkip < 0) ? 0 : UIScrFlowRingBaseSkip;
		var wantDrawn = eb + 2;
		var wantSkip  = ebs + 1;
		var ok = (drawn == wantDrawn) && (skip == wantSkip);
		return "★FLOWRING★ " + (ok ? "PASS" : "FAIL")
			+ "  内存注入=3 件（2 可见 + 1 隐藏）"
			+ "  基线（注入前）=" + eb + " 个 current（其中不可见 " + ebs + "）"
			+ "  上一帧环实画=" + drawn + "（期望 基线+" + 2 + "=" + wantDrawn + "）"
			+ "  跳过=" + skip + "（期望 基线不可见+" + 1 + "=" + wantSkip
			+ "：隐藏节点**不画环** ⇒ 冻结 §四.5 命中与绘制同集）"
			+ "  已还原 " + n + " 件"
			+ "  （判据：`ui_flow_layer.tjs` 的 rings 行；本步骤不写盘）";
	}

	// ---- set：内存副本注入 ----
	var nodes = uiScreenFlowRingNodeList(sc);
	if(nodes.count < 3)
		return "★FLOWRING-SKIP★ 本屏节点底图只找到 " + nodes.count + " 件（<3），跳过";

	// ★ 先记基线（注入前）：屏上原有几个 `flow_state=="current"`、其中几个不可见
	//   —— 判词要按**增量**判（见 clear 步注释：首版写成绝对数，在 states 预设上误判）。
	UIScrFlowRingBase = 0;
	UIScrFlowRingBaseSkip = 0;
	for(var b0 = 0; b0 < sc.elements.count; b0++)
	{
		var e2 = sc.elements[b0];
		if(e2.kind != "image") continue;
		var s2 = e2.flow_state;
		if(s2 === void || s2 === null || ("" + s2) != "current") continue;
		UIScrFlowRingBase = UIScrFlowRingBase + 1;
		if(!uiScreenElementVisible(e2)) UIScrFlowRingBaseSkip = UIScrFlowRingBaseSkip + 1;
	}
	var cur = "";
	if(UIScrFlowLinksOK)
	{
		var lf = uiFlowLinkLayerFlagName(sc);
		if(lf != "") cur = uiScreenFlagGet(lf);
	}
	var other = uiScreenFlowRingOtherLayer(sc, cur);
	UIScrFlowRingBackup = [];
	var ids = "";
	for(var k = 0; k < 3; k++)
	{
		var el = nodes[k];
		var b = %[ el: el, prev: el.flow_state, hasVisw: false, prevVisw: void ];
		el.flow_state = "current";
		if(k == 2)
		{
			// 第 3 件：**可见性守卫的负向对照** —— 把它的 vis_when 改成不可达层名
			b.hasVisw = true;
			b.prevVisw = el.vis_when;
			el.vis_when = other;
		}
		UIScrFlowRingBackup.push(b);
		ids = ids + ((k > 0) ? "," : "") + ("" + el.id);
	}
	return "★FLOWRING-SET★ 已在**内存**里注入 3 件 current（不写盘）：" + ids
		+ "  ｜ 第 3 件 vis_when " + ((UIScrFlowLayerOK) ? "改为不可达层名" : "改为不可达值")
		+ "「" + other + "」（当前层值=「" + ((cur == "") ? "(空)" : cur) + "」）"
		+ "  ｜ 下一帧应画 2 个环（节点矩形内缩 1px / r=16 / w=3 / @palette.node_current，"
		+ "post-pass 画在全部节点之上）";
}

// ★ M47：合成拖动（巡演验收用）—— spec 形如 `<hit 元素id>:<目标值>`
//   走的是与真实鼠标**同一批入口**：uiScreenPressUpdate（按下）→ uiScreenHoverUpdate（移动）
//   → uiScreenPressClear（抬起），即 startup.tjs 的 onMouseDown / onMouseMove / onClick
//   三个处理器内部调用的同三个函数（真实鼠标事件本身不产生 —— 与 uiScreenSyntheticPointer
//   同款局限；这是「机制级」验收，不是「真实输入设备」验收）。
//   判词 `★M47DRAG★ PASS|FAIL` 直接落进巡演日志，比对两件事（方案 §五 验收计划 1）：
//     ① 设置值 == 目标值（**按 step 对齐后**）；
//     ② 设置页预览遮罩 `cfg.pv_mask` 的 opacity == floor(255 * 设置值 / 100)
//        —— 该值**读的是真 ctx**（uiScreenCtx 返回的 ctx.opacityOverride），
//        故「把 ctx 里的写入删掉」这类变异会让本判词立刻 FAIL（变异自证）。
//   负向对照：不存在的 id / 非 hit / 未带 `slider` 字段 / 当前不可见 ⇒ `★M47DRAG-REJECT★`
//   （照 M46 的 `★M46PTR-REJECT★` 先例）。★ 全部守卫在**任何状态变更之前**判定
//   ⇒ 被拒的调用绝不污染拖动状态（不会留下半截拖动）。
// ------------------------------------------------------------
function uiScreenSyntheticDrag(spec)
{
	var s = "" + spec;
	var p1 = s.indexOf(":");
	if(p1 <= 0) return "★M47DRAG-REJECT★ spec 应为 <hit元素id>:<目标值>[:<期望遮罩>]，实收 " + s;
	var hitId = s.substring(0, p1);
	var rest  = s.substring(p1 + 1);
	// ★ 一审 M1：可选第三段 = **期望的遮罩 opacity 字面量**（例如 目标 40 ⇒ 102）。
	//   给了就用它当期望（**独立常量**，不是拿运行期值现算）；没给才回落到「按目标值算」。
	var wantLiteral = -1;
	var p2 = rest.indexOf(":");
	if(p2 >= 0)
	{
		wantLiteral = uiFlowAtoi(rest.substring(p2 + 1));
		rest = rest.substring(0, p2);
	}

	var sid = uiScreenCurrent();
	if(!uiScreenExists(sid)) return "★M47DRAG-REJECT★ 当前屏 " + sid + " 未登记，无法定位滑块";

	var hit = uiScreenFindElementById(hitId);
	if(hit === null) return "★M47DRAG-REJECT★ 当前屏 " + sid + " 无元素 " + hitId + "（走『元素不存在』守卫）";
	if(hit.kind != "hit") return "★M47DRAG-REJECT★ " + hitId + " 不是 hit（kind=" + ("" + hit.kind) + "）";
	if(hit.slider === void || hit.slider === null || ("" + hit.slider) == "")
		return "★M47DRAG-REJECT★ " + hitId + " 未带 slider 字段（不是滑块命中热区）";
	if(!uiScreenElementVisible(hit))
		return "★M47DRAG-REJECT★ " + hitId + " 当前不可见（vis_flag="
			+ ((hit.vis_flag === void || hit.vis_flag === null) ? "(无)" : ("" + hit.vis_flag))
			+ "，多半是所在页签未激活）";
	var slEl = uiScreenFindElementById("" + hit.slider);
	if(slEl === null || slEl.kind != "slider")
		return "★M47DRAG-REJECT★ 热区指向的 " + ("" + hit.slider) + " 不是本屏的 slider 元素";

	// 目标值：先按 step 对齐（用「值→x→值」往返一次，与拖动实际写入的值**逐位相同**）
	var target = uiWidgetSliderValueAt(slEl, uiWidgetSliderXOf(slEl, uiFlowAtoi(rest)));

	// 按下点取**热区中心**（必定落在热区矩形内 ⇒ 一定命中该热区）
	var hr = uiWidgetRect(hit);
	var px = hr.x + Math.floor(hr.w / 2);
	var py = hr.y + Math.floor(hr.h / 2);
	var xt = uiWidgetSliderXOf(slEl, target);
	uiScreenPressUpdate(px, py);        // ① 按下（命中带 slider 的热区 ⇒ 进入拖动）
	uiScreenHoverUpdate(xt, py);        // ② 移动（拖动语义：不因移出热区而取消）
	uiScreenPressClear();               // ③ 抬起（结束拖动）

	var settingKey = (slEl.setting === void || slEl.setting === null) ? "" : ("" + slEl.setting);
	var gotSlider  = uiWidgetSliderValue(slEl);
	var gotSet     = (settingKey == "") ? gotSlider : UISettingGet(settingKey);
	// ★ 一审 M1：**走真正的对话框路径**取「对话框遮罩」——
	//   旧实现从**当前屏（config）**的 uiScreenCtx 读 `dlg.mask_bottom`，与 want 同源同式 ⇒
	//   只证明了「uiScreenCtx 里那两个键存在」，**没覆盖 uiDialogBuildCtx 的写入**
	//   （HTML 侧 ⑲c 反而真的切到 dialog 屏读了）。现在改用 `uiDialogBuildCtx` 现构一次
	//   dialog 屏的 ctx 再读该键 —— 构造器需要 stage（要做文字度量），故借用窗口已登记的
	//   `UIScrMouseSink.stageLayer`（startup.tjs 的 UiWindow 成员）；拿不到 / 构造失败则记 -1
	//   （判词随即 FAIL，绝不静默放过）。
	var dlgMb = -1;
	var stage = void;
	if(UIScrMouseSink !== null && UIScrMouseSink !== void)
	{
		try { stage = UIScrMouseSink.stageLayer; } catch(eS) { stage = void; }
	}
	var dsc = UILayoutData.screens["dialog"];
	if(stage !== void && dsc !== void && dsc !== null && dsc.elements !== void)
	{
		try
		{
			var dctx = uiDialogBuildCtx(stage, dsc);
			if(dctx !== void && dctx !== null && dctx.opacityOverride !== void && dctx.opacityOverride !== null)
			{
				var a0 = dctx.opacityOverride["dlg.mask_bottom"];
				if(a0 !== void && a0 !== null) dlgMb = a0;
			}
		}
		catch(eD) { dlgMb = -1; }
	}
	// 设置页预览遮罩仍从当前屏 ctx 读（它本来就该由 uiScreenCtx 提供）
	var pv = -1;
	var ctx = uiScreenCtx(UILayoutData.screens[sid]);
	if(ctx.opacityOverride !== void && ctx.opacityOverride !== null)
	{
		var a1 = ctx.opacityOverride["cfg.pv_mask"];
		if(a1 !== void && a1 !== null) pv = a1;
	}
	// 期望值：优先用 spec 里的**独立字面量**；否则按**目标值**（不是运行期 gotSet）现算
	var want = (wantLiteral >= 0) ? wantLiteral : Math.floor(255 * target / 100);
	var ok = (target == gotSet) && (pv == want) && (dlgMb == want);
	var raw = UIScrSliderVal["" + slEl.id];

	return "★M47DRAG★ " + (ok ? "PASS" : "FAIL")
		+ "  " + hitId + " 目标=" + target
		+ "  实际设置值=" + gotSet
		+ "  滑块=" + ("" + slEl.id)
		+ "  设置键=" + ((settingKey == "") ? "(纯视觉，不写仓)" : settingKey)
		+ "  预览遮罩 opacity=" + pv + "（期望 " + want + "）"
		+ "  对话框遮罩 opacity=" + dlgMb + "（期望 " + want + "，取自 uiDialogBuildCtx 现构的 dialog ctx）"
		+ "  页签=" + ((uiScreenFlagGet("cfg_page") == "") ? "(未设)" : uiScreenFlagGet("cfg_page"))
		+ "  滑块仓值=" + ((raw === void || raw === null) ? "(空)" : ("" + raw))
		+ "  拖动已结束=" + ((UIScrDragSlider == "") ? 1 : 0)
		+ "  写仓次数=" + UISettingSetCalls;
}

// ------------------------------------------------------------
// 屏绘制
// ------------------------------------------------------------
function uiScreenDraw(stage)
{
	UIScrDrawCount++;
	var id = uiScreenCurrent();
	if(id == "") return 0;

	uiScreenMarkSeen(id);
	UIScrPlaceholder = "";

	if(!uiScreenExists(id))
	{
		UIScrPlaceholder = "layout 中没有屏 \"" + id + "\"（M4/M5 未交付或 _index.json 未登记）";
		uiScreenDrawPlaceholder(stage, id, UIScrPlaceholder);
		return -1;
	}

	var sc = UILayoutData.screens[id];
	// ★ M13：浮层屏（屏对象带 overlay:true，如 sysicons）—— 先把**它下面那一屏**画出来，
	//   再叠自己。本渲染器只画栈顶屏（不做整栈合成），若不补这一步，「全屏压暗遮罩」
	//   压的是一张被清空的透明画面（实机表现为纯黑），而不是游戏画面。
	//   下面那一屏若是 dialog，仍走它的状态机（打字机/选择肢状态不丢）。
	if(sc.overlay === true && UIScrStack.count >= 2)
	{
		var underId = "" + UIScrStack[UIScrStack.count - 2];
		var under = UILayoutData.screens[underId];
		if(under !== void && under.elements !== void)
		{
			// ★ M18：下层屏的重绘套 try/catch。本块在**每一帧**都会跑（blinkTimer 120ms
			//   一次 redraw），若下层渲染抛错，异常会从 uiScreenDraw 一路冒到 startup.tjs 的
			//   redraw，使本帧整体失败（浮层与下层同时消失）。这里降级为「只画浮层」并
			//   去重记一行，绝不让单帧异常扩散。
			try
			{
				uiWidgetDrawScreenBg(stage, under);
				// ★ ISSUE-20260927-05（E2）：下层若是流程图屏，同样走**分层绘制**
				//   （否则右键呼出浮层时流程图屏的连线会凭空消失；口径与主路径逐字一致）。
				//   本分支与主路径一样丢弃返回值（原实现即如此，只画不计数）。
				if(underId == "dialog") uiDialogDraw(stage, under);
				else if(underId == "flowchart" && UIScrFlowLinksOK)
				{
					uiFlowLinksDrawScreenLayered(stage, under, uiScreenCtx(under));
					// ★ 第 2 步：下层流程图屏的 current 环同样要画（口径与主路径逐字一致；
					//   否则右键呼出浮层时环会凭空消失）
					if(UIScrFlowLayerOK) uiFlowLayerDrawRings(stage, under, uiScreenCtx(under));
				}
				else uiWidgetDrawScreen(stage, under, uiScreenCtx(under));
				// ★ B2（2026-09-22）：下层承载屏的**附加层**也要叠 —— 否则浮层弹出时
				//   下层的竖条把手凭空消失（HTML 端 replica.js 的浮层下层重画路径同样调用
				//   附加层渲染，两端必须一致）。注意：浮层自身的 attach 由 uiScreenDraw
				//   末尾那次（针对当前屏）负责，此处只管下层。
				uiScreenDrawAttach(stage, underId);
			}
			catch(eUnder)
			{
				var ekey = "ERR>" + underId + ">" + id;
				if(UIScrOverlayLogged[ekey] !== true)
				{
					UIScrOverlayLogged[ekey] = true;
					Debug.message("[UI][OVERLAY][ERR] 下层屏 " + underId
						+ " 重绘失败，本帧仅绘制浮层 " + id + "：" + eUnder.message);
				}
			}
			// 每对 (下层, 浮层) 只记一次，否则闪烁重画会每 120ms 刷一行
			var okey = underId + ">" + id;
			if(UIScrOverlayLogged[okey] !== true)
			{
				UIScrOverlayLogged[okey] = true;
				Debug.message("[UI][OVERLAY] 先绘制下层屏 " + underId + "，再叠 " + id
					+ "（本对只记一次）");
			}
		}
		else
		{
			Debug.message("[UI][OVERLAY] 下层屏 " + underId + " 无布局数据，浮层将叠在空画面上");
		}
	}
	uiWidgetDrawScreenBg(stage, sc);

	// 对话框屏有专用状态机（打字机 / 光标 / 选择肢）；
	// 流程图屏走**分层绘制**（契约 §三.1）：连线夹在「压暗/视口底板」与「节点族」之间，
	// 由 ui_flow_links.tjs 按 `linksZ = min(fc.node.* 的 z) − 1` 自动切两趟。
	// 无 `links` / 插件缺件 / 模块缺失时该入口**内部回落**为原样单趟，行为与本行不存在时一致。
	var drawn = 0;
	if(id == "dialog") drawn = uiDialogDraw(stage, sc);
	else if(id == "flowchart" && UIScrFlowLinksOK)
	{
		drawn = uiFlowLinksDrawScreenLayered(stage, sc, uiScreenCtx(sc));
		// ★★ ISSUE-20260928-02（第 2 步）：`flow_state=="current"` 的**高亮环** = post-pass。
		//   在整屏（含连线分层两趟）绘制**之后**调用 ⇒ 「画在全部节点之上」由调用次序保证
		//   （语义层 z 取 max(fc.node.* z)+6，见 ui_flow_layer.tjs）。
		//   返回值**不计入 drawn**：本处 `drawn` 的口径是「实绘**元素**条数」（与单趟一致，
		//   连线当初也按同一口径处理），环条数另有 `[UI][FLOWLAYER] rings …` 一行。
		if(UIScrFlowLayerOK) uiFlowLayerDrawRings(stage, sc, uiScreenCtx(sc));
	}
	else drawn = uiWidgetDrawScreen(stage, sc, uiScreenCtx(sc));

	// ★ M2 契约①：承载屏画完后，再按普通屏的方式叠画它的**附加层**（屏级 `attach`）。
	//   叠画不改屏栈语义：uiScreenCurrent() 仍是承载屏；返回值把叠画的元素数一并计入
	//   （巡演日志的「实绘元素」因此包含附加层）。
	drawn += uiScreenDrawAttach(stage);

	return drawn;
}

// 「模块未接入 / 屏未登记」占位：几何全部由 canvas 与 fonts 推出，无硬编码坐标
function uiScreenDrawPlaceholder(stage, id, reason)
{
	var W = uiThemeCanvasW();
	var H = uiThemeCanvasH();
	stage.colorRect(0, 0, W, H, uiThemePalette("backdrop"), uiThemePalette("backdrop_opa"));

	var fTitle = uiThemeApplyFont(stage, %[
		size: uiThemeFontSize("title"),
		color: uiThemePalette("text_title"),
		shadow: true, shadow_color: uiThemePalette("shadow"), shadow_ofs: 0
	], void);
	var fBody = uiThemeApplyFont(stage, %[
		size: uiThemeFontSize("body"),
		color: uiThemePalette("text_hint"),
		shadow: true, shadow_color: uiThemePalette("shadow"), shadow_ofs: 0
	], void);

	var lines = [ "模块未接入 / 屏未登记：", "" + id, "" + reason ];
	var blockH = fTitle.lineH + fBody.lineH * (lines.count - 1);
	var y = Math.floor((H - blockH) / 2);

	// 第一行用 title 字号
	var s0 = lines[0];
	var x0 = Math.floor((W - uiThemeTextWidth(stage, s0)) / 2);
	uiThemeDrawLine(stage, x0, y, s0, fTitle, 255);
	y += fTitle.lineH;

	for(var i = 1; i < lines.count; i++)
	{
		var s = lines[i];
		var x = Math.floor((W - uiThemeTextWidth(stage, s)) / 2);
		uiThemeDrawLine(stage, x, y, s, fBody, 255);
		y += fBody.lineH;
	}
	return 1;
}

// ------------------------------------------------------------
// 动作表（layout/_schema.md §六 的跨组契约；本模块是"演示层实现"）
//   返回 %[ handled:, effect:, msg: ]；effect = "" | "quit" | "hide_window"
// ------------------------------------------------------------
function uiScreenMapOpen(action)
{
	// ★ M2（契约④）：「open_sysmenu -> sysmenu」这条映射**已移除** —— 该动作的语义改为
	//   「展开竖排快捷条（不钉住）」，由 uiActionDispatch 直接处理（见 open_sysmenu 分支）。
	//   ★ M45（2026-09-23，用户裁定）：传统系统菜单屏 `sysmenu` **已废除**（不再是「保留不删」）——
	//   屏文件与 `_index.json` 条目已删除、巡演白名单本就不含它（见 uiTourCollectScreenIds），
	//   快照归档 `_工作\M45_旧素材归档\`。全库唯一曾能打开它的动作 `open_sysmenu` 语义早已改变。
	// ★ M43（2026-09-23，用户裁定）：「open_chapter -> chapter」这条映射**已删除** ——
	//   `chapter` 屏（`30_chapter.json`）已整体移除，其「进入剧情」能力迁到流程图屏的
	//   既有按钮 `fc.jump_hit`（动作 `flow_enter`，由 `ui_flow.tjs` 包装的 uiActionDispatch 处理）。
	var map = %[
		open_save: "save", open_load: "load", open_config: "config",
		open_backlog: "backlog", open_gallery: "gallery", open_music: "music",
		open_fragment: "fragment", open_flowchart: "flowchart"
	];
	var v = map["" + action];
	return (v === void) ? "" : v;
}

function uiScreenActionListForCurrent()
{
	var id = uiScreenCurrent();
	if(!uiScreenExists(id)) return "";
	if(UIScrActiveList != "") return UIScrActiveList;
	var els = UILayoutData.screens[id].elements;
	for(var i = 0; i < els.count; i++)
	{
		var el = els[i];
		if(el.kind == "list" && el.scroll !== void) return "" + el.id;
	}
	return "";
}

// ------------------------------------------------------------
// ★ M47：动作名解析小工具 + 命中热区取值（供 config_set_<键> 的 ON/OFF 值按钮用）
//   TJS2 没有 String.startsWith / lastIndexOf（见 引擎工作原理.md §5.1），故：
//     前缀判定 = indexOf(prefix) == 0；后缀 = substring(prefix.length)（**单参数**取到末尾；
//     注意 substring(start, count) 的第二参是**长度**，见 uiScreenRevealKeyOfId 的实测记录）。
// ------------------------------------------------------------
function uiScreenActionHasPrefix(act, prefix)
{
	return ("" + act).indexOf("" + prefix) == 0;
}

function uiScreenActionSuffix(act, prefix)
{
	var a = "" + act;
	var p = "" + prefix;
	if(a.indexOf(p) != 0) return "";
	return a.substring(p.length);
}

// (x,y) 处命中的、`action == act` 的**可见 hit** 上挂的 `value`（取最高 z，同 z 声明在后者胜）
//   无命中 → ""。★ 只在指针坐标有效（>= 0）时才判定。
function uiScreenActionHitValueAt(act, x, y)
{
	if(x < 0 || y < 0) return "";
	var sid = uiScreenCurrent();
	if(!uiScreenExists(sid)) return "";
	var els = UILayoutData.screens[sid].elements;
	var bestZ = -1, bestV = "";
	for(var i = 0; i < els.count; i++)
	{
		var el = els[i];
		if(el === void || el === null) continue;
		if(el.kind != "hit") continue;
		if(("" + el.action) != act) continue;
		if(!uiScreenElementVisible(el)) continue;
		var r = uiWidgetRect(el);
		if(x < r.x || x >= r.x + r.w || y < r.y || y >= r.y + r.h) continue;
		var z = uiWidgetNum(el, "z", 0);
		if(z < bestZ) continue;
		bestZ = z;
		bestV = (el.value === void || el.value === null) ? "" : ("" + el.value);
	}
	return bestV;
}

// 取某动作的「值」（方案 §三.4：ON/OFF 两个热区各带 `value:"on"|"off"`，动作名同为 config_set_<键>）。
//   解析顺序（每层都有明确理由）：
//     ① 指针位置上命中的同动作热区 —— 鼠标点击路径（onMouseMove → onMouseDown 已写指针坐标）
//        与巡演 ptr 路径都能走到，是**首选**；
//     ② 动作串自带 `:<值>` 后缀 —— 兼容 `config_set_<键>:on` 写法（方案允许该风格）；
//     ③ 全屏扫同动作热区：**只有唯一一个非空 value** 时才采用
//        （两件同 action 却给了不同 value ⇒ 无法判定被点的是谁，不猜、回报取不到）；
//   三者皆空 → ""（调用方回报「取不到 on/off」，不静默当 on 处理）。
function uiScreenActionHitValue(act)
{
	var a = "" + act;
	var v1 = uiScreenActionHitValueAt(a, UIScrPointerX, UIScrPointerY);
	if(v1 != "") return v1;
	var c = a.indexOf(":");
	if(c > 0)
	{
		var v2 = a.substring(c + 1);
		if(v2 != "") return v2;
	}
	var sid = uiScreenCurrent();
	if(!uiScreenExists(sid)) return "";
	var els = UILayoutData.screens[sid].elements;
	var seen = "", dup = false;
	for(var i = 0; i < els.count; i++)
	{
		var el = els[i];
		if(el === void || el === null) continue;
		if(("" + el.action) != a) continue;
		var v = (el.value === void || el.value === null) ? "" : ("" + el.value);
		if(v == "") continue;
		if(seen == "") seen = v;
		else if(seen != v) dup = true;
	}
	return dup ? "" : seen;
}

function uiActionDispatch(action, index)
{
	var act = "" + action;
	uiScreenNote("action " + act + ((index === void) ? "" : (" idx=" + index)));

	// ---- 栈操作 ----
	if(act == "game_start")
	{
		uiDialogReset();
		uiScreenPush("dialog");
		return %[ handled: true, effect: "", msg: "开始新游戏（真实语料演示）" ];
	}
	if(act == "game_continue")
	{
		uiDialogReset();
		UIDlgLine = UIStateDialogLine;
		if(UIDlgLine < 0 || UIDlgLine >= UIDemoLineCount) UIDlgLine = 0;
		uiDialogStartTyping();
		uiScreenPush("dialog");
		return %[ handled: true, effect: "", msg: "继续（读回上次台词序号 " + UIDlgLine + "）" ];
	}
	if(act == "open_title")
	{
		uiScreenReset("title");
		return %[ handled: true, effect: "", msg: "返回标题" ];
	}
	if(act == "close")
	{
		var ok = uiScreenPop();
		return %[ handled: true, effect: "", msg: ok ? "关闭当前层" : "已在栈底" ];
	}
	if(act == "quit_game")
	{
		UIScrQuitRequest = true;
		return %[ handled: true, effect: "quit", msg: "退出游戏" ];
	}
	if(act == "hide_window")
	{
		return %[ handled: true, effect: "hide_window", msg: "切换窗口显示" ];
	}

	// ---- ★ ISSUE-20260930-02（章节详情）· 详情浮层的开合（纯屏级 flag 翻转）----
	//   动作名与 flag 名是**冻结接口**（`_工作\ISSUE-20260930-02_章节详情\接口冻结.md` §四）：
	//     `flow_intro_open`  ← `fc.p_plus_hit`      ⇒ `fc_intro` 置 `open`
	//     `flow_intro_close` ← `fc.intro_scrim_hit` ⇒ `fc_intro` 置 `closed`
	//   实现见 `uiScreenIntroApply()`（含三条**优雅降级**守卫：无屏 / 未声明 flag / 无浮层件；
	//   三者一律 `handled:false` + 可读 msg、**状态不变**，绝不抛异常）。
	//   重绘由调用方（`startup.tjs` 的 handleClick / 巡演 uiTourStep 派发后统一 redraw）。
	if(act == UIScrIntroOpenActFallback || act == UIScrIntroCloseActFallback)
	{
		var CI = uiScreenIntroConst();
		return uiScreenIntroApply((act == CI.openAct) ? CI.openVal : CI.closeVal, act);
	}

	// ---- M2 契约④：竖排快捷条 ----
	//   open_sysmenu：**不再打开传统菜单屏**，改为「展开竖条（不钉住、撤销收起计时）」。
	//   ★ M37：数据里已无元素指向本动作（整条把手 `quick.hit_toggle` 随 M37 形态重构退场）
	//     ⇒ 它是**编程入口**（深链 / 将来的键盘快捷键 / 附加层里 action 留空的 hit 兜底，
	//     见 uiScreenAttachClick）；Esc **不**挂它（H1 裁决：Esc = 返回上一层 / 退出）。
	if(act == UIScrQuickToggleAct)
	{
		return %[ handled: true, effect: "", msg: uiQuickbarOpen() ];
	}
	//   quick_pin：切换钉住（`reveal.pin_flag` 的 "1" ↔ ""）；钉住时**立即展开且不再自动收起**。
	//   ★ 修复 2：flag 名读数据（`reveal.pin_flag`），脚本内不再出现 `qbar_pin` 字面量。
	if(act == "quick_pin")
	{
		if(uiScreenRevealScreen() === null)
			return %[ handled: false, effect: "",
				msg: "当前屏无竖排快捷条（layout 无 reveal 数据），quick_pin 忽略" ];
		var pinName = uiScreenRevealPinFlagName();
		if(pinName == "")
			return %[ handled: false, effect: "",
				msg: "当前屏 reveal 未声明 pin_flag，quick_pin 忽略" ];
		var wasPin = (uiScreenFlagGet(pinName) == UIScrQuickPinOn);
		uiScreenFlagSet(pinName, wasPin ? "" : UIScrQuickPinOn);
		if(wasPin) return %[ handled: true, effect: "",
			msg: "取消钉住（指针离开右端后按 delay_ms 自动收起）" ];
		uiQuickbarOpen();     // 钉住时立即展开
		return %[ handled: true, effect: "", msg: "钉住竖条（不再自动收起，已展开）" ];
	}

	// ---- ★ M47：设置（config）屏 —— 分页 / 角色选中 / ON·OFF 值按钮 / 初始化 ----
	//   动作名与 flag 名是**冻结接口**（方案 §三.4 与 §四「接口冻结项」），HTML 侧同名：
	//     config_tab_1 / config_tab_2  → 页签（cfg_page = "sys" / "snd"）
	//     config_char_<族>             → 角色语音设定选中（cfg_vchar = "<族名>"）
	//     config_set_<键>              → ON/OFF 值按钮（cfg_v_<键> = 该热区自带的 value）
	//     config_reset                 → 全部设置恢复默认 + 回系统页
	//   ⚠️ 本作只做**两页**（方案 §一 用户要求）；旧数据里的 config_tab_3/4 若仍存在，
	//      会落到函数末尾的「未实现的动作」并如实记一行（不静默吞掉）。
	if(act == "config_tab_1" || act == "config_tab_2")
	{
		var page = (act == "config_tab_2") ? "snd" : "sys";
		var chp = uiScreenFlagSet("cfg_page", page);
		// ★ M47 追补：切页后**按数据导出的「值键 → 页」映射**重新派生值标志
		//   （新页的键 = 仓值；非新页的键 = 空串）⇒ 挡掉值元素的跨页泄漏。
		//   详见 uiScreenConfigSyncPage 的长注释。
		var nsync = uiScreenConfigSyncPage(page);
		return %[ handled: true, effect: "",
			msg: "配置页签 -> " + ((page == "snd") ? "声音" : "系统") + "（cfg_page=" + page
				+ "；值键派生 " + nsync + " 项）"
				+ "｜泄漏检查：cfg_v_display=" + uiScreenConfigValueLabel("cfg_v_display")
				+ " cfg_v_facewindow=" + uiScreenConfigValueLabel("cfg_v_facewindow")
				+ " cfg_v_mute_vol_se=" + uiScreenConfigValueLabel("cfg_v_mute_vol_se")
				+ " cfg_vchar=" + uiScreenConfigValueLabel("cfg_vchar")
				+ (chp ? "" : "（原本已在该页）") ];
	}
	if(act == "config_reset")
	{
		var nres = uiSettingResetAll();
		uiScreenConfigMemoClear();              // ★ 追补：初始化 ⇒ 连「切页值记忆」一起清
		                                        //   （否则旧记忆会盖住刚恢复的默认值，见 uiScreenConfigVarMemo 区块注释）
		uiScreenFlagSet("cfg_page", "sys");     // 参考作「初始化」的观感：回到系统页
		// ★ M47 追补：初始化后值键也要按系统页重新派生（重置了仓值 ⇒ 标志必须跟着回到默认）
		uiScreenConfigSyncPage("sys");
		return %[ handled: true, effect: "",
			msg: "初始化：恢复默认并回到系统页（" + nres + " 项）＋清空切页记忆；" + UISettingMsg ];
	}
	if(uiScreenActionHasPrefix(act, "config_char_"))
	{
		var fam = uiScreenActionSuffix(act, "config_char_");
		if(fam == "") return %[ handled: false, effect: "", msg: "config_char_ 之后缺族名：" + act ];
		uiScreenConfigMemoSet("cfg_vchar", fam);   // ★ 追补：切页值记忆（cfg_vchar 无设置项，只靠它存活）
		var chc = uiScreenFlagSet("cfg_vchar", fam);
		// ★ 追补：写完后按**当前页**重派生一次 —— 若当前不在声音页（例如在系统页上程序化派发
		//   config_char_kob），选中值必须**只进记忆、不上屏**（否则 `cfg_vchar` 会让声音页的
		//   角色名胶囊/选中文字这批**只带 cfg_vchar、不带 cfg_page** 的值元素在系统页显形 ⇒ 泄漏）。
		//   与 config_set_ 分支同一条口径；切回声音页时按三级优先链把选择恢复出来。
		uiScreenConfigSyncPage(uiScreenFlagGet("cfg_page"));
		return %[ handled: true, effect: "",
			msg: "角色语音设定选中 -> " + fam + "（cfg_vchar="
				+ uiScreenConfigValueLabel("cfg_vchar") + "，记忆="
				+ ((uiScreenConfigMemoHas("cfg_vchar")) ? uiScreenConfigMemoOf("cfg_vchar") : "(无)")
				+ "）" + (chc ? "" : "（原本已是选中项）") ];
	}
	if(uiScreenActionHasPrefix(act, "config_set_"))
	{
		var ckey = uiScreenActionSuffix(act, "config_set_");
		// ★ 动作串可带 `:<值>` 后缀（`config_set_<键>:<值>`，程序化派发 / 巡演用）⇒ 键名截到冒号前
		var ccolon = ckey.indexOf(":");
		if(ccolon >= 0) ckey = ckey.substring(0, ccolon);
		var cflag = "cfg_v_" + ckey;
		// ★ 值的口径（**照 W2 的真实数据**，不是只认 on/off）：热区带 `value:"<任意串>"`
		//   ⇒ `cfg_v_<键>` 置成该串。W2 数据里就有两种值域：
		//     · ON/OFF 类：`value:"on"|"off"`（facewindow/drama/effect/…，flags_default 里就是 on/off）
		//     · 二选一类：`value:"window"|"full"`（画面模式；flags_default.cfg_v_display = "window"，
		//       配 `vis_when:"window"|"full"` 的两个值按钮）
		//   故**不得**把值域写死成 on/off（写死会把「画面模式」两个热区全部判成非法）。
		// ★★ 动作语义（主代理 2026-09-24 裁决）：键名以 `mute_` 开头 ⇒ **取反（toggle）**，
		//   **忽略** hit 自己的 `value`（参考作的 MUTE 就是一个勾选框；W2 的两枚 hit
		//   「方框=开／静音标签=关」都按 toggle 处理）；其余键 ⇒ 设为 hit 的 `value`。
		var cval = "";
		if(uiScreenActionHasPrefix(ckey, "mute_"))
		{
			var cur = uiScreenConfigValueOf(ckey, cflag);
			cval = (cur == "on") ? "off" : "on";
		}
		else
		{
			cval = uiScreenActionHitValue(act);
			if(cval == "")
				return %[ handled: false, effect: "",
					msg: "config_set_" + ckey + "：取不到值（命中热区未带 value 字段，"
						+ "且指针不在该热区上）——忽略，不猜" ];
		}
		var chs = false;
		if(uiSettingHas(ckey))
		{
			// 有设置项（W2 的 16 个开关键已全部入仓）⇒ 值以**设置仓**为准，
			//   flag 从仓里派生 —— 这样切页重派生、持久化、toggle 三件事共用同一份真相。
			UISettingSet(ckey, cval);
			cval = "" + UISettingGet(ckey);
		}
		uiScreenConfigMemoSet(cflag, cval);              // ★ 追补：值记忆（无设置项的键靠它跨页存活）
		// ★ 追补：写完后按**当前页**重派生一次 —— 若这个键属于**非当前页**（例如在声音页上
		//   程序化派发 config_set_display:full），它的值元素必须仍然不可见（不回退泄漏），
		//   值本身留在设置仓/记忆里，切回该页时再显示。
		uiScreenConfigSyncPage(uiScreenFlagGet("cfg_page"));
		chs = (uiScreenFlagGet(cflag) == cval);
		return %[ handled: true, effect: "",
			msg: "配置项 " + ckey + " -> " + cval + "（" + cflag + "="
				+ uiScreenConfigValueLabel(cflag) + "）"
				+ (uiSettingHas(ckey) ? "" : "；★ 该键不在设置仓（UISettingDef），只置 flag + 记忆")
				+ (chs ? "" : "；★ 该键不属于当前页 ⇒ 值已存但**不显示**（切回该页才显示）") ];
	}

	// ---- ★ M1（ISSUE-20260924-08）：鉴赏模式 —— 四页签切屏 / 页内翻页 / 栏位内差分翻页 ----
	//   接口冻结（方案 §5 机制契约 + 主代理 2026-09-24 跨模块裁决）：
	//     gallery_tab_1..4      → **切到对应屏**（gallery / music / dress / replay）
	//     gallery_page_prev|next → 页内翻页（当前屏第一个可见 list 的页码 ±1，clamp）
	//     gallery_prev|next:<行号> → 栏位内差分翻页（`item_variants`；行号 = 全局项序号）
	//   全部走 `uiActionDispatch`（与真实鼠标同一批入口）⇒ 巡演可机检。
	if(uiScreenActionHasPrefix(act, "gallery_tab_"))
	{
		var gtarget = uiScreenMapGalleryTab(act);
		if(gtarget == "")
			return %[ handled: false, effect: "",
				msg: "★M08TAB-REJECT★ " + act + "：未知页签（只认 gallery_tab_1..4）" ];
		// 守卫：当前屏必须是**挂了鉴赏外壳**的页屏 —— 否则切屏会把别的屏顶掉（不得静默）
		if(uiScreenAttachIdCurrent() != UIScrGalleryShellId)
			return %[ handled: false, effect: "",
				msg: "★M08TAB-REJECT★ " + act + "：当前屏 " + uiScreenCurrent()
					+ " 未挂鉴赏外壳（attach != " + UIScrGalleryShellId + "）" ];
		var from = uiScreenCurrent();
		var nclr = uiScreenPageVariantClearFor(from);     // 离开的页：页码 + 差分序号归零
		uiScreenReplace(gtarget);                        // ★ 同级换屏：上一页**不在栈里**
		UIScrGalLastAct = act;
		UIScrGalLastRow = -1;
		UIScrGalActCount++;
		UIScrGalLastTab = gtarget;
		return %[ handled: true, effect: "",
			msg: "鉴赏页签 -> " + gtarget + "（" + from + " → " + gtarget + "；同级换屏，栈深 "
				+ UIScrStack.count + "，栈内 " + uiScreenStackText()
				+ "；清理该页 list " + nclr + " 个；gal_tab="
				+ ((uiScreenFlagGet(UIScrGalleryTabFlag) == "") ? "(空)"
					: uiScreenFlagGet(UIScrGalleryTabFlag)) + "）" ];
	}
	if(act == "gallery_page_prev" || act == "gallery_page_next")
	{
		var glid = uiScreenFirstListId();
		if(glid == "")
			return %[ handled: false, effect: "",
				msg: "★M08PAGE-REJECT★ " + act + "：当前屏 " + uiScreenCurrent()
					+ " 没有可见的 list（页内翻页无目标）" ];
		var gel = uiScreenElById(uiScreenCurrent(), glid);
		if(gel === null)
			return %[ handled: false, effect: "",
				msg: "★M08PAGE-REJECT★ " + act + "：找不到元素 " + glid ];
		var gpg = UIScrPage[glid];
		if(gpg === void || gpg === null) gpg = 0;
		var gpi = uiWidgetListPage(gel, gpg);
		var gnp = gpi.page + ((act == "gallery_page_next") ? 1 : -1);
		if(gnp < 0) gnp = 0;
		if(gnp > gpi.pages - 1) gnp = gpi.pages - 1;
		UIScrPage[glid] = gnp;
		// ★ M8 一审 R3（2026-09-24）：写完页码后**同步写页码 flag**（1 基）—— 屏内互斥页码文本
		//   （`gal.page_tx_01..12` / `mu.pg_tx_1..2` / `rp.pg_tx_1..2`，`vis_flag` = 该屏 `page_flag`）
		//   由此真正随页切换；flag 名从数据读（`page_flag` 字段），机制不写死。
		var gpflag = uiScreenPageFlagOf(uiScreenCurrent());
		if(gpflag != "") uiScreenFlagSet(gpflag, "" + (gnp + 1));
		var gclamped = (gnp == gpi.page);
		UIScrGalLastAct = act;
		UIScrGalLastRow = -1;
		UIScrGalActCount++;
		return %[ handled: true, effect: "",
			msg: "鉴赏·页内翻页 " + glid + " -> 第 " + (gnp + 1) + "/" + gpi.pages + " 页（每页 "
				+ gpi.perPage + " 栏，共 " + gpi.total + " 栏；本页 " + gpi.first + ".."
				+ (gpi.first + gpi.visibleCount - 1) + "）"
				+ (gpflag != "" ? "；" + gpflag + "=" + uiScreenFlagGet(gpflag) : "")
				+ (gclamped ? "（已在边界，钳制）" : "") ];
	}
	if(uiScreenActionHasPrefix(act, "gallery_prev:") || uiScreenActionHasPrefix(act, "gallery_next:"))
	{
		var gisNext = uiScreenActionHasPrefix(act, "gallery_next:");
		var growS = uiScreenActionSuffix(act, gisNext ? "gallery_next:" : "gallery_prev:");
		var grow = uiScreenRowNumber(growS);
		if(grow < 0)
			return %[ handled: false, effect: "",
				msg: "★M08ACT-REJECT★ " + act + " 行号非法（应为非负十进制整数）" ];
		var vlid = uiScreenVariantListId();
		if(vlid == "")
			return %[ handled: false, effect: "",
				msg: "★M08ACT-REJECT★ " + act + "：当前屏 " + uiScreenCurrent()
					+ " 没有带 item_variants 的可见 list" ];
		var vel = uiScreenElById(uiScreenCurrent(), vlid);
		if(vel === null)
			return %[ handled: false, effect: "",
				msg: "★M08ACT-REJECT★ " + act + "：找不到元素 " + vlid ];
		var vfr = uiWidgetVariantFramesRow(vel, grow);
		if(vfr === null || vfr.count == 0)
			return %[ handled: false, effect: "",
				msg: "★M08ACT-REJECT★ " + act + "：第 " + grow + " 栏没有差分内容（留空或越界）" ];
		var vn = vfr.count;
		var vcur = uiScreenVarIdxGet(vlid, grow);
		if(vcur < 0) vcur = 0;
		if(vcur >= vn) vcur = vn - 1;
		var vnx = vcur + (gisNext ? 1 : -1);
		if(vnx < 0) vnx = 0;                      // ★ 边界口径 = clamp（钳制）
		if(vnx > vn - 1) vnx = vn - 1;
		uiScreenVarIdxSet(vlid, grow, vnx);
		var vclamped = (vnx == vcur);
		UIScrGalLastAct = act;
		UIScrGalLastRow = grow;
		UIScrGalActCount++;
		return %[ handled: true, effect: "",
			msg: "鉴赏·栏位内差分 " + vlid + " 行=" + grow + " -> " + (vnx + 1) + "/" + vn
				+ "（素材 " + ("" + vfr[vnx]) + "）" + (vclamped ? "（已在边界，钳制）" : "") ];
	}

	// ---- 打开某屏 ----
	var target = uiScreenMapOpen(act);
	if(target != "")
	{
		if(uiScreenExists(target))
		{
			uiScreenPush(target);
			return %[ handled: true, effect: "", msg: "打开 " + target ];
		}
		// M4/M5 未交付：仍然入栈，绘制时走「模块未接入」占位
		uiScreenPush(target);
		return %[ handled: true, effect: "",
			msg: "打开 " + target + "（layout 缺该屏 -> 显示模块未接入占位）" ];
	}

	// ---- 对话推进 / 选择 ----
	if(act == "advance_dialog")
	{
		var r = uiDialogAdvance();
		return %[ handled: true, effect: "", msg: r.msg ];
	}
	if(act == "open_choices")
	{
		uiDialogCompleteTyping();
		uiDialogOpenChoices();
		return %[ handled: true, effect: "", msg: "展开选择肢（文本取自 layout dlg.choices.labels，出自 ot_s01_02c）" ];
	}
	if(act == "select_choice")
	{
		var m = uiDialogChoiceCommit((index === void) ? 0 : index);
		return %[ handled: true, effect: "", msg: m ];
	}

	// ---- 模式开关 ----
	if(act == "skip_on")
	{
		UIDlgSkipMode = !UIDlgSkipMode;
		if(UIDlgSkipMode) UIDlgAutoMode = false;
		return %[ handled: true, effect: "", msg: "快进 " + (UIDlgSkipMode ? "开" : "关") ];
	}
	if(act == "auto_on")
	{
		UIDlgAutoMode = !UIDlgAutoMode;
		if(UIDlgAutoMode) UIDlgSkipMode = false;
		return %[ handled: true, effect: "", msg: "自动播放 " + (UIDlgAutoMode ? "开" : "关") ];
	}

	// ---- 翻页 ----
	if(act == "page_prev" || act == "page_next")
	{
		var lid = uiScreenActionListForCurrent();
		if(lid == "") return %[ handled: false, effect: "", msg: "当前屏没有可翻页的列表" ];
		var cur = (UIScrPage[lid] === void) ? 0 : UIScrPage[lid];
		var next = (act == "page_next") ? cur + 1 : cur - 1;
		if(next < 0) next = 0;
		UIScrPage[lid] = next;
		return %[ handled: true, effect: "", msg: "列表 " + lid + " 翻页 -> " + (next + 1) ];
	}

	// ---- 存/读槽 ----
	if(act == "do_save")
	{
		uiStateSave();
		return %[ handled: true, effect: "", msg: "写入存档槽 " + ((index === void) ? 0 : index + 1) ];
	}
	if(act == "do_load")
	{
		uiStateLoad();
		return %[ handled: true, effect: "", msg: "读取存档槽 " + ((index === void) ? 0 : index + 1) ];
	}

	// ---- M13：右键图标浮层 + 9 图标动作 ----
	// open_sysicons：打开/收起浮层（右键的处理器 toggleSysIcons 也走这个动作语义）
	if(act == "open_sysicons")
	{
		if(!uiScreenExists("sysicons"))
			return %[ handled: false, effect: "", msg: "layout 缺 sysicons 屏（_index.json 未登记）" ];
		if(uiScreenCurrent() == "sysicons")
		{
			uiScreenPop();
			return %[ handled: true, effect: "", msg: "收起图标浮层 -> " + uiScreenCurrent() ];
		}
		uiScreenPush("sysicons");
		return %[ handled: true, effect: "", msg: "呼出 9 图标浮层（sysicons）" ];
	}
	if(act == "do_quicksave")
	{
		uiStateSave();
		return %[ handled: true, effect: "", msg: "快速存档 -> "
			+ ((UIStateSavePath == "") ? "(写入失败)" : UIStateSavePath) ];
	}
	if(act == "do_quickload")
	{
		uiStateLoad();
		return %[ handled: true, effect: "", msg: "快速读档 -> " + UIStateReport ];
	}
	if(act == "prev_choice")
	{
		if(UIDlgChoicesOpen)
		{
			uiDialogCloseChoices();
			return %[ handled: true, effect: "", msg: "返回上一选择点：收起选择肢" ];
		}
		return %[ handled: true, effect: "", msg: "返回上一选择点（演示层无回溯数据，仅登记动作）" ];
	}
	// ★ M2 契约④：`next_choice` = `prev_choice` 的**镜像**（同一位置、方向相反）：
	//   prev 收起选择肢 → next 展开选择肢；两者都不改屏栈，仅驱动对话框状态机。
	if(act == "next_choice")
	{
		if(UIDlgChoicesOpen)
		{
			uiDialogOpenChoices();
			return %[ handled: true, effect: "", msg: "前进到下一选择点：展开选择肢" ];
		}
		return %[ handled: true, effect: "", msg: "前进到下一选择点（演示层无前向数据，仅登记动作）" ];
	}
	if(act == "replay_voice")
	{
		return %[ handled: true, effect: "", msg: "重复语音（演示工程无语音资源，仅登记动作）" ];
	}

	// ---- ★ M06：回想屏逐块按钮的动作（`backlog_jump:<行号>` / `backlog_replay:<行号>`）----
	//   动作名是**冻结接口**（`layout/_schema.md` §六 动作名表；HTML 侧 replica.js 同名实现）。
	//   行号 = **全局项序号**（含分页偏移）—— 由 `uiScreenRowAction` 用点中的那一行的
	//   `%row%` 换出来（机制里不写死按钮几何）。
	//   语义**本轮 = 接口冻结/占位**（理由见 UIScrBacklogLastAct 的声明处）：
	//     ① `backlog_replay`：命中 → 派发 → 日志/状态可见；**音频留给编程组**（引擎无音频代码）；
	//     ② `backlog_jump`  ：派发 + 可观测状态；**真正的跳转生效留给编程组**。
	//   行号非法（非「非负十进制整数字面量」）⇒ 显式拒绝并打 `★M06ACT-REJECT★`，不猜、不静默。
	if(act.indexOf("backlog_jump:") == 0 || act.indexOf("backlog_replay:") == 0)
	{
		var isJump = (act.indexOf("backlog_jump:") == 0);
		var pre = isJump ? "backlog_jump:" : "backlog_replay:";
		var rowN = uiScreenRowNumber(act.substring(pre.length));
		if(rowN < 0)
		{
			UIScrBacklogLastAct = act;
			UIScrBacklogLastRow = -1;
			return %[ handled: false, effect: "",
				msg: "★M06ACT-REJECT★ " + act + " 行号非法（应为非负十进制整数）" ];
		}
		UIScrBacklogLastAct  = act;
		UIScrBacklogLastRow  = rowN;
		UIScrBacklogActCount = UIScrBacklogActCount + 1;
		return %[ handled: true, effect: "",
			msg: (isJump ? "回想·跳转" : "回想·重新播放") + " 第 " + rowN + " 行"
				+ "（本轮仅派发 + 状态可见；音频/跳转生效留给编程组）" ];
	}

	// ---- M4 预留：进入番外 ----
	//   ★ M43：原 `chapter_enter` 分支已删除（`chapter` 屏整体移除）；「进入剧情」的动作
	//   `flow_enter` 由 `ui_flow.tjs` 包装的 uiActionDispatch 直接处理，不经过本函数。
	if(act == "fragment_enter")
	{
		uiScreenPush("dialog");
		return %[ handled: true, effect: "", msg: act + "（内容待 M4 接入）" ];
	}

	uiScreenNote("未实现的动作：" + act);
	return %[ handled: false, effect: "", msg: "未实现的动作：" + act ];
}

// ------------------------------------------------------------
// 点击 / 按键
// ------------------------------------------------------------

// ★★ ISSUE-20260928-02（第 2 步）· 命中元素的**动作参数**透传（`layer` 字段）★★
//   背景（接口冻结 §二）：番外入口/返回键热区在数据里形如
//       %[ action: "flow_layer", layer: "frag1" | "main" ]
//   —— **同一个动作名配不同参数**（6 个入口 + 1 个返回键），故「要切到哪一层」只能由
//   **被命中的那个元素**决定，动作名本身携带不了它。
//   约定（**两端同一句话**：命中即取该元素的 `layer` 字段）：
//     · `uiScreenClick` 命中 `kind=="hit"` 的元素时，把它的 `layer` 抄进 `UIScrHitLayer`
//       （无该字段 ⇒ 空串；每次进入 `uiScreenClick` 先**清空**，杜绝上一次点击的残留值
//        被下一次派发误用）；
//     · 派发方（流程图 `flow_layer` 分支，在 `ui_flow.tjs` 的 uiActionDispatch 包装器里）
//       经 `uiScreenHitLayer()` 读取 —— 与写入处在**同一调用栈**：`handleClick` 与
//       `uiScreenSyntheticClick`（巡演）都是「先 uiScreenClick 再 uiActionDispatch」。
//   为什么不用「动作串带参」（如 `flow_layer:frag1`）：动作名与 `layer` 字段都属**冻结接口**，
//   数据侧已按 `action` + `layer` 两字段产出（冻结 §二），改串会与 HTML 侧分叉。
//   与既有模块级约定同款：`UIScrFocus` / `UIScrActiveList` / `UIScrPressHit` 都是这个套路。
var UIScrHitLayer = "";

function uiScreenHitLayer() { return UIScrHitLayer; }

function uiScreenHitLayerSet(v)
{
	UIScrHitLayer = (v === void || v === null) ? "" : ("" + v);
	return UIScrHitLayer;
}

function uiScreenClick(stage, x, y)
{
	uiScreenHitLayerSet("");          // ★ 每次命中判定前清空（杜绝残留参数）
	var id = uiScreenCurrent();
	if(id == "") return %[ action: "", hit: false ];

	// ★ M2 契约①：附加层的点击优先级高于承载屏（命中即返回，不再看承载屏）
	var ra = uiScreenAttachClick(x, y);
	if(ra !== null) return ra;

	if(!uiScreenExists(id)) return %[ action: "", hit: false ];

	// 对话框屏有专用命中（选择肢 → kind=hit（★ M25：九宫格 9 功能图标）→ 推进）
	if(id == "dialog") return uiDialogClick(stage, UILayoutData.screens[id], x, y);

	var els = UILayoutData.screens[id].elements;
	// 由上层往下层扫（后声明的、z 更大的先命中）
	var bestZ = -1, best = null;
	for(var i = 0; i < els.count; i++)
	{
		var el = els[i];
		if(el.kind != "list" && el.kind != "hit") continue;
		if(!uiScreenElementVisible(el)) continue;        // ★ M1：统一走屏级 flag 谓词
		var r = uiWidgetRect(el);
		if(x < r.x || x >= r.x + r.w || y < r.y || y >= r.y + r.h) continue;
		var z = uiWidgetNum(el, "z", 0);
		if(z < bestZ) continue;
		bestZ = z; best = el;
	}
	if(best === null) return %[ action: "", hit: false ];

	if(best.kind == "list")
	{
		var pg = uiWidgetListPage(best, UIScrPage[best.id]);
		var hit = uiWidgetListHit(best, x, y, pg.page);
		if(hit < 0) return %[ action: "", hit: false ];
		UIScrFocus[best.id] = hit;
		UIScrActiveList = "" + best.id;
		// ★ M06：**逐项按钮优先于整行** —— 落在某按钮矩形内即派发该按钮的动作，
		//   且动作串里的 `%row%` 换成**全局项序号**（含分页偏移）。块内其余区域仍走
		//   既有 `actions[项]`（按钮**吃掉**整行命中，见冻结书 §2 第 4 条）。
		//   几何全部来自数据（`uiWidgetItemButtonAt` 与绘制共用同一张表）⇒ 机制不写死按钮几何。
		//   ★ M1：命中链扩成「`item_buttons`（声明序）→ `item_variants.prev` → `.next` → 整行」，
		//   由 `uiWidgetItemSubHitAt` 统一给出（与绘制/悬停令牌同集）。
		var bt = uiWidgetItemSubHitAt(best, x, y, pg.page);
		if(bt !== null)
			return %[ action: uiScreenRowAction(bt.action, bt.index), index: bt.index,
				hit: true, button: bt.key, subkind: bt.kind ];
		return %[ action: best.actions[hit], index: hit, hit: true ];
	}
	// ★ 第 2 步：把命中元素的 `layer` 字段抄进 `UIScrHitLayer`（参数化动作用；
	//   普通 hit 无该字段 ⇒ 置空，行为与改动前一致）
	uiScreenHitLayerSet(best.layer);
	return %[ action: best.action, index: -1, hit: true ];
}

function uiScreenKey(key)
{
	var id = uiScreenCurrent();

	if(id == "dialog" && uiScreenExists(id))
	{
		var r = uiDialogKey(UILayoutData.screens[id], key);
		if(r.handled) return %[ handled: true, action: r.action ];
	}

	// Esc：非标题屏 → 关闭当前层；标题屏 → 退出
	if(key == 27)
	{
		if(UIScrStack.count > 1) return %[ handled: true, action: "close" ];
		return %[ handled: true, action: "quit_game" ];
	}
	// 上下键：移动当前屏第一个列表的高亮
	if(key == 38 || key == 40)
	{
		var lid = uiScreenActionListForCurrent();
		if(lid == "")
		{
			var sc = uiScreenExists(id) ? UILayoutData.screens[id] : void;
			if(sc !== void)
			{
				for(var i = 0; i < sc.elements.count; i++)
				{
					var el = sc.elements[i];
					if(el.kind == "list" && uiScreenElementVisible(el)) { lid = "" + el.id; break; }
				}
			}
		}
		if(lid == "") return %[ handled: false, action: "" ];
		UIScrActiveList = lid;
		var n = 0;
		var sc2 = UILayoutData.screens[id];
		for(var j = 0; j < sc2.elements.count; j++)
			if("" + sc2.elements[j].id == lid) n = sc2.elements[j].labels.count;
		if(n <= 0) return %[ handled: false, action: "" ];
		var cur = (UIScrFocus[lid] === void) ? -1 : UIScrFocus[lid];
		cur += (key == 40) ? 1 : -1;
		while(cur < 0) cur += n;
		while(cur >= n) cur -= n;
		UIScrFocus[lid] = cur;
		return %[ handled: true, action: "move" ];
	}
	// Enter：触发当前高亮项
	if(key == 13)
	{
		var lid2 = uiScreenActionListForCurrent();
		if(lid2 == "" || UIScrFocus[lid2] === void) return %[ handled: false, action: "" ];
		var idx = UIScrFocus[lid2];
		var sc3 = UILayoutData.screens[id];
		for(var k = 0; k < sc3.elements.count; k++)
		{
			var e3 = sc3.elements[k];
			if("" + e3.id == lid2)
				return %[ handled: true, action: e3.actions[idx], index: idx ];
		}
	}
	return %[ handled: false, action: "" ];
}

// ------------------------------------------------------------
// 自动巡演（步骤表）
//   顺序按 M2 验收要求：标题 → 对话框 → 选择肢 → 系统菜单 → 存档 → 读档 →
//   配置 → 回想 → 画廊 → 音乐 → Fragment 占位 → 流程图占位 →
//   片尾 → 加载提示 → 标题
//   末尾再自动追加「layout 里存在但上面没列到」的屏（M5 新增屏自动纳入）
//   ★ M43（2026-09-23，用户裁定）：「章节选择 chapter」一步**已移除** ——
//     该屏整体删除；进入剧情改由流程图屏的 `fc.jump_hit`（动作 `flow_enter`）承担，
//     巡演**不**点它（巡演只做逐屏展示，不进剧情）。
//   ★ M46（2026-09-23）：选择支屏 `choices` **已显式列出**（原先靠自动追加排末尾），
//     以便紧跟三条 `kind: "ptr"` 合成指针步骤做「列表逐项三态」的目标级验收。
// ------------------------------------------------------------
var UIScrTourSteps = [
	%[ kind: "screen", v: "title",     label: "标题画面" ],
	%[ kind: "screen", v: "dialog",    label: "对话框（真实台词）" ],
	%[ kind: "action", v: "open_choices", label: "选择肢" ],
	// ★ M46（2026-09-23，用户指令「加拓展，让现在选择支能有三态效果（并应用）」）：
	//   选择支屏（全屏列表）**显式列出** —— 它此前靠「自动追加未列屏」兜底排在最末尾，
	//   而下面的逐项三态验收必须紧跟它、用同一个 `ch.choices`。
	//   验收手法：巡演不产生真实鼠标移动，故**合成指针**直接置到具体项上（走
	//   uiScreenHoverUpdate / uiScreenPressUpdate —— 与真实鼠标同一批入口），并在日志
	//   打出 PASS/FAIL 判词（命中项序号 + 选出的态图 vs 期望）；下一步的 tourRecord
	//   会把带态的画面导出 PNG（第 2 行 hover 图 / 第 3 行 pressed 图，可目视核对）。
	//   末尾一条是**负向对照**（序列最末、标题屏上），见该行注释。
	%[ kind: "screen", v: "choices",     label: "选择支屏（全屏列表·项数自适应）" ],
	%[ kind: "ptr",    v: "ch.choices:1",       label: "合成指针：悬停第 2 项（应取 hover 态图）" ],
	%[ kind: "ptr",    v: "ch.choices:2:press", label: "合成指针：按住第 3 项（应取 pressed 态图）" ],
	// ★ M13：右键图标浮层（sysicons）。巡演不产生真实鼠标事件，故用合成鼠标按下走
	//   onMouseDown 同一入口，验证「右键 → 呼出 / 再右键 → 收起」这条路径。
	%[ kind: "mouse",  v: "right",     label: "合成右键：呼出 9 图标浮层" ],
	%[ kind: "mouse",  v: "right",     label: "合成右键：收起 9 图标浮层" ],
	// ★ M2（契约⑥）：原「系统菜单 sysmenu」一步已**移除** —— 该屏不再是可达界面
	//   （open_sysmenu 改为展开竖排快捷条，见 uiScreenMapOpen / uiQuickbarOpen）；
	//   竖条本体由巡演末尾按白名单自动追加的 `quickbar` 屏覆盖。
	//   ★ M45（2026-09-23，用户裁定）：该屏**已整体废除**（屏文件与 `_index.json` 条目均已删除）
	//   ⇒ 巡演序列里不会再出现 `sysmenu`（白名单本就不含它）。
	%[ kind: "screen", v: "save",      label: "存档" ],
	%[ kind: "screen", v: "load",      label: "读档" ],
	%[ kind: "screen", v: "config",    label: "配置" ],
	// ★★ M47（2026-09-24，ISSUE-20260924-01 ·《M47_设置屏重设方案》§五 验收计划 1）：
	//   config 屏之后加**三条**目标级验收步骤（判词 `★M47DRAG★` / `★M47DRAG-REJECT★`
	//   直接写进巡演日志，可机检）。
	//   ★ 顺序**有意**是「先拖动、再切页、最后负向对照」，而不是方案 §五 的书面顺序
	//     （切页→拖动→负向）：`cfg.sl_winopac` 是**系统页**的滑块，它的命中热区带
	//     `vis_flag="cfg_page" / vis_when="sys"`（方案 §3.4）⇒ 先切到声音页再拖它，
	//     会被「当前不可见」守卫**正当地**挡下（★M47DRAG-REJECT★），变成假失败。
	//     故：① 在**默认的系统页**上完成拖动验收（用户要求 2 就是「默认展示系统页」）；
	//         ② 再切声音页，验证 `config_tab_2` 动作与 `cfg_page` 分页机制；
	//         ③ 最后用 `cfg.tab2_hit`（**真元素、但不是滑块热区**）做负向对照。
	//   ★ 步骤 id 依赖 W2 的 config 屏数据（元素 id `cfg.sl_winopac_hit`、`cfg.tab2_hit`）。
	//     ★ 2026-09-24 实机：W2 数据已落盘（371 件 / 9 根 slider），三步均已**实跑**：
	//       拖动步骤判词 `★M47DRAG★ PASS … 预览遮罩 opacity=102（期望 102）`；
	//       负向对照 `★M47DRAG-REJECT★ cfg.tab2_hit 未带 slider 字段`；
	//       切页步骤 `配置页签 -> 声音（cfg_page=snd；值键派生 17 项）`。
	//       若将来该屏数据被换回旧版（无这些 id），三步会如实打出 REJECT/FAIL 判词
	//       —— **不是**静默通过。
	%[ kind: "drag", v: "cfg.sl_winopac_hit:40:102", label: "配置·拖动「文本窗口的不透明度」到 40%（期望遮罩用独立常量 102 判）" ],
	%[ kind: "action", v: "config_tab_2",       label: "配置·切到「声音」页（config_tab_2 -> cfg_page=snd）" ],
	// ★★ M47 三轮（一审 C1）：**按在 MUTE 上不得改音量、且 MUTE 正常取反**。
	//   实机反例（改前）：声音页 6 条音量行的行热区 100% 包住 MUTE 控件（test_click_reach.py 的
	//   重叠清单可查），而旧拖动命中只看「带 slider 字段的候选集」⇒ 按在 MUTE 上会先进入拖动、
	//   把 vol_master 写成 100 并落盘，抬起又 toggle ⇒ 一次点击既静音又改音量。
	//   本步骤走 `uiScreenPressUpdate/PressClear/uiScreenClick/uiActionDispatch`（与真实鼠标
	//   同批入口），断言「拖动未启动 + vol_master 未变 + 动作是 config_set_mute_vol_master + 值键已翻面」。
	%[ kind: "click",  v: "cfg.o_mute_vol_master_off_hit:vol_master:config_set_mute_vol_master",
	   label: "配置·点 MUTE（按在 MUTE 上：音量不得变、MUTE 取反）" ],
	%[ kind: "drag", v: "cfg.tab2_hit:40",      label: "配置·拖动负向对照①（非滑块热区必须被守卫挡下）" ],
	%[ kind: "drag", v: "cfg.sl_not_exist_hit:40", label: "配置·拖动负向对照②（不存在的 id 必须被守卫挡下）" ],
	// ★★ M47 追补（主代理 2026-09-24 追加验收）：**切页往返不丢值**（值记忆层）
	//   ① 程序化派发 `config_set_display:full`（动作串自带 `:<值>` 后缀 ⇒ 不依赖指针/可见性）；
	//      此刻屏在**声音页**，display 属**系统页** ⇒ 值入设置仓（+记忆）但**不显示**（不回退泄漏）。
	//   ② `config_tab_1` 切回系统页 ⇒ 值键按三级优先链恢复（设置仓 → 记忆 → flags_default）。
	//   ③ 断言 `cfg_v_display == "full"`（**不是** window）——这条就是「不丢状态」的证据。
	//   ④ `config_reset` 收尾：恢复默认 + 清空切页记忆（并回系统页）。
	%[ kind: "action", v: "config_set_display:full", label: "配置·画面模式 -> 全屏（程序化派发 config_set_display:full）" ],
	%[ kind: "action", v: "config_tab_1",           label: "配置·切回系统页（config_tab_1 -> cfg_page=sys）" ],
	%[ kind: "flag",   v: "cfg_v_display:full",     label: "断言 cfg_v_display 仍为 full（切页往返不丢值）" ],
	%[ kind: "action", v: "config_reset",           label: "配置·初始化收尾（恢复默认 + 清空切页记忆）" ],
	// ★ 主代理 2026-09-24 补（W3 报告 §4.2 的建议）：把 `config_char_<族>` 也纳入巡演闭环 ——
	//   选角色 ⇒ 横幅 33 件互斥换人；W3 据此实测并修掉一条**同源泄漏**：在系统页派发角色动作时，
	//   声音页那批只带 `cfg_vchar` 的值元素会显形（实绘 115→119）⇒ 已按 `config_set_` 同一口径修
	//   （值进记忆、flag 按当前页派生）。该步不需要指针（族名在动作名里），判词 = 分发器 msg。
	//   ⚠️ 其后**不再**补 `config_reset`：本块上面 W3 的记忆验收序列已用它收尾（恢复默认 +
	//   清切页记忆 + 回系统页），重复派发只会让「初始化被调用几次」这个读数失去意义。
	%[ kind: "action", v: "config_char_kob",     label: "配置·选角色「小鸠」（config_char_kob -> cfg_vchar=kob）" ],
	// ★★ M47 三轮（一审 C4）：**跨屏往返不丢选中角色** —— 只有 `cfg_vchar` 能鉴别记忆层
	//   （它**没有设置项**，优先链的第二级才是记忆；`cfg_v_display` 走设置仓第一位，验不出记忆）。
	//   序列：切声音页 → 选「小鸠」→ **离开设置屏**（换屏 ⇒ flags 被 flags_default 重置）→
	//   再进设置屏（C4 修：进屏路径 captureMemo=false，不得用默认值冲掉记忆）→ 切声音页 →
	//   断言 `cfg_vchar` 仍是 kob（改前会回落 asu）。
	%[ kind: "action", v: "config_tab_2",    label: "配置·切到声音页（为选角色做准备）" ],
	%[ kind: "action", v: "config_char_kob", label: "配置·声音页选中「小鸠」（cfg_vchar=kob，进记忆）" ],
	%[ kind: "screen", v: "load",            label: "离开设置屏（换屏 ⇒ flag 被 flags_default 重置）" ],
	%[ kind: "screen", v: "config",          label: "再次进入设置屏（进屏不捕获记忆）" ],
	%[ kind: "action", v: "config_tab_2",    label: "配置·再切声音页" ],
	%[ kind: "flag",   v: "cfg_vchar:kob",   label: "断言跨屏往返后 cfg_vchar 仍为 kob（记忆层生效）" ],
	%[ kind: "screen", v: "backlog",   label: "回想" ],
	// ★★ M06（2026-09-24，ISSUE-20260924-06_回想屏重排 · 用户指令「每一块里都要有跳转与重新播放」）：
	//   backlog 屏之后插入**逐块按钮**的 8 条目标级验收 + 3 条负向对照（判词 `★M06BTN★` /
	//   `★M06ROW★` / `★M06GUARD★` / `★M06……-REJECT★` 直接写进巡演日志，可机检）。
	//   · 每条 `itembtn` 走**真实入口**：uiScreenHoverUpdate → uiScreenPressUpdate →
	//     uiScreenClick → uiActionDispatch（与真实鼠标同一批函数），断言四件事：
	//     ① 按钮中心命中的**令牌** = `bl.list:<行>:<键>`（不是整行、不是别的块）；
	//     ② 悬停态选图 = 该按钮的 `state_assets.hover`、按下态选图 = `.pressed`；
	//     ③ `uiScreenClick` 返回的 action = 数据里该按钮的 action 且 `%row%` 换成**点中的那一行**；
	//     ④ `uiActionDispatch` 之后 `UIScrBacklogLastRow` = 所点行、`UIScrBacklogLastAct` = 该动作串。
	//   · 带 `:press` 的两条**不释放**按下态，让紧随其后的一次导图把 pressed 形态留在 PNG 上
	//     （tourTick 是「先导图、再走下一步」⇒ 第 N 步的画面出现在第 N+1 张 PNG 里，同 M46）。
	//   · 负向对照 ①/②：块内**两按钮之间的空隙**与**块右侧文案区**必须**命中整行**
	//     （按钮命中=无、按钮悬停令牌=空；回想屏整行 action 数据为空 ⇒ 按既有契约不派发）。
	//   · 负向对照 ③：不存在的按钮 key / 越界行号 / 非 list 元素 / 不存在的元素 —— 四条
	//     `★M06BTN-REJECT★`；再加一条 `itemguard`：把 item_buttons 改坏成 5 种非法形态
	//     （空 action / 矩形出块 / 零面积 / key 空 / 非对象项，**内存副本、不写磁盘**），
	//     逐条断言机制守卫（与绘制路径共用同一个校验函数）产出 `★M06ITEMBTN-REJECT★`。
	//   ⚠️ 依赖数据：元素 id `bl.list`、按钮 key `jump` / `replay`、行号 0..3 必须在本页可见
	//     （`item_h=205`、`max_rows=4`）。数据若换回旧版（无 `item_buttons`），这些步骤会**如实
	//     打出 REJECT/FAIL 判词** —— 不是静默通过。
	%[ kind: "itembtn",   v: "bl.list:0:jump",     label: "回想·第 1 行「跳转」按钮中心（命中自身 + 派发 backlog_jump:0）" ],
	%[ kind: "itembtn",   v: "bl.list:0:replay",   label: "回想·第 1 行「重新播放」按钮中心（命中自身 + 派发 backlog_replay:0）" ],
	%[ kind: "itembtn",   v: "bl.list:1:jump",     label: "回想·第 2 行「跳转」按钮中心（派发行号必须 = 1）" ],
	%[ kind: "itembtn",   v: "bl.list:1:replay:press", label: "回想·第 2 行「重新播放」按住（pressed 图留在导图上）" ],
	%[ kind: "itembtn",   v: "bl.list:2:jump",     label: "回想·第 3 行「跳转」按钮中心（派发行号必须 = 2）" ],
	%[ kind: "itembtn",   v: "bl.list:2:replay",   label: "回想·第 3 行「重新播放」按钮中心（派发行号必须 = 2）" ],
	%[ kind: "itembtn",   v: "bl.list:3:jump:press", label: "回想·第 4 行「跳转」按住（pressed 图留在导图上）" ],
	%[ kind: "itembtn",   v: "bl.list:3:replay",   label: "回想·第 4 行「重新播放」按钮中心（派发行号必须 = 3）" ],
	%[ kind: "itemrow",   v: "bl.list:0:138,40",   label: "回想·负向①：两按钮之间的空隙 ⇒ 必须命中整行（不是按钮）" ],
	%[ kind: "itemrow",   v: "bl.list:2:1300,180", label: "回想·负向②：块右侧文案区 ⇒ 必须命中整行（不是按钮）" ],
	%[ kind: "itembtn",   v: "bl.list:0:nosuchkey", label: "回想·负向③：不存在的按钮 key ⇒ 必须被守卫挡下（★M06BTN-REJECT★）" ],
	%[ kind: "itembtn",   v: "bl.list:9:jump",     label: "回想·负向④：越界行号 ⇒ 必须被守卫挡下（★M06BTN-REJECT★）" ],
	%[ kind: "itembtn",   v: "bl.close:0:jump",    label: "回想·负向⑤：非 list 元素 ⇒ 必须被守卫挡下（★M06BTN-REJECT★）" ],
	%[ kind: "itembtn",   v: "bl.nosuchlist:0:jump", label: "回想·负向⑥：不存在的元素 ⇒ 必须被守卫挡下（★M06BTN-REJECT★）" ],
	%[ kind: "itemguard", v: "bl.list",            label: "回想·负向⑦：item_buttons 5 种非法形态（内存副本）⇒ 机制守卫必须逐条 REJECT" ],
	// ★ M06：**分页后按钮随块走**（冻结书 §2 第 5 条）—— 临时把 `max_rows` 由 4 改成 2（内存副本，
	//   退出时还原）⇒ 页数变 2，翻到第 1 页（全局行 2..3）后，**同一个屏坐标**上的按钮必须属于
	//   全局第 2 行（而不是原第 0 行），点击派发 `backlog_jump:2`。这是「逐项渲染 ⇒ 按钮天然随块走」
	//   的机检证据（改前若把按钮做成静态元素，此步必 FAIL）。
	%[ kind: "itempage",  v: "bl.list:2:2:jump",   label: "回想·分页：max_rows 临时改 2 后第 2 页的按钮属于全局第 2 行（随块走）" ],
	// ★★ M1（2026-09-24，ISSUE-20260924-08_鉴赏模式 · 主代理跨模块裁决「页签 = 切屏」）：
	//   鉴赏模式 = **四个屏**（gallery/music/dress/replay）+ **共享外壳屏 `gal_shell`**
	//   （四个页屏各自 `attach: "gal_shell"`）。本块按「入口 → 切屏 → 页内翻页 →
	//   栏位内差分 → 守卫负向」的顺序做**目标级**验收，判词 `★M08TAB★` / `★M08PAGE★` /
	//   `★M08VAR★` / `★M08GUARD★`（负向 `…-REJECT★`）直接写进巡演日志，可机检。
	//   · `galtab`：走 `uiActionDispatch`（真实入口）——断言「当前屏 = 目标屏」「上一页**不在栈里**」
	//     「外壳页签 flag `gal_tab` = 目标屏」「目标屏有元素」。为让「不在栈里」可判，
	//     本块**先回到标题、再从入口 `open_gallery` 进**（栈 = [title, gallery]）⇒ 切屏后
	//     title 仍在栈中、gallery 已不在。
	//   · `galpage` / `galvar`：走 `uiScreenHoverUpdate` / `uiScreenPressUpdate` / `uiScreenClick`
	//     → `uiActionDispatch`（与真实鼠标同一批函数）；`galvar` 的 `auto` 行号会挑**第一栏 N≥2**
	//     并把序号预置到非钳制的一端 ⇒「确实换图」这一条必然可判。
	//   · `galguard`：把 `item_variants` 改坏成 12 种非法形态（**内存副本、不写磁盘**），
	//     断言绘制/命中调用的同一套校验函数逐条给出预期理由。
	//   ⚠️ 依赖数据（M2/M3/M4 交付）：页屏 `attach:"gal_shell"`、CG 页 list id = `gal.list`、
	//     该 list 带 `item_variants`。数据未落盘时这些步骤会**如实**打出 `-REJECT★`/`FAIL`
	//     —— 不是静默通过。
	%[ kind: "screen", v: "title",     label: "回到标题（准备从入口进入鉴赏模式）" ],
	%[ kind: "action", v: "open_gallery", label: "鉴赏模式入口（open_gallery -> push gallery）" ],
	%[ kind: "galtab", v: "2", label: "鉴赏·页签 2「BGM 鉴赏」（切屏：上一页不在栈里）" ],
	%[ kind: "galtab", v: "3", label: "鉴赏·页签 3「立绘鉴赏」" ],
	%[ kind: "galtab", v: "4", label: "鉴赏·页签 4「情景回想」" ],
	%[ kind: "galtab", v: "1", label: "鉴赏·页签 1「CG 鉴赏」（回到默认页）" ],
	%[ kind: "galpage", v: "auto:next", label: "鉴赏·CG 页内翻页（下一页，栏位内容随页走）" ],
	%[ kind: "galpage", v: "auto:prev", label: "鉴赏·CG 页内翻页（上一页，回到第 1 页）" ],
	// ★ M8 一审 R3（2026-09-24）：页码 flag 接线 —— 翻到第 2 页后断言 `gal_page`（1 基）随页变化，
	//   再翻回第 1 页复位（注入模式下该屏未声明 page_flag ⇒ 步骤自动降级为只判页码，不 FAIL）。
	%[ kind: "galpageassert", v: "1", label: "鉴赏·页码基线断言（第 1 页 + 页码 flag=1，只读）" ],
	%[ kind: "galpage", v: "auto:next", label: "鉴赏·CG 翻到第 2 页（页码 flag 应同步=2）" ],
	%[ kind: "galpageassert", v: "2", label: "鉴赏·R3 断言：翻页后页码 flag 应=2（注入模式自动降级）" ],
	%[ kind: "galpage", v: "auto:prev", label: "鉴赏·翻回第 1 页（页码 flag 复位=1）" ],
	%[ kind: "galpageassert", v: "1", label: "鉴赏·R3 断言：翻回后页码 flag 应=1" ],
	%[ kind: "galvar", v: "auto:auto:next", label: "鉴赏·栏位内差分翻页（挑第一栏 N≥2，翻下一张 ⇒ 缩略图换图 + n/N 变）" ],
	%[ kind: "galvar", v: "auto:auto:prev", label: "鉴赏·栏位内差分翻页（翻回上一张）" ],
	%[ kind: "galguard", v: "auto", label: "鉴赏·负向：item_variants 12 种非法形态（内存副本）⇒ 机制守卫必须逐条 REJECT" ],
	// ★ M1：**attach 能否被四个不同承载屏复用**（主代理 2026-09-24 要求实测的一件事）：
	//   四步各把当前屏换成对应承载屏，断言「attach 指向 gal_shell + 外壳元素可见数 >0 +
	//   外壳每个热区被真实命中链命中且派发自身 action + gal_tab 派生成本屏 id」。
	//   具体像素由这四步导出的 PNG 见证（外壳页签条应在四屏上都画出来）。
	%[ kind: "galattach", v: "gallery", label: "鉴赏·外壳复用①：承载屏 gallery（attach=gal_shell 绘制 + 命中）" ],
	%[ kind: "galattach", v: "music",   label: "鉴赏·外壳复用②：承载屏 music" ],
	%[ kind: "galattach", v: "dress",   label: "鉴赏·外壳复用③：承载屏 dress" ],
	%[ kind: "galattach", v: "replay",  label: "鉴赏·外壳复用④：承载屏 replay" ],
	// ★ M8 一审 + 主代理追认项⑥（2026-09-24）：**挂壳屏重进归零** —— 翻到第 2 页后 push 重进
	//   （open_gallery 走 uiScreenPush），断言页码与页码 flag 都回到 1；随后 close 弹掉重进的那层，
	//   恢复原栈深（不干扰后续步骤）。
	%[ kind: "galtab", v: "1", label: "鉴赏·切回 CG（准备重进归零验证）" ],
	%[ kind: "galpage", v: "auto:next", label: "鉴赏·翻到第 2 页（为重进归零铺垫）" ],
	%[ kind: "galpageassert", v: "2", label: "鉴赏·铺垫确认：当前在第 2 页（页码 flag=2）" ],
	%[ kind: "action", v: "open_gallery", label: "鉴赏·重进鉴赏模式（open_gallery → push ⇒ 页码/差分/页码flag 归零）" ],
	%[ kind: "galpageassert", v: "1", label: "鉴赏·⑥ 断言：重进后页码回 1（页码 flag=1）" ],
	%[ kind: "action", v: "close", label: "鉴赏·弹掉重进的那层（恢复栈深 [title, gallery]）" ],
	%[ kind: "galtab", v: "bad", label: "鉴赏·负向：未知页签（gallery_tab_9）⇒ 必须被守卫挡下（★M08TAB-REJECT★）" ],
	%[ kind: "action", v: "close", label: "外壳「返回」（close -> 回入口屏 title）" ],
	%[ kind: "screen", v: "gallery",   label: "CG 鉴赏" ],
	%[ kind: "screen", v: "music",     label: "BGM 鉴赏" ],
	// ★ ISSUE-20260928-06（用户裁定）：原 `open_fragment` 巡演步**已删** —— `fragment` 屏整体删除后
	//   该步会 push 出不存在的屏、把「模块未接入」占位画进巡演截图（脏证据）。**动作本身保留**（见屏映射表）。
	%[ kind: "action", v: "open_flowchart", label: "剧情流程图占位" ],
	// ★★ ISSUE-20260928-02（第 2 步）· 流程图「运行态 / 层」巡演块 ★★
	//   位置有意放在 `open_flowchart` **之后**：此刻屏 = flowchart，且后续各屏（★ ISSUE-20260928-07：`ending` 步已删，此处原枚举的 `ending` 不再存在 /
	//   loading / title）与末尾的 M46 负向对照（依赖 title 屏）都不受影响。
	//   ① `flowstate`＝**只读**断言，读**当前屏数据**报：
	//      节点 `flow_state` 分布 / 连线 `state` 档位分布 / 应画 `current` 环条数 / 层 flag 值。
	//      `--preset states` ⇒ 五档节点 + 三档连线同屏（应画环 3 个）；默认预设 ⇒ 无 `flow_state`、0 环。
	//   ② `flowclick`＝**真实点击**层切换热区（命中 → `UIScrHitLayer` → `flow_layer` → flag）：
	//      数据里没有该层元素时**明确跳过**（`★FLOWLAYER-SKIP★`，不做任何状态变更）；
	//      `--preset frag`（可配 `run_autotour.bat frag1` 强制层）才会真切换并打出
	//      `★FLOWLAYER★ PASS|FAIL`。
	//   ③ 两态由图见证：本块每一步之后的 PNG 由 `tourRecord` 导出（`shot_NN_flowchart.png`）
	//      —— `fc_layer=main` 有连线、`fc_layer=frag1` 无连线。
	%[ kind: "screen",    v: "flowchart", label: "★运行态★ 流程图（层/运行态随预设数据而定）" ],
	%[ kind: "flowstate", v: "1",         label: "★运行态★ 只读断言：flow_state 分布 + 连线档位 + 应画环数 + 层值" ],
	%[ kind: "flowclick", v: "frag1",     label: "★运行态★ 真实点击：层入口热区（layer=frag1 ⇒ 切独立层）" ],
	%[ kind: "flowstate", v: "1",         label: "★运行态★ 只读断言：切层后（独立层：连线 0 / 主干不可见）" ],
	%[ kind: "flowclick", v: "main",      label: "★运行态★ 真实点击：返回主干热区（layer=main ⇒ 回主干）" ],
	%[ kind: "flowstate", v: "1",         label: "★运行态★ 只读断言：回主干后（fc_layer==main ⇒ 连线恢复）" ],
	//   ★ M1（2026-09-28 一审真缺陷 + 主代理裁决）：**6 组真实进出闭环**。
	//     起因：选点循环原先取「第一个 `layer=="main"` 候选」再判可见性 ⇒ frag2..frag6 里取到的
	//     恒是不可见的 `fc.frag1_back_hit` ⇒ 「返回主干」必 SKIP、2..6 组回不了主干；
	//     修法见 `uiScreenSyntheticFlowClick` 的 ②（可见性过滤放进选点）。
	//     本块给**每组两步**：`flowclick frag<G>`（进）→ `flowclick main`（出，修后能选到该组自己的
	//     `fc.frag<G>_back_hit`）。两条判词都含「点击热区 id / 中心 / 层值 from→to」，
	//     且 `ok` 要求 `after == 目标层` ⇒ **逐组断言进的是该组自己的层**（不是"非 main 即可"）。
	//     默认（screen1）预设 6 组齐全 ⇒ 无注入、不用强制层即可全绿。
	%[ kind: "flowclick", v: "frag1", label: "★闭环★ frag1 进（真实点击该组入口热区）" ],
	%[ kind: "flowclick", v: "main",  label: "★闭环★ frag1 出（真实点击该组返回键 ⇒ 回主干）" ],
	%[ kind: "flowclick", v: "frag2", label: "★闭环★ frag2 进" ],
	%[ kind: "flowclick", v: "main",  label: "★闭环★ frag2 出" ],
	%[ kind: "flowclick", v: "frag3", label: "★闭环★ frag3 进" ],
	%[ kind: "flowclick", v: "main",  label: "★闭环★ frag3 出" ],
	%[ kind: "flowclick", v: "frag4", label: "★闭环★ frag4 进" ],
	%[ kind: "flowclick", v: "main",  label: "★闭环★ frag4 出" ],
	%[ kind: "flowclick", v: "frag5", label: "★闭环★ frag5 进" ],
	%[ kind: "flowclick", v: "main",  label: "★闭环★ frag5 出" ],
	%[ kind: "flowclick", v: "frag6", label: "★闭环★ frag6 进" ],
	%[ kind: "flowclick", v: "main",  label: "★闭环★ frag6 出" ],
	%[ kind: "flowstate", v: "1",     label: "★闭环★ 收尾只读断言：6 组往返后 fc_layer==main" ],
	//   ★★ ISSUE-20260929-02（右栏大改）· 播放/暂停切换的巡演块 ★★
	//     位置有意放在上面各「运行态/层」步**之后、`flowring` 之前**：此刻前台屏仍是 `flowchart`
	//     （本块全部步骤不改屏），且不依赖任何在途延时（巡演每步 2 秒驱动，本步全同步）。
	//     ① `replaytoggle auto`＝**正向四断言**（真实点击 `fc.pbkick_hit`）：点击前的值 / 翻转 / 
	//        `uiScreenElementVisible` 复算两键「恰好一键可见」/ 再点翻回原值。判词 `★REPLAYTOGGLE★`。
	//        本步结束时 flag 停回**原值（play）**⇒ 本帧 PNG 即「播放态（只见 ▶）」。
	//     ② 三条负向对照必须打出 `★REPLAYTOGGLE-REJECT★`（不存在的 id / 非 hit / 非本动作的 hit），
	//        且**状态不变**——证明守卫有牙齿、不静默。
	//     ③ 两条 `action` 步（既有步骤类型，走 `uiActionDispatch`）**只用于两态截图**：
	//        切到 `pause` ⇒ 本帧 PNG「暂停态（只见 ‖）」；再切回 `play` ⇒ 复位并再取一张播放态。
	//        （功能正确性由 ① 的四断言负责，这两步只产图；不得据此声称画面播放已生效。）
	%[ kind: "replaytoggle", v: "auto",
	   label: "★REPLAYTOGGLE★ 真实点击 fc.pbkick_hit：四断言（点击前值 / 已翻转 / 一键可见 / 幂等闭环）" ],
	%[ kind: "replaytoggle", v: "fc.pbkick_hit__no_such__",
	   label: "★REPLAYTOGGLE-REJECT★ 负向①：目标元素不存在（显式拒绝、不改状态）" ],
	%[ kind: "replaytoggle", v: "fc.pbkick",
	   label: "★REPLAYTOGGLE-REJECT★ 负向②：目标不是 hit（无派发入口）" ],
	%[ kind: "replaytoggle", v: "fc.jump_hit",
	   label: "★REPLAYTOGGLE-REJECT★ 负向③：是 hit 但不是 flow_replay_toggle 热区" ],
	%[ kind: "action", v: "flow_replay_toggle",
	   label: "★两态截图★ 切到暂停态（同一动作经 uiActionDispatch）⇒ 本帧 PNG = 暂停态（只见 ‖）" ],
	%[ kind: "action", v: "flow_replay_toggle",
	   label: "★两态截图★ 切回播放态（复位）⇒ 本帧 PNG = 播放态（只见 ▶）" ],
	//   ★★ ISSUE-20260930-02（章节详情）· 详情浮层开合的巡演块 ★★
	//     位置：紧接播放/暂停两态截图之后（此刻前台屏仍是 `flowchart`，本块不改屏）。
	//     ① `intro open` ⇒ 真实点击 `fc.p_plus_hit`（auto：从数据推 `action==flow_intro_open` 的热区）：
	//        断言 `fc_intro` closed→open、带该 flag 的浮层件（`fc.intro_bg`/`_title_tx`/`_text_tx`）
	//        用 `uiScreenElementVisible` 复算**全部可见**，并验证「浮层打开时其余热区不可达」
	//        （顶层动作 ≠ 被覆盖热区的动作；**只判定不派发**）；判词 `★INTROOPEN★`。
	//     ② `intro close` ⇒ 真实点击 `fc.intro_scrim_hit`（挑一个**面板之外**的压暗层点）：
	//        断言回 `closed`、浮层件全部不可见、再点一次仍是 `closed`（幂等）；判词 `★INTROCLOSE★`。
	//     ③ 三条负向对照必须逐条打出 REJECT 且**不改状态**（不存在的 id / 非 hit 的图 / 动作不匹配的 hit）。
	//     ④ 数据未落（M3 之前）⇒ ①② 打 `★INTROOPEN-SKIP★` / `★INTROCLOSE-SKIP★`（**不算失败**，
	//        与 `★REPLAYTOGGLE-SKIP★` 同形制）；③ 的三条守卫**不依赖 M3 数据**（用既有件即可触发）。
	//     ⚠ 语义边界：本块只证「命中 → flag 翻转 → 显隐谓词翻面」；浮层正文/标题的**真实取数**
	//       属编程组（冻结 §四 末段），本块不得声称已接真实数据。
	%[ kind: "intro", v: "open",
	   label: "★INTROOPEN★ 真实点击 fc.p_plus_hit：closed→open + 浮层件全可见 + 其余热区不可达" ],
	%[ kind: "intro", v: "close",
	   label: "★INTROCLOSE★ 真实点击 fc.intro_scrim_hit（面板外）：回 closed + 浮层件全不可见（幂等）" ],
	%[ kind: "intro", v: "open:__no_such_intro_hit__",
	   label: "★INTROOPEN-REJECT★ 负向①：目标元素不存在（显式拒绝、不改状态）" ],
	%[ kind: "intro", v: "open:fc.pbkick",
	   label: "★INTROOPEN-REJECT★ 负向②：目标不是 hit（无派发入口）必须被守卫挡下" ],
	%[ kind: "intro", v: "close:fc.pbkick_hit",
	   label: "★INTROCLOSE-REJECT★ 负向③：是 hit 但不是 flow_intro_close 热区必须被挡下" ],
	//   ★★ ISSUE-20260930-02 · 第 2 轮：超框省略号的**引擎侧**自检 ★★
	//     背景（证据缺口）：省略号三处实现里，此前只有 HTML（`复刻/replica.js`）与 Python
	//     （`工具/gen_flow_layout.py`）有机器判据（`工具/test_text_ellipsis.py` 的冻结期望表两端交叉）；
	//     **引擎侧只有逻辑审阅** —— 交付样例各槽文字都太短、巡演任何一步都走不到「超框」分支。
	//     本步直调渲染路径用的那一支 `uiThemeWrap`，用**合成长串**走完三个分支并打读数。
	//     位置：紧随详情浮层块（不改屏、不改任何状态；只做文字度量）。
	%[ kind: "wrapellip", v: "long",
	   label: "★WRAPELLIP★ 直调引擎 uiThemeWrap：长文本⇒4 行+末行「……」+末行宽≤maxW；短文本⇒<4 行且无「……」；极窄 maxW⇒3 行且无「……」" ],
	%[ kind: "wrapellip", v: "__no_such_spec__",
	   label: "★WRAPELLIP-REJECT★ 负向对照：未知 spec 必须被显式拒绝（不静默放过）" ],
	//   ★★ ISSUE-20260929-05（第 13 批 · 模式入口）· **三态真值探针** ★★
	//     缺口背景：本工程此前登记过「**hover 态从未被渲染验证**」（M35b 时代遗留）——
	//     数据里写了 `state_assets`，但没有任何实测证明 `_over`/`_press` **真的被换用**。
	//     本块用 M46 的合成指针先例（走 `uiScreenHoverUpdate`/`uiScreenPressUpdate` 同一批入口）
	//     把指针停在 `fc.mode_main_hit` 上，断言**同组** `fc.mode_main_glow` 当前选用的素材
	//     ＝ `x_ui_modetab_over.png`；再合成按下 ⇒ `x_ui_modetab_press.png`。
	//     三步负向对照：① 交叉探针（悬停 main 时 **frag 的 `_glow` 必须仍是 normal** ⇒ 组绑定不串组）；
	//     ② 目标非 hit（image）；③ 是 hit 但无 `state_group`。另有 `clear` 复位步（断言回 normal）。
	//     本块结束时**指针已移开**（clear）⇒ 后续步骤的画面前提不被悬停态污染。
	//     ⚠ 判词只证「命中 → ctx → 选图」这条链路；**不产生真实设备事件**（同 M46 局限）。
	%[ kind: "modestate", v: "fc.mode_main_hit",
	   label: "★MODESTATE★ 合成指针：悬停「本篇集合」⇒ 底光图须取 x_ui_modetab_over.png" ],
	%[ kind: "modestate", v: "fc.mode_main_hit:press",
	   label: "★MODESTATE★ 合成指针：按住「本篇集合」⇒ 底光图须取 x_ui_modetab_press.png" ],
	%[ kind: "modestate", v: "fc.mode_main_hit|fc.mode_frag_glow",
	   label: "★MODESTATE★ 负向对照：悬停 main 时 frag 的底光图必须仍是 normal（组绑定不串组）" ],
	%[ kind: "modestate", v: "clear",
	   label: "★MODESTATE★ 复位：指针移开 + 清按下 ⇒ 两枚 `_glow` 均回 normal（闭环）" ],
	%[ kind: "modestate", v: "fc.mode_main_glow",
	   label: "★MODESTATE-REJECT★ 负向①：目标不是 hit（image）必须被守卫挡下" ],
	%[ kind: "modestate", v: "fc.jump_hit",
	   label: "★MODESTATE-REJECT★ 负向②：是 hit 但无 `state_group`（无配对底光图）必须被挡下" ],
	%[ kind: "modestate", v: "__no_such_element__",
	   label: "★MODESTATE-REJECT★ 负向③：元素不存在必须被挡下（且不做状态变更）" ],
	//   ④ `flowring`＝**内存副本注入**（不写盘）：把 3 个节点底图标成 `current`（2 可见 +
	//      1 个 `vis_when` 改成不可达层名）⇒ 下一步的帧应画 2 个环、跳过 1 个；`clear` 步
	//      先读上一帧环计数打 `★FLOWRING★ PASS|FAIL`，再还原内存副本。
	//      为什么另起一支：交付样例屏**不含** `flow_state`（缺省不写 ⇒ 无环），含五态的
	//      `--preset states` 屏数据当前**引擎加载不了**（生成器把带点的键写成 TJS2 不接受
	//      的 `"k": v`，见 E2 报告阻塞项）⇒ 环的绘制路径需要一支独立取证 + 负向对照。
	%[ kind: "flowring", v: "set",       label: "★运行态★ 内存注入：3 件 current（2 可见 + 1 隐藏）" ],
	%[ kind: "flowring", v: "clear",     label: "★运行态★ 断言环计数（2 画 / 1 跳过）并还原内存副本" ],
	// ★ ISSUE-20260928-07（2026-09-28，用户裁定）：原 `ending`（片尾）巡演步**已删** ——
	//   该屏**已整体删除**（用户：未来改用一段视频代替片尾）。屏没了仍留此步会画出「模块未接入」占位＝脏证据。
	%[ kind: "screen", v: "loading",   label: "加载提示" ],
	//   ★ ISSUE-20260929-02：**SKIP 分支的实测证据** —— 前台屏换成 `loading`（非 flowchart、
	//     也无 `flow_replay_toggle` 热区）后跑一步 `replaytoggle`：必须打 `★REPLAYTOGGLE-SKIP★`
	//     且**不做任何状态变更**（不是静默放过、也不是假 PASS）。
	//     理由：正向上游各步的前台屏都是 flowchart（机制齐备）⇒ 不换屏就**永远验不到 SKIP 分支**；
	//     而 SKIP 是本步「不假跑」的承诺，必须有实测输出，不能只写在注释里（同 flowclick 的 SKIP 形制）。
	%[ kind: "replaytoggle", v: "auto",
	   label: "★REPLAYTOGGLE-SKIP★ 前台屏=loading（无该机制）⇒ 必须明确跳过、不改状态" ],
	%[ kind: "screen", v: "title",     label: "回到标题" ],
	// ★ M46 逐项三态的**负向对照**（一审 Major-1 打回后从选择支屏挪到这里）：
	//   `title.menu_hit_1` 是**真·非 list** 元素（`kind:"hit"`）⇒ 命中
	//   `uiScreenSyntheticPointer` 的 `el.kind != "list"` 那条守卫，日志应出现
	//   `★M46PTR-REJECT★ title.menu_hit_1 不是 list（kind=hit）`。
	//   放在标题屏还有两个副作用（都是想要的）：① 借换屏清掉上一步遗留的按下态
	//   （一审 Minor-5）；② 「元素不存在」那条守卫不再被冒充成「非 list 守卫」。
	%[ kind: "ptr",    v: "title.menu_hit_1:0", label: "合成指针：负向对照（非 list 必须被守卫挡下）" ]
];

var UIScrTourIndex  = 0;
var UIScrTourPlan   = null;

// 生成本次巡演的完整步骤表（含自动追加的未列屏）
function uiTourBuildPlan()
{
	var plan = [];
	for(var i = 0; i < UIScrTourSteps.count; i++) plan.push(UIScrTourSteps[i]);

	// 追加 layout 中存在但未列到的屏
	var listed = %[];
	for(var j = 0; j < plan.count; j++)
		if(plan[j].kind == "screen") listed[plan[j].v] = true;
	var extra = [];
	var sc = UILayoutData.screens;
	for(var m = 0; m < UIScrTourIdList.count; m++)
	{
		var sid = UIScrTourIdList[m];
		if(listed[sid] === true) continue;
		extra.push(%[ kind: "screen", v: sid, label: "追加：" + sid ]);
	}
	for(var n = 0; n < extra.count; n++) plan.push(extra[n]);
	return plan;
}

// layout 里已登记的屏 id 清单（并行数组维护；Dictionary 不能枚举）
var UIScrTourIdList = [];

function uiTourCollectScreenIds()
{
	UIScrTourIdList = [];
	// 已知屏 id 白名单来自 layout/screens/_index.json 的 15 类界面（M13 追加 sysicons → 16 类），
	// 这里按"存在性"探测（Dictionary 读缺失键返回 void，不抛）。
	// ★ M2（契约⑥）：`sysmenu` 已从白名单移除 —— 该屏不再是可达界面，不参与巡演与
	//   追加屏清单；`quickbar` **保留**（竖条本体的展开态由它自己的 flags_default/reveal 决定）。
	//   ★ M45（2026-09-23，用户裁定）：`sysmenu` 屏**已整体废除** ⇒ 白名单不含它、屏文件亦已删除。
	// ★ M43（2026-09-23）：`chapter` 已从白名单移除 —— 该屏已整体删除（用户裁定）。
	// ★ M46（2026-09-23，用户裁定）：`sysbar` 已从白名单移除 —— 该屏**已整体删除**
	//   （用户原话「把系统条 sysbar 页删了，但底条素材保留（防冲突）」），屏文件与 `_index.json`
	//   条目均已移除；**素材一律保留原位**（★ ISSUE-20260929-04 订正：`sysbar` 屏与流程图屏的
	//   `fc.sysbar` **均已退场**——流程图屏的 `fc.sysbar` 元素已删；**素材保留不删**、防冲突）。
	//   `quickbar` / `choices` / `dress` **不在删除范围，照旧保留**。
	// ★ ISSUE-20260928-06（2026-09-28，用户裁定）：`fragment` 已从白名单移除 —— 该屏**已整体删除**
	//   （番外 6 组内容已全部由流程图屏的独立层 `flow_layer` 承载；实测页面 40 格 ⊂ 流程图 45 格、
	//     文案 40/40 逐字相同 ⇒ 删屏零内容丢失）。**动作 `open_fragment` / `fragment_enter` 保留**
	//   （与 `sysmenu` 废除时「删屏 ≠ 删动作」同口径），`x_gen_fragpage.png` 素材与 `fragments` 数据**一律保留**。
	// ★ ISSUE-20260928-07（2026-09-28，用户裁定）：`ending` 已从白名单移除 —— 该屏**已整体删除**
	//   （用户：**未来改用一段视频代替片尾**）。素材 `ui/x_ui_ending_bg.png` 与 `ui/x_gen_ed_char.png`
	//   **保留**（作将来做视频的参考/来源），屏内 7 件元素（bg/shade/char/staff/lyric_bar/lyric/hit_skip）随之移除。
	//   ⚠ 该屏被删前巡演汇总里那条 `截断文本 1 处 [ed.staff : …]` 也随之消失（那不是本次引入的问题）。
	var probe = [ "title", "dialog", "confirm", "loading", "save", "load",
		"config", "backlog", "gallery", "music",
		"flowchart", "sysicons",
		// ★ M34 新增屏（PSB 复刻）：系统菜单快捷条 / 选择支 / 立绘鉴赏（底部系统条已于 M46 删除）
		"quickbar", "choices", "dress",
		// ★ M1（ISSUE-20260924-08）：鉴赏模式四页之一「情景回想」（M4 交付）+ 共享外壳屏
		//   （外壳是 attach 附加层，单独列一步可单独出图核对页签条/标题/返回键）。
		"replay", "gal_shell" ];
	for(var i = 0; i < probe.count; i++)
		if(UILayoutData.screens[probe[i]] !== void) UIScrTourIdList.push(probe[i]);
	return UIScrTourIdList.count;
}

function uiTourReset()
{
	UIScrTourPlan = uiTourBuildPlan();
	UIScrTourIndex = 0;
	uiScreenReset("title");
}

// 执行下一步；返回 %[ done:, label:, screen:, note: ]
function uiTourStep()
{
	if(UIScrTourPlan === null) uiTourReset();
	if(UIScrTourIndex >= UIScrTourPlan.count)
		return %[ done: true, label: "(巡演结束)", screen: uiScreenCurrent(), note: "" ];

	var st = UIScrTourPlan[UIScrTourIndex];
	UIScrTourIndex++;

	var note = "";
	if(st.kind == "screen")
	{
		if(uiScreenExists(st.v)) uiScreenReset(st.v);
		else
		{
			uiScreenReset(st.v);
			note = "屏未登记 -> 占位";
		}
	}
	else if(st.kind == "mouse")     // ★ M13：合成鼠标事件（走 onMouseDown 同一入口）
	{
		note = uiScreenSyntheticMouse(st.v);
	}
	else if(st.kind == "ptr")       // ★ M46：合成指针定位（走 uiScreenHoverUpdate 同一入口）
	{
		note = uiScreenSyntheticPointer(st.v);
	}
	else if(st.kind == "drag")      // ★ M47：合成拖动（走 按下/移动/抬起 同一批入口）
	{
		note = uiScreenSyntheticDrag(st.v);
	}
	else if(st.kind == "flag")      // ★ M47 追补：值标志断言（切页往返不丢值的证据）
	{
		note = uiScreenSyntheticFlagCheck(st.v);
	}
	else if(st.kind == "click")     // ★ M47 三轮：合成点击（按下/抬起/命中/分发 同批入口）
	{
		note = uiScreenSyntheticClick(st.v);
	}
	else if(st.kind == "itembtn")   // ★ M06：逐块按钮的合成指针+点击（命中 + 派发行号）
	{
		note = uiScreenSyntheticItemBtn(st.v);
	}
	else if(st.kind == "itemrow")   // ★ M06：负向对照（块内非按钮区 ⇒ 整行命中）
	{
		note = uiScreenSyntheticItemRow(st.v);
	}
	else if(st.kind == "itemguard") // ★ M06：机制守卫的负向对照（改坏的内存副本必须被挡下）
	{
		note = uiScreenSyntheticItemGuard(st.v);
	}
	else if(st.kind == "itempage")  // ★ M06：分页后按钮随块走（临时改小 max_rows，内存副本）
	{
		note = uiScreenSyntheticItemPage(st.v);
	}
	else if(st.kind == "galtab")    // ★ M1：鉴赏页签切屏（上一页不在栈里 + 外壳页签 flag）
	{
		note = uiScreenSyntheticGalTab(st.v);
	}
	else if(st.kind == "galpage")   // ★ M1：鉴赏页内翻页
	{
		note = uiScreenSyntheticGalPage(st.v);
	}
	else if(st.kind == "galpageassert")  // ★ M8 一审 R3/⑥：页码+页码flag 的只读断言（不派发）
	{
		note = uiScreenSyntheticGalPageAssert(st.v);
	}
	else if(st.kind == "galvar")    // ★ M1：栏位内差分翻页（换图 + n/N + 派发行号）
	{
		note = uiScreenSyntheticGalVar(st.v);
	}
	else if(st.kind == "galguard")  // ★ M1：item_variants 非法形态的负向对照
	{
		note = uiScreenSyntheticGalGuard(st.v);
	}
	else if(st.kind == "galattach") // ★ M1：外壳在四个承载屏下的绘制 + 命中复用
	{
		note = uiScreenSyntheticGalAttach(st.v);
	}
	else if(st.kind == "flowstate") // ★ 第 2 步：流程图运行态只读断言（五态/三档/环数/层值）
	{
		note = uiScreenFlowStateLine();
	}
	else if(st.kind == "flowclick") // ★ 第 2 步：走真实点击入口切层（命中参数 → flow_layer）
	{
		note = uiScreenSyntheticFlowClick(st.v);
	}
	else if(st.kind == "replaytoggle") // ★ ISSUE-20260929-02：走真实点击入口切「播放/暂停」（四断言）
	{
		note = uiScreenSyntheticReplayToggle(st.v);
	}
	else if(st.kind == "intro")     // ★ ISSUE-20260930-02：详情浮层开合（走真实点击入口 + 负向对照 + SKIP）
	{
		note = uiScreenSyntheticIntroToggle(st.v);
	}
	else if(st.kind == "wrapellip") // ★ ISSUE-20260930-02 第 2 轮：超框省略号的引擎侧自检（直调 uiThemeWrap）
	{
		note = uiScreenSyntheticWrapEllip(st.v);
	}
	else if(st.kind == "modestate") // ★ ISSUE-20260929-05：模式入口三态真值探针（合成指针/按下 + 交叉负向对照）
	{
		note = uiScreenSyntheticModeState(st.v);
	}
	else if(st.kind == "flowring") // ★ 第 2 步：current 环的内存副本注入（含「隐藏节点不画环」负向对照）
	{
		note = uiScreenSyntheticFlowRing(st.v);
	}
	else
	{
		var r = uiActionDispatch(st.v, 0);
		note = r.msg;
	}

	return %[ done: false, label: st.label, screen: uiScreenCurrent(),
		note: note, kind: st.kind, value: st.v ];
}

function uiTourProgress()
{
	var total = (UIScrTourPlan === null) ? 0 : UIScrTourPlan.count;
	return (UIScrTourIndex) + "/" + total;
}

// 巡演单屏日志行（要求：当前屏 id / 元素数 / 字体 / 是否缺件）
function uiTourLogLine(label, drawn)
{
	var id = uiScreenCurrent();
	var n = 0;
	if(uiScreenExists(id)) n = UILayoutData.screens[id].elements.count;
	var line = "[UI][TOUR] " + uiTourProgress() + "  屏=" + id
		+ "  中文名=" + (uiScreenExists(id) ? ("" + UILayoutData.screens[id].title_cn) : "(未登记)")
		+ "  元素数=" + n
		+ "  实绘元素=" + drawn
		+ "  字体=" + ((UIThemeFace != "") ? UIThemeFace : "(引擎默认)")
		+ "  缺件=" + uiAssetMissCount()
		+ "  占位=" + ((UIScrPlaceholder == "") ? "无" : "有")
		+ "  标签=" + label;
	return line;
}

// ------------------------------------------------------------
// ★ ISSUE-20260927-05（E2）：装载流程图连线渲染模块
//   为什么在这里 execStorage：startup.tjs 的装载名单**不在本轮改动范围**内，
//   而本文件（ui_screens.tjs）在 ui_flow*.tjs 之前装载、在任何一次 uiScreenDraw
//   之前就已执行完 ⇒ 在此装载即可保证绘制入口调用时函数已就位。
//   `uiExec` 是 startup.tjs 的装载封装（同款 Scripts.execStorage + 日志 + 容错）。
//   装载结果存 `UIScrFlowLinksOK`：uiScreenDraw 的两个调用点据此守卫 —— 模块缺失
//   时**不调用**（否则每帧都会因「未找到 Member」把整帧打掉，比不画连线严重得多）。
// ------------------------------------------------------------
var UIScrFlowLinksOK = false;
// ★ ISSUE-20260928-02（第 2 步）：层/环模块（`flow_layer` 动作 + `current` 环 post-pass）。
//   两张装标志都在**装载之前**声明：被装载的模块会在自己的装载期读它们
//   （`ui_flow_layer.tjs` 的 `uiFlowLayerInit()` 要报「插件探测来自哪个模块」），
//   若等到装载之后才声明，那次读取就会抛「未找到 Member」。
var UIScrFlowLayerOK = false;

try { UIScrFlowLinksOK = uiExec("ui_flow_links.tjs"); }
catch(eFL)
{
	try { Debug.message("[UI][FLOWLINK] load FAIL : " + eFL.message); } catch(eFL2) { }
}
if(!UIScrFlowLinksOK)
	Debug.message("[UI][FLOWLINK] module unavailable -> flowchart links degraded to none (screen still draws)");

try { UIScrFlowLayerOK = uiExec("ui_flow_layer.tjs"); }
catch(eFLa)
{
	try { Debug.message("[UI][FLOWLAYER] load FAIL : " + eFLa.message); } catch(eFLa2) { }
}
if(!UIScrFlowLayerOK)
	Debug.message("[UI][FLOWLAYER] module unavailable -> flow_layer action + current rings degraded (screen still draws)");