			if(badKey[uiWidgetVariantBtnKey(spec, which)] === true) continue;
			var br = uiWidgetVariantRect(el, i, which);
			if(br === null) continue;
			var st = uiWidgetVariantBtnState(el, ctx, rowG, "" + spec.key);
			var ba = uiWidgetVariantBtnAsset(spec, st);
			if(ba === void || ba === null || ("" + ba) == "") continue;
			var brr = uiWidgetBlitAsset(stage, "" + ba, br.x, br.y, br.w, br.h, spec.nine,
				(spec.opacity !== void) ? spec.opacity : opa);
			if(brr.missing) uiWidgetNoteMiss(el.id + "[" + spec.key + "]", "" + ba);
			if(spec.label !== void && ("" + spec.label) != "")
			{
				var bt = %[ id: uiWidgetVariantBtnToken(el.id, rowG, spec.key) + ".label", kind: "text",
					x: br.x, y: br.y, w: br.w, h: br.h,
					align: (spec.align !== void) ? spec.align : "center", valign: "middle",
					wrap: false, max_lines: 1, sample: spec.label ];
