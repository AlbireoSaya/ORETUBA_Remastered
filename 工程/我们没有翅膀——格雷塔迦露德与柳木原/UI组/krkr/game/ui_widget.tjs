// 该栏此刻应显示的差分序号（clamp 到 [0, n-1]）；n<=0 ⇒ 0。
//   运行期值由 `ctx.variantIndex` 携带，结构 = **嵌套字典**：`{ <listId>: { <全局行号>: 序号 } }`
//   （与 `ui_screens.tjs` 的 `UIScrVarIdx` 同构，直接传引用 ⇒ 每帧零拷贝）。
function uiWidgetVariantIdx(ctx, el, row, n)
{
	var i = 0;
	if(ctx !== void && ctx !== null && ctx.variantIndex !== void && ctx.variantIndex !== null)
	{
		var m = ctx.variantIndex["" + el.id];
		if(m !== void && m !== null)
		{
			var v = m["" + row];
			if(v !== void && v !== null) i = v;
		}
	}
	i = Math.floor(i);
	if(i < 0) i = 0;
	if(n > 0 && i >= n) i = n - 1;
	return i;
}

// 差分子命中（**先于整行**，后于 `item_buttons`）：返回 null 或
//   %[ index: 全局项序号, key:, bi:, action:, kind: "variant" ]（`action` 里的 `%row%` 未替换）。
