	var hot = false, pss = false;
	if(ctx.pressHit !== void && ctx.pressHit !== null && ("" + ctx.pressHit) == id)
		if(ctx.pressIndex !== void && ctx.pressIndex !== null && ctx.pressIndex == i) pss = true;
	if(ctx.hoverHit !== void && ctx.hoverHit !== null && ("" + ctx.hoverHit) == id)
		if(ctx.hoverIndex !== void && ctx.hoverIndex !== null && ctx.hoverIndex == i) hot = true;
	if(pss) return "pressed";
	if(hot) return "hover";
	return "";
}

function uiWidgetItemFrameAsset(fr, state)
{
	var sa = (fr !== void && fr !== null) ? fr.state_assets : void;
	if(sa === void || sa === null) return fr.asset;
	var a = void;
	if(state == "pressed" && sa.pressed !== void && sa.pressed !== null && ("" + sa.pressed) != "") a = sa.pressed;
	if(a === void && (state == "pressed" || state == "hover")
		&& sa.hover !== void && sa.hover !== null && ("" + sa.hover) != "") a = sa.hover;
	if(a === void && sa.normal !== void && sa.normal !== null && ("" + sa.normal) != "") a = sa.normal;
	if(a === void) a = fr.asset;
	return a;
}

// ------------------------------------------------------------
// ★ M06（2026-09-24 · ISSUE-20260924-06_回想屏重排 · 冻结书 §1b/§2）：**逐项按钮 `item_buttons`**
//   ＋ **逐项文本区 `item_text`**
//
//   背景：`list` 原先只有「整行一个 action + 一行居中标签」；回想屏要求**每一块里都有
//   「跳转」「重新播放」两个按钮**，且每块文案要按真实语料折行（最坏 132 全角字）。
//   静态元素做不到（列表会分页滚动，静态件不随块走，见冻结书 §0 结论）⇒ 必须逐项渲染
//   ＋ 逐项子命中，沿用 M46「列表逐项三态」的同一套路。
//
//   数据契约（**接口冻结，不得改名**；`layout\_schema.md` §四 `list` 节）：
//     `item_buttons`: [ { key, x, y, w, h,            // **块内局部坐标**（相对项矩形左上）
//                          asset, nine?, state_assets?,
//                          action,                    // 串内 `%row%` = **全局项序号**
//                          label?, font?, align? } ]
//     `item_text`   : { x, y, w, h, wrap, max_lines, align, valign, font? }  // 同样块内局部
//
//   两端同口径（**改一处须改两处**，HTML 侧见 复刻/replica.js 的 buildList）：
//     ① 渲染：逐按钮贴图（九宫格／1:1）＋ 按 `state_assets` 取态；给了 `label` 才画文字；
//     ② 命中：按钮矩形**优先于整行**（块内其余区域仍走既有 `actions[项]`）；
//        悬停/按下态**只影响被指到的那一个按钮的那一行**（与 M46 逐项态同规矩）；
//     ③ 派发：`%row%` 替换为全局项序号（含分页偏移，由 `uiWidgetListHit` 给出）；
//     ④ `item_text` 缺省 ⇒ **旧路径逐字不变**（单行、无内缩、整项垂直居中）。
