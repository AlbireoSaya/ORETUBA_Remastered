		var tsp = v.text;
		if(tsp !== void && tsp !== null && typeof tsp == "Object")
		{
			var txtR = uiWidgetVariantRect(el, i, "text");
			if(txtR !== null)
			{
				var label = "" + (idx + 1) + "/" + n;
				var tmp = %[ id: el.id + "[" + rowG + "].var", kind: "text",
					x: txtR.x, y: txtR.y, w: txtR.w, h: txtR.h,
					align: (tsp.align !== void) ? tsp.align : "center",
					valign: (tsp.valign !== void) ? tsp.valign : "middle",
					wrap: false, max_lines: 1, sample: label ];
				tmp.font = (tsp.font !== void) ? tsp.font : el.font;
				uiWidgetDrawText(stage, tmp, ctx);
			}
		}
	}
}

// ★ M1：**列表逐项子命中的统一出口**（`item_buttons` 优先，其次 `item_variants.prev/next`）。
//   返回 null 或 %[ index:, key:, bi:, action:, kind: "button"|"variant" ]。
//   为什么要有这一层：`uiScreenClick` / `uiScreenListItemBtnHit`（悬停·按下令牌）都要问
//   「这一行上有没有子控件」，两处必须**同集**；把优先级收在一个函数里，两端也只需对齐这一处。
function uiWidgetItemSubHitAt(el, px, py, page)
{
	var bt = uiWidgetItemButtonAt(el, px, py, page);
	if(bt !== null)
		return %[ index: bt.index, key: bt.key, bi: bt.bi, action: bt.action, kind: "button" ];
