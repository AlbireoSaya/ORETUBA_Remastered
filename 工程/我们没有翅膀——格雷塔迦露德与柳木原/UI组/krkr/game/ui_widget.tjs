		for(var j2 = 0; j2 < pg.visibleCount; j2++)
		{
			var idx2 = pg.first + j2;
			var ir3 = uiWidgetListItemRect(el, j2);
			var label2 = "" + el.labels[idx2];
			var tmp2 = %[ id: "" + el.id + "[" + idx2 + "].text", kind: "text",
