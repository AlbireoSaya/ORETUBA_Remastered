	if(v === null) return null;
	var spec = null;
	if(part == "thumb")
	{
		spec = v.thumb;
		if(spec === void || spec === null || typeof spec != "Object")
		{
			var size = uiWidgetItemSize(el);
			spec = %[ x: 0, y: 0, w: size.w, h: size.h ];
