		var rp = uiWidgetItemVariantRowProblem(el, rowG);
		if(rp != "")
		{
			uiWidgetItemVariantReject(el.id, "frames[" + rowG + "]", rp);
			continue;
		}
		var fr = uiWidgetVariantFramesRow(el, rowG);
		if(fr === null || fr.count == 0) continue;      // 留空（合法）
		var n = fr.count;
		var idx = uiWidgetVariantIdx(ctx, el, rowG, n);
		// ① 缩略图（当前差分）
		var asset = fr[idx];
		var tr = uiWidgetVariantRect(el, i, "thumb");
		if(tr !== null)
		{
			var thumbNine = void;
			if(v.thumb !== void && v.thumb !== null && typeof v.thumb == "Object") thumbNine = v.thumb.nine;
			var rr = uiWidgetBlitAsset(stage, "" + asset, tr.x, tr.y, tr.w, tr.h, thumbNine, opa);
