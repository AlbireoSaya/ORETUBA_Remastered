function uiWidgetVariantTextProblem(el, t)
{
	return uiWidgetVariantRectProblem(el, t, "文本区");
}

// 某栏（**全局行号**）的差分表校验。返回 "" = 合法或留空；否则 = 拒绝理由。
//   · row 越界 / frames[row] 为空数组 ⇒ ""（**留空是合法状态**，用于「其余留空」的页）；
//   · frames[row] 非数组 ⇒ 非法；· 含空串/非字符串 ⇒ 非法（**空素材**）。
function uiWidgetItemVariantRowProblem(el, row)
{
	var v = uiWidgetItemVariants(el);
	if(v === null) return "";
	var fr = uiWidgetVariantFrames(el);
	if(fr === null) return "";
	if(row < 0 || row >= fr.count) return "";
	var r = fr[row];
	if(r === void || r === null) return "";
	if(typeof r != "Object" || r.count === void)
		return "第 " + row + " 栏差分列表不是数组";
	if(r.count == 0) return "";
	for(var i = 0; i < r.count; i++)
	{
		var a = r[i];
		if(a === void || a === null || typeof a != "String" || ("" + a) == "")
			return "差分素材为空（第 " + (i + 1) + " 张）";
	}
	return "";
}

var UIWidgetVariantRejectSeen  = %[];
var UIWidgetVariantRejectLines = [];

// 差分守卫的判词出口：`★M08VARIANT-REJECT★ <listId>[<key>] <理由>`
//   · 去重（同一 (list,key,理由) 只记一次，避免每帧刷屏）；
//   · 同时进 `Debug.message`（巡演日志立即可见）与 `UIWidgetVariantRejectLines`（机检汇总）。
function uiWidgetItemVariantReject(listId, key, reason)
{
	var line = "★M08VARIANT-REJECT★ " + listId + "[" + key + "] " + reason;
	if(UIWidgetVariantRejectSeen[line] === true) return line;
	UIWidgetVariantRejectSeen[line] = true;
	UIWidgetVariantRejectLines.push(line);
	try { Debug.message("[UI][REJECT] " + line); } catch(e) { }
	return line;
}

// 差分按钮的身份令牌 —— **与 M06 的 `uiWidgetItemBtnToken` 同构**
//（`<listId>:<全局行号>:<key>`），故可复用 `ctx.hoverBtn` / `ctx.pressBtn` 那一套悬停/按下机制。
function uiWidgetVariantBtnToken(listId, idx, key)
{
	return ("" + listId) + ":" + idx + ":" + ("" + key);
}

// 该差分按钮此刻的状态：""｜"hover"｜"pressed"（复用 M06 的令牌机制 ⇒ 规则表同 M46/M06）
function uiWidgetVariantBtnState(el, ctx, idx, key)
{
	return uiWidgetItemButtonState(el, ctx, idx, key);
}

// 差分按钮素材：`state_assets` 按「按下 > 悬停 > 常态」取，缺键逐级回落 `asset`
//（梯级与 `uiWidgetItemButtonAsset` 完全一致 ⇒ 直接复用）
function uiWidgetVariantBtnAsset(b, state)
{
	return uiWidgetItemButtonAsset(b, state);
}

// 某栏某件的**画布矩形**（part ∈ "thumb"|"prev"|"next"|"text"）。
//   ⚠️ **绘制与命中共用这一个函数**（契约要求）：index = 当页**局部**序号。
function uiWidgetVariantRect(el, index, part)
{
