	var v = el.item_variants;
	if(typeof v != "Object") return null;
	if(v.count !== void) return null;          // 数组（TJS2 数组有 count，Dictionary 没有）
	return v;
}

function uiWidgetHasItemVariants(el)
{
	return !(el.item_variants === void || el.item_variants === null);
}

// frames 数组（非法一律 null）
function uiWidgetVariantFrames(el)
{
	var v = uiWidgetItemVariants(el);
	if(v === null) return null;
	var fr = v.frames;
	if(fr === void || fr === null || typeof fr != "Object" || fr.count === void) return null;
	return fr;
}

// 某栏的差分表（**全局行号**）；null = 该栏留空（合法）
function uiWidgetVariantFramesRow(el, row)
{
	var fr = uiWidgetVariantFrames(el);
	if(fr === null) return null;
	if(row < 0 || row >= fr.count) return null;
	var r = fr[row];
	if(r === void || r === null || typeof r != "Object" || r.count === void) return null;
	return r;
}

// 子按钮（prev/next）的字段校验 —— 与 M06 的 `uiWidgetItemButtonProblems` 同一套判据与措辞。
// 返回 "" = 合法；否则 = 拒绝理由（绘制/命中/守卫共用）。
function uiWidgetVariantBtnProblem(el, b)
{
	if(b === void || b === null || typeof b != "Object") return "不是对象";
	var k = (b.key === void || b.key === null) ? "" : ("" + b.key);
	if(k == "") return "缺 key";
	var size = uiWidgetItemSize(el);
	var bw = uiWidgetNum(b, "w", 0), bh = uiWidgetNum(b, "h", 0);
	var bx = uiWidgetNum(b, "x", 0), by = uiWidgetNum(b, "y", 0);
	if(bw <= 0 || bh <= 0) return "矩形零/负面积（" + bw + "×" + bh + "）";
	if(bx < 0 || by < 0 || bx + bw > size.w || by + bh > size.h)
		return "矩形出块（局部 " + bx + "," + by + " " + bw + "×" + bh
			+ " 不在 " + size.w + "×" + size.h + " 内）";
	var act = (b.action === void || b.action === null) ? "" : ("" + b.action);
	if(act == "") return "action 为空";
	if(b.asset === void && b.state_assets === void) return "既无 asset 也无 state_assets";
	return "";
}

// `item_variants` 的**容器级**结构校验。返回非法清单 %[ key:, reason: ]；合法数据恒空数组。
//   ⚠️ 只查容器与 prev/next/text/thumb 的**结构**；逐栏 `frames[row]` 的检查在
//   `uiWidgetItemVariantRowProblem`（按可见栏调用，避免每帧扫全表）。
function uiWidgetItemVariantProblems(el)
{
	var out = [];
	if(!uiWidgetHasItemVariants(el)) return out;
	var v = uiWidgetItemVariants(el);
	if(v === null)
	{
