// 该 list 是否声明了**任何一种**逐项子控件（`item_buttons` / `item_variants`）
function uiWidgetHasItemSub(el)
{
	if(uiWidgetItemButtons(el) !== null) return true;
	return uiWidgetItemVariants(el) !== null;
}

function uiWidgetDrawList(stage, el, ctx)
{
	var page = 0;
	var focus = -1;
	if(ctx !== void)
	{
		if(ctx.page !== void && ctx.page[el.id] !== void)  page  = ctx.page[el.id];
		if(ctx.focus !== void && ctx.focus[el.id] !== void) focus = ctx.focus[el.id];
