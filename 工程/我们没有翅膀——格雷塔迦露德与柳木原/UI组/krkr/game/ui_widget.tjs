	if(uiWidgetVariantFrames(el) === null)
	{
		out.push(%[ key: "(frames)", reason: "frames 不是数组" ]);
		return out;
	}
	var rp = uiWidgetVariantBtnProblem(el, v.prev);
	if(rp != "") out.push(%[ key: uiWidgetVariantBtnKey(v.prev, "prev"), reason: rp ]);
	var rn = uiWidgetVariantBtnProblem(el, v.next);
	if(rn != "") out.push(%[ key: uiWidgetVariantBtnKey(v.next, "next"), reason: rn ]);
	var rtext = uiWidgetVariantTextProblem(el, v.text);
	if(rtext != "") out.push(%[ key: "text", reason: rtext ]);
	var rthumb = uiWidgetVariantRectProblem(el, v.thumb, "缩略区");
	if(rthumb != "") out.push(%[ key: "thumb", reason: rthumb ]);
