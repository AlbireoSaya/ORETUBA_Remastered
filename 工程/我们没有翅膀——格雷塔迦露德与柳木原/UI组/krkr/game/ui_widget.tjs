	return out;
}

// 子按钮的判词键：有非空 `key` 用它，否则用缺省名（prev/next）—— 两端同口径。
function uiWidgetVariantBtnKey(b, def)
{
	if(b === void || b === null || typeof b != "Object") return def;
	var k = (b.key === void || b.key === null) ? "" : ("" + b.key);
	return (k == "") ? def : k;
}

// 块内局部矩形的通用校验（text / thumb 共用）。what = 报错里用的名字。
function uiWidgetVariantRectProblem(el, r, what)
{
	if(r === void || r === null) return "";
	if(typeof r != "Object") return what + "不是对象";
	var w = uiWidgetNum(r, "w", 0), h = uiWidgetNum(r, "h", 0);
	if(w <= 0 || h <= 0) return what + "零/负面积（" + w + "×" + h + "）";
	var size = uiWidgetItemSize(el);
	var x = uiWidgetNum(r, "x", 0), y = uiWidgetNum(r, "y", 0);
	if(x < 0 || y < 0 || x + w > size.w || y + h > size.h)
		return what + "出块（局部 " + x + "," + y + " " + w + "×" + h
