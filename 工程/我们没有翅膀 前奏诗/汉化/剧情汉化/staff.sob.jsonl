{"seq": 345, "addr": 15296, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "ポンカン", "voice": "PON0055", "td": 0, "jp": "「──以上の皆さまでお送りいたしました」", "cn": "“——以上就是全部人员了”"}
{"seq": 368, "addr": 16200, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "シトラス", "voice": "CIT0129", "td": 0, "jp": "「わー、終わったお疲れさまー！」", "cn": "“哇～结束了，大家辛苦了——！”"}
{"seq": 372, "addr": 16348, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "ミネオラ", "voice": "MIN0127", "td": 0, "jp": "「うう、なんとかまとまって良かった……」", "cn": "“呜呜，总算是收好尾了……”"}
{"seq": 376, "addr": 16496, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "ポンカン", "voice": "PON0056", "td": 0, "jp": "「はあー、なんだか安心したらおなか空いちゃいました」", "cn": "“唉～不知怎么，一放心肚子就饿了”"}
{"seq": 384, "addr": 16788, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "シトラス", "voice": "CIT0130", "td": 0, "jp": "「よーし、焼肉食べるぞー！　寂しい女同士ー！」", "cn": "“好～去吃烤肉喽——！孤单女人组——！”"}
{"seq": 389, "addr": 16984, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "ミネオラ", "voice": "MIN0128", "td": 0, "jp": "「シトラスちゃん、なんで私たちが自動的にそのカテゴリへ編入されるのかはいいとして、あんまり食べすぎると本編の発売日までに太っちゃうよ」", "cn": "“小西特拉斯，先不管我们为什么会被自动归进那个分类，吃太多的话，到本篇发售日会胖的哦”"}
{"seq": 393, "addr": 17132, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "シトラス", "voice": "CIT0131", "td": 0, "jp": "「えっ、本編の発売日ってどうせ数年先でしょ？」", "cn": "“诶，本篇的发售日反正也是好几年后吧？”"}
{"seq": 397, "addr": 17280, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "ミネオラ", "voice": "MIN0129", "td": 0, "jp": "「あ、あはは、面白い冗談だね……でも、ちょっと縁起悪いかな……」", "cn": "“啊、啊哈哈，真是有趣的玩笑……不过，好像有点不吉利……”"}
{"seq": 401, "addr": 17428, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "ポンカン", "voice": "PON0057", "td": 0, "jp": "「それはきっと何処にでもある、ありふれた物語。ネーブル」", "cn": "“那一定是个随处都有、平凡无奇的故事。Navel”"}
{"seq": 408, "addr": 17708, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "ミネオラ", "voice": "MIN0130", "td": 0, "jp": "「キャー！　やめてやめて、嫌なタイミングで作品キャッチ入れないで！　すぐ出るの、ぜったい出るの！」", "cn": "“呀——！住手住手，别在这种讨厌的时机插作品宣传语！马上就出的，绝对会出的！”"}
{"seq": 413, "addr": 17904, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "シトラス", "voice": "CIT0132", "td": 0, "jp": "「僕らが君に語るのは、たとえばそんなメルヘン。ネーブル」", "cn": "“我们要向你讲述的，就是那样一个童话。Navel”"}
{"seq": 420, "addr": 18184, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "ミネオラ", "voice": "MIN0131", "td": 0, "jp": "「ええ～ん、最後までこんな締め方～」", "cn": "“呜～嗯，到最后都是这种收尾方式——”"}
{"seq": 429, "addr": 18528, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "シトラス", "voice": "CIT0133", "td": 0, "jp": "「それじゃね、みんな！　ばいばーい！」", "cn": "“那么再见啦，大家！拜拜——！”"}
{"seq": 434, "addr": 18724, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "ミネオラ", "voice": "MIN0132", "td": 0, "jp": "「さ、さようなら～！」", "cn": "“再、再见～！”"}
{"seq": 442, "addr": 19052, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "ポンカン", "voice": "PON0058", "td": 0, "jp": "「ありがとうございました！」", "cn": "“非常感谢！”"}
