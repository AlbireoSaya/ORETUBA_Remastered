{"seq": 1, "addr": 28, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 0, "jp": "また会うんじゃね？", "cn": "还会再见吧？"}
{"seq": 8, "addr": 336, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "隼人", "voice": "", "td": 0, "jp": "「ああ……あー、まー、それは……あるかもな」", "cn": "“啊啊……啊～，嘛～，那……说不定吧”"}
{"seq": 12, "addr": 484, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "鳴", "voice": "NAR0289", "td": 0, "jp": "「あるかもですね」", "cn": "“说不定真有呢”"}
{"seq": 14, "addr": 576, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　そうかもな、と俺は言った。", "cn": "说不定吧，俺说道。"}
{"seq": 16, "addr": 668, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　そうですよね、とやつも言った。", "cn": "是啊，那家伙也说道。"}
{"seq": 18, "addr": 760, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　なるほどね、とふたりで言った。", "cn": "原来如此，两个人一起说道。"}
{"seq": 20, "addr": 852, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　だから何だ、と誰かが言った。", "cn": "所以呢，不知是谁说道。"}
{"seq": 24, "addr": 1000, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "鳴", "voice": "NAR0290", "td": 0, "jp": "「えー、はい、それではまた近いうちに」", "cn": "“诶～，好，那就改天再见”"}
{"seq": 26, "addr": 1092, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "隼人", "voice": "", "td": 0, "jp": "「ん。じゃーな」", "cn": "“嗯。回头见”"}
{"seq": 30, "addr": 1240, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "鳴", "voice": "NAR0291", "td": 0, "jp": "「はい、それでは、また近いうちにー」", "cn": "“好，那就改天再见了～”"}
{"seq": 32, "addr": 1332, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "隼人", "voice": "", "td": 0, "jp": "「繰りかえさないでいいから。ほら、早く行け。いい席なくなんぞ」", "cn": "“不用重复一遍。喂，快去吧。好位子要被抢光了”"}
{"seq": 34, "addr": 1424, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　たぶんこいつは車両の連結部を好むタイプだ。", "cn": "这家伙多半是喜欢车厢连接处的那种人。"}
