{"seq": 1, "addr": 28, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 0, "jp": "ラメンタービレ（哀れに）", "cn": "哀伤调（悲切地）"}
{"seq": 7, "addr": 308, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　わたしは……。", "cn": "我……。"}
{"seq": 9, "addr": 400, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　ある疾病を……かかえている……。", "cn": "身患……某种疾病……。"}
{"seq": 11, "addr": 492, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　病名は伏せる……そこに意味はないから……。", "cn": "病名就隐去不提……因为那没有意义……。"}
{"seq": 16, "addr": 752, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　これが、わたしの家……。", "cn": "这就是，我的家……。"}
{"seq": 18, "addr": 844, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　たばこ屋をいとなんでいる、わたしの家……。", "cn": "经营着烟草店，我的家……。"}
{"seq": 24, "addr": 1100, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　これが、わたし……。", "cn": "这就是，我……。"}
{"seq": 26, "addr": 1192, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　今夜のわたし……。", "cn": "今晚的我……。"}
{"seq": 34, "addr": 1576, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　これは一日前、きのうのわたし……。", "cn": "这是一天前，昨天的我……。"}
{"seq": 38, "addr": 1700, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　きのうの朝のわたし……。", "cn": "昨天早上的我……。"}
{"seq": 40, "addr": 1792, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "祖母", "voice": "X520001", "td": 0, "jp": "「みやこー、学校おくれるよー」", "cn": "“京～，上学要迟到啦～”"}
{"seq": 42, "addr": 1884, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "京", "voice": "MIY0008", "td": 0, "jp": "「んー……」", "cn": "“嗯～……”"}
{"seq": 53, "addr": 2316, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　これも、きのうのわたし……。", "cn": "这也是，昨天的我……。"}
{"seq": 55, "addr": 2408, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　きのうの、夕方のわたし……。", "cn": "昨天的，傍晚的我……。"}
{"seq": 57, "addr": 2500, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "祖母", "voice": "X520002", "td": 0, "jp": "「みやこー、ちょっと店番たのめるー？」", "cn": "“京～，能帮忙看会儿店吗～？”"}
{"seq": 59, "addr": 2592, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "京", "voice": "MIY0009", "td": 0, "jp": "「んー……」", "cn": "“嗯～……”"}
{"seq": 70, "addr": 3024, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　これも、きのうのわたし……。", "cn": "这也是，昨天的我……。"}
{"seq": 72, "addr": 3116, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　きのうの、夜のわたし……。", "cn": "昨天的，夜晚的我……。"}
{"seq": 74, "addr": 3208, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "祖母", "voice": "X520003", "td": 0, "jp": "「みやこー、みんな帰ってきたから晩ごはんにするよー」", "cn": "“京～，大家都回来了，吃晚饭啦～”"}
{"seq": 76, "addr": 3300, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "京", "voice": "MIY0010", "td": 0, "jp": "「んー……」", "cn": "“嗯～……”"}
{"seq": 78, "addr": 3392, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　きのうは、終日この調子……。", "cn": "昨天一整天，都是这个样子……。"}
{"seq": 80, "addr": 3484, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　まるで、駄目人間……。", "cn": "简直就像，废人……。"}
{"seq": 82, "addr": 3576, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　まるで、いとこのトシ兄さん……。", "cn": "简直就像，表哥俊哥……。"}
{"seq": 84, "addr": 3668, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　トシ兄さんは、週に二回のバイト以外、部屋にこもってネット三昧……。", "cn": "俊哥除了每周打两次工，就窝在房间里沉溺网络……。"}
{"seq": 86, "addr": 3760, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　ご両親も、困っている……でも、いまトシ兄さんのことは、どうでもいい……。", "cn": "他父母也很头疼……不过，现在俊哥的事，怎样都好……。"}
{"seq": 88, "addr": 3852, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　どうでもいい……どうでもいい……。", "cn": "怎样都好……怎样都好……。"}
{"seq": 90, "addr": 3944, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　何もかも、どうでもいい……。", "cn": "一切的一切，怎样都好……。"}
{"seq": 95, "addr": 4180, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　けれどいまは、どうでもいいわたしのこと……", "cn": "不过现在，关于怎样都好的我……"}
{"seq": 97, "addr": 4272, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　山科京という、どうでもいい屑のことについて、語る……。", "cn": "要讲述一下名叫山科京的、怎样都好的垃圾……。"}
{"seq": 99, "addr": 4364, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　ひとまず……記録を早送りしよう……。", "cn": "暂且……把记录快进吧……。"}
{"seq": 101, "addr": 4456, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　これは……いまから３時間前の、わたし……。", "cn": "这是……从现在算起三小时前的，我……。"}
{"seq": 113, "addr": 4948, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "京", "voice": "MIY0011", "td": 0, "jp": "「きゃああああ！　素敵ィー！　サイコー！」", "cn": "“呀啊啊啊啊！好棒～！最棒了！”"}
{"seq": 115, "addr": 5040, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "友人", "voice": "X530001", "td": 0, "jp": "「あっ、瑠樺ちゃんコレ！　この曲アレ、限定版のボーナストラックの！」", "cn": "“啊，小榴桦这个！这首曲子，就是那个，限定版附赠曲的！”"}
{"seq": 117, "addr": 5132, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "京", "voice": "MIY0012", "td": 0, "jp": "「やあああ！　うそ、サンデーナイトメア！？　えええ、なんでなんで！　これやるの？　やだ嬉しい、嬉しい嬉しい泣きそう、きゃああああ！」", "cn": "“呀啊啊！不是吧，星期日夜魇！？诶诶诶，为什么为什么！要演这首吗？不要啦好开心，好开心好开心要哭了，呀啊啊啊啊！”"}
{"seq": 119, "addr": 5224, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "友人", "voice": "X530002", "td": 0, "jp": "「あーっ、うそマジで！　やばい瑠樺ちゃん、いまクリヤこっち見たよ！」", "cn": "“啊——，不是吧真的假的！糟了小榴桦，克里亚刚才看过来了！”"}
{"seq": 121, "addr": 5316, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "京", "voice": "MIY0013", "td": 0, "jp": "「きゃああああ、クリヤぁぁぁ！」", "cn": "“呀啊啊啊啊，克里亚～！”"}
{"seq": 128, "addr": 5608, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　これはひどい……。", "cn": "这太糟糕了……。"}
{"seq": 130, "addr": 5700, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　まるで、ふつうの女の子……。", "cn": "简直就像，普通的女孩子……。"}
{"seq": 132, "addr": 5792, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　まるで、同じクラスの高内さんや岡村さん……。", "cn": "简直就像，同班的高内同学和冈村同学……。"}
{"seq": 134, "addr": 5884, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　高内さんたちは……相手の本質に拘泥せず……外殻次第で異性と交接……。", "cn": "高内她们……不拘泥于对方的本质……只看外壳就跟异性交合……。"}
{"seq": 136, "addr": 5976, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　性の乱れ……識者たちが、嘆いている……でも、いま彼女らのことは、どうでもいい……。", "cn": "性关系混乱……有识之士们在叹息……不过，现在她们的事，怎样都好……。"}
{"seq": 138, "addr": 6068, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　いまは、わたしのこと……山科京という、この生きている価値もない屑について、語らねばならない……。", "cn": "现在，必须讲述我……名叫山科京的、这个毫无生存价值的垃圾……。"}
{"seq": 140, "addr": 6160, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　ふたたび記録を、早送りしよう……。", "cn": "再次把记录，快进吧……。"}
{"seq": 149, "addr": 6604, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　これが、その３時間後……つまり、現在のわたし……。", "cn": "这就是，那之后三小时……也就是，现在的我……。"}
{"seq": 151, "addr": 6696, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "祖母", "voice": "X520004", "td": 0, "jp": "「みやこー？　帰ってきてるのー？」", "cn": "“京～？你回来了吗～？”"}
{"seq": 153, "addr": 6788, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "京", "voice": "MIY0014", "td": 0, "jp": "「んー……」", "cn": "“嗯～……”"}
{"seq": 155, "addr": 6880, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　やっぱり、駄目人間……。", "cn": "果然，是废人……。"}
{"seq": 157, "addr": 6972, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　端的にいえば……この、顕著なアップダウンの、激しさが……わたしの病気……。", "cn": "直截了当地说……这种明显的起伏之剧烈……就是我的病……。"}
{"seq": 159, "addr": 7064, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　このことは、めったに口外、しない……。", "cn": "这件事，我很少对外说……。"}
{"seq": 161, "addr": 7156, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　なぜなら……大抵の場合、ある種の好ましからざる、印象を……与えてしまうから……。", "cn": "因为……大多数情况下，都会给人留下某种不太好的印象……。"}
{"seq": 165, "addr": 7376, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　たとえば……松葉杖をついていれば、痛そうだねと、労わってくれる……。", "cn": "比如说……如果拄着拐杖，别人就会说看着好疼啊，来关心我……。"}
{"seq": 167, "addr": 7468, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　レントゲンに影でも映れば、大変だねと、案じてくれる……。", "cn": "如果X光片上照出阴影，别人就会说真不容易啊，来为我担忧……。"}
{"seq": 169, "addr": 7560, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　でもわたしの病気は……そういう、確たる証が提示できない……だから、胡乱な泣き言と思われて、おしまい……。", "cn": "可我的病……拿不出那样的确凿证据……所以只会被当成莫名其妙的抱怨，然后就结束了……。"}
{"seq": 171, "addr": 7652, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　当然だと、思う……。", "cn": "我觉得，这是理所当然的……。"}
{"seq": 173, "addr": 7744, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　もしわたしが、逆の立ち場なら……たぶん、同じことを思う……。", "cn": "如果我处在相反的立场……大概，也会这么想……。"}
{"seq": 175, "addr": 7836, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　こんな、五体満足なくせに、ぐちぐちぐちぐちと、泣き言ばかりの面倒な女には……侮蔑の嘲笑を、浴びせるはず……。", "cn": "对这种明明四肢健全、却叽叽咕咕叽叽咕咕净是抱怨的麻烦女人……我一定会投以轻蔑的嘲笑……。"}
{"seq": 179, "addr": 8056, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "京", "voice": "MIY0015", "td": 0, "jp": "「うざい」", "cn": "“烦死了”"}
{"seq": 181, "addr": 8148, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "京", "voice": "MIY0016", "td": 0, "jp": "「消えろ」", "cn": "“消失吧”"}
{"seq": 183, "addr": 8240, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "京", "voice": "MIY0017", "td": 0, "jp": "「いなくなれ」", "cn": "“消失掉吧”"}
{"seq": 188, "addr": 8456, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　うん……同感……。", "cn": "嗯……同感……。"}
{"seq": 190, "addr": 8548, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　ほんとうに……こんな鬱陶しいやつは、消えてしまうべきだと、心から賛同する……。", "cn": "真的……这种烦人的家伙，就该消失掉，我打心底赞同……。"}
{"seq": 195, "addr": 8764, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　消えたいなあ……。", "cn": "好想消失啊……。"}
{"seq": 197, "addr": 8856, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　ああ、消したいなあ……。", "cn": "啊啊，好想让自己消失啊……。"}
{"seq": 199, "addr": 8948, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　みんなの慈悲深い目がかえって卑しいわたしに恐怖を与えるから誰の視界にも入らない場所へと飛びたってしまいたいなあ……。", "cn": "大家慈悲为怀的目光反而让卑贱的我感到恐惧，所以好想飞到一个不进入任何人视野的地方去啊……。"}
{"seq": 201, "addr": 9040, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　こんな青臭い、ありふれた、酔いしれた、個性的なつもりで実は一文字残らず誰かの爪の垢で構成されたわたしたちの年代特有のはしかみたいな白々しい告白を他の自我には決して晒したくないなあ……。", "cn": "这种青涩的、老套的、自我陶醉的、自以为有个性其实一字不剩都是由别人的牙慧构成的、我们这代人特有的像麻疹一样的、装模作样的告白，我绝不想把它暴露给其他自我啊……。"}
{"seq": 203, "addr": 9132, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　だから、ほんとうは、いますぐこの記録簿を閉じてほしい……。", "cn": "所以，其实，我希望你立刻合上这本记录簿……。"}
{"seq": 205, "addr": 9224, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　みなさんの貴重な時間を、こんな、つまらない愚図のために、浪費しないでください……。", "cn": "请不要为了这么个无聊的蠢货，浪费各位宝贵的时间……。"}
{"seq": 207, "addr": 9316, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　輝かしい未来が、待って、いるのでしょう……？", "cn": "辉煌的未来，正在等着你们吧……？"}
{"seq": 209, "addr": 9408, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　わたしは決して……世のみなさんに、理解や、同情や、憐憫その他……を求めようなどとは、思っていない……。", "cn": "我绝没有……想向世上的各位，求得理解、同情、怜悯以及其他……的打算……。"}
{"seq": 214, "addr": 9624, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　たぶん。", "cn": "大概。"}
{"seq": 219, "addr": 9840, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　そんな大それた野望は、とうに、捨てさった……。", "cn": "那种狂妄的野心，早就，被我抛弃了……。"}
{"seq": 224, "addr": 10056, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　たぶん。", "cn": "大概。"}
{"seq": 226, "addr": 10148, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　だって、もはや自分すら愛していないこの身を、誰が赦してくれるというのか……。", "cn": "毕竟，连自己都不再爱的这副身躯，又有谁会来宽恕呢……。"}
{"seq": 230, "addr": 10368, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "京", "voice": "MIY0018", "td": 0, "jp": "「はあ」", "cn": "“唉”"}
{"seq": 234, "addr": 10552, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "京", "voice": "MIY0019", "td": 0, "jp": "「死のうかな」", "cn": "“要不要去死呢”"}
{"seq": 238, "addr": 10736, "sel": 0, "idx": 0, "kind": "dialogue", "speaker": "京", "voice": "MIY0020", "td": 0, "jp": "「むりだけど」", "cn": "“虽然做不到”"}
{"seq": 240, "addr": 10828, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　それも恐いからね……。", "cn": "因为那也很可怕啊……。"}
{"seq": 245, "addr": 11044, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　ごめんなさい。分を弁えて隅のほう隅のほうで生きてゆきますので、厚かましいお願いではありますが、みなさんどうか温かい目でこの屑の命をお見逃しください。", "cn": "对不起。我会安分守己地在角落里角落里活下去的，虽然是个厚颜无耻的请求，但请各位务必用温暖的眼光饶过这条垃圾的命。"}
{"seq": 247, "addr": 11136, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　そして出来ることなら、やはり、いますぐにでもこの記録簿を閉じてください。", "cn": "还有如果可能的话，果然还是请立刻合上这本记录簿。"}
{"seq": 249, "addr": 11228, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　いえ、山科京の分際で、恥ずかしいなどと一端の口をきくつもりは毛頭ございません。ただ、ただ一点、わたしどもの駄文で皆さんのお目を汚し、大事なお時間まで頂いてしまうのが本当に心苦しいのです。", "cn": "不，以山科京这种身份，我丝毫没有摆出一副了不起的口气说“好羞耻”的打算。只是，只有一点，用我这种拙劣的文字弄脏各位的眼睛、甚至占用各位宝贵的时间，真的让我很过意不去。"}
{"seq": 251, "addr": 11320, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　それでも（たとえば巣穴に餌をはこぶ蟻の姿がときに好奇の対象となるように）世界の底で這いつくばる女に一抹の興味をお持ちとあらば、もはやわたしもお止めはいたしません。", "cn": "即便如此（比如说就像往巢穴里搬食物的蚂蚁有时也会成为好奇的对象那样），如果您对在世界的底层匍匐爬行的女人怀有一丝兴趣，那我也不再阻止。"}
{"seq": 253, "addr": 11412, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　たいへん申しわけなく存じますが、しばしお付き合いのほどよろしくお願いいたします。", "cn": "万分抱歉，还请陪我这一会儿。"}
{"seq": 259, "addr": 11676, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　でも皆さんお忙しいと思うので、ほんとうに、飽きたらすぐに放りだしてください。", "cn": "不过各位应该都很忙，所以真的，腻了就请马上丢下我。"}
{"seq": 261, "addr": 11768, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　それがわたしの本心──", "cn": "那是我的真心——"}
{"seq": 263, "addr": 11860, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　──ではありません。", "cn": "——并不是。"}
{"seq": 265, "addr": 11952, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　ほら、めんどくさい女。", "cn": "看吧，麻烦的女人。"}
{"seq": 267, "addr": 12044, "sel": 0, "idx": 0, "kind": "other", "speaker": "", "voice": "", "td": 1, "jp": "　だからあのひとにも捨てられたんだ。", "cn": "所以才会被那个人抛弃啊。"}
