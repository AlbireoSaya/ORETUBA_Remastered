[
 {
  "file": "21_2c.tob",
  "idx": 16,
  "cn": "“小玉你下一部作品改写成科幻了吗？”"
 },
 {
  "file": "21_2c.tob",
  "idx": 30,
  "cn": "“不是吧？”"
 },
 {
  "file": "21_2c.tob",
  "idx": 55,
  "cn": "佐久间同学？"
 },
 {
  "file": "21_2c.tob",
  "idx": 57,
  "cn": "佐久间同学……？"
 },
 {
  "file": "21_2c.tob",
  "idx": 66,
  "cn": "“和那个……关系很好……？”"
 },
 {
  "file": "21_2c.tob",
  "idx": 69,
  "cn": "“不是？”"
 },
 {
  "file": "21_2c.tob",
  "idx": 86,
  "cn": "“呐佐久间同学刚才在校门口和你说话的那位前辈、是你的朋友吗？”"
 },
 {
  "file": "21_2d.tob",
  "idx": 5,
  "cn": "“好～幸福～……”"
 },
 {
  "file": "21_2d.tob",
  "idx": 18,
  "cn": "“林田～”"
 },
 {
  "file": "21_2d.tob",
  "idx": 38,
  "cn": "“普通……的……”"
 },
 {
  "file": "21_2d.tob",
  "idx": 43,
  "cn": "“啊、那个……什什什么……”"
 },
 {
  "file": "21_2d.tob",
  "idx": 50,
  "cn": "“啊～原来如此～、萌好难啊～”"
 },
 {
  "file": "21_2e.tob",
  "idx": 49,
  "cn": "“啊啊……抱歉。开开玩笑”"
 },
 {
  "file": "21_2f.tob",
  "idx": 34,
  "cn": "“是的……我自己也不知道该怎么办才好了……”"
 },
 {
  "file": "21_2f.tob",
  "idx": 79,
  "cn": "“不、完全没有！”"
 },
 {
  "file": "21_3a.tob",
  "idx": 57,
  "cn": "“鸭志田同学、你好像很久前就、一直坐这个时间这节车厢吧”"
 },
 {
  "file": "21_3a.tob",
  "idx": 98,
  "cn": "“前辈！！”"
 },
 {
  "file": "21_3a.tob",
  "idx": 116,
  "cn": "“啊～……”"
 },
 {
  "file": "21_3b.tob",
  "idx": 15,
  "cn": "“啊啊、原来如此。琳达你还真是一如既往地极端呢”"
 },
 {
  "file": "21_3b.tob",
  "idx": 50,
  "cn": "“……我跟这事无关吧？”"
 },
 {
  "file": "21_3b.tob",
  "idx": 51,
  "cn": "“别～这样啦、害羞什么啊好朋友～”"
 },
 {
  "file": "22_1a.tob",
  "idx": 51,
  "cn": "“那玉泉同学呢？”"
 },
 {
  "file": "22_2a.tob",
  "idx": null,
  "cn": "回归招牌女孩"
 },
 {
  "file": "22_2a.tob",
  "idx": 8,
  "cn": "“话说这不是纪奈子小姐嘛”"
 },
 {
  "file": "22_2a.tob",
  "idx": 83,
  "cn": "“我也要我也要”"
 },
 {
  "file": "22_2c.tob",
  "idx": 25,
  "cn": "“啊～”"
 },
 {
  "file": "22_2d.tob",
  "idx": 25,
  "cn": "“诶～”"
 },
 {
  "file": "22_2d.tob",
  "idx": 64,
  "cn": "“不用不用～”"
 },
 {
  "file": "22_2d.tob",
  "idx": 87,
  "cn": "哪个孩子？"
 },
 {
  "file": "22_2e.tob",
  "idx": 3,
  "cn": "“店长也是”"
 },
 {
  "file": "22_2e.tob",
  "idx": 24,
  "cn": "“啊哈哈、恶心死了～。什么啊这待遇”"
 },
 {
  "file": "22_2e.tob",
  "idx": 32,
  "cn": "“活该～、活该～、被骂了～”"
 },
 {
  "file": "22_2e.tob",
  "idx": 73,
  "cn": "“店长～”"
 },
 {
  "file": "22_2e.tob",
  "idx": 96,
  "cn": "“你们这帮人说忙根本是骗人的吧”"
 },
 {
  "file": "22_2e.tob",
  "idx": 113,
  "cn": "“不、这孩子正处在幸福的顶峰”"
 },
 {
  "file": "22_2e.tob",
  "idx": 133,
  "cn": "“呵呵……呵呵呵……呼哈哈哈……”"
 },
 {
  "file": "22_2f.tob",
  "idx": 20,
  "cn": "“嘿嘿～”"
 },
 {
  "file": "22_2f.tob",
  "idx": 45,
  "cn": "“纪奈子小姐、你这被害妄想真强啊”"
 },
 {
  "file": "23_1a.tob",
  "idx": 10,
  "cn": "“那个做完了吗～？”"
 },
 {
  "file": "23_1a.tob",
  "idx": 11,
  "cn": "“哪个～？”"
 },
 {
  "file": "23_1a.tob",
  "idx": 13,
  "cn": "“啊～、个别课题”"
 },
 {
  "file": "23_1a.tob",
  "idx": 14,
  "cn": "“对就是那个～、感觉怎么样～？”"
 },
 {
  "file": "23_1a.tob",
  "idx": 18,
  "cn": "“诶～、那东西什么时候到期来着～”"
 },
 {
  "file": "23_1a.tob",
  "idx": 20,
  "cn": "“真的假的～。话说今天周几～？”"
 },
 {
  "file": "23_1a.tob",
  "idx": 24,
  "cn": "“不如说连笑的力气都没了”"
 },
 {
  "file": "23_1a.tob",
  "idx": 27,
  "cn": "“是啊～……”"
 },
 {
  "file": "23_1a.tob",
  "idx": 30,
  "cn": "“唉～……”"
 },
 {
  "file": "23_1a.tob",
  "idx": 31,
  "cn": "“呼～……”"
 },
 {
  "file": "23_1a.tob",
  "idx": 36,
  "cn": "“话说啊～”"
 },
 {
  "file": "23_1a.tob",
  "idx": 37,
  "cn": "“嗯～？”"
 },
 {
  "file": "23_1a.tob",
  "idx": 39,
  "cn": "“对啊～太抖Ｓ了吧～”"
 },
 {
  "file": "23_1a.tob",
  "idx": 43,
  "cn": "“塞不进新的呢～”"
 },
 {
  "file": "23_1a.tob",
  "idx": 45,
  "cn": "“一天就完了呢～”"
 },
 {
  "file": "23_1a.tob",
  "idx": 51,
  "cn": "“嗯～？嗯～、嘛～、各种各样～”"
 },
 {
  "file": "23_1a.tob",
  "idx": 52,
  "cn": "“人际关系之类？”"
 },
 {
  "file": "23_1a.tob",
  "idx": 53,
  "cn": "“嘛～”"
 },
 {
  "file": "23_1a.tob",
  "idx": 56,
  "cn": "“呼～嗯”"
 },
 {
  "file": "23_1a.tob",
  "idx": 61,
  "cn": "“对～”"
 },
 {
  "file": "23_1a.tob",
  "idx": 62,
  "cn": "“嗯～”"
 },
 {
  "file": "23_1a.tob",
  "idx": 65,
  "cn": "“啊～”"
 },
 {
  "file": "23_1a.tob",
  "idx": 66,
  "cn": "“诶～？”"
 },
 {
  "file": "23_1a.tob",
  "idx": 71,
  "cn": "“就是数学的那个”"
 },
 {
  "file": "23_1a.tob",
  "idx": 77,
  "cn": "“对啊～、连一分一秒都很可惜了呢～”"
 },
 {
  "file": "23_1a.tob",
  "idx": 93,
  "cn": "“嘛～、那个比较现实吧～”"
 },
 {
  "file": "23_1a.tob",
  "idx": 109,
  "cn": "“诶～、那罩杯是多少？”"
 },
 {
  "file": "23_1a.tob",
  "idx": 111,
  "cn": "“啊、一样一样～”"
 },
 {
  "file": "23_1a.tob",
  "idx": 116,
  "cn": "“骗人·第二遍吗”"
 },
 {
  "file": "23_1a.tob",
  "idx": 117,
  "cn": "“真的真的～”"
 },
 {
  "file": "23_1a.tob",
  "idx": 124,
  "cn": "“嗯～……普通？”"
 },
 {
  "file": "23_1a.tob",
  "idx": 125,
  "cn": "“不是？”"
 },
 {
  "file": "23_1a.tob",
  "idx": 136,
  "cn": "“有感觉？”"
 },
 {
  "file": "23_1a.tob",
  "idx": 137,
  "cn": "“没感觉”"
 },
 {
  "file": "23_1a.tob",
  "idx": 142,
  "cn": "“嘴上这么说、手不是已经捏了吗”"
 },
 {
  "file": "23_1a.tob",
  "idx": 149,
  "cn": "“哇～、装得像很敏感一样～”"
 },
 {
  "file": "23_1a.tob",
  "idx": 152,
  "cn": "“诶～？逃避现实～”"
 },
 {
  "file": "23_1a.tob",
  "idx": 162,
  "cn": "“……那～、刚才说到哪来着～？”"
 },
 {
  "file": "23_1b.tob",
  "idx": 0,
  "cn": "“呼～……”"
 },
 {
  "file": "23_1b.tob",
  "idx": 1,
  "cn": "“唉～……”"
 },
 {
  "file": "23_1b.tob",
  "idx": 15,
  "cn": "“嗯～、什么～”"
 },
 {
  "file": "23_1b.tob",
  "idx": 25,
  "cn": "“诶～？嗯～”"
 },
 {
  "file": "23_1b.tob",
  "idx": 30,
  "cn": "“好闲～。说点什么嘛～”"
 },
 {
  "file": "23_1b.tob",
  "idx": 31,
  "cn": "“诶～、什么话题～？”"
 },
 {
  "file": "23_1b.tob",
  "idx": 40,
  "cn": "“不会吧那是什么。为什么为什么？”"
 },
 {
  "file": "23_1b.tob",
  "idx": 70,
  "cn": "“嗯～……”"
 },
 {
  "file": "23_1b.tob",
  "idx": 75,
  "cn": "“诶～就是～要开始的课题～？”"
 },
 {
  "file": "23_1b.tob",
  "idx": 77,
  "cn": "“对吧～、就是那种类型呢～”"
 },
 {
  "file": "23_1b.tob",
  "idx": 78,
  "cn": "“嗯～……”"
 },
 {
  "file": "23_1b.tob",
  "idx": 82,
  "cn": "“嗯～？”"
 },
 {
  "file": "23_1b.tob",
  "idx": 87,
  "cn": "“诶、有那种压箱底的段子吗？”"
 },
 {
  "file": "23_1b.tob",
  "idx": 91,
  "cn": "“什么样的？”"
 },
 {
  "file": "23_1b.tob",
  "idx": 92,
  "cn": "“看到食堂送货卡车七次就有幸运降临、之类的”"
 },
 {
  "file": "23_1b.tob",
  "idx": 97,
  "cn": "“哦～？那个挺像那么回事。像是吉利小迷信”"
 },
 {
  "file": "23_1b.tob",
  "idx": 98,
  "cn": "“对吧～？有感觉有感觉”"
 },
 {
  "file": "23_1b.tob",
  "idx": 111,
  "cn": "“啊、对哦……哎呀～、大意了～”"
 },
 {
  "file": "23_1b.tob",
  "idx": 115,
  "cn": "“呀～、你问我这种问题我也～”"
 },
 {
  "file": "23_1b.tob",
  "idx": 118,
  "cn": "“呼～嗯”"
 },
 {
  "file": "23_1b.tob",
  "idx": 152,
  "cn": "“对吧～？回去吧回去吧～”"
 },
 {
  "file": "23_1c.tob",
  "idx": 7,
  "cn": "“唉～、只剩两天了啊～……”"
 },
 {
  "file": "23_1c.tob",
  "idx": 8,
  "cn": "“那个啊～”"
 },
 {
  "file": "23_1c.tob",
  "idx": 9,
  "cn": "“嗯～？”"
 },
 {
  "file": "23_1c.tob",
  "idx": 21,
  "cn": "“啊～、我也是～。跑法、后追型～”"
 },
 {
  "file": "23_1c.tob",
  "idx": 29,
  "cn": "“好厉害～”"
 },
 {
  "file": "23_1c.tob",
  "idx": 34,
  "cn": "“不如说、垫底之间比高矮？”"
 },
 {
  "file": "23_1c.tob",
  "idx": 35,
  "cn": "“好会接～”"
 },
 {
  "file": "23_1c.tob",
  "idx": 37,
  "cn": "“也就是说很不妙～”"
 },
 {
  "file": "23_1c.tob",
  "idx": 45,
  "cn": "“好悲伤啊～、原来真的有没有回报的努力呢～”"
 },
 {
  "file": "23_1c.tob",
  "idx": 51,
  "cn": "“真是个艰难的时代～”"
 },
 {
  "file": "23_1c.tob",
  "idx": 52,
  "cn": "“啊～真是的、超难受。今天完全没干劲～……”"
 },
 {
  "file": "23_1c.tob",
  "idx": 60,
  "cn": "“懂、也许是不一样～”"
 },
 {
  "file": "23_1c.tob",
  "idx": 81,
  "cn": "“唉～”"
 },
 {
  "file": "23_1c.tob",
  "idx": 88,
  "cn": "“毕竟也该开始了～”"
 },
 {
  "file": "23_1c.tob",
  "idx": 89,
  "cn": "“嗯～、那～、再过五分钟就开始～”"
 },
 {
  "file": "23_1c.tob",
  "idx": 94,
  "cn": "“诶～？什么啊香田～”"
 },
 {
  "file": "23_1d.tob",
  "idx": 0,
  "cn": "“唉～、久等了～”"
 },
 {
  "file": "23_1d.tob",
  "idx": 9,
  "cn": "“那个啊～……”"
 },
 {
  "file": "23_1d.tob",
  "idx": 10,
  "cn": "“嗯～、什么～……”"
 },
 {
  "file": "23_1d.tob",
  "idx": 12,
  "cn": "“啊～、有有有～……”"
 },
 {
  "file": "23_1d.tob",
  "idx": 16,
  "cn": "“不会吧～、在这种大冷天？”"
 },
 {
  "file": "23_1d.tob",
  "idx": 18,
  "cn": "“哪些孩子～？”"
 },
 {
  "file": "23_1d.tob",
  "idx": 20,
  "cn": "“啊～、真的呢～”"
 },
 {
  "file": "23_1d.tob",
  "idx": 30,
  "cn": "“好～、下次不会输了哦～”"
 },
 {
  "file": "23_1d.tob",
  "idx": 33,
  "cn": "“怎么说……”"
 },
 {
  "file": "23_1d.tob",
  "idx": 88,
  "cn": "“然后？”"
 },
 {
  "file": "23_1d.tob",
  "idx": 90,
  "cn": "“开始啥？”"
 },
 {
  "file": "23_1e.tob",
  "idx": 6,
  "cn": "“你觉得呢～？”"
 },
 {
  "file": "23_1e.tob",
  "idx": 11,
  "cn": "“嗯～、是啊～……”"
 },
 {
  "file": "23_1e.tob",
  "idx": 21,
  "cn": "“哇～、讨厌的前辈”"
 },
 {
  "file": "23_1e.tob",
  "idx": 64,
  "cn": "“没有、没有！”"
 },
 {
  "file": "23_1e.tob",
  "idx": 66,
  "cn": "“完～全、完全没有！”"
 },
 {
  "file": "23_1e.tob",
  "idx": 68,
  "cn": "“啊啊～、羽田同学在这儿～！”"
 },
 {
  "file": "23_1e.tob",
  "idx": 74,
  "cn": "“哇～、好感人的重逢啊～”"
 },
 {
  "file": "23_1e.tob",
  "idx": 75,
  "cn": "“真是个好故事呢～”"
 },
 {
  "file": "23_1f.tob",
  "idx": 33,
  "cn": "“真厉害啊～、年轻人真是不知道害怕啊～”"
 },
 {
  "file": "23_1f.tob",
  "idx": 46,
  "cn": "“没有理想型～？”"
 },
 {
  "file": "23_1f.tob",
  "idx": 88,
  "cn": "“啊～对～对～、就是那种感觉”"
 },
 {
  "file": "23_1f.tob",
  "idx": 91,
  "cn": "“好微不足道啊～”"
 },
 {
  "file": "23_1f.tob",
  "idx": 97,
  "cn": "“嗯～……”"
 },
 {
  "file": "23_1f.tob",
  "idx": 99,
  "cn": "“就这个！”"
 },
 {
  "file": "23_1f.tob",
  "idx": 114,
  "cn": "“好厉害～、我们好成熟～”"
 },
 {
  "file": "23_1f.tob",
  "idx": 139,
  "cn": "“好厉害～、传统艺能～”"
 },
 {
  "file": "23_1f.tob",
  "idx": 143,
  "cn": "“肯做就能做好的孩子”"
 },
 {
  "file": "23_2a.tob",
  "idx": 5,
  "cn": "“啊～……”"
 },
 {
  "file": "23_2a.tob",
  "idx": 45,
  "cn": "“什么～、不可饶恕～！”"
 },
 {
  "file": "24_1a.tob",
  "idx": 16,
  "cn": "“呼～”"
 },
 {
  "file": "24_1a.tob",
  "idx": 65,
  "cn": "“‘我的眼泪啊，请传达给谁’？”"
 },
 {
  "file": "24_1a.tob",
  "idx": 100,
  "cn": "“啊～真是的，你们几个怎么混一起了～。”"
 },
 {
  "file": "24_1b.tob",
  "idx": 84,
  "cn": "“绣球花的阴影之类的”"
 },
 {
  "file": "24_1b.tob",
  "idx": 106,
  "cn": "“明白了。那么公主、祝旅途愉快”"
 },
 {
  "file": "24_1b.tob",
  "idx": 110,
  "cn": "终之子啊、暂别一段时日、就此告辞。"
 },
 {
  "file": "24_2b.tob",
  "idx": 55,
  "cn": "“啊、鹫那家伙”"
 },
 {
  "file": "24_2b.tob",
  "idx": 60,
  "cn": "“就是行为可疑分子！”"
 },
 {
  "file": "24_2b.tob",
  "idx": 67,
  "cn": "所以说这个人很难对付。"
 },
 {
  "file": "24_2b.tob",
  "idx": 90,
  "cn": "“好、好的～！如果有机会的话！”"
 },
 {
  "file": "24_2b.tob",
  "idx": 98,
  "cn": "“咦、意外地不可怕……话说、什么嘛、只是个摆架子的搞笑艺人”"
 },
 {
  "file": "24_2c.tob",
  "idx": 15,
  "cn": "里面？"
 },
 {
  "file": "24_2c.tob",
  "idx": 17,
  "cn": "“这么说来……宇宙？”"
 },
 {
  "file": "24_2c.tob",
  "idx": 37,
  "cn": "“啊、羽田同学～”"
 },
 {
  "file": "24_2c.tob",
  "idx": 38,
  "cn": "“羽田同学？”"
 },
 {
