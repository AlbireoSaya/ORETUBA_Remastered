[
 {
  "file": "13_2a.tob",
  "idx": 42,
  "cn": "“哈……你这家伙、真是会体贴的女人啊。太让人放松了”"
 },
 {
  "file": "13_2a.tob",
  "idx": 46,
  "cn": "“本、本来吗”"
 },
 {
  "file": "13_2a.tob",
  "idx": 65,
  "cn": "“嘛、是啊……”"
 },
 {
  "file": "13_2a.tob",
  "idx": 82,
  "cn": "“哎呀、你这人真是的。夸我也不会给你什么好处哦”"
 },
 {
  "file": "13_2a.tob",
  "idx": 87,
  "cn": "“尽心尽力的我、超——良妻。我现在闪闪发光——。工作服最棒”"
 },
 {
  "file": "13_2a.tob",
  "idx": 89,
  "cn": "“哈——、是这里吗？”"
 },
 {
  "file": "13_2a.tob",
  "idx": 97,
  "cn": "“啊——、是啊。比起鸡肉还是肌肉更要紧吧。呜哈——、肌肉好硬——”"
 },
 {
  "file": "13_2a.tob",
  "idx": 126,
  "cn": "…………生理期吗？"
 },
 {
  "file": "13_2a.tob",
  "idx": 134,
  "cn": "“既、既然说到这份上、那个……如果真的、不管发生什么都心意不变的话……”"
 },
 {
  "file": "13_2b.tob",
  "idx": 38,
  "cn": "“别放回去”"
 },
 {
  "file": "13_2b.tob",
  "idx": 46,
  "cn": "“不、我打个比方”"
 },
 {
  "file": "13_2b.tob",
  "idx": 52,
  "cn": "“啊——！真是的受不了！在意外表的男人最差劲——！这就是没在看你内在的证据——！”"
 },
 {
  "file": "13_2b.tob",
  "idx": 161,
  "cn": "该出的东西出去就行。毕竟对手是打者。"
 },
 {
  "file": "13_2b.tob",
  "idx": 166,
  "cn": "“这是牵制球哦”"
 },
 {
  "file": "13_2b.tob",
  "idx": 208,
  "cn": "嘴上这么说却舍不得从鸣嘴里拔出来的我真是贪婪。"
 },
 {
  "file": "13_2b.tob",
  "idx": 214,
  "cn": "她像在喉咙深处挑衅地一笑、紧接着一股可怕的吸力朝我袭来。"
 },
 {
  "file": "13_2b.tob",
  "idx": 227,
  "cn": "“咕、要出来……！”"
 },
 {
  "file": "13_2b.tob",
  "idx": 234,
  "cn": "“啊、啊、笨蛋、别在关键时候放开啊”"
 },
 {
  "file": "13_2b.tob",
  "idx": 253,
  "cn": "在我脑中浮现就消不掉啊——！"
 },
 {
  "file": "13_2b.tob",
  "idx": 363,
  "cn": "真是受不了这个女朋友……。"
 },
 {
  "file": "13_3a.tob",
  "idx": 33,
  "cn": "这是让男人尊严动摇的金额。"
 },
 {
  "file": "13_3b.tob",
  "idx": 84,
  "cn": "“日野英里、那家伙隼人”"
 },
 {
  "file": "13_3b.tob",
  "idx": 98,
  "cn": "“可、可恶、真是不得了的女人……”"
 },
 {
  "file": "13_3b.tob",
  "idx": 100,
  "cn": "“隼人好弱”"
 },
 {
  "file": "13_3b.tob",
  "idx": 137,
  "cn": "“不是吧——差那么多？”"
 },
 {
  "file": "13_3b.tob",
  "idx": 150,
  "cn": "“不知”"
 },
 {
  "file": "13_3b.tob",
  "idx": 154,
  "cn": "“是啊——。那家伙不在还真无聊呢”"
 },
 {
  "file": "13_3c0.tob",
  "idx": 14,
  "cn": "“啊、这不是隼人君嘛”"
 },
 {
  "file": "13_3c2.tob",
  "idx": 5,
  "cn": "“哦。意外”"
 },
 {
  "file": "13_3d.tob",
  "idx": 38,
  "cn": "“好、好”"
 },
 {
  "file": "13_3d.tob",
  "idx": 67,
  "cn": "“好、好”"
 },
 {
  "file": "13_3d.tob",
  "idx": 97,
  "cn": "“啊、我我”"
 },
 {
  "file": "13_3d.tob",
  "idx": 116,
  "cn": "“英语里就是有罪哦”"
 },
 {
  "file": "13_3d.tob",
  "idx": 144,
  "cn": "“呀——就知道你会这么说、不过好开心、扭啊扭——扭啊扭”"
 },
 {
  "file": "13_3d.tob",
  "idx": 149,
  "cn": "“嘴硬——嘴硬”"
 },
 {
  "file": "13_3d.tob",
  "idx": 164,
  "cn": "走前比了个戳眼的胜利手势。未来的面魔组就拜托你们了、后辈们。"
 },
 {
  "file": "13_4b.tob",
  "idx": 43,
  "cn": "“命？……”"
 },
 {
  "file": "13_4b.tob",
  "idx": 103,
  "cn": "“喂喂、刚才那个是什么？刚才那白色粉末是什么？塞满一堆白色粉末的那是什么？”"
 },
 {
  "file": "13_4b.tob",
  "idx": 125,
  "cn": "“真是的、笨蛋——！这算什么啊隼人你这个笨蛋——！”"
 },
 {
  "file": "13_4b.tob",
  "idx": 130,
  "cn": "“啊、啊、抱歉”"
 },
 {
  "file": "13_4b.tob",
  "idx": 154,
  "cn": "“……结果那是什么？”"
 },
 {
  "file": "13_4c.tob",
  "idx": 87,
  "cn": "“就这么回事，我走了。再见”"
 },
 {
  "file": "13_4c.tob",
  "idx": 95,
  "cn": "“Ｎｏ ｍａｎ！我拒绝”"
 },
 {
  "file": "13_4d.tob",
  "idx": 0,
  "cn": "那么、说回凤吧。"
 },
 {
  "file": "13_4d.tob",
  "idx": 22,
  "cn": "“都说了、不行嘛。再见啦、See you tomorrow～☆”"
 },
 {
  "file": "13_4e.tob",
  "idx": 8,
  "cn": "“凤——。是我、我来打扰了”"
 },
 {
  "file": "13_4e.tob",
  "idx": 48,
  "cn": "“隼人。出来一下”"
 },
 {
  "file": "13_4e.tob",
  "idx": 62,
  "cn": "“那、什么、有话？”"
 },
 {
  "file": "13_4e.tob",
  "idx": 81,
  "cn": "但他既然肯听，话就好说多了。"
 },
 {
  "file": "13_4f.tob",
  "idx": 2,
  "cn": "“隼人”"
 },
 {
  "file": "13_4f.tob",
  "idx": 21,
  "cn": "“隼人先生？”"
 },
 {
  "file": "13_4f.tob",
  "idx": 36,
  "cn": "“呀——温柔的男朋友——。心里暖洋洋——。暖洋洋——”"
 },
 {
  "file": "13_4f.tob",
  "idx": 39,
  "cn": "“诶——、那一起等不就好了吗？”"
 },
 {
  "file": "13_4f.tob",
  "idx": 46,
  "cn": "“哇——你这说法好刻薄——。难道是女孩子……之类的？”"
 },
 {
  "file": "13_4f.tob",
  "idx": 110,
  "cn": "“啊、我我”"
 },
 {
  "file": "13_4f.tob",
  "idx": 120,
  "cn": "“是心爱的男朋友哦”"
 },
 {
  "file": "13_4f.tob",
  "idx": 147,
  "cn": "“叫我？”"
 },
 {
  "file": "13_4f.tob",
  "idx": 153,
  "cn": "“那就是你说的东西？”"
 },
 {
  "file": "13_4f.tob",
  "idx": 161,
  "cn": "“都说多少遍了不是那玩意儿！”"
 },
 {
  "file": "13_4f.tob",
  "idx": 188,
  "cn": "“混蛋……”"
 },
 {
  "file": "13_4f.tob",
  "idx": 228,
  "cn": "“你小子先动手！”"
 },
 {
  "file": "13_4g.tob",
  "idx": 76,
  "cn": "“啊、啊——啊——啊——……这样啊、那个话原来是这个意思啊——”"
 },
 {
  "file": "13_4g.tob",
  "idx": 103,
  "cn": "“啊——啊——啊我听不见”"
 },
 {
  "file": "13_4g.tob",
  "idx": 156,
  "cn": "那是啥玩意儿？"
 },
 {
  "file": "13_4g.tob",
  "idx": 164,
  "cn": "“真的假的！”"
 },
 {
  "file": "13_5a.tob",
  "idx": 27,
  "cn": "“……果然你也这么觉得？”"
 },
 {
  "file": "13_5a.tob",
  "idx": 39,
  "cn": "“你这家伙”"
 },
 {
  "file": "13_5a.tob",
  "idx": 64,
  "cn": "“啊对、就是那个”"
 },
 {
  "file": "13_5a.tob",
  "idx": 99,
  "cn": "“我想回家啊——！”"
 },
 {
  "file": "13_5b.tob",
  "idx": 19,
  "cn": "“哈”"
 },
 {
  "file": "13_5b.tob",
  "idx": 21,
  "cn": "“哈”"
 },
 {
  "file": "13_5b.tob",
  "idx": 47,
  "cn": "“这是事后找的理由吧、算了。今天我一个人回去”"
 },
 {
  "file": "13_5b.tob",
  "idx": 71,
  "cn": "“忘东西了”"
 },
 {
  "file": "13_5b.tob",
  "idx": 115,
  "cn": "“你小子完全无视啊”"
 },
 {
  "file": "13_5b.tob",
  "idx": 121,
  "cn": "“心跳加速——！”"
 },
 {
  "file": "14_1b.tob",
  "idx": 180,
  "cn": "“哇、鸿野同学那帮人！”"
 },
 {
  "file": "14_1b.tob",
  "idx": 294,
  "cn": "不久就到第三学期。"
 },
 {
  "file": "14_2a.tob",
  "idx": 80,
  "cn": "“故事”"
 },
 {
  "file": "14_2a.tob",
  "idx": 87,
  "cn": "两人微妙地把视线移开了。我夸张地凑过去想看，她们的眼神却一个个飘来飘去。"
 },
 {
  "file": "14_2a.tob",
  "idx": 98,
  "cn": "“什、什么啊”"
 },
 {
  "file": "14_2a.tob",
  "idx": 106,
  "cn": "“唔……”"
 },
 {
  "file": "14_2a.tob",
  "idx": 108,
  "cn": "“唉……”"
 },
 {
  "file": "14_2a.tob",
  "idx": 118,
  "cn": "“这种事、怎么可能说得出口啊！”"
 },
 {
  "file": "14_2a.tob",
  "idx": 119,
  "cn": "“说到底你就是那种程度的男人”"
 },
 {
  "file": "14_2a.tob",
  "idx": 124,
  "cn": "“哇——、爱丽丝酱好厉害好厉害。明明小孩却很成熟——”"
 },
 {
  "file": "14_2a.tob",
  "idx": 127,
  "cn": "“好厉害、爱丽丝酱你们是三角关系呢——”"
 },
 {
  "file": "14_3a.tob",
  "idx": 2,
  "cn": "在这样的状况下我度过了一个哭到湿透的夜晚。"
 },
 {
  "file": "14_3a.tob",
  "idx": 17,
  "cn": "在冬天的寒冷中我只穿着一条内裤指向天空。"
 },
 {
  "file": "14_3a.tob",
  "idx": 31,
  "cn": "“啊、什么啊、原来是这么回事”"
 },
 {
  "file": "14_3b.tob",
  "idx": 44,
  "cn": "“把时间还给我啊时间小偷。把我的慢生活还回来”"
 },
 {
  "file": "14_3b.tob",
  "idx": 46,
  "cn": "“把我的一星期还来！”"
 },
 {
  "file": "14_3b.tob",
  "idx": 86,
  "cn": "“……诶，什么”"
 },
 {
  "file": "14_3b.tob",
  "idx": 93,
  "cn": "“不过等累了，把一辈子白白搭进去的可能也有呢”"
 },
 {
  "file": "14_3b.tob",
  "idx": 100,
  "cn": "“是、这样啊……很有参考价值啊……哈哈哈”"
 },
 {
  "file": "14_3b.tob",
  "idx": 112,
  "cn": "糟了、山科京的眼神变得不妙了……"
 },
 {
  "file": "14_3b.tob",
  "idx": 116,
  "cn": "“羽田同学打算怎么办”"
 },
 {
  "file": "14_3b.tob",
  "idx": 125,
  "cn": "“回答羽田同学”"
 },
 {
  "file": "14_3b.tob",
  "idx": 126,
  "cn": "“羽田？”"
 },
 {
  "file": "14_3b.tob",
  "idx": 132,
  "cn": "“确实很让人退避”"
 },
 {
  "file": "14_3c.tob",
  "idx": 128,
  "cn": "“店长的话，感觉经历很丰富呢”"
 },
 {
  "file": "14_3c.tob",
  "idx": 133,
  "cn": "“不，前世”"
 },
 {
  "file": "14_3c.tob",
  "idx": 138,
  "cn": "“两人？”"
 },
 {
  "file": "14_3c.tob",
  "idx": 156,
  "cn": "“凤同学？”"
 },
 {
  "file": "14_3c.tob",
  "idx": 161,
  "cn": "“千岁同学？”"
 },
 {
  "file": "14_3c.tob",
  "idx": 166,
  "cn": "“哈哈、也就是说纪奈子小姐要不是应考生，也会谈个恋爱之类的”"
 },
 {
  "file": "14_3c.tob",
  "idx": 173,
  "cn": "“不，没有哦”"
 },
 {
  "file": "14_3c.tob",
  "idx": 178,
  "cn": "“诶、什么恋爱话题？让我加入加入”"
 },
 {
  "file": "14_3c.tob",
  "idx": 180,
  "cn": "“什么啊，是千岁啊”"
 },
 {
  "file": "14_3c.tob",
  "idx": 184,
  "cn": "“啊啊、比自己小的女孩之类的？”"
 },
 {
  "file": "14_4b.tob",
  "idx": 5,
  "cn": "“不看着别人的眼睛说话！今天也一样无礼的针生同学！”"
 },
 {
  "file": "14_4b.tob",
  "idx": 8,
  "cn": "“羽田班一朵红花！今天也一样没精神的山科同学！”"
 },
 {
  "file": "14_4b.tob",
  "idx": 18,
  "cn": "“啊？什么羽田班、现在要吃午饭？”"
 },
 {
  "file": "14_4b.tob",
  "idx": 66,
  "cn": "“呐——渡来”"
 },
 {
  "file": "14_4b.tob",
  "idx": 76,
  "cn": "“萌到底是什么”"
 },
 {
  "file": "14_4b.tob",
  "idx": 110,
  "cn": "“森里同学”"
 },
 {
  "file": "14_4c.tob",
  "idx": 20,
  "cn": "“啊——是角色扮演吗——”"
 },
 {
  "file": "14_4c.tob",
  "idx": 33,
  "cn": "“啊——是从身体线条和身材来的——”"
 },
 {
  "file": "14_4c.tob",
  "idx": 57,
  "cn": "“哈……”"
 },
 {
  "file": "14_4c.tob",
  "idx": 59,
  "cn": "“哈——哈、原来如此——……啊哈”"
 },
 {
  "file": "14_4c.tob",
  "idx": 70,
  "cn": "“听我说！”"
 },
 {
  "file": "14_4d.tob",
  "idx": 27,
  "cn": "“嗯……没什么特别的”"
 },
 {
  "file": "14_4d.tob",
  "idx": 58,
  "cn": "“你在闹别扭吗”"
 },
 {
  "file": "14_5c.tob",
  "idx": 29,
  "cn": "“哇——、爱丽丝酱好厉害！明明小孩却这么成熟——！”"
 },
 {
  "file": "14_5c.tob",
  "idx": 30,
  "cn": "“受欢迎的女人真辛苦”"
 },
 {
  "file": "14_5c.tob",
  "idx": 34,
  "cn": "“噗”"
 },
 {
  "file": "14_5c.tob",
  "idx": 68,
  "cn": "“对啊”"
 },
 {
  "file": "14_5d.tob",
  "idx": 62,
  "cn": "“诶……你在说什么啊。明明是超级好的女孩啊”"
 },
 {
  "file": "14_6a0.tob",
  "idx": 0,
  "cn": "“我回来了”"
 },
 {
  "file": "14_6a0.tob",
  "idx": 3,
  "cn": "“这石头是什么”"
 },
 {
  "file": "14_6b.tob",
  "idx": 12,
  "cn": "“你玩透太快了吧？”"
 },
 {
  "file": "14_6b.tob",
  "idx": 35,
  "cn": "“啊、刚才那个我赞成”"
 },
 {
  "file": "14_6b.tob",
  "idx": 37,
  "cn": "“毕业旅行……？羽田班全员是头一次听说”"
 },
 {
  "file": "14_6b.tob",
  "idx": 41,
  "cn": "“诶我也能去？”"
 },
 {
  "file": "14_6b.tob",
  "idx": 52,
  "cn": "“诶”"
 },
 {
  "file": "14_6b.tob",
  "idx": 61,
  "cn": "“我觉得、觉得很棒哦噗呐田同学。我赞成！”"
 },
 {
  "file": "14_6c1.tob",
  "idx": 57,
  "cn": "“什么啊那是、要求真多。再缩小范围啊”"
 },
 {
  "file": "14_6c1.tob",
  "idx": 76,
  "cn": "“啊、她离席了！”"
 },
 {
  "file": "14_6c2.tob",
  "idx": 69,
  "cn": "“啊、原来如此”"
 },
 {
  "file": "14_6c2.tob",
  "idx": 94,
  "cn": "“哇——好开心啊——”"
 },
 {
  "file": "14_6d.tob",
  "idx": 76,
  "cn": "“诶、这……小鸠做的？”"
 },
 {
  "file": "14_7a.tob",
  "idx": 212,
  "cn": "也能弄清这毫无根据的确信是什么。"
 },
 {
  "file": "14_7a.tob",
  "idx": 228,
  "cn": "“初见就被当同性恋！？”"
 },
 {
  "file": "14_8a.tob",
  "idx": 79,
  "cn": "事到如今说什么。明明是自己发了那么又高兴又害羞的邮件。"
 },
 {
  "file": "14_8a.tob",
  "idx": 89,
  "cn": "虽然确实没有！"
 },
 {
  "file": "21_1a.tob",
  "idx": 15,
  "cn": "从第一次触碰到他的温柔的那命运之日算起、已经整整两年。"
 },
 {
  "file": "21_1a.tob",
  "idx": 98,
  "cn": "“我受伤了！你看就是这句！”"
 },
 {
  "file": "21_1a.tob",
  "idx": 109,
  "cn": "“几乎是全部啦——真是的——！”"
 },
 {
  "file": "21_1a.tob",
  "idx": 140,
  "cn": "“不是那样啦”"
 },
 {
  "file": "21_1a.tob",
  "idx": 145,
  "cn": "“那个我也做不到，才发愁啊——！”"
 },
 {
  "file": "21_1a.tob",
  "idx": 151,
  "cn": "“细川老师、第三部是恋爱题材吗？”"
 },
 {
  "file": "21_1a.tob",
  "idx": 161,
