[
 {
  "file": "24_2d.tob",
  "idx": 60,
  "cn": "“哪儿好”"
 },
 {
  "file": "24_2d.tob",
  "idx": 69,
  "cn": "“嘛、就算毕业了、哪天想起来就给我打电话吧”"
 },
 {
  "file": "24_2d.tob",
  "idx": 75,
  "cn": "“丰富得很。多余东西也丰富”"
 },
 {
  "file": "24_3a.tob",
  "idx": 2,
  "cn": "就算稀里糊涂去一趟，对我也没有坏处。以奈落之名起誓、没错、就这么办。"
 },
 {
  "file": "24_3b.tob",
  "idx": 34,
  "cn": "“哈。嘛、如果马上就能说完的话？”"
 },
 {
  "file": "24_3b.tob",
  "idx": 37,
  "cn": "“嘛，稍微有点”"
 },
 {
  "file": "24_3b.tob",
  "idx": 41,
  "cn": "“啊、那个超喜欢！”"
 },
 {
  "file": "24_3b.tob",
  "idx": 94,
  "cn": "“全力，有问题吗”"
 },
 {
  "file": "24_3b.tob",
  "idx": 97,
  "cn": "“就是这么回事。认清身份吧女侍、别厚着脸皮对余发号施令。这可是在王的面前”"
 },
 {
  "file": "24_3b.tob",
  "idx": 106,
  "cn": "“头抬得太高、你个哥布林脑！”"
 },
 {
  "file": "24_3b.tob",
  "idx": 122,
  "cn": "“你你、你这家伙……认清身份吧贱仆！你把骄傲的王当成什么了！？”"
 },
 {
  "file": "24_3b.tob",
  "idx": 125,
  "cn": "隐痛。"
 },
 {
  "file": "24_3b.tob",
  "idx": 126,
  "cn": "嘎吱响。"
 },
 {
  "file": "24_3b.tob",
  "idx": 127,
  "cn": "我的本分。我存在的意义。"
 },
 {
  "file": "24_3c.tob",
  "idx": 0,
  "cn": "“千岁同学～”"
 },
 {
  "file": "24_3c.tob",
  "idx": 6,
  "cn": "“诶、什么？有趣的故事？”"
 },
 {
  "file": "24_3c.tob",
  "idx": 41,
  "cn": "“诶、什么？有趣的故事？”"
 },
 {
  "file": "24_3c.tob",
  "idx": 61,
  "cn": "“年轻人疏远绘里绘里真严重哈哈哈哈哈哈我都泪目了哈哈哈哈哈所以要去攻击别的声优哦！”"
 },
 {
  "file": "24_3c.tob",
  "idx": 64,
  "cn": "是我啊。完全不懂意思。"
 },
 {
  "file": "24_3c.tob",
  "idx": 70,
  "cn": "“签了名你就讲有趣的故事给我听吗？”"
 },
 {
  "file": "24_3c.tob",
  "idx": 74,
  "cn": "“不对吧，反了。先写了我再讲”"
 },
 {
  "file": "24_3c.tob",
  "idx": 80,
  "cn": "“好、写完了。那么接下来就是千岁同学开讲的有趣故事～”"
 },
 {
  "file": "24_3c.tob",
  "idx": 89,
  "cn": "“诶～”"
 },
 {
  "file": "24_3d.tob",
  "idx": 0,
  "cn": "“千岁～”"
 },
 {
  "file": "24_3d.tob",
  "idx": 1,
  "cn": "“啊、现在要休息？”"
 },
 {
  "file": "24_3d.tob",
  "idx": 20,
  "cn": "“一笔一百万”"
 },
 {
  "file": "24_3d.tob",
  "idx": 58,
  "cn": "“哦～”"
 },
 {
  "file": "24_3d.tob",
  "idx": 62,
  "cn": "“哦～哦～”"
 },
 {
  "file": "24_3d.tob",
  "idx": 84,
  "cn": "“那就是婚约登记吗”"
 },
 {
  "file": "24_3e.tob",
  "idx": 28,
  "cn": "“决定要点什么了吗？”"
 },
 {
  "file": "24_3e.tob",
  "idx": 113,
  "cn": "“我才不会干那种事～！”"
 },
 {
  "file": "24_4b.tob",
  "idx": 5,
  "cn": "啊——、鳳家的、叫鸣还是什么的小姑娘啊。"
 },
 {
  "file": "24_4b.tob",
  "idx": 60,
  "cn": "“呀～唔、果然还是有点违和感——”"
 },
 {
  "file": "24_4b.tob",
  "idx": 64,
  "cn": "“啊～、以前很喜欢～”"
 },
 {
  "file": "24_4b.tob",
  "idx": 72,
  "cn": "“现在的话‘软式文艺部！’之类挺有趣哦”"
 },
 {
  "file": "24_4b.tob",
  "idx": 94,
  "cn": "“啊——、别说了别说了、脑子要被怀旧的汁水淹满了～。大人对童年的乡愁都很没抵抗力呢～”"
 },
 {
  "file": "24_4b.tob",
  "idx": 97,
  "cn": "“喂、你这家伙～！谁说我是小孩——！”"
 },
 {
  "file": "24_4b.tob",
  "idx": 104,
  "cn": "“你打我，就跟猪长得一模一样了”"
 },
 {
  "file": "24_4c.tob",
  "idx": 77,
  "cn": "“现在的过去”"
 },
 {
  "file": "24_4c.tob",
  "idx": 78,
  "cn": "“现在的过去？喂、啥意思？”"
 },
 {
  "file": "24_4d.tob",
  "idx": 35,
  "cn": "“五百日元”"
 },
 {
  "file": "24_4e.tob",
  "idx": 82,
  "cn": "“达～摩～先～生～是～……”"
 },
 {
  "file": "24_4e.tob",
  "idx": 88,
  "cn": "“噗～”"
 },
 {
  "file": "24_5a.tob",
  "idx": 9,
  "cn": "“我没高——兴！”"
 },
 {
  "file": "24_5a.tob",
  "idx": 14,
  "cn": "“我没迎接你啊啊啊啊啊——！”"
 },
 {
  "file": "24_5b.tob",
  "idx": 7,
  "cn": "“小鸠啊啊啊～！”"
 },
 {
  "file": "24_5b.tob",
  "idx": 39,
  "cn": "我再也忍不住，像男人一样哭了。"
 },
 {
  "file": "24_5b.tob",
  "idx": 60,
  "cn": "“不、那是变态。或者说犯罪”"
 },
 {
  "file": "24_5b.tob",
  "idx": 61,
  "cn": "“就是嘛～！”"
 },
 {
  "file": "24_5c.tob",
  "idx": null,
  "cn": "Ｂ－ＥＮＤ：我的泪啊，传达给谁"
 },
 {
  "file": "24_5c.tob",
  "idx": 34,
  "cn": "就算是嚣张的渡不来的同学、你看、也成了这样！"
 },
 {
  "file": "31_1.tob",
  "idx": 60,
  "cn": "“不是什么嗯～。这种地方该帮我圆一下啊，男朋友”"
 },
 {
  "file": "31_1.tob",
  "idx": 66,
  "cn": "“感觉好敷衍～”"
 },
 {
  "file": "31_1.tob",
  "idx": 72,
  "cn": "“话说啊～”"
 },
 {
  "file": "31_1.tob",
  "idx": 77,
  "cn": "“这、这样啊……知道了”"
 },
 {
  "file": "31_1.tob",
  "idx": 91,
  "cn": "“羽、羽田同学、那种像少女漫画一样的话你竟能一本正经地说出口……”"
 },
 {
  "file": "31_1.tob",
  "idx": 92,
  "cn": "“嗯。因为是男朋友”"
 },
 {
  "file": "31_1.tob",
  "idx": 98,
  "cn": "“羽田君”"
 },
 {
  "file": "31_1.tob",
  "idx": 102,
  "cn": "“别管了，借我”"
 },
 {
  "file": "31_1.tob",
  "idx": 105,
  "cn": "“不会吧！”"
 },
 {
  "file": "31_1.tob",
  "idx": 108,
  "cn": "“好，拿来了”"
 },
 {
  "file": "31_1.tob",
  "idx": 124,
  "cn": "“不用”"
 },
 {
  "file": "31_1.tob",
  "idx": 135,
  "cn": "“不要。现在的男朋友我也喜欢、过去的羽田同学我也喜欢”"
 },
 {
  "file": "32_1.tob",
  "idx": 9,
  "cn": "“这、是命运……！”"
 },
 {
  "file": "32_1.tob",
  "idx": 57,
  "cn": "“诶、看着很难的学术书只有最上层……？”"
 },
 {
  "file": "32_1.tob",
  "idx": 59,
  "cn": "“诶、不、完全没……”"
 },
 {
  "file": "32_1.tob",
  "idx": 71,
  "cn": "哑然。"
 },
 {
  "file": "32_1.tob",
  "idx": 84,
  "cn": "“啊哈哈～”"
 },
 {
  "file": "33_1.tob",
  "idx": 33,
  "cn": "“哈～、真是的～、隼人先生真是个没办法的孩子呢～”"
 },
 {
  "file": "33_1.tob",
  "idx": 45,
  "cn": "“诶、啊啊、这样啊”"
 },
 {
  "file": "33_1.tob",
  "idx": 92,
  "cn": "“哦～”"
 },
 {
  "file": "33_1.tob",
  "idx": 118,
  "cn": "从这里就是男人的世界。劳动男人的时间——"
 },
 {
  "file": "34_1.tob",
  "idx": 22,
  "cn": "“嚯哈哈、别说客套话。可爱的小家伙”"
 },
 {
  "file": "34_1.tob",
  "idx": 44,
  "cn": "“不要、好可怕～”"
 },
 {
  "file": "34_1.tob",
  "idx": 78,
  "cn": "“公主…”"
 },
 {
  "file": "34_1.tob",
  "idx": 80,
  "cn": "“公主啊啊啊～！”"
 },
 {
  "file": "34_1.tob",
  "idx": 101,
  "cn": "怎么、刚才胸口有股异样的感觉……。"
 },
 {
  "file": "34_1.tob",
  "idx": 114,
  "cn": "“公主、这个”"
 },
 {
  "file": "34_1.tob",
  "idx": 117,
  "cn": "一瞬间她的身体像弹了一下似的僵住了。"
 },
 {
  "file": "41_2.tob",
  "idx": 5,
  "cn": "是渡来明日香。"
 },
 {
  "file": "41_2.tob",
  "idx": 14,
  "cn": "“哇哦～、新年参拜啦～！”"
 },
 {
  "file": "41_2.tob",
  "idx": 57,
  "cn": "“真是个美好的梦呢”"
 },
 {
  "file": "41_3.tob",
  "idx": 3,
  "cn": "“抱歉……没事、马上能站起来……”"
 },
 {
  "file": "41_3.tob",
  "idx": 55,
  "cn": "“你才昏过去”"
 },
 {
  "file": "41_3.tob",
  "idx": 63,
  "cn": "“自己”"
 },
 {
  "file": "41_4.tob",
  "idx": 43,
  "cn": "“诶～？你说什么了～？”"
 },
 {
  "file": "41_4.tob",
  "idx": 51,
  "cn": "“是第一次，所以对我温柔点！？”"
 },
 {
  "file": "41_4.tob",
  "idx": 52,
  "cn": "不禁像鹫介那样喊了出来"
 },
 {
  "file": "41_4.tob",
  "idx": 91,
  "cn": "“行是行……你没事吧？”"
 },
 {
  "file": "41_4.tob",
  "idx": 120,
  "cn": "“神明你这笨蛋啊啊啊啊！”"
 },
 {
  "file": "42_1.tob",
  "idx": 94,
  "cn": "“呼嘿？什么、你说的话前后不一样”"
 },
 {
  "file": "42_2.tob",
  "idx": 40,
  "cn": "“哈～……”"
 },
 {
  "file": "42_2.tob",
  "idx": 42,
  "cn": "“羽田同学、怎样？”"
 },
 {
  "file": "42_3.tob",
  "idx": 5,
  "cn": "“啊～、羽田同学没事吧～！？”"
 },
 {
  "file": "42_3.tob",
  "idx": 24,
  "cn": "“啊～”"
 },
 {
  "file": "42_4.tob",
  "idx": 10,
  "cn": "“是呀”"
 },
 {
  "file": "42_4.tob",
  "idx": 12,
  "cn": "“是呀”"
 },
 {
  "file": "42_4.tob",
  "idx": 87,
  "cn": "刚才电影里有味道的大叔说过的那个玩意儿。"
 },
 {
  "file": "42_5.tob",
  "idx": 6,
  "cn": "“哦～、哦～”"
 },
 {
  "file": "42_5.tob",
  "idx": 23,
  "cn": "等等、啥时候来着？"
 },
 {
  "file": "50_1.tob",
  "idx": 20,
  "cn": "“剧本组真我行我素啊——”"
 },
 {
  "file": "50_1.tob",
  "idx": 37,
  "cn": "“诶、等等等等、现在剧本到哪儿了？”"
 },
 {
  "file": "50_1.tob",
  "idx": 43,
  "cn": "“诶嘿嘿～”"
 },
 {
  "file": "50_1.tob",
  "idx": 53,
  "cn": "“那～、从日常场景里来一个这种的”"
 },
 {
  "file": "50_1.tob",
  "idx": 54,
  "cn": "“那就～、去死～高内～”"
 },
 {
  "file": "50_1.tob",
  "idx": 59,
  "cn": "“要求真多啊～”"
 },
 {
  "file": "50_1.tob",
  "idx": 80,
  "cn": "“哇～、结果大家都在秀恩爱～”"
 },
 {
  "file": "50_1.tob",
  "idx": 90,
  "cn": "“结束了吗～？”"
 },
 {
  "file": "50_1.tob",
  "idx": 92,
  "cn": "“哇～”"
 },
 {
  "file": "51_1.tob",
  "idx": 19,
  "cn": "“唔、谈恋爱时的渡来同学什么的、不就是萌要素的集合体吗？”"
 },
 {
  "file": "51_1.tob",
  "idx": 21,
  "cn": "“对、就是没自觉的地方特有那味儿”"
 },
 {
  "file": "51_1.tob",
  "idx": 48,
  "cn": "“好，下一个——、山科”"
 },
 {
  "file": "52_1.tob",
  "idx": 64,
  "cn": "“那个、中年Ｍ奴隶有几个人啊”"
 },
 {
  "file": "52_1.tob",
  "idx": 69,
  "cn": "“呐～呐～、大家一起去卡拉ＯＫ吧～？”"
 },
 {
  "file": "54_1.tob",
  "idx": 7,
  "cn": "“什么愚弄，就是事实吧”"
 },
 {
  "file": "61_1a.tob",
  "idx": 40,
  "cn": "说什么。怎么可能。"
 },
 {
  "file": "61_1a.tob",
  "idx": 50,
  "cn": "面对过于唐突的提问、我怀疑起耳朵、说不出话。"
 },
 {
  "file": "61_1a.tob",
  "idx": 54,
  "cn": "“什、什么啊、你什么意思……”"
 },
 {
  "file": "61_1b.tob",
  "idx": 7,
  "cn": "“哦哦～”"
 },
 {
  "file": "61_1b.tob",
  "idx": 44,
  "cn": "说什么。怎么可能。"
 },
 {
  "file": "61_1b.tob",
  "idx": 57,
  "cn": "“普通？有线广播也有普通一说吗？”"
 },
 {
  "file": "61_1b.tob",
  "idx": 86,
  "cn": "“唔、什么～”"
 },
 {
  "file": "61_1b.tob",
  "idx": 90,
  "cn": "“看不出你想说什么、到底是什么”"
 },
 {
  "file": "61_1b.tob",
  "idx": 104,
  "cn": "“诶……那是什么”"
 },
 {
  "file": "61_1c.tob",
  "idx": null,
  "cn": "不是澡堂却摆出战斗架势"
 },
 {
  "file": "61_1c.tob",
  "idx": 0,
  "cn": "“怎么说呢……虽是自己先开口的，有点那什么……”"
 },
 {
  "file": "61_1c.tob",
  "idx": 19,
  "cn": "她默默泼了我一身热水。"
 },
 {
  "file": "61_1c.tob",
  "idx": 29,
  "cn": "她没有戏弄我，只点了点头。"
 },
 {
  "file": "61_1c.tob",
  "idx": 78,
  "cn": "“渡来同学、没事吧？站得起来？”"
 },
 {
  "file": "61_1c.tob",
  "idx": 86,
  "cn": "伴随不懂礼数的钟声。"
 },
 {
  "file": "61_2b.tob",
  "idx": 11,
  "cn": "“啊、京同学、身体看着好多了……是吗？”"
 },
 {
  "file": "62_1a.tob",
  "idx": 46,
  "cn": "“说什么呢、怎么会有那种事啊！”"
 },
 {
  "file": "62_1a.tob",
  "idx": 47,
  "cn": "“就是说嘛～！”"
 },
 {
  "file": "63_1a.tob",
  "idx": 7,
  "cn": "“你把别的行李全无视就盯着工作服啊。正常来说用不上吧、我们到底去干嘛的”"
 },
 {
  "file": "63_1a.tob",
  "idx": 37,
  "cn": "“诶、这什么情况……我？诶、我？”"
 },
 {
  "file": "63_1b.tob",
  "idx": 3,
  "cn": "“呜哈～、请看外面～。已经完全是一副旅途梦幻心情了～”"
 },
 {
  "file": "63_1b.tob",
  "idx": 37,
  "cn": "——偶尔也好。我补上一句、把鸣的身体用力拉过来。"
 },
 {
  "file": "63_1b.tob",
  "idx": 66,
  "cn": "“屋外禁止～！”"
 },
 {
  "file": "64_2a.tob",
  "idx": 20,
  "cn": "“不适”"
 },
 {
  "file": "64_2a.tob",
  "idx": 35,
  "cn": "“不，不行”"
 },
 {
  "file": "64_2a.tob",
  "idx": 89,
  "cn": "啊、原来是我的"
 },
 {
  "file": "64_3a.tob",
  "idx": 32,
  "cn": "“真头疼呢”"
 },
 {
  "file": "64_3a.tob",
  "idx": 59,
  "cn": "“啊、到点了”"
 },
 {
  "file": "64_3a.tob",
  "idx": 62,
  "cn": "“报时～嗯”"
 },
 {
  "file": "sc_04.tob",
  "idx": 92,
  "cn": "“快、要来了……”"
 },
 {
  "file": "sc_06.tob",
  "idx": 24,
  "cn": "“哼哼～、这在都市电车是不可能有的站间距离～！”"
 },
 {
  "file": "sc_06.tob",
  "idx": 35,
  "cn": "“哼哼～、我的男朋友是鬼畜～！”"
 },
 {
  "file": "sc_06.tob",
  "idx": 59,
  "cn": "“哼哼～、光凭这种话就高兴起来的自己真可恨——！”"
 },
 {
  "file": "sc_06.tob",
  "idx": 84,
  "cn": "“不愿意的话就停手。还没鬼畜到那种程度”"
 },
 {
  "file": "sc_06.tob",
  "idx": 115,
  "cn": "“身体、起得来吗”"
 },
 {
  "file": "sc_06.tob",
  "idx": 116,
  "cn": "“好、好的～……”"
 },
 {
