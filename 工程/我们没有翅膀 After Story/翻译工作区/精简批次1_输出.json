[
 {
  "file": "11_1b.tob",
  "idx": 20,
  "cn": "“抱歉，你已经睡了吧”"
 },
 {
  "file": "11_1b.tob",
  "idx": 59,
  "cn": "渡来同学用像是要吐出沙子般的声音呻吟着。"
 },
 {
  "file": "11_1b.tob",
  "idx": 66,
  "cn": "“早上好。你们两个都很早啊”"
 },
 {
  "file": "11_1b.tob",
  "idx": 75,
  "cn": "“什么啊，地球防卫军？”"
 },
 {
  "file": "11_1b.tob",
  "idx": 79,
  "cn": "“啊哈哈，真像山科。”"
 },
 {
  "file": "11_1b.tob",
  "idx": 89,
  "cn": "“我觉得你失笑一下就好。”"
 },
 {
  "file": "11_1b.tob",
  "idx": 102,
  "cn": "“老公，你一脸晴天霹雳哦。”"
 },
 {
  "file": "11_1b.tob",
  "idx": 103,
  "cn": "“喂，老公。到校舍后面来一趟。”"
 },
 {
  "file": "11_1b.tob",
  "idx": 104,
  "cn": "“啊，不，不是这样、对不起渡来同学”"
 },
 {
  "file": "11_1b.tob",
  "idx": 105,
  "cn": "“老公、他在害怕哦”"
 },
 {
  "file": "11_1b.tob",
  "idx": 109,
  "cn": "“老婆、她在害羞哦”"
 },
 {
  "file": "11_1b.tob",
  "idx": 125,
  "cn": "另一边，除了针生同学，其他全是石头。"
 },
 {
  "file": "11_1b.tob",
  "idx": 141,
  "cn": "“我２２”"
 },
 {
  "file": "11_1b.tob",
  "idx": 142,
  "cn": "“２３”"
 },
 {
  "file": "11_1b.tob",
  "idx": 143,
  "cn": "“２４”"
 },
 {
  "file": "11_1b.tob",
  "idx": 149,
  "cn": "“老公，你一脸‘怎么暴露了’哦。”"
 },
 {
  "file": "11_1b.tob",
  "idx": 152,
  "cn": "“老公，他好像不同意哦。”"
 },
 {
  "file": "11_1b.tob",
  "idx": 162,
  "cn": "“羽田同学——？背挺直点——？”"
 },
 {
  "file": "11_1b.tob",
  "idx": 167,
  "cn": "“啊……说得对。”"
 },
 {
  "file": "11_1b.tob",
  "idx": 184,
  "cn": "“等等，跟你一起去。”"
 },
 {
  "file": "11_1b.tob",
  "idx": 195,
  "cn": "“渡来同学”"
 },
 {
  "file": "11_1b.tob",
  "idx": 196,
  "cn": "“嗯～？”"
 },
 {
  "file": "11_1b.tob",
  "idx": 208,
  "cn": "“真随便啊”"
 },
 {
  "file": "11_1b.tob",
  "idx": 222,
  "cn": "“怎样？”"
 },
 {
  "file": "11_1b.tob",
  "idx": 226,
  "cn": "“嗯～？事到如今还心动什么啊。”"
 },
 {
  "file": "11_1b.tob",
  "idx": 236,
  "cn": "“你觉得我是个麻烦女人吧。”"
 },
 {
  "file": "11_1b.tob",
  "idx": 241,
  "cn": "“啊哈哈”"
 },
 {
  "file": "11_1b.tob",
  "idx": 249,
  "cn": "“没有。”"
 },
 {
  "file": "11_2a.tob",
  "idx": 9,
  "cn": "“嗯，对。花水木大街上新开的那家店的。”"
 },
 {
  "file": "11_2a.tob",
  "idx": 66,
  "cn": "“啊”"
 },
 {
  "file": "11_2a.tob",
  "idx": 69,
  "cn": "“啊哈哈、没事。”"
 },
 {
  "file": "11_2a.tob",
  "idx": 88,
  "cn": "“……那不用了。”"
 },
 {
  "file": "11_2a.tob",
  "idx": 98,
  "cn": "不过她正是那个年纪的女孩，所以我忍住了。"
 },
 {
  "file": "11_2b.tob",
  "idx": 33,
  "cn": "“１０７７”"
 },
 {
  "file": "11_2b.tob",
  "idx": 40,
  "cn": "“可惜、７８”"
 },
 {
  "file": "11_2b.tob",
  "idx": 63,
  "cn": "“啊，藤野同学，早上好”"
 },
 {
  "file": "11_2b.tob",
  "idx": 101,
  "cn": "“特别是脸”"
 },
 {
  "file": "11_2b.tob",
  "idx": 106,
  "cn": "“你、你看，吓人……脸吓人哦高内同学……”"
 },
 {
  "file": "11_2b.tob",
  "idx": 108,
  "cn": "“嗯～、怎么啦这是～”"
 },
 {
  "file": "11_2b.tob",
  "idx": 121,
  "cn": "“什么嘛，是说高内啊”"
 },
 {
  "file": "11_2b.tob",
  "idx": 131,
  "cn": "“这不是有吗”"
 },
 {
  "file": "11_2c.tob",
  "idx": 9,
  "cn": "“啊、啊这样啊”"
 },
 {
  "file": "11_2c.tob",
  "idx": 31,
  "cn": "“啊啊、栗山君”"
 },
 {
  "file": "11_2c.tob",
  "idx": 37,
  "cn": "“——是说ＫｕＲｉＹａ？”"
 },
 {
  "file": "11_2c.tob",
  "idx": 66,
  "cn": "“久等了～。回～家吧。”"
 },
 {
  "file": "11_2c.tob",
  "idx": 71,
  "cn": "“羽田”"
 },
 {
  "file": "11_2c.tob",
  "idx": 107,
  "cn": "“啊～、德拉你带女朋友来啦——、好火热好火热，咻——咻——”"
 },
 {
  "file": "11_2c.tob",
  "idx": 143,
  "cn": "“太糟了……好久没见到这么糟的男人了……”"
 },
 {
  "file": "11_2c.tob",
  "idx": 148,
  "cn": "“……在意一点”"
 },
 {
  "file": "11_3a.tob",
  "idx": 34,
  "cn": "“这样啊。那就好”"
 },
 {
  "file": "11_3a.tob",
  "idx": 66,
  "cn": "“啊”"
 },
 {
  "file": "11_3b0.tob",
  "idx": 6,
  "cn": "“早上好。佐久间同学今天也很有精神啊”"
 },
 {
  "file": "11_3b0.tob",
  "idx": 30,
  "cn": "“我也吓了一跳。羽田同学和咲夜君、什么时候关系这么好？”"
 },
 {
  "file": "11_3b0.tob",
  "idx": 32,
  "cn": "“啊、不、不是那样的山科同学。我们的关系再健全不过了。之前我和女孩子走在一起时，佐久间同学拿刀威胁我、我把他打回去，然后我们之间就萌生了火热的友情，仅此而已。”"
 },
 {
  "file": "11_3b0.tob",
  "idx": 39,
  "cn": "“……啊哈哈、真是个有趣的人”"
 },
 {
  "file": "11_3b2.tob",
  "idx": 12,
  "cn": "恋爱"
 },
 {
  "file": "11_3b2.tob",
  "idx": 17,
  "cn": "“是怎样的女孩？”"
 },
 {
  "file": "11_3b2.tob",
  "idx": 30,
  "cn": "“佐久间同学、你对女性的心理意外地迟钝？”"
 },
 {
  "file": "11_3b2.tob",
  "idx": 37,
  "cn": "“早上好～羽田同学、早上真好”"
 },
 {
  "file": "11_3c.tob",
  "idx": 21,
  "cn": "“喂～！不好意思、稍微注意这边～”"
 },
 {
  "file": "11_3c.tob",
  "idx": 27,
  "cn": "“藤野同学、你为难吗？”"
 },
 {
  "file": "11_3c.tob",
  "idx": 31,
  "cn": "“诶、那可真够呛。打算怎么办？”"
 },
 {
  "file": "11_3c.tob",
  "idx": 84,
  "cn": "“嗯？怎么了明日香、鬼也会得病吗”"
 },
 {
  "file": "11_3c.tob",
  "idx": 86,
  "cn": "“哈哈哈哈哈”"
 },
 {
  "file": "11_3c.tob",
  "idx": 97,
  "cn": "“猪肉包定了”"
 },
 {
  "file": "11_3c.tob",
  "idx": 100,
  "cn": "“猪肉包”"
 },
 {
  "file": "11_3c.tob",
  "idx": 102,
  "cn": "“变成哪个都行！”"
 },
 {
  "file": "11_3d0.tob",
  "idx": null,
  "cn": "停不住的男人"
 },
 {
  "file": "11_3d0.tob",
  "idx": 7,
  "cn": "“那东西我已练到极致。现在算世界遗产吧”"
 },
 {
  "file": "11_3d0.tob",
  "idx": 25,
  "cn": "“Ｅｘａｃｔｌｙ。就是那个难道。那家伙——”"
 },
 {
  "file": "11_3d0.tob",
  "idx": 45,
  "cn": "“那么”"
 },
 {
  "file": "11_3d0.tob",
  "idx": 55,
  "cn": "“不、你用那种仰视的眼神说‘对吧’也没用”"
 },
 {
  "file": "11_3d1.tob",
  "idx": 2,
  "cn": "“为何一副不情愿的样子？”"
 },
 {
  "file": "11_3d1.tob",
  "idx": 17,
  "cn": "“羽～田～同学！”"
 },
 {
  "file": "11_3d1.tob",
  "idx": 20,
  "cn": "“软趴趴～、最喜欢你了～”"
 },
 {
  "file": "11_3d1.tob",
  "idx": 27,
  "cn": "“咦、好冷淡”"
 },
 {
  "file": "11_3d1.tob",
  "idx": 41,
  "cn": "“什么～”"
 },
 {
  "file": "11_3d1.tob",
  "idx": 47,
  "cn": "“渡来同学”"
 },
 {
  "file": "11_3d1.tob",
  "idx": 48,
  "cn": "“嗯～？”"
 },
 {
  "file": "11_3d1.tob",
  "idx": 52,
  "cn": "“最喜欢你了”"
 },
 {
  "file": "11_3d1.tob",
  "idx": 71,
  "cn": "“嗯～、书名呢～？”"
 },
 {
  "file": "11_3d1.tob",
  "idx": 85,
  "cn": "“再～来～一遍～”"
 },
 {
  "file": "11_3d2.tob",
  "idx": 69,
  "cn": "“小学生吗”"
 },
 {
  "file": "11_3d2.tob",
  "idx": 75,
  "cn": "“唔～、怎么说呢。”"
 },
 {
  "file": "11_3d3.tob",
  "idx": 38,
  "cn": "“哦、好像要被吸进去了”"
 },
 {
  "file": "11_3d3.tob",
  "idx": 54,
  "cn": "“哈啊”"
 },
 {
  "file": "11_3d3.tob",
  "idx": 71,
  "cn": "“山科、你说得真像别人的事～。去跟那家伙交往一次试试、会累的。”"
 },
 {
  "file": "11_3d3.tob",
  "idx": 95,
  "cn": "“……为何用敬语？”"
 },
 {
  "file": "11_3d3.tob",
  "idx": 96,
  "cn": "“啊、对了。你该不会听到刚才的对话吧？”"
 },
 {
  "file": "11_4a.tob",
  "idx": 41,
  "cn": "“鸭志田同学、你好像从挺早以前就一直坐这个点儿的车厢吧。”"
 },
 {
  "file": "11_4a.tob",
  "idx": 45,
  "cn": "“啊、不、是的、没错，可是……”"
 },
 {
  "file": "11_4b.tob",
  "idx": null,
  "cn": "回来了，针生同学"
 },
 {
  "file": "11_4b.tob",
  "idx": 19,
  "cn": "“朋友啊。”"
 },
 {
  "file": "11_4b.tob",
  "idx": 28,
  "cn": "“羽田同学羽田同学、这儿没有值得同情的地方。”"
 },
 {
  "file": "11_4b.tob",
  "idx": 42,
  "cn": "“山科在吗～？”"
 },
 {
  "file": "11_4b.tob",
  "idx": 46,
  "cn": "“啊～、不用起来，躺着就好”"
 },
 {
  "file": "11_5a.tob",
  "idx": 4,
  "cn": "“羽田同学、你在紧张”"
 },
 {
  "file": "11_5a.tob",
  "idx": 6,
  "cn": "“会紧张、一般人都会。倒不如说渡来同学、你怎么不紧张？”"
 },
 {
  "file": "11_5a.tob",
  "idx": 30,
  "cn": "“嗯～……”"
 },
 {
  "file": "11_5a.tob",
  "idx": 33,
  "cn": "“嗯～？嗯～……”"
 },
 {
  "file": "11_5a.tob",
  "idx": 51,
  "cn": "“今天不能亲热、所以现在把一整天的分量一次补上”"
 },
 {
  "file": "11_5a.tob",
  "idx": 53,
  "cn": "我自己都觉得这回答蠢透了。"
 },
 {
  "file": "11_5a.tob",
  "idx": 72,
  "cn": "“哈……哈？您是说、到现在为止吗”"
 },
 {
  "file": "11_5a.tob",
  "idx": 79,
  "cn": "“你说什么”"
 },
 {
  "file": "11_5a.tob",
  "idx": 86,
  "cn": "‘总还是’？"
 },
 {
  "file": "11_5a.tob",
  "idx": 95,
  "cn": "“啊哈哈”"
 },
 {
  "file": "11_5a.tob",
  "idx": 109,
  "cn": "“哎呀呀、这算什么闹剧啊”"
 },
 {
  "file": "11_5a.tob",
  "idx": 118,
  "cn": "“海胆鱿鱼明太～”"
 },
 {
  "file": "11_5b.tob",
  "idx": 6,
  "cn": "“啊”"
 },
 {
  "file": "11_5b.tob",
  "idx": 7,
  "cn": "“啊”"
 },
 {
  "file": "11_5b.tob",
  "idx": 17,
  "cn": "羽田同学、朋友？"
 },
 {
  "file": "11_5b.tob",
  "idx": 21,
  "cn": "“那、重新来。”"
 },
 {
  "file": "11_5b.tob",
  "idx": 22,
  "cn": "“这位是渡来明日香同学”"
 },
 {
  "file": "11_5b.tob",
  "idx": 24,
  "cn": "“我妹妹小鸠。”"
 },
 {
  "file": "11_5b.tob",
  "idx": 45,
  "cn": "羽田同学、话题。"
 },
 {
  "file": "11_5b.tob",
  "idx": 55,
  "cn": "“诶、你在意的是这个？我明日香到底给人多硬汉的印象啊”"
 },
 {
  "file": "11_5b.tob",
  "idx": 68,
  "cn": "“呵呵呵呵”"
 },
 {
  "file": "11_5b.tob",
  "idx": 94,
  "cn": "说的是我的——我们的事。"
 },
 {
  "file": "11_5b.tob",
  "idx": 98,
  "cn": "“我也这么觉得”"
 },
 {
  "file": "11_5b.tob",
  "idx": 125,
  "cn": "“哈～……”"
 },
 {
  "file": "11_5b.tob",
  "idx": 174,
  "cn": "“所以、现在还不行、停在这。”"
 },
 {
  "file": "11_5c.tob",
  "idx": 4,
  "cn": "“不过羽田同学、这是你第五次说了。”"
 },
 {
  "file": "11_5c.tob",
  "idx": 9,
  "cn": "“是吗～”"
 },
 {
  "file": "11_5c.tob",
  "idx": 31,
  "cn": "她打趣着说、挽住我的手臂——我的恋人。"
 },
 {
  "file": "11_5c.tob",
  "idx": 34,
  "cn": "“哇——羽田同学虽然是个妹控、对女朋友也很温柔呢”"
 },
 {
  "file": "11_5c.tob",
  "idx": 55,
  "cn": "“唔、什么什么？”"
 },
 {
  "file": "11_5c.tob",
  "idx": 65,
  "cn": "羽田同学！"
 },
 {
  "file": "11_5c.tob",
  "idx": 67,
  "cn": "“换衣服”"
 },
 {
  "file": "11_5c.tob",
  "idx": 73,
  "cn": "“是吗～？”"
 },
 {
  "file": "11_5c.tob",
  "idx": 82,
  "cn": "“突、突然干嘛。”"
 },
 {
  "file": "11_5c.tob",
  "idx": 94,
  "cn": "“羽田同学～、不觉得有点热吗？”"
 },
 {
  "file": "11_5c.tob",
  "idx": 98,
  "cn": "“你说什么”"
 },
 {
  "file": "11_5c.tob",
  "idx": 100,
  "cn": "“这里”"
 },
 {
  "file": "11_5c.tob",
  "idx": 104,
  "cn": "“嘿嘿～”"
 },
 {
  "file": "11_5c.tob",
  "idx": 110,
  "cn": "“把女朋友晾在一边太久，男人味会掉的哦——？”"
 },
 {
  "file": "11_5c.tob",
  "idx": 118,
  "cn": "“给你提升女人味。”"
 },
 {
  "file": "11_5d.tob",
  "idx": 0,
  "cn": "“啊～唔姆……唔姆、唔唔……”"
 },
 {
  "file": "11_5d.tob",
  "idx": 2,
  "cn": "“唔……渡来同学、那里”"
 },
 {
  "file": "11_5d.tob",
  "idx": 16,
  "cn": "“嗯呼～、唔姆姆姆”"
 },
 {
  "file": "11_5d.tob",
  "idx": 30,
  "cn": "“渡来同学、技术真好……”"
 },
 {
  "file": "11_5d.tob",
  "idx": 36,
  "cn": "“嘿嘿～”"
 },
 {
  "file": "11_5d.tob",
  "idx": 52,
  "cn": "“嗯哈嗯哈……嗯嗯嗯嗯，嗯哈。”"
 },
 {
  "file": "11_5d.tob",
  "idx": 58,
  "cn": "“嗯呼嗯，嗯诶嗯哇嗯哈。”"
 },
 {
  "file": "11_5d.tob",
  "idx": 72,
  "cn": "“啊、找到了～”"
 },
 {
  "file": "11_5d.tob",
  "idx": 98,
  "cn": "“别较真，小象。”"
 },
 {
  "file": "11_5d.tob",
  "idx": 122,
  "cn": "“嗯～”"
 },
 {
  "file": "11_5d.tob",
  "idx": 123,
  "cn": "这样下去，我这男朋友的脸就丢光了。"
 },
 {
  "file": "11_5d.tob",
  "idx": 140,
  "cn": "“嗯、我现在就随自己喜欢。”"
 },
 {
  "file": "11_5d.tob",
  "idx": 147,
  "cn": "“你说什么”"
 },
 {
  "file": "11_5d.tob",
  "idx": 155,
  "cn": "“…………嗯”"
 },
 {
  "file": "11_5d.tob",
  "idx": 160,
  "cn": "“反过来说，我只是呼吸了下哦？”"
 },
 {
  "file": "11_5d.tob",
  "idx": 165,
  "cn": "“…………嗯”"
 },
 {
  "file": "11_5d.tob",
  "idx": 167,
  "cn": "“…………嗯、嗯”"
 },
 {
  "file": "11_5d.tob",
  "idx": 168,
  "cn": "我试着朝她脖颈吹了一口细细的气。"
