[
 {
  "file": "11_6a.tob",
  "idx": 35,
  "cn": "“女孩子说就没关系。”"
 },
 {
  "file": "11_6a.tob",
  "idx": 42,
  "cn": "“啊哈哈”"
 },
 {
  "file": "11_6a.tob",
  "idx": 45,
  "cn": "“是啊是啊”"
 },
 {
  "file": "11_6a.tob",
  "idx": 59,
  "cn": "“接下来的话等回去再说。等只有我们两人时聊个够吧”"
 },
 {
  "file": "12_1b.tob",
  "idx": 50,
  "cn": "“诶？什么？”"
 },
 {
  "file": "12_1b.tob",
  "idx": 76,
  "cn": "“哟——玉日和——、还没换好衣服吗！”"
 },
 {
  "file": "12_1b.tob",
  "idx": 90,
  "cn": "“根本没想帮我说话！？”"
 },
 {
  "file": "12_1b.tob",
  "idx": 128,
  "cn": "“我就是可怕的恶鬼怎样”"
 },
 {
  "file": "12_1b.tob",
  "idx": 130,
  "cn": "被——听——到——了！"
 },
 {
  "file": "12_1b.tob",
  "idx": 138,
  "cn": "“喂”"
 },
 {
  "file": "12_1b.tob",
  "idx": 185,
  "cn": "轻轻一握。"
 },
 {
  "file": "12_1b.tob",
  "idx": 198,
  "cn": "另一边、我若无其事地把手指缠过去……好、十指相扣——。"
 },
 {
  "file": "12_1b.tob",
  "idx": 203,
  "cn": "“哈？怎么可能、空调设定的是２５度啊”"
 },
 {
  "file": "12_1b.tob",
  "idx": 224,
  "cn": "她用肩膀轻轻碰了碰我说了一句。"
 },
 {
  "file": "12_1b.tob",
  "idx": 234,
  "cn": "“真是的、算什么啊……啊哈哈”"
 },
 {
  "file": "12_1b.tob",
  "idx": 238,
  "cn": "“开心是开心啦！”"
 },
 {
  "file": "12_1c.tob",
  "idx": 12,
  "cn": "“这是什么东西啊”"
 },
 {
  "file": "12_1c.tob",
  "idx": 30,
  "cn": "“别放下啊”"
 },
 {
  "file": "12_1c.tob",
  "idx": 53,
  "cn": "“然后呢？玉日和你怎么办——？”"
 },
 {
  "file": "12_1e.tob",
  "idx": 57,
  "cn": "“啊啊”"
 },
 {
  "file": "12_1e.tob",
  "idx": 106,
  "cn": "“横向Ｖ手势……”"
 },
 {
  "file": "12_1e.tob",
  "idx": 170,
  "cn": "“日和子同学？”"
 },
 {
  "file": "12_1e.tob",
  "idx": 194,
  "cn": "“嗯……？”"
 },
 {
  "file": "12_1e.tob",
  "idx": 207,
  "cn": "“很乐意！”"
 },
 {
  "file": "12_1e.tob",
  "idx": 221,
  "cn": "“刚才心里被‘咚’地击中……”"
 },
 {
  "file": "12_1e.tob",
  "idx": 246,
  "cn": "“日、日和子同学……我快不行了”"
 },
 {
  "file": "12_1e.tob",
  "idx": 251,
  "cn": "要、要出来了！要出来了要出来了要出来了、要出来了！"
 },
 {
  "file": "12_1e.tob",
  "idx": 259,
  "cn": "瘫软下来。"
 },
 {
  "file": "12_1e.tob",
  "idx": 279,
  "cn": "“你、干嘛……”"
 },
 {
  "file": "12_1e.tob",
  "idx": 292,
  "cn": "“咒别人就得挖两个坟坑！”"
 },
 {
  "file": "12_1e.tob",
  "idx": 311,
  "cn": "“嗯嗯？”"
 },
 {
  "file": "12_1e.tob",
  "idx": 390,
  "cn": "“可是我不想在没能把现在这份心情完全传达的情况下就让你回去。”"
 },
 {
  "file": "12_1e.tob",
  "idx": 400,
  "cn": "“下面的嘴老实！”"
 },
 {
  "file": "12_1e.tob",
  "idx": 401,
  "cn": "“嗯呼呼呼”"
 },
 {
  "file": "12_2a.tob",
  "idx": 2,
  "cn": "“唔、好冷……”"
 },
 {
  "file": "12_2a.tob",
  "idx": 8,
  "cn": "“哇啊哦、一直以来谢谢你啦、我现在就下去——”"
 },
 {
  "file": "12_2a.tob",
  "idx": 14,
  "cn": "话说回来、这已不是别人的事了吧，我。"
 },
 {
  "file": "12_2a.tob",
  "idx": 65,
  "cn": "“我觉得这是出色的妥协方案。”"
 },
 {
  "file": "12_2b.tob",
  "idx": 48,
  "cn": "“后面第三节车厢。”"
 },
 {
  "file": "12_2b.tob",
  "idx": 66,
  "cn": "“是吗”"
 },
 {
  "file": "12_2b.tob",
  "idx": 86,
  "cn": "“诶诶诶？什么啊、搞得人家在意得要命。都吊到这份上了、这样太过分了吧。”"
 },
 {
  "file": "12_2b.tob",
  "idx": 91,
  "cn": "“哎呀、受欢迎的男人真辛苦啊。开玩笑的，啊哈哈——”"
 },
 {
  "file": "12_2c.tob",
  "idx": 8,
  "cn": "“早上好……”"
 },
 {
  "file": "12_2c.tob",
  "idx": 14,
  "cn": "“早上好羽田同学——”"
 },
 {
  "file": "12_2c.tob",
  "idx": 16,
  "cn": "“挑拨得也太露骨了。”"
 },
 {
  "file": "12_2c.tob",
  "idx": 20,
  "cn": "“那是当然”"
 },
 {
  "file": "12_2c.tob",
  "idx": 45,
  "cn": "“骗人、修罗场！？讨厌啦你早说啊、那可是我的超级专长！”"
 },
 {
  "file": "12_2c.tob",
  "idx": 55,
  "cn": "明明摆着羽田鹰志式的真诚表情回答，当场就被戳穿了！"
 },
 {
  "file": "12_2c.tob",
  "idx": 57,
  "cn": "“确实、要说羽田的话，可不会摆这种嬉皮笑脸没正形的表情啊。”"
 },
 {
  "file": "12_2c.tob",
  "idx": 66,
  "cn": "“什么啊。有闲工夫放那种东西，不如把羽田同学放出来。”"
 },
 {
  "file": "12_2c.tob",
  "idx": 91,
  "cn": "“这、这次是什么事？”"
 },
 {
  "file": "12_2c.tob",
  "idx": 92,
  "cn": "“诶？所以说是我生病的事。”"
 },
 {
  "file": "12_2c.tob",
  "idx": 104,
  "cn": "“啊啊、就是这个。虽然很过分，但说得真妙、你。”"
 },
 {
  "file": "12_2c.tob",
  "idx": 130,
  "cn": "话说、京同学什么时候才腻啊……。"
 },
 {
  "file": "12_2d.tob",
  "idx": 13,
  "cn": "“驳回”"
 },
 {
  "file": "12_2d.tob",
  "idx": 30,
  "cn": "“哦——。哦哦”"
 },
 {
  "file": "12_2d.tob",
  "idx": 35,
  "cn": "“啊”"
 },
 {
  "file": "12_2d.tob",
  "idx": 39,
  "cn": "“你说什么”"
 },
 {
  "file": "12_2d.tob",
  "idx": 54,
  "cn": "“鹫。鹫、鹫——”"
 },
 {
  "file": "12_2d.tob",
  "idx": 72,
  "cn": "“喂——、哦——、鹫”"
 },
 {
  "file": "12_2d.tob",
  "idx": 82,
  "cn": "“你好——、我是玉泉。就算没有蛋蛋，也还是玉泉”"
 },
 {
  "file": "12_2e.tob",
  "idx": 22,
  "cn": "“ＡＶ吗！”"
 },
 {
  "file": "12_2e.tob",
  "idx": 24,
  "cn": "“面试吗！”"
 },
 {
  "file": "12_2e.tob",
  "idx": 26,
  "cn": "“哲学吗！”"
 },
 {
  "file": "12_2e.tob",
  "idx": 28,
  "cn": "“普通吗！”"
 },
 {
  "file": "12_2e.tob",
  "idx": 39,
  "cn": "“硬来吗！”"
 },
 {
  "file": "12_2e.tob",
  "idx": 41,
  "cn": "“狩男吗！”"
 },
 {
  "file": "12_2e.tob",
  "idx": 43,
  "cn": "“我吗！”"
 },
 {
  "file": "12_2e.tob",
  "idx": 76,
  "cn": "“是吗”"
 },
 {
  "file": "12_2e.tob",
  "idx": 99,
  "cn": "“还真猜中了”"
 },
 {
  "file": "12_2e.tob",
  "idx": 116,
  "cn": "“你、你好”"
 },
 {
  "file": "12_2e.tob",
  "idx": 117,
  "cn": "“你好”"
 },
 {
  "file": "12_2e.tob",
  "idx": 130,
  "cn": "“啊、就是那个被称为拼命婊子的最后手段的东西。”"
 },
 {
  "file": "12_2e.tob",
  "idx": 144,
  "cn": "不过最重要的是，穿着制服、一副低年级生模样的日和子同学，可爱得毫无道理可讲。"
 },
 {
  "file": "12_2f.tob",
  "idx": 26,
  "cn": "“……你在干什么”"
 },
 {
  "file": "12_2f.tob",
  "idx": 27,
  "cn": "“被真心嫌弃了！”"
 },
 {
  "file": "12_2f.tob",
  "idx": 54,
  "cn": "“喂……不要不要、都说了不要……啊啊、别弄了、真是的——”"
 },
 {
  "file": "12_2f.tob",
  "idx": 77,
  "cn": "“不对，是味道、味道”"
 },
 {
  "file": "12_2f.tob",
  "idx": 123,
  "cn": "“诶？啊啊、是醋拌菜”"
 },
 {
  "file": "12_2f.tob",
  "idx": 128,
  "cn": "“啥！？”"
 },
 {
  "file": "12_2f.tob",
  "idx": 132,
  "cn": "“骗人吧啊啊啊！你到底放了什么啊啊！？”"
 },
 {
  "file": "12_2f.tob",
  "idx": 138,
  "cn": "自言自语能得到回应，何等幸福。"
 },
 {
  "file": "12_2f.tob",
  "idx": 148,
  "cn": "“就是说……相思病、之类的？”"
 },
 {
  "file": "12_2f.tob",
  "idx": 152,
  "cn": "“真的假的”"
 },
 {
  "file": "12_2f.tob",
  "idx": 160,
  "cn": "哦、是个坚强的孩子"
 },
 {
  "file": "12_3a0.tob",
  "idx": 4,
  "cn": "“羽田同学”"
 },
 {
  "file": "12_3a0.tob",
  "idx": 10,
  "cn": "“我不承认”"
 },
 {
  "file": "12_3a0.tob",
  "idx": 18,
  "cn": "“什么”"
 },
 {
  "file": "12_3a0.tob",
  "idx": 22,
  "cn": "“那是什么”"
 },
 {
  "file": "12_3a0.tob",
  "idx": 25,
  "cn": "“那是当然”"
 },
 {
  "file": "12_3a0.tob",
  "idx": 42,
  "cn": "“……为什么摆出一副快哭的表情。”"
 },
 {
  "file": "12_3a0.tob",
  "idx": 50,
  "cn": "“可别迷上我？”"
 },
 {
  "file": "12_3a0.tob",
  "idx": 51,
  "cn": "“才没有”"
 },
 {
  "file": "12_3a0.tob",
  "idx": 58,
  "cn": "好厉害、面无表情全肯定，厉害。"
 },
 {
  "file": "12_3a0.tob",
  "idx": 62,
  "cn": "“不过比日和子同学还是差一点。”"
 },
 {
  "file": "12_3a0.tob",
  "idx": 154,
  "cn": "“因为她就在那儿”"
 },
 {
  "file": "12_3a0.tob",
  "idx": 164,
  "cn": "“为、为了这个特地来？”"
 },
 {
  "file": "12_3a0.tob",
  "idx": 167,
  "cn": "哗——（心里的眼泪）"
 },
 {
  "file": "12_3a1.tob",
  "idx": null,
  "cn": "和日和子同学回去"
 },
 {
  "file": "12_3a1.tob",
  "idx": 3,
  "cn": "“看脸色、看脸色”"
 },
 {
  "file": "12_3a2.tob",
  "idx": null,
  "cn": "和明日香同学回去"
 },
 {
  "file": "12_3a2.tob",
  "idx": 33,
  "cn": "“跟他”"
 },
 {
  "file": "12_3b.tob",
  "idx": 61,
  "cn": "“哈哈”"
 },
 {
  "file": "12_3b.tob",
  "idx": 79,
  "cn": "“你说什么”"
 },
 {
  "file": "12_3b.tob",
  "idx": 144,
  "cn": "“……没什么”"
 },
 {
  "file": "12_3b.tob",
  "idx": 148,
  "cn": "“我不喜欢强势女性”"
 },
 {
  "file": "12_3b.tob",
  "idx": 151,
  "cn": "“哇，真是张可恨的脸。多亏你，羽田同学的影子已干干净净地消失了。”"
 },
 {
  "file": "12_3b.tob",
  "idx": 172,
  "cn": "“啊”"
 },
 {
  "file": "12_3b.tob",
  "idx": 178,
  "cn": "“诶”"
 },
 {
  "file": "12_4a.tob",
  "idx": 16,
  "cn": "Ａｒｅ Ｕ ＯＫ？"
 },
 {
  "file": "12_4a.tob",
  "idx": 71,
  "cn": "“因为那家伙的怒气就会集中到千岁身上。”"
 },
 {
  "file": "12_4a.tob",
  "idx": 72,
  "cn": "“你是这条街的避雷针！”"
 },
 {
  "file": "12_4a.tob",
  "idx": 89,
  "cn": "“出轨吗”"
 },
 {
  "file": "12_4a.tob",
  "idx": 94,
  "cn": "“哎呀、不行的哦千岁同学、出轨。”"
 },
 {
  "file": "12_4a.tob",
  "idx": 125,
  "cn": "“没有啦”"
 },
 {
  "file": "12_4b.tob",
  "idx": null,
  "cn": "忘记时间男人"
 },
 {
  "file": "12_4b.tob",
  "idx": 36,
  "cn": "“啊哈哈、凤同学玩笑像店长一样”"
 },
 {
  "file": "12_4b.tob",
  "idx": 51,
  "cn": "“那、那个、心理还没准备好……”"
 },
 {
  "file": "12_4b.tob",
  "idx": 78,
  "cn": "“真是的、英里子小姐说太多了……”"
 },
 {
  "file": "12_4b.tob",
  "idx": 138,
  "cn": "“啊、不过已经到时间了”"
 },
 {
  "file": "12_4b.tob",
  "idx": 139,
  "cn": "“诶”"
 },
 {
  "file": "12_4b.tob",
  "idx": 140,
  "cn": "“好——、收工回去、辛苦啦”"
 },
 {
  "file": "12_4b.tob",
  "idx": 143,
  "cn": "“不愧是忘记时间的男人。噗嗤……”"
 },
 {
  "file": "12_4c0.tob",
  "idx": 51,
  "cn": "“诶？诶诶？骗人的吧？”"
 },
 {
  "file": "12_4c0.tob",
  "idx": 64,
  "cn": "“嗯、全员一起”"
 },
 {
  "file": "12_4c0.tob",
  "idx": 93,
  "cn": "“每天都S！”"
 },
 {
  "file": "12_4c0.tob",
  "idx": 99,
  "cn": "“好、凤同学真了不起！你呀该把输翔的名号改成赢翔啦！”"
 },
 {
  "file": "12_4c0.tob",
  "idx": 101,
  "cn": "“我感受到一股惊人的一体感。前所未有的某种炽热的一体感……结账就交给我吧噼里啪啦”"
 },
 {
  "file": "12_4c0.tob",
  "idx": 108,
  "cn": "好、好厉害啊大家、居然能那么一如平常。"
 },
 {
  "file": "12_4c0.tob",
  "idx": 119,
  "cn": "“千岁、你看起来就是嘴上说说感谢感谢那种人呢”"
 },
 {
  "file": "12_4c1.tob",
  "idx": 7,
  "cn": "“啊、那也给我介绍一个！”"
 },
 {
  "file": "12_4c2.tob",
  "idx": 19,
  "cn": "“那么、接下来就相信千岁同学的爱回家啦”"
 },
 {
  "file": "12_4d.tob",
  "idx": 25,
  "cn": "竟然如此。"
 },
 {
  "file": "12_4d.tob",
  "idx": 33,
  "cn": "“今天的……？”"
 },
 {
  "file": "12_4d.tob",
  "idx": 57,
  "cn": "“真是……”"
 },
 {
  "file": "12_4d.tob",
  "idx": 63,
  "cn": "“那个——、日和子同学”"
 },
 {
  "file": "12_4d.tob",
  "idx": 69,
  "cn": "“日和子同学”"
 },
 {
  "file": "12_4d.tob",
  "idx": 78,
  "cn": "“啊哈哈哈”"
 },
 {
  "file": "12_4d.tob",
  "idx": 100,
  "cn": "“诶、那个……开玩笑的吧？”"
 },
 {
  "file": "13_1b.tob",
  "idx": 2,
  "cn": "“呼嘿……”"
 },
 {
  "file": "13_1b.tob",
  "idx": 13,
  "cn": "“哈……”"
 },
 {
  "file": "13_1b.tob",
  "idx": 15,
  "cn": "也就是说、是个有本事的笨蛋。比我这种既没脑子也没教养的家伙要聪明得多的笨蛋"
 },
 {
  "file": "13_1b.tob",
  "idx": 17,
  "cn": "“哈……”"
 },
 {
  "file": "13_1b.tob",
  "idx": 20,
  "cn": "“那个”"
 },
 {
  "file": "13_1b.tob",
  "idx": 26,
  "cn": "“哈——、还好”"
 },
 {
  "file": "13_1b.tob",
  "idx": 46,
  "cn": "“现在可是在约会哦、请收敛一点——？”"
 },
 {
  "file": "13_1b.tob",
  "idx": 47,
  "cn": "“不懂什么意思”"
 },
 {
  "file": "13_1b.tob",
  "idx": 74,
  "cn": "“想没想呢”"
 },
 {
  "file": "13_1b.tob",
  "idx": 78,
  "cn": "“呜哈——、害羞了——。这孩子、害羞了”"
 },
 {
  "file": "13_1b.tob",
  "idx": 101,
  "cn": "“她说的”"
 },
 {
  "file": "13_1b.tob",
  "idx": 115,
  "cn": "“嘛、是啊……”"
 },
 {
  "file": "13_1b.tob",
  "idx": 121,
  "cn": "“啊、啊——、那个”"
 },
 {
  "file": "13_1b.tob",
  "idx": 131,
  "cn": "“唔……”"
 },
 {
  "file": "13_1b.tob",
  "idx": 141,
  "cn": "“哈”"
 },
 {
  "file": "13_1b.tob",
  "idx": 143,
  "cn": "“哈”"
 },
 {
  "file": "13_1b.tob",
  "idx": 146,
  "cn": "“哈”"
 },
 {
  "file": "13_1b.tob",
  "idx": 157,
  "cn": "“诶、给您添麻烦了吗？”"
 },
 {
  "file": "13_1b.tob",
  "idx": 190,
  "cn": "“……傻不傻”"
 },
 {
  "file": "13_2a.tob",
  "idx": 13,
  "cn": "“因为、男朋友会穿着女朋友喜欢的衣服回来嘛、女朋友也得穿着男朋友喜欢的衣服来迎接才行——”"
 },
 {
  "file": "13_2a.tob",
  "idx": 19,
  "cn": "“啊、那就贤惠的妻子吧。老公、我饿了、有没有什么能随手抓着吃的东西呢。毕竟要老婆出手嘛”"
 },
 {
  "file": "13_2a.tob",
  "idx": 20,
  "cn": "“呀、装什么新婚夫妻——、隼人你真是的——。扭扭——、扭扭——”"
 },
 {
  "file": "13_2a.tob",
  "idx": 21,
  "cn": "“有没有能随手抓着吃的呢。毕竟要老婆出手嘛”"
 },
 {
  "file": "13_2a.tob",
  "idx": 33,
  "cn": "“把装柠檬的壶整个端来。要的就是柠檬嘛”"
 }
]