{
 "batch": 16,
 "tr": [
  {
   "i": 12000,
   "cn": "“怎么说呢……就是那种别扭小孩的、寂寞啊逞强啊——、之类的。这么没救的东西、本来就不该给别人看吧。嘛、就我个人来说算是常见套路……感觉还真有点能共情”"
  },
  {
   "i": 12001,
   "cn": "“嘛、怎么想这个作者都是脑子有病、所以我可不想跟他打交道”"
  },
  {
   "i": 12002,
   "cn": "“啊哈哈哈、猜得还挺准。真不爽啊、这家伙”"
  },
  {
   "i": 12003,
   "cn": "“哈？”"
  },
  {
   "i": 12004,
   "cn": "“明日香。这家伙、就是凤凰寺翔”"
  },
  {
   "i": 12005,
   "cn": "“这就是！？”"
  },
  {
   "i": 12006,
   "cn": "“不会吧……我对本人完全没兴趣、虽然都被说成帅哥但照片一次都没看过……”"
  },
  {
   "i": 12007,
   "cn": "“前辈、这种事要早点说啊。我什么没救啦、脑子有病啦、当着人家的面全都乱说了一遍啊”"
  },
  {
   "i": 12008,
   "cn": "“有什么不好。那种话、对那家伙来说算是夸奖吧。他只是不习惯被夸才顶回来的”"
  },
  {
   "i": 12009,
   "cn": "“诶、那个、凤凰寺同学？其实我、这种东西完全看不懂、但又新又有深度、我觉得是幅非常棒的画！开玩笑的！”"
  },
  {
   "i": 12010,
   "cn": "“啊哈哈、干嘛特地换成那么老套的说法啊。别装普通人了、天蓝色小穴”"
  },
  {
   "i": 12011,
   "cn": "“咕”"
  },
  {
   "i": 12012,
   "cn": "“啊？你身边的人全是这种货色吗？啊？啊？”"
  },
  {
   "i": 12013,
   "cn": "“店长～”"
  },
  {
   "i": 12014,
   "cn": "“嗯呼、嗯呼呼……不行的啊……三根手指的话我会坏掉的、嗯呼呼……”"
  },
  {
   "i": 12015,
   "cn": "“店长！刚才点的浓缩咖啡还没好吗！”"
  },
  {
   "i": 12016,
   "cn": "“哈！？啊、抱歉抱歉。没什么、刚才渡来同学批准了、我正拿她随意想象呢”"
  },
  {
   "i": 12017,
   "cn": "“哇……玉泉真忍得住啊、摊上这种上司”"
  },
  {
   "i": 12018,
   "cn": "“嗯？那是什么眼神、是在勾引我吗”"
  },
  {
   "i": 12019,
   "cn": "“呐呐。话说、大家聚在一起看什么呢？”"
  },
  {
   "i": 12020,
   "cn": "“啊、在看去年的贺年卡。对了、客户和员工送来的也拿来参考一下吧”"
  },
  {
   "i": 12021,
   "cn": "“哇、好怀念——！这个、是我去年、寄到店里的那个啊”"
  },
  {
   "i": 12022,
   "cn": "“土死了、什么啊满是草莓。跟贺年卡一点关系都没有吧”"
  },
  {
   "i": 12023,
   "cn": "“噗——！有什么不好、女孩子的生肖永远都是草莓年啦”"
  },
  {
   "i": 12024,
   "cn": "“这是小孩的生日卡吗。想想自己的年纪、年纪”"
  },
  {
   "i": 12025,
   "cn": "“哼。儿童文学的名著、难道就只是启蒙小孩的知育书吗？所有小鬼都像出麻疹一样必定憧憬一次的异国跑车、真正开着它到处跑的主顾又是谁？”"
  },
  {
   "i": 12026,
   "cn": "“连离开故乡后回望的原风景之趣都理解不了、鸡先生啊、看来你也不过是个相当无趣的大人啊”"
  },
  {
   "i": 12027,
   "cn": "“哈？什么啊乌鸦、刮的什么风。明明是个阳痿还给女人撑腰”"
  },
  {
   "i": 12028,
   "cn": "“啊、这个人、就是对那种柔柔弱弱的女孩子类型没抵抗力。拿艺人来说、就是蛎崎海胆那种”"
  },
  {
   "i": 12029,
   "cn": "“哇、是这样吗！”"
  },
  {
   "i": 12030,
   "cn": "“这个嘛、谁知道呢。我只是对那种不理会世间风评、坚持自己摇滚的笨蛋、姑且抱有一份敬意而已”"
  },
  {
   "i": 12031,
   "cn": "“别害羞啊”"
  },
  {
   "i": 12032,
   "cn": "“操”"
  },
  {
   "i": 12033,
   "cn": "“喂喂、别在店里吵架啊？好了、我去干点活。想被抱的时候随时叫我”"
  },
  {
   "i": 12034,
   "cn": "“不会有那种事、好——”"
  },
  {
   "i": 12035,
   "cn": "“诶、什么什么贺年卡！？给我看看给我看看！”"
  },
  {
   "i": 12036,
   "cn": "“你们这帮人说忙根本是骗人的吧”"
  },
  {
   "i": 12037,
   "cn": "“呀、因为、我们朋友之间就只发个短信说新年快乐、这种东西反而很怀念——”"
  },
  {
   "i": 12038,
   "cn": "“哦、发现了一张挺古怪的。寄件人、到底是谁呢……”"
  },
  {
   "i": 12039,
   "cn": "“哇、是玉泉。那家伙跟那张脸真不搭、画和字都怪花哨的啊”"
  },
  {
   "i": 12040,
   "cn": "“话说这个、到底是什么东西？十二生肖里有海象和变形虫还有怪诞虫的合成兽吗？”"
  },
  {
   "i": 12041,
   "cn": "“哇！小明日香、这是什么啊、这幅画简直像心怀黑暗的小孩画的家族肖像”"
  },
  {
   "i": 12042,
   "cn": "“啊、很厉害吧。这个玉——”"
  },
  {
   "i": 12043,
   "cn": "“哇哈——！什么啊这个、像受了北斋春画影响的海外情色猎奇作家画的画”"
  },
  {
   "i": 12044,
   "cn": "“啊、不是、玉——”"
  },
  {
   "i": 12045,
   "cn": "“哈！？什、什么啊那个、像是把宇宙真理浓缩起来的哲学视觉化一样的画……！”"
  },
  {
   "i": 12046,
   "cn": "“所以说不是那样、玉——”"
  },
  {
   "i": 12047,
   "cn": "“了不得。老实说、我现在在发抖”"
  },
  {
   "i": 12048,
   "cn": "“呼——……虽然不想轻易承认、但确实有那种达到神域的家伙。唉、普通的天才花上一百年、靠人类级别的脑子和手指也画不出这幅图吧”"
  },
  {
   "i": 12049,
   "cn": "“诶？这幅画很厉害的吗、这个？”"
  },
  {
   "i": 12050,
   "cn": "“不会吧？这种东西、跟玉日和画的超烂的画没什么差别啊”"
  },
  {
   "i": 12051,
   "cn": "“哈、你们根本不懂这个好在哪！真遗憾啊、你们说到底就是那一边的人！”"
  },
  {
   "i": 12052,
   "cn": "“我能听见、这位美术家的叹息……诅咒人类身为人类这不讲理、那灵魂的啜泣……！”"
  },
  {
   "i": 12053,
   "cn": "“不、这孩子正处在幸福的顶峰”"
  },
  {
   "i": 12054,
   "cn": "“厉害、太厉害了……画这个的家伙、是哪个国家的什么狂人……从巴洛克样式的笔触这么浓重来看、创作出来应该是在中世纪或近世吧……”"
  },
  {
   "i": 12055,
   "cn": "“不、是去年”"
  },
  {
   "i": 12056,
   "cn": "“真是令人敬畏。这是把绘画这个概念彻底打破的、新世代的观念艺术！”"
  },
  {
   "i": 12057,
   "cn": "“不、是贺年卡”"
  },
  {
   "i": 12058,
   "cn": "“啊、来客人了！我过去……一下……”"
  },
  {
   "i": 12059,
   "cn": "“哟～！圣诞快乐蹦蹦～！”"
  },
  {
   "i": 12060,
   "cn": "“ＹＯ！ＹＯ！圣夜、神圣之夜哦！”"
  },
  {
   "i": 12061,
   "cn": "“哇……怎么、又来了群看起来很麻烦的家伙……”"
  },
  {
   "i": 12062,
   "cn": "“被当成同类的话谁受得了啊……大家、去那边吧——”"
  },
  {
   "i": 12063,
   "cn": "“呀曼～！听说皇帝在这儿就跑来玩了～！”"
  },
  {
   "i": 12064,
   "cn": "“啊？干嘛啊、我不是说过已经退出团队了吗”"
  },
  {
   "i": 12065,
   "cn": "“皇帝～！别说什么这么冷冰冰的话、跟我们一起去在幸福的情侣面前、没完没了地表演有趣的验便小故事嘛——！”"
  },
  {
   "i": 12066,
   "cn": "“现在不是说那个的时候。喏、看看这幅画”"
  },
  {
   "i": 12067,
   "cn": "“哇、好家伙！这是什么画啊、不得了的灵魂嗖嗖往外冒啊！”"
  },
  {
   "i": 12068,
   "cn": "“酷毙了！怎么会这样、我啃着蹩脚的烟熏鸡的工夫、咱们什么时候迷进郡立美术馆来了？”"
  },
  {
   "i": 12069,
   "cn": "“对吧？连心都要被夺走了吧？呵呵呵……真好啊、自然地就嗨起来了呢！”"
  },
  {
   "i": 12070,
   "cn": "“噗哈哈哈哈！懂懂！哎呀——、浑身上下都咔嚓咔嚓地张开了呢～！”"
  },
  {
   "i": 12071,
   "cn": "“所以说啊皇帝！我从车里、把换的衣服和发胶拿来了——！”"
  },
  {
   "i": 12072,
   "cn": "“耶！上吧皇帝、在圣夜里来个黑暗面转换！”"
  },
  {
   "i": 12073,
   "cn": "“呵呵……呵呵呵……呼哈哈哈……”"
  },
  {
   "i": 12074,
   "cn": "“吓——哈哈哈哈哈——！久等了、红鼻子驯鹿们！柳木原头号圣者的再度诞生、把钟敲响吧！”"
  },
  {
   "i": 12075,
   "cn": "“哼、请安静点、粗俗的一行人。平民们都在皱眉头了吧”"
  },
  {
   "i": 12076,
   "cn": "“呼呜呜呜……别给我退缩啊、臭玻璃呜！跳舞吧！挣扎吧！难看地散去吧！叽吓啊啊——！”"
  },
  {
   "i": 12077,
   "cn": "“啧……血气方刚的鸡呢、看来需要稍微灸一灸呢……”"
  },
  {
   "i": 12078,
   "cn": "“喂、你们、到底在闹什么。虽说现在是平安夜最热闹的时候、但要是闹得太过火我可不会坐视不管”"
  },
  {
   "i": 12079,
   "cn": "“☆One～Two斯霍！寂静夜！神圣夜！没爱没钱没指望！”"
  },
  {
   "i": 12080,
   "cn": "“等等、叽喵啊啊啊啊——！？哈哈哈、哈里～！？我们的哈里跟火烈鸟第三类接触了～！？唔真的假的、真的要干一场吗！干了也没问题的ＤＥＡＴＨ啦——！”"
  },
  {
   "i": 12081,
   "cn": "“邦邦咔啦！祭典之夜不分敌我嘛～！大家一起来哗地摆好姿势、来个爱与和平的快乐体验呗～！”"
  },
  {
   "i": 12082,
   "cn": "“说得对！说得好啊ＤＪ奇肯多！大家一起来、把手举起来！”"
  },
  {
   "i": 12083,
   "cn": "“☆嗨～、嗨～、嗨嗨嗨嗨——！”"
  },
  {
   "i": 12084,
   "cn": "“啊哇吧啪哇吧吧啊——！！”"
  },
  {
   "i": 12085,
   "cn": "“混账东西、声音太小了——！给我彻底放开喊、我是皇帝！”"
  },
  {
   "i": 12086,
   "cn": "“不间断摇滚时间——！”"
  },
  {
   "i": 12087,
   "cn": "“哎、吵死人的家伙们、我说过我不会沉默的。所以说我喊了！”"
  },
  {
   "i": 12088,
   "cn": "“波利尼西亚性爱！”"
  },
  {
   "i": 12089,
   "cn": "“吵死了——！要闹给我到外面闹——！！”"
  },
  {
   "i": 12090,
   "cn": "我们的奶子啊直到永远"
  },
  {
   "i": 12091,
   "cn": "“呼、闭店的收尾检查也做完了。员工们好像都已经回去了”"
  },
  {
   "i": 12092,
   "cn": "“不过……虽然也闹了点小乱子、总之、总算是把平安夜这忙碌的一天熬过来了。真是的、手下都是优秀的人才、我这个店长真幸福”"
  },
  {
   "i": 12093,
   "cn": "“那么、我也很想赶紧回家休息、但为了准备明天还是稍微加一会儿班吧”"
  },
  {
   "i": 12094,
   "cn": "“唉、嘿咻——”"
  },
  {
   "i": 12095,
   "cn": "“——哦！？”"
  },
  {
   "i": 12096,
   "cn": "“圣诞！”"
  },
  {
   "i": 12097,
   "cn": "“快乐！”"
  },
  {
   "i": 12098,
   "cn": "“啦！”"
  },
  {
   "i": 12099,
   "cn": "“什、什什、什么情况这是……”"
  },
  {
   "i": 12100,
   "cn": "“啊哈哈、店长吓到了”"
  },
  {
   "i": 12101,
   "cn": "“不是、可是、你们不是已经回去了吗……而且还连优都……而且还那身打扮……”"
  },
  {
   "i": 12102,
   "cn": "“啊、因为你说可以穿我就借了、前辈的秘藏收藏品”"
  },
  {
   "i": 12103,
   "cn": "“你、你们……为了我特地……”"
  },
  {
   "i": 12104,
   "cn": "“才、才不是为了店长、就是随便……气氛啦、气氛”"
  },
  {
   "i": 12105,
   "cn": "“对对。才不是因为听了店长的青春故事之类的、完全不是那么回事啦”"
  },
  {
   "i": 12106,
   "cn": "“对对对。说什么平时受了你不少照顾之类的、完全没有那种事”"
  },
  {
   "i": 12107,
   "cn": "“你、你们……”"
  },
  {
   "i": 12108,
   "cn": "“这、这帮混蛋、居然做这么够义气的事……眼睛、眼睛里的热汗停不下来了啊！”"
  },
  {
   "i": 12109,
   "cn": "“前辈、比起那种掩饰害羞的话、该对可爱的部下们说的话有吧。我也是、被这两个人求着没办法才回来的啊”"
  },
  {
   "i": 12110,
   "cn": "“啊、说得对。谢谢、你们两个。我真是、开了这家店太好了。这是最棒的圣诞礼物”"
  },
  {
   "i": 12111,
   "cn": "“嘿嘿～”"
  },
  {
   "i": 12112,
   "cn": "“啊！也就是说、第一届·制服乱交节要开幕了对吧！”"
  },
  {
   "i": 12113,
   "cn": "“唉唉……店长、真是不擅长正经话题啊”"
  },
  {
   "i": 12114,
   "cn": "“唉、我还是回去吧。打扮成年轻孩子的样子感觉太亏了”"
  },
  {
   "i": 12115,
   "cn": "“哈哈哈、抱歉抱歉。不、拿出自信来、优。你那身打扮也很合适哦”"
  },
  {
   "i": 12116,
   "cn": "“诶……真、真的吗？我这样还能算现役吗？”"
  },
  {
   "i": 12117,
   "cn": "“啊、从哪个角度看、都完全像学园题材的ＡＶ”"
  },
  {
   "i": 12118,
   "cn": "“呜哇啊啊啊啊！”"
  },
  {
   "i": 12119,
   "cn": "“日野同学果然是最年轻的、完全没有违和感”"
  },
  {
   "i": 12120,
   "cn": "“唔、算是吧。化妆手法倒是稍微改了点”"
  },
  {
   "i": 12121,
   "cn": "“嗯呼呼——。大家一起挑制服的时候、小英里最先挑的就是那件吧——？”"
  },
  {
   "i": 12122,
   "cn": "“哦——？”"
  },
  {
   "i": 12123,
   "cn": "“干、干嘛。有什么问题吗”"
  },
  {
   "i": 12124,
   "cn": "“嗯呼呼——。是想跟小日和穿一样的吧——”"
  },
  {
   "i": 12125,
   "cn": "“啊、说起来这个、是她那儿的制服啊。我完全没注意”"
  },
  {
   "i": 12126,
   "cn": "“唔嗯、领结应该也有三种颜色、却特地挑了跟玉泉同学一样的那件吗。真讲究啊”"
  },
  {
   "i": 12127,
   "cn": "“嗯、是偶然啦！”"
  },
  {
   "i": 12128,
   "cn": "“嗯呼呼？”"
  },
  {
   "i": 12129,
   "cn": "“咕呼呼？”"
  },
  {
   "i": 12130,
   "cn": "“话说小纪奈子你、也挺干脆地挑了那件制服呢。有什么理由吗？”"
  },
  {
   "i": 12131,
   "cn": "“苍女的西装外套、我以前穿过一次。所以下次想试试水手服那款”"
  },
  {
   "i": 12132,
   "cn": "“丁零～☆怎么样、合适——？”"
  },
  {
   "i": 12133,
   "cn": "“啊、很合适很可爱哦”"
  },
  {
   "i": 12134,
   "cn": "“谁是色情片啊！”"
  },
  {
   "i": 12135,
   "cn": "“不、不是、那个……我刚刚只是普通地夸了一句……”"
  },
  {
   "i": 12136,
   "cn": "“纪奈子小姐、你这被害妄想真强啊”"
  },
  {
   "i": 12137,
   "cn": "“算了、总之今晚就痛快地闹一场吧！哦、对了、我待会儿也把学生时代的灯笼裤穿上”"
  },
  {
   "i": 12138,
