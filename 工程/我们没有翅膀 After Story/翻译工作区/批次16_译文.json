  {
   "i": 12519,
   "cn": "“呀——、全力上的话还来得及吧——”"
  },
  {
   "i": 12520,
   "cn": "“嗯——……嘛、也许吧——”"
  },
  {
   "i": 12521,
   "cn": "“对对、只要全力上的话——”"
  },
  {
   "i": 12522,
   "cn": "“…………”"
  },
  {
   "i": 12523,
   "cn": "“…………”"
  },
  {
   "i": 12524,
   "cn": "“小鸣——……”"
  },
  {
   "i": 12525,
   "cn": "“诶——？什么——、小亚衣……”"
  },
  {
   "i": 12526,
   "cn": "“快点拿出来啊、全力……”"
  },
  {
   "i": 12527,
   "cn": "“呀——、小亚衣先拿出来就好——”"
  },
  {
   "i": 12528,
   "cn": "“咦、我没说过吗。我、是慢热型”"
  },
  {
   "i": 12529,
   "cn": "“啊～、我也是～。跑法、后追型～”"
  },
  {
   "i": 12530,
   "cn": "“那就该动手了、已经转过第四个弯道了”"
  },
  {
   "i": 12531,
   "cn": "“没事。我的最后冲刺、超强的”"
  },
  {
   "i": 12532,
   "cn": "“说什么呢、不是还没出闸门吗？”"
  },
  {
   "i": 12533,
   "cn": "“出了啦——。我已经做了半页笔记呢”"
  },
  {
   "i": 12534,
   "cn": "“太少了！”"
  },
  {
   "i": 12535,
   "cn": "“诶——、小亚衣呢——？”"
  },
  {
   "i": 12536,
   "cn": "“嘛、是啊……４～５页、左右？”"
  },
  {
   "i": 12537,
   "cn": "“好厉害～”"
  },
  {
   "i": 12538,
   "cn": "“厉害吧——？”"
  },
  {
   "i": 12539,
   "cn": "“真的吗——？”"
  },
  {
   "i": 12540,
   "cn": "“半页左右”"
  },
  {
   "i": 12541,
   "cn": "“哇——、半斤八两——”"
  },
  {
   "i": 12542,
   "cn": "“不如说、垫底之间比高矮？”"
  },
  {
   "i": 12543,
   "cn": "“好会接～”"
  },
  {
   "i": 12544,
   "cn": "“会接吧——？”"
  },
  {
   "i": 12545,
   "cn": "“也就是说很不妙～”"
  },
  {
   "i": 12546,
   "cn": "“嗯、不妙呢、终于”"
  },
  {
   "i": 12547,
   "cn": "“只剩两天了嘛——、终于”"
  },
  {
   "i": 12548,
   "cn": "“…………”"
  },
  {
   "i": 12549,
   "cn": "“…………”"
  },
  {
   "i": 12550,
   "cn": "“真奇怪啊——、之前我们都在干什么呢”"
  },
  {
   "i": 12551,
   "cn": "“对吧——？我们、还挺努力的呢”"
  },
  {
   "i": 12552,
   "cn": "“对吧——？放学后留下来、一边玩闹一边摊开笔记本、很努力了吧——？”"
  },
  {
   "i": 12553,
   "cn": "“好悲伤啊～、原来真的有没有回报的努力呢～”"
  },
  {
   "i": 12554,
   "cn": "“不过、我们该做的都做了、老师应该也会理解吧”"
  },
  {
   "i": 12555,
   "cn": "“嘛嘛、应该要有酌情处理的余地呢——”"
  },
  {
   "i": 12556,
   "cn": "“如果这样还不被原谅、现在这一刻正在努力的我们、也太可怜了吧？”"
  },
  {
   "i": 12557,
   "cn": "“真的——。而且那样的话、至今那些血泪般的努力也全都白费了吧——？”"
  },
  {
   "i": 12558,
   "cn": "“什么啊这太鬼畜了……不可能——……”"
  },
  {
   "i": 12559,
   "cn": "“真是个艰难的时代～”"
  },
  {
   "i": 12560,
   "cn": "“啊～真是的、超难受。今天完全没干劲～……”"
  },
  {
   "i": 12561,
   "cn": "“嗯——、就是、进不来呢……”"
  },
  {
   "i": 12562,
   "cn": "“进不来呢……”"
  },
  {
   "i": 12563,
   "cn": "“也提不起来”"
  },
  {
   "i": 12564,
   "cn": "“提不起来呢——”"
  },
  {
   "i": 12565,
   "cn": "“也降不下来”"
  },
  {
   "i": 12566,
   "cn": "“降不下来呢——”"
  },
  {
   "i": 12567,
   "cn": "“果然今天、跟平时有点不一样呢”"
  },
  {
   "i": 12568,
   "cn": "“懂、也许是不一样～”"
  },
  {
   "i": 12569,
   "cn": "“该说是动力没法维持吗？还是说注意力被扰乱了呢？”"
  },
  {
   "i": 12570,
   "cn": "“有种什么东西嗖地一下抽走了的感觉”"
  },
  {
   "i": 12571,
   "cn": "“到昨天为止的自己已经不在这里了呢”"
  },
  {
   "i": 12572,
   "cn": "“这是怎么回事。风水上不太行吗”"
  },
  {
   "i": 12573,
   "cn": "“呀——、也许是生物钟的紊乱期”"
  },
  {
   "i": 12574,
   "cn": "“难道是身体上的问题吗。诶、怎么办、现在去医院？”"
  },
  {
   "i": 12575,
   "cn": "“想去——、可是课题怎么办——？”"
  },
  {
   "i": 12576,
   "cn": "“啊、对哦、那个还留着呢”"
  },
  {
   "i": 12577,
   "cn": "“是还留着啦——、不过我最近、笔头不太顺呢——”"
  },
  {
   "i": 12578,
   "cn": "“啊、我也是我也是。怎么说呢、终于撞上墙的感觉？”"
  },
  {
   "i": 12579,
   "cn": "“对对、就是低潮期的感觉——”"
  },
  {
   "i": 12580,
   "cn": "“是不是一开始冲太猛了——。嗯、就是所谓的燃尽症候群？”"
  },
  {
   "i": 12581,
   "cn": "“我也感觉到热情的枯竭了——。无法否认已经全部掏空了呢——”"
  },
  {
   "i": 12582,
   "cn": "“哈、说实话已经累了。偶尔也想忘了学习的事懒懒地躺着呢”"
  },
  {
   "i": 12583,
   "cn": "“唉——、名为课题的残酷命运什么时候才会把我解放呢——”"
  },
  {
   "i": 12584,
   "cn": "“是吗。我们的课题没进展、是命运般的、那个、神的恶作剧”"
  },
  {
   "i": 12585,
   "cn": "“菅原的恶作剧吗”"
  },
  {
   "i": 12586,
   "cn": "“哎呀——、那个啊——、最近菅Ｐ是不是太得意忘形了？”"
  },
  {
   "i": 12587,
   "cn": "“那待会儿去收拾他——”"
  },
  {
   "i": 12588,
   "cn": "“哈、解决”"
  },
  {
   "i": 12589,
   "cn": "“唉～”"
  },
  {
   "i": 12590,
   "cn": "“…………”"
  },
  {
   "i": 12591,
   "cn": "“…………”"
  },
  {
   "i": 12592,
   "cn": "“小鸣——”"
  },
  {
   "i": 12593,
   "cn": "“诶——？什么——、小亚衣”"
  },
  {
   "i": 12594,
   "cn": "“差不多开始吧——？”"
  },
  {
   "i": 12595,
   "cn": "“啊——、是啊——”"
  },
  {
   "i": 12596,
   "cn": "“毕竟也该开始了～”"
  },
  {
   "i": 12597,
   "cn": "“嗯～、那～、再过五分钟就开始～”"
  },
  {
   "i": 12598,
   "cn": "“收——到——”"
  },
  {
   "i": 12599,
   "cn": "“…………”"
  },
  {
   "i": 12600,
   "cn": "“…………”"
  },
  {
   "i": 12601,
   "cn": "“凤——”"
  },
  {
   "i": 12602,
   "cn": "“诶～？什么啊香田～”"
  },
  {
   "i": 12603,
   "cn": "“总之去趟Ｔ放松一下怎么样？”"
  },
  {
   "i": 12604,
   "cn": "“去厕所参拜吗——、不错呢——”"
  },
  {
   "i": 12605,
   "cn": "“也差不多到该休息的时间了、顺便轻松换口气”"
  },
  {
   "i": 12606,
   "cn": "“洗手间是少女身边最近的隐秘据点呢——”"
  },
  {
   "i": 12607,
   "cn": "“是给努力的自己的奖励呢——”"
  },
  {
   "i": 12608,
   "cn": "“让小溪的潺潺声治愈心灵之旅”"
  },
  {
   "i": 12609,
   "cn": "“诶、小鸣你是尼亚加拉吧”"
  },
  {
   "i": 12610,
   "cn": "“哇——、低俗到越界成名誉损毁——”"
  },
  {
   "i": 12611,
   "cn": "“可是、翔同学说的哦？”"
  },
  {
   "i": 12612,
   "cn": "“那家伙也可以杀了吧”"
  },
  {
   "i": 12613,
   "cn": "２天前：黄昏忧郁"
  },
  {
   "i": 12614,
   "cn": "“唉～、久等了～”"
  },
  {
   "i": 12615,
   "cn": "“喏。小鸣、洗手了吗？”"
  },
  {
   "i": 12616,
   "cn": "“洗了啊——。话说、干嘛特地问我——？我从来没有一次没洗手过哦——？”"
  },
  {
   "i": 12617,
   "cn": "“手帕、不嫌弃的话用我的”"
  },
  {
   "i": 12618,
   "cn": "“不用啦——。话说、我自己有带哦——？为什么要把我设定成用窗帘擦手的角色啊——？”"
  },
  {
   "i": 12619,
   "cn": "“唉……这样就焕然一新、可以毫无顾虑地投入学习了呢……”"
  },
  {
   "i": 12620,
   "cn": "“唉……心情非常清爽呢……”"
  },
  {
   "i": 12621,
   "cn": "“…………”"
  },
  {
   "i": 12622,
   "cn": "“…………”"
  },
  {
   "i": 12623,
   "cn": "“那个啊～……”"
  },
  {
   "i": 12624,
   "cn": "“嗯～、什么～……”"
  },
  {
   "i": 12625,
   "cn": "“会不会有啊……回到教室之后、小小的菅原已经把课题全都做完了之类的……”"
  },
  {
   "i": 12626,
   "cn": "“啊～、有有有～……”"
  },
  {
   "i": 12627,
   "cn": "“唔？”"
  },
  {
   "i": 12628,
   "cn": "“诶——、怎么了小亚衣、窗户下面有菅原吗——？”"
  },
  {
   "i": 12629,
   "cn": "“呀、刚才等小鸣的时候、中庭里有附属的孩子在打羽毛球”"
  },
  {
   "i": 12630,
   "cn": "“不会吧～、在这种大冷天？”"
  },
  {
   "i": 12631,
   "cn": "“刚才仔细一看、那些孩子——”"
  },
  {
   "i": 12632,
   "cn": "“哪些孩子～？”"
  },
  {
   "i": 12633,
   "cn": "“——是小鸠儿和吉川酱”"
  },
  {
   "i": 12634,
   "cn": "“啊～、真的呢～”"
  },
  {
   "i": 12635,
   "cn": "“她们在说什么呢”"
  },
  {
   "i": 12636,
   "cn": "“打开窗户看看吧——”"
  },
  {
   "i": 12637,
   "cn": "“好啊”"
  },
  {
   "i": 12638,
   "cn": "“好冷！”"
  },
  {
   "i": 12639,
   "cn": "“冻、冻冻冻冻死了、暴风雪警报发布”"
  },
  {
   "i": 12640,
   "cn": "“不不不不可能、这根本不是人能待的气温。糟了、得赶紧把那两个孩子救出来……”"
  },
  {
   "i": 12641,
   "cn": "“嘿嘿、动来动去所以出汗了”"
  },
  {
   "i": 12642,
   "cn": "“不过、身上暖洋洋的很舒服呢”"
  },
  {
   "i": 12643,
   "cn": "“唔、稍微休息一下就开始第４回合吧”"
  },
  {
   "i": 12644,
   "cn": "“好～、下次不会输了哦～”"
  },
  {
   "i": 12645,
   "cn": "“…………”"
  },
  {
   "i": 12646,
   "cn": "“…………”"
  },
  {
   "i": 12647,
   "cn": "“怎么说……”"
  },
  {
   "i": 12648,
   "cn": "“嗯……”"
  },
  {
   "i": 12649,
   "cn": "“好耀眼呢……”"
  },
  {
   "i": 12650,
   "cn": "“好纯真呢……”"
  },
  {
   "i": 12651,
   "cn": "“该说是透明感吗——”"
  },
  {
   "i": 12652,
   "cn": "“里面住了天使呢”"
  },
  {
   "i": 12653,
   "cn": "“该说是天真吗——”"
  },
  {
   "i": 12654,
   "cn": "“正是毫无邪气呢”"
  },
  {
   "i": 12655,
   "cn": "“嗯、毫不浑浊”"
  },
  {
   "i": 12656,
   "cn": "“嗯、毫不世故”"
  },
  {
   "i": 12657,
   "cn": "“真清澈啊——”"
  },
  {
   "i": 12658,
   "cn": "“真清爽啊——”"
  },
  {
   "i": 12659,
   "cn": "“眼睛闪闪发光呢——”"
  },
  {
   "i": 12660,
   "cn": "“那是悲伤时还能坦率地流下眼泪的眼睛呢”"
  },
  {
   "i": 12661,
   "cn": "“是对谁都能毫无算计地笑的眼睛呢——”"
  },
  {
   "i": 12662,
   "cn": "“是还不知道妥协和挫折的眼睛呢”"
  },
  {
   "i": 12663,
   "cn": "“希望她还相信圣诞老人呢——”"
  },
  {
   "i": 12664,
   "cn": "“希望她说将来的梦想是当新娘呢”"
  },
  {
   "i": 12665,
   "cn": "“我也有过那样的时代吗——”"
  },
  {
   "i": 12666,
   "cn": "“我们是从什么时候起不再是小孩的呢”"
  },
  {
   "i": 12667,
   "cn": "“所谓大人、就是被背叛的青年的模样——太宰治”"
  },
  {
   "i": 12668,
   "cn": "“呼——、年轻真好呢”"
  },
  {
   "i": 12669,
   "cn": "“不会肌肉酸痛、之类的吧——”"
  },
  {
   "i": 12670,
   "cn": "“往后转的时候、不会腰疼之类的吧”"
  },
  {
   "i": 12671,
   "cn": "“唉——……真怀念把书包一扔玩到天黑的那些日子啊——”"
  },
  {
   "i": 12672,
   "cn": "“奶奶、经常瞒着妈妈给我零花钱呢”"
  },
  {
   "i": 12673,
   "cn": "“啊对——、手心里攥着的十日元的味道一瞬间就能穿越回那个时候呢——”"
  },
  {
   "i": 12674,
   "cn": "“那时候啊……粉末果汁和１０日元蛋糕什么的、不可思议地好吃呢”"
  },
  {
   "i": 12675,
   "cn": "“还在帆布鞋里堆沙子玩呢——”"
  },
  {
   "i": 12676,
   "cn": "“书法套装、现在拿的话应该也没多重吧”"
  },
  {
   "i": 12677,
   "cn": "“供餐有炸面包的日子超兴奋的呢——”"
  },
  {
   "i": 12678,
   "cn": "“我、以前喜欢那种奶油炖鸡肉”"
  },
  {
   "i": 12679,
   "cn": "“小孩最喜欢‘能长血长肉的东西’了嘛——”"
  },
  {
   "i": 12680,
   "cn": "“啊……说起来、附属那边中午、是吃供餐的吧”"
  },
  {
   "i": 12681,
   "cn": "“真好啊——、那些孩子、还在吃软面之类的呢——”"
  },
  {
   "i": 12682,
   "cn": "“吉川同学、体力恢复了吗？”"
  },
  {
   "i": 12683,
   "cn": "“嗯、已经没事了。那开始吧”"
  },
  {
   "i": 12684,
   "cn": "“球场、下次我在这一边哦”"
  },
  {
   "i": 12685,
   "cn": "“那我、去那边……呀啊”"
  },
  {
   "i": 12686,
   "cn": "“没、没事吧！？”"
  },
  {
   "i": 12687,
   "cn": "“嘿嘿、没事——”"
  },
  {
   "i": 12688,
   "cn": "“…………”"
  },
  {
   "i": 12689,
   "cn": "“…………”"
  },
  {
   "i": 12690,
   "cn": "“……摔倒了”"
  },
  {
   "i": 12691,
   "cn": "“摔倒了呢——”"
  },
  {
   "i": 12692,
   "cn": "“冒失鬼”"
  },
  {
   "i": 12693,
   "cn": "“小孩基本上都是冒失鬼呢——”"
  },
  {
   "i": 12694,
   "cn": "“话说、小时候、为什么那么频繁地摔倒呢”"
  },
  {
   "i": 12695,
   "cn": "“年轻人向前走、老人低头走——奥托丽·纳露恩”"
  },
  {
   "i": 12696,
   "cn": "“大人真精明呢”"
  },
  {
   "i": 12697,
   "cn": "“不想变成那样的大人呢——”"
  },
  {
   "i": 12698,
   "cn": "“想变成能向前走的成年人呢”"
  },
  {
   "i": 12699,
   "cn": "“比起避开痛苦的聪明、更想拥有忍耐痛苦的坚强呢——”"
  },
  {
   "i": 12700,
   "cn": "“不如说、按场合把大人和小孩分开来用的、我们这一代才最烦人呢”"
  },
  {
   "i": 12701,
   "cn": "“好、就用这个收个尾——”"
  },
  {
   "i": 12702,
   "cn": "“然后？”"
  },
  {
   "i": 12703,
   "cn": "“差不多该开始了吧——！”"
  },
  {
   "i": 12704,
   "cn": "“开始啥？”"
  },
  {
   "i": 12705,
   "cn": "“不、课题……”"
  },
  {
   "i": 12706,
